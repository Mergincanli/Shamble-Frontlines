{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node tools/gate.mjs)",
      "Bash(node tools/gate.mjs *)",
      "Bash(node tools/battery.js *)",
      "Bash(node tools/preview.js *)",
      "Bash(node tools/pageshot.js *)",
      "Bash(node --check *)",
      "Bash(npx --no -- playwright *)",
      "Bash(python tools/village.py *)",
      "Bash(python3 tools/village.py *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)",
      "Bash(git merge-base *)",
      "Bash(git push -u origin cs/*)",
      "Bash(git push --set-upstream origin cs/*)",
      "Bash(git push origin cs/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)"
    ],
    "ask": [
      "Bash(git switch -f *)",
      "Bash(git switch --force *)",
      "Bash(git switch --discard-changes *)",
      "Bash(git switch -C *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete --force *)",
      "Bash(git worktree remove *)",
      "Bash(git commit --amend *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(gh pr merge *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm run *)",
      "Bash(npm test *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push * HEAD:main)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *+*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)",
      "Bash(git push * -d *)",
      "Bash(git push *--receive-pack*)",
      "Bash(git push *--exec*)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git fetch *ext::*)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(rm -rf *)",
      "Bash(gh repo delete *)",
      "Read(**/.env*)",
      "Read(~/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/syntax-gate.mjs" }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  }
}
