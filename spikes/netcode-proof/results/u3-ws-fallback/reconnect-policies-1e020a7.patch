+    fn lineage(o: Opts, r: u64, n: u64, spacing: u64) -> Outcome {
+        let b0 = 5 * SEC + ((r * 618_033_989) % SEC) * 2;
+        let starts: Vec<u64> = (0..n).map(|j| b0 + j * spacing).collect();
+        let p = Profile::b1(&starts);
+        run(&p, 9_000_000 + r, b0 + (n - 1) * spacing + 13 * SEC, o)
+    }
+
+    fn multi_summary(name: &str, o: Opts, runs: u64, n: u64) {
+        let outs = multi(o, runs, n, 20 * SEC);
+        let bursts: Vec<&BurstOut> = outs.iter().flat_map(|r| r.bursts.iter()).collect();
+        let mut all: Vec<u64> = bursts.iter().map(|b| b.recovery.unwrap_or(u64::MAX)).collect();
+        all.sort_unstable();
+        let thr = bursts.iter().filter(|b| b.throttle_max >= MS).count();
+        let thr500 = bursts.iter().filter(|b| b.throttle_max >= 500 * MS).count();
+        let tmax = bursts.iter().map(|b| b.throttle_max).max().unwrap_or(0) / MS;
+        let att: u64 = bursts.iter().map(|b| u64::from(b.attempts)).sum();
+        let tk: u64 = bursts.iter().map(|b| u64::from(b.takeovers + b.takeovers_after)).sum();
+        println!("{name} {n} x {runs}: {}; throttled>=1ms {thr}, >=500ms {thr500}, max {tmax} ms; attempts/burst {:.3}, takeovers/burst {:.3}",
+            summary(&all), att as f64 / bursts.len() as f64, tk as f64 / bursts.len() as f64);
+    }
