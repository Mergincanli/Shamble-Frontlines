      "Bash(curl --fail --silent --show-error --max-time 30 -H \"accept: application/dns-json\" \"https://cloudflare-dns.com/dns-query?name=_acme-challenge.rs.nt.shamblefrontlines.com&type=TXT\")",
      "PowerShell(curl.exe --fail --silent --show-error --max-time 30 \"https://crt.sh/?q=%25.nt.shamblefrontlines.com&output=json\")",
      "PowerShell(curl.exe --fail --silent --show-error --max-time 30 \"https://api.certspotter.com/v1/issuances?domain=nt.shamblefrontlines.com&include_subdomains=true&expand=dns_names\")",
      "PowerShell(curl.exe --fail --silent --show-error --max-time 30 -H \"accept: application/dns-json\" \"https://cloudflare-dns.com/dns-query?name=rs.nt.shamblefrontlines.com&type=A\")",
      "PowerShell(curl.exe --fail --silent --show-error --max-time 30 -H \"accept: application/dns-json\" \"https://cloudflare-dns.com/dns-query?name=_acme-challenge.rs.nt.shamblefrontlines.com&type=TXT\")"
