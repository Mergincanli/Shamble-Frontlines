{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Bash(git push origin claude/netcode-proof-test-plan-hcky5g)",
      "Bash(git push origin claude/netcode-proof-test-plan-hcky5g *)",
      "Bash(git push * claude/netcode-proof-test-plan-hcky5g)",
      "Bash(git push * claude/netcode-proof-test-plan-hcky5g *)",
      "Bash(git push *:claude/netcode-proof-test-plan-hcky5g*)",
      "Bash(git push origin cs/*)",
      "Bash(git push * cs/*)",
      "Bash(git push *:cs/*)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push *:refs/heads/claude/netcode-proof-test-plan-hcky5g*)",
      "Bash(git push *:refs/heads/cs/*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git -c *)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config --global core.hooksPath *)",
      "Bash(git config --local core.hooksPath *)",
      "Bash(git config set *core.hooksPath*)",
      "PowerShell(git push origin claude/netcode-proof-test-plan-hcky5g)",
      "PowerShell(git push origin claude/netcode-proof-test-plan-hcky5g *)",
      "PowerShell(git push * claude/netcode-proof-test-plan-hcky5g)",
      "PowerShell(git push * claude/netcode-proof-test-plan-hcky5g *)",
      "PowerShell(git push *:claude/netcode-proof-test-plan-hcky5g*)",
      "PowerShell(git push origin cs/*)",
      "PowerShell(git push * cs/*)",
      "PowerShell(git push *:cs/*)",
      "PowerShell(git push origin main)",
      "PowerShell(git push origin main *)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main*)",
      "PowerShell(git push *:refs/heads/main*)",
      "PowerShell(git push *:refs/heads/claude/netcode-proof-test-plan-hcky5g*)",
      "PowerShell(git push *:refs/heads/cs/*)",
      "PowerShell(git push --no-verify*)",
      "PowerShell(git push * --no-verify*)",
      "PowerShell(git -c *hookspath*)",
      "PowerShell(git * -c *hookspath*)",
      "PowerShell(git config core.hooksPath *)",
      "PowerShell(git config --global core.hooksPath *)",
      "PowerShell(git config --local core.hooksPath *)",
      "PowerShell(git config set *core.hooksPath*)",
      "Bash(gh)",
      "Bash(gh *)",
      "PowerShell(gh)",
      "PowerShell(gh *)",
      "PowerShell(gh.exe *)",
      "WebFetch",
      "WebSearch",
      "Bash(node .gate/*)",
      "PowerShell(node .gate/*)",
      "PowerShell(node .gate\\*)",
      "Read(~/.ssh/npt_operator)",
      "Read(~/.ssh/**)",
      "Read(//**/.ssh/**)",
      "Bash(cat *npt_operator)",
      "Bash(less *npt_operator)",
      "Bash(head *npt_operator)",
      "PowerShell(Get-Content *npt_operator*)",
      "PowerShell(Get-Content *.ssh*)",
      "PowerShell(gc *npt_operator*)",
      "PowerShell(gc *.ssh*)",
      "PowerShell(cat *npt_operator*)",
      "PowerShell(cat *.ssh*)",
      "PowerShell(type *npt_operator*)",
      "PowerShell(type *.ssh*)",
      "PowerShell(Select-String *npt_operator*)",
      "PowerShell(Select-String *.ssh*)",
      "PowerShell(Format-Hex *npt_operator*)",
      "PowerShell(Format-Hex *.ssh*)",
      "PowerShell(Copy-Item *npt_operator*)",
      "PowerShell(Copy-Item *.ssh*)"
    ],
    "allow": [
      "Bash(curl --fail --silent --show-error --max-time 30 \"https://crt.sh/?q=%25.nt.shamblefrontlines.com&output=json\")",
      "Bash(curl --fail --silent --show-error --max-time 30 \"https://api.certspotter.com/v1/issuances?domain=nt.shamblefrontlines.com&include_subdomains=true&expand=dns_names\")",
