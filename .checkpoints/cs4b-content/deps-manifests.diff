diff --git a/Cargo.toml b/Cargo.toml
index 01b6eff..539634c 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -15,6 +15,11 @@ ts-rs = { version = "=12.0.1", default-features = false }
 # module, which links sim-wasm's panic hook (a later cargo-deny rule on wasm-bindgen must allow both). The
 # command-line tool that writes the glue must be exactly this version (PM-0002-18); each bump is its own change-set.
 wasm-bindgen = "=0.2.130"
+# The collision library, the first outside crate inside the simulation (ADR 0004 part 10): exactly this version,
+# with its own maps ordered and its vector maths scalar (`enhanced-determinism`), behind one module of `sim`
+# (crates/sim/src/collision.rs). Each bump is its own change-set: the source audit behind the built-file check
+# (packages/client/scripts/build-checks.mjs) is per version.
+parry3d = { version = "=0.31.1", default-features = false, features = ["dim3", "f32", "alloc", "enhanced-determinism"] }
 
 # Every crate opts in with `[lints] workspace = true` (ADR 0002 parts 4 and 7).
 [workspace.lints.rust]
@@ -53,3 +58,93 @@ overflow-checks = true
 
 [profile.release.package.wasm-bindgen-shared]
 overflow-checks = true
+
+# The collision library's tree (parry3d =0.31.1; change-set 4b): every crate `cargo tree -p sim-wasm` lists for
+# wasm32, and `safe_arch`, which only an x86 build has (the native tests). The build's own check reads the wasm32
+# list (packages/client/scripts/build-checks.mjs, missingOverflowOverrides).
