+/// The commands of a step's `Input`s, newest first.
+fn sent(out: &StepOut) -> Vec<Command> {
+    out.datagrams
+        .iter()
+        .filter_map(
+            |d| match decode(Direction::ClientToRoom, Channel::Datagram, d) {
+                Ok(Message::Input(i)) => Some(i.commands),
+                _ => None,
+            },
+        )
+        .flatten()
+        .collect()
+}
