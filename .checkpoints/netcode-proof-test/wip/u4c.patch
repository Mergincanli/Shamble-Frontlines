+        assert!(
+            stream > 1_600 && acks > datagrams,
+            "{name}: {stream} stream packets and {acks} acknowledgements logged beside them"
+        );
+        assert_eq!(
+            h, pin,
+            "{name}: the datagram entries are not v1's ({h:#018x})"
+        );
+    }
+}
