+fn mixed(profile: Profile, seed: u64) -> L1Net {
+    let net = L1Net::new(seed);
+    let mut c = net.connect(profile, 1200, 0);
+    let mut listener = net.listener();
+    let mut s: Option<Box<dyn Link>> = None;
+    let mut t = MS;
+    let mut k = 0u64;
+    let big = [7u8; 1500];
