+#![cfg(feature = "bites")]
+
+const OWNER_TO_ALL: &str = "catalogue-5/owner-to-all";
+
+#[test]
+fn the_rooms_bites_are_pinned_and_every_pm_id_is_marks_jsons() {
+    assert_eq!(
+        npt_room::BITES,
+        [
+            "PM-0001-18/no-fallback",
+            "PM-0001-58/lt-ack",
+            "PM-0001-58/lt-cmd-seq",
+            "PM-0001-58/lt-press",
