--- /dev/null
+++ b/spikes/netcode-proof/crates/server/src/pump.rs
@@ -0,0 +1,430 @@
+//! The I/O step (u4-build-plan.md §4.1, §4.4 A26, §4.5, §4.9; catalogue §1 and §2): [`Decoder::pump`] decodes every
+//! inbound message of one session through npt-proto's `Quant::decode` with the `Quant` it was given, counts each
+//! refusal by kind, applies the size and channel checks at the socket ([`DecodeError`]'s socket kinds), the Input
+//! bucket, the Ping limit and the Join deadline on the injected `now`, sends the room's pings and answers the client's
+//! with their hold time, and keeps the session's RTT and the bytes the server side sent it since the last tick. It
+//! holds no `Link` (§4.11: so it can be `Send`); the caller lends one per call.
+
+use std::collections::VecDeque;
+
+use npt_link::{Channel, Link};
+use npt_proto::{DecodeError, Direction, Join, JoinRejected, Kick, Message, Ping, Pong, Quant};
+
+/// The Join deadline: 2 s from the connection's accept (catalogue :93), in ns.
+const JOIN_DEADLINE_NS: u64 = 2_000_000_000;
+/// The room's ping interval: a few a second (catalogue :91), in ns.
+const PING_INTERVAL_NS: u64 = 250_000_000;
+/// One second, in ns.
+const SECOND_NS: u64 = 1_000_000_000;
+/// The Input bucket's size (catalogue :87: "a bucket of 8 datagrams").
+const INPUT_BUCKET: u64 = 8;
+/// The Ping limit (catalogue :91: "10 a second per session"), as a bucket of 10 refilled at 10 a second.
+const PINGS_A_SECOND: u64 = 10;
+/// Outstanding pings kept, at most; an older one's `Pong` is then not outstanding.
+const OUTSTANDING: usize = 8;
+/// RTT samples kept for the lowest-recent estimate.
+const SAMPLES: usize = 8;
+/// What each datagram costs the window beyond its payload (catalogue :88).
+const DATAGRAM_OVERHEAD: u32 = 28;
+
+/// A token bucket on the injected clock, exact in integers: its level counts tokens in units of 10^-9 token, so a
+/// refill of `rate` tokens a second adds `rate` units per ns.
+#[derive(Clone, Copy, Debug)]
+struct Bucket {
+    cap: u64,
+    rate: u64,
+    level: u64,
+    at_ns: u64,
+}
+
+impl Bucket {
+    fn full(cap: u64, rate: u64, now_ns: u64) -> Bucket {
+        Bucket {
+            cap,
+            rate,
+            level: cap.saturating_mul(SECOND_NS),
+            at_ns: now_ns,
+        }
+    }
+
+    /// Takes one token at `now_ns` if the bucket holds one.
+    fn take(&mut self, now_ns: u64) -> bool {
+        let elapsed = now_ns.saturating_sub(self.at_ns);
+        self.at_ns = self.at_ns.max(now_ns);
+        self.level = self
+            .level
+            .saturating_add(elapsed.saturating_mul(self.rate))
+            .min(self.cap.saturating_mul(SECOND_NS));
+        if self.level >= SECOND_NS {
+            self.level -= SECOND_NS;
+            true
+        } else {
+            false
+        }
+    }
+}
+
+/// One connection's wall-time limits on the injected clock (catalogue :87, :91, :93): the Input bucket (8 datagrams,
+/// refilled at 2 × the tick rate a second), the Ping limit (10 a second) and the Join deadline (2 s from the accept).
+/// The tick rate is an argument (the F2 ruling): production callers pass `npt_sim::TICK_HZ`.
+#[derive(Clone, Copy, Debug)]
+pub struct ConnLimits {
+    tick_hz: u32,
+    input: Bucket,
+    ping: Bucket,
+    deadline_ns: u64,
+}
+
+impl ConnLimits {
+    /// The limits of a connection accepted at `accept_ns`, at `tick_hz` ticks a second.
+    pub fn new(tick_hz: u32, accept_ns: u64) -> ConnLimits {
+        let tick_hz = tick_hz.max(1);
+        ConnLimits {
+            tick_hz,
+            input: Bucket::full(INPUT_BUCKET, 2 * u64::from(tick_hz), accept_ns),
+            ping: Bucket::full(PINGS_A_SECOND, PINGS_A_SECOND, accept_ns),
+            deadline_ns: accept_ns.saturating_add(JOIN_DEADLINE_NS),
+        }
+    }
+
+    /// The Input bucket's refill, datagrams a second: 2 × the tick rate (60 at 30 Hz, 120 at 60 Hz).
+    pub fn input_refill_per_second(&self) -> u64 {
+        self.input.rate
+    }
+
+    /// The most of a `Pong`'s hold time the RTT subtracts: one tick period (catalogue :92: "33.3 ms at 30 Hz"), ns.
+    pub fn hold_cap_ns(&self) -> u64 {
+        SECOND_NS / u64::from(self.tick_hz)
+    }
+
+    /// When a connection with no `Join` is closed, ns.
+    pub fn join_deadline_ns(&self) -> u64 {
+        self.deadline_ns
+    }
+}
+
+/// One session's refusal and traffic counts (PM-0001-21's counters; U4f adds their -21 series: U4E-Q11).
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Counters {
+    /// `decode` refusals by kind: above the size the receiving end takes ...
+    pub too_large: u64,
+    /// ... ending inside a field ...
+    pub truncated: u64,
+    /// ... a stream message whose length prefix does not count its bytes ...
+    pub bad_length: u64,
+    /// ... a type byte no message has ...
+    pub unknown_type: u64,
+    /// ... a room → client type from a client (forged) ...
+    pub wrong_direction: u64,
+    /// ... a known type on a channel it does not travel on ...
+    pub wrong_channel: u64,
+    /// ... bytes after the last field ...
+    pub trailing_bytes: u64,
+    /// ... a reserved or pad bit set ...
+    pub unknown_field: u64,
+    /// ... a code outside its field ...
+    pub out_of_range: u64,
+    /// ... and well framed but not a message.
+    pub malformed: u64,
+    /// Datagrams before the session's `Join` was accepted: dropped (ADR 0001:446).
+    pub before_join: u64,
+    /// `Input` datagrams over the bucket: dropped.
+    pub input_limited: u64,
+    /// `Ping`s over the limit: dropped.
+    pub ping_limited: u64,
+    /// `Pong`s naming no outstanding ping of this session: dropped.
+    pub pong_unknown: u64,
+    /// Sessions closed as malformed because their first stream message was not a `Join` (never INVALID: the run
+    /// verdict is the judge's).
+    pub first_not_join: u64,
+    /// Sessions closed as malformed for a stream message that failed its framing, size or type checks.
+    pub stream_malformed: u64,
+    /// Sessions closed for no `Join` within 2 s of the accept.
+    pub join_deadline: u64,
+    /// `Join`s refused for the protocol version ...
+    pub wrong_version: u64,
+    /// ... or the content hash.
+    pub wrong_content_hash: u64,
+    /// A second `Join` on a session already joining or joined: dropped.
+    pub join_again: u64,
+    /// Pings the room sent.
+    pub pings_sent: u64,
+    /// Pongs the room sent.
+    pub pongs_sent: u64,
+}
+
+impl Counters {
+    fn refused(&mut self, e: DecodeError) {
+        match e {
+            DecodeError::TooLarge => self.too_large += 1,
+            DecodeError::Truncated => self.truncated += 1,
+            DecodeError::BadLength => self.bad_length += 1,
+            DecodeError::UnknownType => self.unknown_type += 1,
+            DecodeError::WrongDirection => self.wrong_direction += 1,
+            DecodeError::WrongChannel => self.wrong_channel += 1,
+            DecodeError::TrailingBytes => self.trailing_bytes += 1,
+            DecodeError::UnknownField => self.unknown_field += 1,
+            DecodeError::OutOfRange => self.out_of_range += 1,
+            DecodeError::Malformed => self.malformed += 1,
+        }
+    }
+}
+
+/// Where a session is in its life.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum State {
+    AwaitJoin,
+    /// The `Join` went to the room; its answer (`Decoder::accept` or `Decoder::reject`) is due.
+    Joining,
+    Joined,
+    Closed,
+}
+
+/// One session's decoder and I/O step (the module text).
+#[derive(Clone, Debug)]
+pub struct Decoder {
+    quant: Quant,
+    limits: ConnLimits,
+    counters: Counters,
+    version: u16,
+    content_hash: [u8; 32],
+    state: State,
+    next_ping_ns: u64,
+    ping_id: u8,
+    outstanding: VecDeque<(u8, u64)>,
+    samples: VecDeque<u64>,
+    sent_bytes: u32,
+}
+
+impl Decoder {
+    /// The decoder of a session accepted at `accept_ns`, decoding with `quant` (the wire's, `Quant::default()`; in a
+    /// bites build one of npt-proto's planted defects through `Quant::with_bite`), at `tick_hz` ticks a second
+    /// (production callers pass `npt_sim::TICK_HZ`), taking `Join`s of protocol `version` and `content_hash` only.
+    pub fn new(
+        quant: Quant,
+        tick_hz: u32,
+        accept_ns: u64,
+        version: u16,
+        content_hash: [u8; 32],
+    ) -> Decoder {
+        Decoder {
+            quant,
+            limits: ConnLimits::new(tick_hz, accept_ns),
+            counters: Counters::default(),
+            version,
+            content_hash,
+            state: State::AwaitJoin,
+            next_ping_ns: accept_ns,
+            ping_id: 0,
+            outstanding: VecDeque::new(),
+            samples: VecDeque::new(),
+            sent_bytes: 0,
+        }
+    }
+
+    /// The session's counts.
+    pub fn counters(&self) -> &Counters {
+        &self.counters
+    }
+
+    /// The session's limits.
+    pub fn limits(&self) -> &ConnLimits {
+        &self.limits
+    }
+
+    /// Whether the pump closed the session (the caller drops its link).
+    pub fn is_closed(&self) -> bool {
+        self.state == State::Closed
+    }
+
+    /// Whether the room accepted the session's `Join`.
+    pub fn is_joined(&self) -> bool {
+        self.state == State::Joined
+    }
+
+    /// The room accepted the `Join` the pump passed on: datagrams are taken from now on.
+    pub fn accept(&mut self) {
+        if self.state == State::Joining {
+            self.state = State::Joined;
+        }
+    }
+
+    /// The room refused the `Join`: `JoinRejected` with its reason, then the session closes (catalogue :96).
+    pub fn reject(&mut self, link: &mut dyn Link, reason: JoinRejected, now_ns: u64) {
+        self.send_control(link, &Message::JoinRejected(reason), now_ns);
+        self.state = State::Closed;
+    }
+
+    /// The bytes the server side sent this session since the last call (pings and pongs, payload plus 28 B each: the
+    /// room's window counts them, u4-build-plan.md §4.5).
+    pub fn take_sent_bytes(&mut self) -> u32 {
+        core::mem::take(&mut self.sent_bytes)
+    }
+
+    /// The session's RTT (u4-build-plan.md §4.9 :352-353): the link's smoothed estimate for an L1 or `wt` session
+    /// (Loopback's is 0), else the lowest recent sample of the room's own pings, each less the client's hold time up
+    /// to one tick period.
+    pub fn rtt_ns(&self, link: &dyn Link) -> Option<u64> {
+        link.rtt_ns().or_else(|| self.samples.iter().copied().min())
+    }
+
+    fn send_control(&mut self, link: &mut dyn Link, msg: &Message, now_ns: u64) {
+        let mut out = Vec::new();
+        if npt_proto::encode(msg, &mut out).is_ok() {
+            link.send_reliable(Channel::Control, &out, now_ns);
+        }
+    }
+
+    fn send_datagram(&mut self, link: &mut dyn Link, msg: &Message, now_ns: u64) {
+        let mut out = Vec::new();
+        if npt_proto::encode(msg, &mut out).is_ok() {
+            link.send_unreliable(&out, now_ns);
+            self.sent_bytes = self
+                .sent_bytes
+                .saturating_add(out.len() as u32 + DATAGRAM_OVERHEAD);
+        }
+    }
+
+    /// Closes the session as malformed, with `Kick(malformed)` while the stream still works (catalogue §1).
+    fn close_malformed(&mut self, link: &mut dyn Link, now_ns: u64) {
+        self.send_control(link, &Message::Kick(Kick::Malformed), now_ns);
+        self.state = State::Closed;
+    }
+
+    /// The I/O step at `now_ns` (the room at `tick`): the deadline, the ping sender, then every message that has
+    /// arrived, decoded and checked; what the room takes goes onto `out` with its arrival time. After a `Join` the
+    /// step returns, so the room answers it before the session's next message is read.
+    pub fn pump(
+        &mut self,
+        link: &mut dyn Link,
+        now_ns: u64,
+        tick: u32,
+        out: &mut Vec<(Message, u64)>,
+    ) {
+        if self.state == State::Closed {
+            return;
+        }
+        if self.state == State::AwaitJoin && now_ns >= self.limits.deadline_ns {
+            self.counters.join_deadline += 1;
+            self.state = State::Closed;
+            return;
+        }
+        if self.state == State::Joined && now_ns >= self.next_ping_ns {
+            let id = self.ping_id;
+            self.ping_id = id.wrapping_add(1);
+            self.outstanding.push_back((id, now_ns));
+            if self.outstanding.len() > OUTSTANDING {
+                self.outstanding.pop_front();
+            }
+            self.send_datagram(
+                link,
+                &Message::Ping(Ping {
+                    id,
+                    sent_ns: now_ns,
+                }),
+                now_ns,
+            );
+            self.counters.pings_sent += 1;
+            self.next_ping_ns = now_ns.saturating_add(PING_INTERVAL_NS);
+        }
+        while let Some(r) = link.poll_recv(now_ns) {
+            let stream = r.channel != Channel::Datagram;
+            let msg = match self
+                .quant
+                .decode(Direction::ClientToRoom, r.channel, &r.bytes)
+            {
+                Ok(m) => m,
+                Err(e) => {
+                    self.counters.refused(e);
+                    // A forged kind of a known type within its limits is refused and counted, never kicked
+                    // (u4-build-plan.md §4.10); any other bad stream message closes the session.
+                    if stream
+                        && !matches!(e, DecodeError::WrongChannel | DecodeError::WrongDirection)
+                    {
+                        self.counters.stream_malformed += 1;
+                        self.close_malformed(link, now_ns);
+                        return;
+                    }
+                    continue;
+                }
+            };
+            match (self.state, msg) {
+                (State::AwaitJoin, Message::Join(j)) => {
+                    if !self.join_ok(link, &j, now_ns) {
+                        return;
+                    }
+                    self.state = State::Joining;
+                    out.push((Message::Join(j), r.arrival_ns));
+                    return;
+                }
+                (State::AwaitJoin, _) if stream => {
+                    self.counters.first_not_join += 1;
+                    self.close_malformed(link, now_ns);
+                    return;
+                }
+                (State::AwaitJoin | State::Joining, _) if !stream => self.counters.before_join += 1,
+                (_, Message::Join(_)) => self.counters.join_again += 1,
+                (State::Joined, Message::Input(i)) => {
+                    if self.limits.input.take(now_ns) {
+                        out.push((Message::Input(i), r.arrival_ns));
+                    } else {
+                        self.counters.input_limited += 1;
+                    }
+                }
+                (State::Joined, Message::Ping(p)) => {
+                    if self.limits.ping.take(now_ns) {
+                        let hold = now_ns.saturating_sub(r.arrival_ns) / 1_000;
+                        let pong = Pong {
+                            id: p.id,
+                            echo_ns: p.sent_ns,
+                            tick,
+                            hold_us: u16::try_from(hold).unwrap_or(u16::MAX),
+                        };
+                        self.send_datagram(link, &Message::Pong(pong), now_ns);
+                        self.counters.pongs_sent += 1;
+                    } else {
+                        self.counters.ping_limited += 1;
+                    }
+                }
+                (State::Joined, Message::Pong(p)) => self.pong(&p, now_ns),
+                (State::Joined, m) => out.push((m, r.arrival_ns)),
+                _ => {}
+            }
+        }
+    }
+
+    /// The server's half of the `Join` checks (catalogue :93): the protocol version and the content hash.
+    fn join_ok(&mut self, link: &mut dyn Link, j: &Join, now_ns: u64) -> bool {
+        let reason = if j.version != self.version {
+            self.counters.wrong_version += 1;
+            JoinRejected::WrongVersion
+        } else if j.content_hash != self.content_hash {
+            self.counters.wrong_content_hash += 1;
+            JoinRejected::WrongContentHash
+        } else {
+            return true;
+        };
+        self.reject(link, reason, now_ns);
+        false
+    }
+
+    /// A `Pong` of one of the room's outstanding pings: one RTT sample, the hold time subtracted up to one tick
+    /// period (catalogue :92); any other id is dropped and counted.
+    fn pong(&mut self, p: &Pong, now_ns: u64) {
+        let Some(at) = self
+            .outstanding
+            .iter()
+            .position(|&(id, sent)| id == p.id && sent == p.echo_ns)
+        else {
+            self.counters.pong_unknown += 1;
+            return;
+        };
+        self.outstanding.remove(at);
+        let hold = (u64::from(p.hold_us) * 1_000).min(self.limits.hold_cap_ns());
+        let sample = now_ns.saturating_sub(p.echo_ns).saturating_sub(hold);
+        self.samples.push_back(sample);
+        if self.samples.len() > SAMPLES {
+            self.samples.pop_front();
+        }
+    }
+}
diff --git a/spikes/netcode-proof/crates/server/tests/common/mod.rs b/spikes/netcode-proof/crates/server/tests/common/mod.rs
new file mode 100644
index 0000000..59820ca
--- /dev/null
+++ b/spikes/netcode-proof/crates/server/tests/common/mod.rs
@@ -0,0 +1,378 @@
+//! The Loopback lab for U4e's tests (u4-build-plan.md §5 Lanes: in npt-server's own tests, through its npt-link and its
+//! dev dependency on npt-client; never in crates/lab): a `Room<World>` behind one `Decoder` per session, each session a
+//! Loopback pair to a real `ClientEndpoint`, on an injected clock. The server ticks at U4b's schedule
+//! (base + ⌊k × 10^9 / tick_hz⌋ ns); each client steps at its own offset after each server tick. A test-only `Link`
+//! wrapper, [`Gate`], drops every datagram in a window both ways (2.5's gap; Loopback itself neither delays nor loses).
+#![allow(dead_code, reason = "each test binary uses part of the lab")]
+
+use std::cell::Cell;
+use std::collections::BTreeMap;
+use std::rc::Rc;
+
+use npt_client::ClientEndpoint;
+use npt_link::{Channel, Link, LinkState, Loopback, Recv, SendResult};
+use npt_proto::{Join, Limits, Message, Quant};
+use npt_room::Room;
+use npt_server::Decoder;
+use npt_sim::replay::Recording;
+use npt_sim::{Command, Scene, World};
+
+pub const VERSION: u16 = 1;
+pub const CONTENT: [u8; 32] = [7; 32];
+/// Loopback's datagram limit for the lab's sessions (the link's own; the room's groups stay within 1,000 B).
+pub const MAX_DATAGRAM: usize = 1_200;
+
+pub fn token(slot: u8) -> [u8; 16] {
+    let mut t = [0x5a; 16];
+    t[0] = slot;
+    t
+}
+
+pub fn bind(slot: u8) -> [u8; 16] {
+    [slot ^ 0xa5; 16]
+}
+
+pub fn join(slot: u8) -> Join {
+    Join {
+        token: token(slot),
+        bind: bind(slot),
+        version: VERSION,
+        content_hash: CONTENT,
+    }
+}
+
+/// A window of ns in which a [`Gate`] drops every datagram it is asked to send.
+#[derive(Clone, Default)]
+pub struct Window(Rc<Cell<(u64, u64)>>);
+
+impl Window {
+    pub fn set(&self, from_ns: u64, to_ns: u64) {
+        self.0.set((from_ns, to_ns));
+    }
+    fn holds(&self, now_ns: u64) -> bool {
+        let (a, b) = self.0.get();
+        now_ns >= a && now_ns < b
+    }
+}
+
+/// A test-only `Link` over a Loopback end: datagrams sent inside its window are dropped (counted), every other call is
+/// the Loopback's.
+pub struct Gate {
+    inner: Loopback,
+    window: Window,
+    pub dropped: Rc<Cell<u64>>,
+}
+
+impl Link for Gate {
+    fn send_unreliable(&mut self, bytes: &[u8], now_ns: u64) -> SendResult {
+        if self.window.holds(now_ns) {
+            self.dropped.set(self.dropped.get() + 1);
+            return SendResult::Sent;
+        }
+        self.inner.send_unreliable(bytes, now_ns)
+    }
+    fn send_reliable(&mut self, channel: Channel, bytes: &[u8], now_ns: u64) -> SendResult {
+        self.inner.send_reliable(channel, bytes, now_ns)
+    }
+    fn poll_recv(&mut self, now_ns: u64) -> Option<Recv> {
+        self.inner.poll_recv(now_ns)
+    }
+    fn state(&self) -> LinkState {
+        self.inner.state()
+    }
+    fn rtt_ns(&self) -> Option<u64> {
+        self.inner.rtt_ns()
+    }
+    fn max_datagram_size(&self) -> usize {
+        self.inner.max_datagram_size()
+    }
+    fn unsent_unreliable(&self) -> usize {
+        self.inner.unsent_unreliable()
+    }
+}
+
+/// What a client's command is, from its slot and the tick it will stamp.
+pub type Script = Box<dyn FnMut(u8, u32) -> Option<Command>>;
+
+/// The commands of a synthetic recording (npt-sim's seeded generator), by (slot, tick): each slot's first command of
+/// each tick, as the page's command for the tick the client stamps it with.
+pub fn recorded(scene: &Scene, seed: u64, first_tick: u32, ticks: u32) -> Script {
+    let rec = Recording::synthetic(scene, seed, first_tick, ticks, 2_000);
+    let mut by: BTreeMap<(u8, u32), Command> = BTreeMap::new();
+    for t in &rec.ticks {
+        for (c, _) in &t.commands {
+            by.entry((c.slot, c.tick)).or_insert(*c);
+        }
+    }
+    Box::new(move |slot, tick| by.get(&(slot, tick)).copied())
+}
+
+/// One session: the server's end with its decoder, the client's end with its endpoint, and what each side filed.
+pub struct Conn {
+    pub server: Gate,
+    pub client: Gate,
+    pub decoder: Decoder,
+    pub endpoint: ClientEndpoint,
+    pub slot: Option<u8>,
+    pub offset_ns: u64,
+    pub step: u64,
+    /// Every (tick, hash) the client filed, in order (0 the sentinel).
+    pub filed: Vec<(u32, u64)>,
+    /// The runs of ticks the client resolved lost.
+    pub lost: Vec<(u32, u32)>,
+    pub wraps: Vec<&'static str>,
+}
+
+/// The lab (the module text).
+pub struct Lab {
+    pub room: Room<World>,
+    pub conns: Vec<Conn>,
+    pub hz: u32,
+    pub base_ns: u64,
+    pub k: u64,
+    pub now_ns: u64,
+    pub script: Script,
+    /// The room's hash per (slot, tick).
+    pub server: BTreeMap<(u8, u32), u64>,
+    /// The client hashes per (slot, tick): a second, different hash makes it the sentinel (marks/README.md §1).
+    pub client: BTreeMap<(u8, u32), u64>,
+    /// When each server tick ran, ns.
+    pub tick_at: BTreeMap<u32, u64>,
+    /// The window every session's gates share (both ways).
+    pub window: Window,
+    /// The bytes the pump reported to the room per (slot, tick) before that tick ran.
+    pub pumped: BTreeMap<(u8, u32), u32>,
+    /// Drops the room's datagram (slot, tick, group) when it answers true (e2's and e3's lost group).
+    pub tamper: Option<Tamper>,
+}
+
+/// Which of the room's datagrams the lab drops, by (slot, tick, group).
+pub type Tamper = Box<dyn FnMut(u8, u32, usize) -> bool>;
+
+impl Lab {
+    /// A lab of `endpoints.len()` sessions on `room`, each client stepping `offsets[i]` ns after each server tick.
+    pub fn new(
+        room: Room<World>,
+        endpoints: Vec<ClientEndpoint>,
+        offsets: &[u64],
+        script: Script,
+    ) -> Lab {
+        Lab::sized(room, endpoints, offsets, script, MAX_DATAGRAM)
+    }
+
+    /// The same, each session's Loopback taking datagrams up to `max_datagram` bytes.
+    pub fn sized(
+        room: Room<World>,
+        endpoints: Vec<ClientEndpoint>,
+        offsets: &[u64],
+        script: Script,
+        max_datagram: usize,
+    ) -> Lab {
+        let hz = npt_sim::TICK_HZ;
+        let base_ns = 1_000_000_000;
+        let window = Window::default();
+        let conns = endpoints
+            .into_iter()
+            .enumerate()
+            .map(|(i, endpoint)| {
+                let (s, c) = Loopback::pair(max_datagram);
+                Conn {
+                    server: Gate {
+                        inner: s,
+                        window: window.clone(),
+                        dropped: Rc::default(),
+                    },
+                    client: Gate {
+                        inner: c,
+                        window: window.clone(),
+                        dropped: Rc::default(),
+                    },
+                    decoder: Decoder::new(Quant::default(), hz, base_ns, VERSION, CONTENT),
+                    endpoint,
+                    slot: None,
+                    offset_ns: offsets.get(i).copied().unwrap_or(1_000_000),
+                    step: 0,
+                    filed: Vec::new(),
+                    lost: Vec::new(),
+                    wraps: Vec::new(),
+                }
+            })
+            .collect();
+        Lab {
+            room,
+            conns,
+            hz,
+            base_ns,
+            k: 0,
+            now_ns: base_ns,
+            script,
+            server: BTreeMap::new(),
+            client: BTreeMap::new(),
+            tick_at: BTreeMap::new(),
+            window,
+            pumped: BTreeMap::new(),
+            tamper: None,
+        }
+    }
+
+    /// The same lab with session `i`'s pump decoding with `quant`.
+    pub fn with_decoder(mut self, i: usize, quant: Quant) -> Lab {
+        self.conns[i].decoder = Decoder::new(quant, self.hz, self.base_ns, VERSION, CONTENT);
+        self
+    }
+
+    /// The time of server tick `k` (U4b's schedule).
+    pub fn tick_ns(&self, k: u64) -> u64 {
+        self.base_ns + (u128::from(k) * 1_000_000_000 / u128::from(self.hz)) as u64
+    }
+
+    fn server_tick(&mut self, now: u64) {
+        let tick = self.room.last_tick().wrapping_add(1);
+        for conn in &mut self.conns {
+            loop {
+                let mut msgs = Vec::new();
+                conn.decoder.pump(&mut conn.server, now, tick, &mut msgs);
+                let mut joined = false;
+                for (m, _) in msgs {
+                    match (&m, conn.slot) {
+                        (Message::Join(j), _) => {
+                            joined = true;
+                            match self.room.join(j) {
+                                Ok((slot, _)) => {
+                                    conn.decoder.accept();
+                                    conn.slot = Some(slot);
+                                }
+                                Err(r) => conn.decoder.reject(&mut conn.server, r, now),
+                            }
+                        }
+                        (_, Some(slot)) => self.room.receive(slot, &m),
+                        _ => {}
+                    }
+                }
+                if !joined {
+                    break;
+                }
+            }
+            if let Some(slot) = conn.slot {
+                let sent = conn.decoder.take_sent_bytes();
+                self.pumped.insert((slot, tick), sent);
+                self.room
+                    .pump_report(slot, sent, conn.server.max_datagram_size());
+            }
+        }
+        self.room.tick();
+        let t = self.room.last_tick();
+        self.tick_at.insert(t, now);
+        for conn in &mut self.conns {
+            let Some(slot) = conn.slot else { continue };
+            for (g, d) in self.room.take_datagrams(slot).into_iter().enumerate() {
+                if self.tamper.as_mut().is_some_and(|f| f(slot, t, g)) {
+                    continue;
+                }
+                conn.server.send_unreliable(&d, now);
+            }
+            for m in self.room.take_control(slot) {
+                let channel = Limits::TYPES
+                    .iter()
+                    .find(|r| r.0 == m.name())
+                    .map_or(Channel::Control, |r| r.1);
+                let mut out = Vec::new();
+                npt_proto::encode(&m, &mut out).expect("the room's control messages encode");
+                conn.server.send_reliable(channel, &out, now);
+            }
+            if let Some(h) = self.room.client(slot).and_then(|c| c.server_hash()) {
+                self.server.insert((slot, t), h);
+            }
+        }
+    }
+
+    fn client_step(&mut self, i: usize, now: u64) {
+        let conn = &mut self.conns[i];
+        let mut received = Vec::new();
+        while let Some(r) = conn.client.poll_recv(now) {
+            received.push((r.channel, r.bytes, r.arrival_ns));
+        }
+        conn.endpoint.input(None, &received, now);
+        // The page's command for the tick the endpoint stamps it with (its newest tick plus its lead of 1).
+        let stamp = conn.endpoint.newest_tick().map(|n| n.wrapping_add(1));
+        if let (Some(slot), Some(t)) = (conn.endpoint.slot(), stamp)
+            && let Some(c) = (self.script)(slot, t)
+        {
+            conn.endpoint.input(Some(c), &[], now);
+        }
+        let out = conn.endpoint.step();
+        for d in &out.datagrams {
+            conn.client.send_unreliable(d, now);
+        }
+        for (ch, b) in &out.reliable {
+            conn.client.send_reliable(*ch, b, now);
+        }
+        let slot = conn.endpoint.slot().unwrap_or(u8::MAX);
+        for &(t, h) in &out.hashes {
+            conn.filed.push((t, h));
+            let e = self.client.entry((slot, t)).or_insert(h);
+            if *e != h {
+                *e = 0;
+            }
+        }
+        conn.lost.extend_from_slice(&out.lost);
+        conn.wraps.extend_from_slice(&out.wraps);
+        conn.step += 1;
+    }
+
+    /// Runs `ticks` server ticks, each client stepping at its offset after each; `after` sees the lab after each
+    /// server tick.
+    pub fn run(&mut self, ticks: u64, mut after: impl FnMut(&Lab)) {
+        for _ in 0..ticks {
+            let at = self.tick_ns(self.k);
+            let next = self.tick_ns(self.k + 1);
+            self.now_ns = at;
+            self.server_tick(at);
+            after(self);
+            let mut order: Vec<(u64, usize)> = (0..self.conns.len())
+                .map(|i| (at + self.conns[i].offset_ns.min(next - at - 1), i))
+                .collect();
+            order.sort_unstable();
+            for (t, i) in order {
+                self.now_ns = t;
+                self.client_step(i, t);
+            }
+            self.k += 1;
+        }
+    }
+
+    /// Every (slot, tick) both sides hashed, and how many pairs differ or are the sentinel.
+    pub fn compare(&self) -> (usize, usize) {
+        let mut compared = 0;
+        let mut bad = 0;
+        for (k, h) in &self.client {
+            compared += 1;
+            if *h == 0 || self.server.get(k) != Some(h) {
+                bad += 1;
+            }
+        }
+        (compared, bad)
+    }
+}
+
+/// `n` endpoints that join as slots 0 to n-1.
+pub fn endpoints(n: u8) -> Vec<ClientEndpoint> {
+    (0..n)
+        .map(|s| ClientEndpoint::new(join(s), npt_sim::TICK_HZ))
+        .collect()
+}
+
+/// A room on `scene` from `seed`, its first tick `first_tick`, with a roster of `n` slots.
+pub fn room(scene: &Scene, seed: u64, first_tick: u32, n: u8) -> Room<World> {
+    let world = World::new(scene, seed, first_tick);
+    let greybox = world.greybox().clone();
+    Room::new(
+        world,
+        scene,
+        &greybox,
+        (0..n).map(token).collect(),
+        usize::from(n),
+        npt_sim::TICK_HZ,
+    )
+    .with_hashes(CONTENT, [0; 32])
+}
diff --git a/spikes/netcode-proof/crates/server/tests/gap.rs b/spikes/netcode-proof/crates/server/tests/gap.rs
new file mode 100644
index 0000000..d5eecb4
--- /dev/null
+++ b/spikes/netcode-proof/crates/server/tests/gap.rs
@@ -0,0 +1,263 @@
+//! e5 and -18's bite end to end (u4e-brief.md 2.4 e5, 2.5; u4-build-plan.md §4.14 :461, §5 U4e): a gap in delivery,
+//! every datagram dropped both ways by the lab's `Gate` on the injected clock, of `npt_sim::ACK_RING_TICKS` tick
+//! periods (U4E-Q14 (b)), at two alignments against the server's send of tick T; the clients step 5 ms after each
+//! server tick. Its length in ns is computed here from that constant by path and the rate the test passes in.
+
+mod common;
+
+use std::collections::BTreeMap;
+
+use common::{Lab, endpoints, recorded, room};
+use npt_room::Room;
+use npt_sim::{Scene, World};
+
+const CLIENTS: u8 = 4;
+const OFFSET_NS: u64 = 5_000_000;
+
+/// Where the gap starts against the server's send of tick T.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Align {
+    /// 1 ns after it: T is delivered, the client's acknowledgement of T is the first datagram lost.
+    AfterSend,
+    /// 1 ns before it: T's snapshot is the first datagram lost.
+    BeforeSend,
+}
+
+/// What one gap run showed for client 0.
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Gap {
+    align: Align,
+    /// Tick T and the gap's start and end, ns.
+    t: u32,
+    from_ns: u64,
+    to_ns: u64,
+    /// The first tick the server runs at or after the gap's end, F.
+    f: u32,
+    /// B's tick (the last tick fully acknowledged) and B's age at F, and the room's per-tick eviction flag at F.
+    b_tick: Option<u32>,
+    b_age: Option<u32>,
+    evicted: bool,
+    /// The baseline age F's snapshot was coded at (0: the per-type defaults).
+    f_age: Option<u16>,
+    /// The first tick at or after F the client decoded with the server's hash, and when the server sent it.
+    fresh: Option<(u32, u64)>,
+    /// The sentinels the client filed from F on.
+    sentinels: usize,
+    /// Every pair compared over the run, and how many differ or are the sentinel; the events resent.
+    compared: usize,
+    bad: usize,
+    resent: u64,
+    /// The room's hashes, for e11.
+    server: BTreeMap<(u8, u32), u64>,
+}
+
+/// The gap's length: `npt_sim::ACK_RING_TICKS` tick periods at `tick_hz` (1.067 s at 30 Hz), in ns.
+fn ring_gap_ns(tick_hz: u32) -> u64 {
+    u64::from(npt_sim::ACK_RING_TICKS) * 1_000_000_000 / u64::from(tick_hz)
+}
+
+fn gap_case(room: Room<World>, align: Align, gap_ns: u64) -> Gap {
+    let scene = Scene::stress();
+    let script = recorded(&scene, 1, 300, 200);
+    let offsets = vec![OFFSET_NS; usize::from(CLIENTS)];
+    let mut lab = Lab::new(room, endpoints(CLIENTS), &offsets, script);
+    let mut per_tick: BTreeMap<u32, (Option<u32>, bool, Option<u16>)> = BTreeMap::new();
+    let mut record = |lab: &Lab| {
+        if let Some(c) = lab.room.client(0) {
+            per_tick.insert(
+                lab.room.last_tick(),
+                (c.last_acked(), c.burst_eviction(), c.baseline_age()),
+            );
+        }
+    };
+    lab.run(30, &mut record);
+    let t = lab.room.last_tick() + 1;
+    let send = lab.tick_ns(lab.k);
+    let from_ns = match align {
+        Align::AfterSend => send + 1,
+        Align::BeforeSend => send - 1,
+    };
+    let to_ns = from_ns + gap_ns;
+    lab.window.set(from_ns, to_ns);
+    lab.run(32 + 30, &mut record);
+    let f = *lab
+        .tick_at
+        .iter()
+        .find(|(_, at)| **at >= to_ns)
+        .map(|(t, _)| t)
+        .expect("a tick after the gap");
+    let (b_tick, evicted, f_age) = per_tick[&f];
+    let fresh = lab
+        .client
+        .iter()
+        .filter(|((s, k), h)| {
+            *s == 0 && *k >= f && **h != 0 && lab.server.get(&(0, *k)) == Some(*h)
+        })
+        .map(|((_, k), _)| (*k, lab.tick_at[k]))
+        .next();
+    let sentinels = lab
+        .client
+        .iter()
+        .filter(|((s, k), h)| *s == 0 && *k >= f && **h == 0)
+        .count();
+    let (compared, bad) = lab.compare();
+    let resent = lab.room.client(0).map_or(0, |c| c.counters().events_resent);
+    Gap {
+        align,
+        t,
+        from_ns,
+        to_ns,
+        f,
+        b_tick,
+        b_age: b_tick.map(|b| f - b),
+        evicted,
+        f_age,
+        fresh,
+        sentinels,
+        compared,
+        bad,
+        resent,
+        server: lab.server.clone(),
+    }
+}
+
+fn clean_room() -> Room<World> {
+    room(&Scene::stress(), 1, 300, CLIENTS)
+}
+
+/// e5a (u4e-brief.md 2.4; U4E-Q14 (b)): at both alignments the gap leaves B at age ≥ `npt_sim::ACK_RING_TICKS` at the
+/// first tick after it, and `burst_eviction` is 1 there; a 1 s gap's B is reported beside it (not asserted).
+#[test]
+fn e5a_a_gap_of_ack_ring_ticks_periods_evicts_b_at_both_alignments() {
+    for align in [Align::AfterSend, Align::BeforeSend] {
+        let g = gap_case(clean_room(), align, ring_gap_ns(npt_sim::TICK_HZ));
+        println!(
+            "e5a {align:?}: T {} gap {}..{} ns, F {}, B {:?} at age {:?}, evicted {}",
+            g.t, g.from_ns, g.to_ns, g.f, g.b_tick, g.b_age, g.evicted
+        );
+        assert!(
+            g.b_age.is_some_and(|a| a >= npt_sim::ACK_RING_TICKS),
+            "{align:?}: {g:?}"
+        );
+        assert!(g.evicted, "{align:?}: burst_eviction = 1");
+        let one = gap_case(clean_room(), align, 1_000_000_000);
+        println!(
+            "e5a {align:?}, a 1 s gap: F {}, B {:?} at age {:?}, evicted {} (reported, not asserted)",
+            one.f, one.b_tick, one.b_age, one.evicted
+        );
+    }
+}
+
+/// e5b: the first snapshot after the gap is coded against the per-type defaults (`baseline_age` 0: §4.5).
+fn e5b_check(room: impl Fn() -> Room<World>) -> Result<(), String> {
+    for align in [Align::AfterSend, Align::BeforeSend] {
+        let g = gap_case(room(), align, ring_gap_ns(npt_sim::TICK_HZ));
+        if g.f_age != Some(0) {
+            return Err(format!("{align:?}: F {} coded at age {:?}", g.f, g.f_age));
+        }
+    }
+    Ok(())
+}
+
+#[test]
+fn e5b_the_first_snapshot_after_the_gap_is_coded_against_the_defaults() {
+    e5b_check(clean_room).unwrap_or_else(|e| panic!("{e}"));
+}
+
+/// 2.5: end to end, a fresh delta decodes within 500 ms of the gap's end on the injected clock, at both alignments;
+/// over the whole run every compared pair is equal (the mirror across events resent after the gap: e7's resent part).
+fn end_to_end_check(room: impl Fn() -> Room<World>) -> Result<Vec<Gap>, String> {
+    let mut out = Vec::new();
+    for align in [Align::AfterSend, Align::BeforeSend] {
+        let g = gap_case(room(), align, ring_gap_ns(npt_sim::TICK_HZ));
+        match g.fresh {
+            Some((_, at)) if at <= g.to_ns + 500_000_000 => {}
+            _ => {
+                return Err(format!(
+                    "{align:?}: no fresh delta within 500 ms of {} ns: {:?}",
+                    g.to_ns, g.fresh
+                ));
+            }
+        }
+        out.push(g);
+    }
+    Ok(out)
+}
+
+#[test]
+fn pm_0001_18_a_fresh_delta_decodes_within_500_ms_of_the_gaps_end() {
+    let runs = end_to_end_check(clean_room).unwrap_or_else(|e| panic!("{e}"));
+    for g in &runs {
+        let (tick, at) = g.fresh.unwrap_or_default();
+        println!(
+            "2.5 {:?}: gap ends {} ns; the first fresh delta is tick {tick}, sent at {at} ns ({} ms after); {} pairs, {} \
+             differ; {} events resent",
+            g.align,
+            g.to_ns,
+            (at - g.to_ns) / 1_000_000,
+            g.compared,
+            g.bad,
+            g.resent
+        );
+        assert_eq!(g.bad, 0, "{:?}", g.align);
+        assert!(g.resent >= 1, "{:?}: events resent after the gap", g.align);
+    }
+}
+
+/// -18's bite (bites builds only), in wave 1's two parts: the bites-only twins assert the defect on the bitten room.
+#[cfg(feature = "bites")]
+mod bites {
+    use super::*;
+
+    const NO_FALLBACK: &str = "PM-0001-18/no-fallback";
+
+    fn bitten() -> Room<World> {
+        clean_room()
+            .with_bite(NO_FALLBACK)
+            .expect("npt-room plants it")
+    }
+
+    #[test]
+    fn pm_0001_18_no_fallback_codes_the_first_snapshot_after_the_gap_against_an_evicted_baseline() {
+        assert!(e5b_check(bitten).is_err());
+    }
+
+    #[test]
+    fn pm_0001_18_no_fallback_leaves_no_fresh_delta_within_500_ms() {
+        assert!(end_to_end_check(bitten).is_err());
+        for align in [Align::AfterSend, Align::BeforeSend] {
+            let g = gap_case(bitten(), align, ring_gap_ns(npt_sim::TICK_HZ));
+            println!(
+                "2.5 bitten {align:?}: F {} coded at age {:?} (B {:?}, age {:?}); fresh {:?}; {} sentinels from F",
+                g.f, g.f_age, g.b_tick, g.b_age, g.fresh, g.sentinels
+            );
+            assert!(
+                g.fresh.is_none() && g.sentinels >= 1,
+                "the client refuses every delta after the gap"
+            );
+        }
+    }
+
+    /// e11 (§4.11 :398-400): a bitten instance and a clean one on parallel threads in one process: the bitten one shows
+    /// its defect, the clean one none, its result equal to the same run alone.
+    #[test]
+    fn e11_a_bitten_and_a_clean_instance_run_side_by_side_on_two_threads() {
+        let gap = ring_gap_ns(npt_sim::TICK_HZ);
+        let alone = gap_case(clean_room(), Align::AfterSend, gap);
+        let a = std::thread::spawn(move || gap_case(bitten(), Align::AfterSend, gap));
+        let b = std::thread::spawn(move || gap_case(clean_room(), Align::AfterSend, gap));
+        let (a, b) = (
+            a.join().expect("bitten thread"),
+            b.join().expect("clean thread"),
+        );
+        assert!(
+            a.fresh.is_none() && a.f_age != Some(0),
+            "the bitten instance shows its defect"
+        );
+        assert!(
+            b.fresh.is_some() && b.f_age == Some(0),
+            "the clean instance shows none"
+        );
+        assert_eq!(b, alone, "the clean result equals the same run alone");
+    }
+}
