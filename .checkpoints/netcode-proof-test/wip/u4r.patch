+        }
+        let a = run_leg(&r, "SS-P0-s4", Leg::Loopback, 2, None).expect("loopback");
+        let b = run_leg(&r, "SS-P0-s4", Leg::L1, 2, None).expect("L1");
+        for (leg, o) in [("loopback", &a), ("L1", &b)] {
