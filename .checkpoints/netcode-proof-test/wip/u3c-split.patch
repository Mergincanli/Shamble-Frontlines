+fn split_lines(rows: &[(&'static str, u64)], d: usize) -> Vec<String> {
+    let class = |p: usize| value(rows, names::SPLIT_COUNT[d][usize::from(p >= WAIT)]);
+    let part = |p: usize| {
+        let g = |i: usize| value(rows, names::SPLIT[d][p][i]);
