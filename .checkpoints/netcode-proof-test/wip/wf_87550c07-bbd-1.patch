+/// The replay (S10): the run's model counters and delivery stamps equal those of a pure TcpModel driven by the logged
+/// writes and added bursts at their stamps: the real path moves no fate. P2 with its loss and jitter, plus a burst,
+/// 90 ticks (3 s).
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_replay_on_a_pure_model_gives_the_same_counters_and_stamps() {
+    let c = cfg(Profile::p2(), 31);
+    let (client, server) = tokio::io::duplex(1 << 20);
+    let mut ds = DelayStream::wrap(server, &c, 3, now()).expect("wrapped");
+    ds.add_burst(now() + SEC, 400 * MS).expect("added");
+    traffic(&mut ds, client, 90).await;
+    let logs = ds.logs();
+    let (_, counters, delivered) = ds.model_state();
+    let end_t = ds.model_now();
+    let mut m = TcpModel::new(&c.profile, c.seed, 3).with_one_way_ns(one_way_ns(&c));
+    let mut ends: [VecDeque<u64>; 2] = [VecDeque::new(), VecDeque::new()];
+    let mut written = [0u64; 2];
+    let mut releases = Vec::new();
+    /// DelayStream's stepping on a pure model: event by event, each delivered record released at the event's stamp.
+    fn step(
+        m: &mut TcpModel,
+        ends: &mut [VecDeque<u64>; 2],
+        t: u64,
+        out: &mut Vec<(usize, u64, u64)>,
+    ) {
+        while let Some(x) = m.next_event().filter(|&x| x <= t) {
+            m.advance(x);
+            for dir in [DOWN, UP] {
+                while ends[dir]
+                    .front()
+                    .is_some_and(|&e| e <= m.delivered(1 - dir))
+                {
+                    out.push((dir, ends[dir].pop_front().unwrap_or_default(), x));
+                }
+            }
+        }
+        m.advance(t);
+    }
+    for &(t, s) in &logs.steps {
+        step(&mut m, &mut ends, t, &mut releases);
+        match s {
+            Step::Write { end, bytes } => {
+                assert_eq!(m.write(end, bytes, t), bytes);
+                written[end] += bytes;
+                ends[end].push_back(written[end]);
+            }
+            Step::Burst { start, len } => assert!(m.add_burst(start, len)),
+        }
+    }
+    step(&mut m, &mut ends, end_t, &mut releases);
+    let sorted = |v: &[(usize, u64, u64)], d: usize| -> Vec<(u64, u64)> {
+        v.iter().filter(|r| r.0 == d).map(|r| (r.1, r.2)).collect()
+    };
+    for d in [DOWN, UP] {
+        assert_eq!(sorted(&releases, d), sorted(&logs.releases, d), "dir {d}");
+    }
+    assert_eq!([m.counters(DOWN), m.counters(UP)], counters);
+    assert_eq!([m.delivered(1), m.delivered(0)], delivered);
+    let n = |c: &Counters| (c.transmissions, c.lost_profile, c.lost_burst, c.stalls);
+    println!(
+        "replay: {} steps, {} releases; down {:?} up {:?} (transmissions, lost, burst, stalls)",
+        logs.steps.len(),
+        logs.releases.len(),
+        n(&counters[DOWN]),
+        n(&counters[UP])
+    );
+    assert!(
+        counters[DOWN].lost_burst > 0
+            && counters[DOWN].lost_profile + counters[UP].lost_profile > 0
+    );
+}
