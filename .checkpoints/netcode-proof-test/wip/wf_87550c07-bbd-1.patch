+struct Shared {
+    key: u64,
+    clock: &'static Clock,
+    conn: Mutex<Conn>,
+}
+
+impl Shared {
+    fn lock(&self) -> MutexGuard<'_, Conn> {
+        self.conn.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+}
