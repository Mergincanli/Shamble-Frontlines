+#[test]
+fn loss_from_one_end_spares_the_other() {
+    let p = Profile::p2();
+    let feed = |m: &mut TcpModel| {
+        let mut feeds = [
+            Feed {
+                end: 0,
+                size: SNAP,
+                next: TICK,
+                stop: 3_000 * TICK,
