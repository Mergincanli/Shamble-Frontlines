+/// Mechanism test (c)'s connection: the server's shipped per-tick writer (with `bite`, or reading unsent bytes only)
+/// writes one 1,024 B snapshot (1,050 B in the model) per tick over TLS and tungstenite at P2, through two 1 s bursts
+/// added after the wrap at `bursts` from the start. Returns the per-return records with N at each return's srtt, the
+/// writes, the skips, and the writes that found bytes owed (before or after).
+async fn writer_run(
+    seed: u64,
+    conn: u32,
+    bite: Option<Bite>,
+    unsent_only: bool,
+    bursts: [u64; 2],
+    ticks: u64,
+) -> (Vec<(Return, u64)>, u64, u64, u64) {
+    let c = cfg(Profile::p2(), seed);
+    let (mut server, mut client, _, _) = pair(&c, conn).await;
+    let reader = tokio::spawn(async move {
+        run_ticks(&mut client, 0, Duration::from_secs(60), |_| {}, |_, _| {}).await;
+    });
+    let start = now();
+    for b in bursts {
+        server
+            .get_ref()
+            .io
+            .add_burst(start + b, SEC)
+            .expect("a burst");
+    }
+    let mut w = TickWriter::new(TICK);
+    if let Some(b) = bite {
+        w = w.with_bite(b);
+    }
+    let mut owed_at_write = 0;
+    run_ticks(
+        &mut server,
+        ticks,
+        Duration::ZERO,
+        |_| {},
+        |k, ws| {
+            let ds = &ws.get_ref().io;
+            let inp = Inputs {
+                srtt_ns: ds.srtt_ns(),
+                outstanding: if unsent_only {
+                    ds.unsent_bytes()
+                } else {
+                    ds.outstanding_bytes()
+                },
+                owed: ds.owed_bytes(),
+                free: ds.free_bytes(),
+            };
+            if w.on_tick(Snap { id: k, size: SNAP }, inp).is_some() {
+                owed_at_write += u64::from(inp.owed != 0);
+                send(ws, vec![0x5a; 1_024]);
+                owed_at_write += u64::from(ws.get_ref().io.owed_bytes() != 0);
+            }
+        },
+    )
+    .await;
+    let rets = server
+        .get_ref()
+        .io
+        .returns()
+        .into_iter()
+        .map(|r| (r, snapshot_budget(r.srtt_ns, TICK)))
+        .collect();
+    drop(server);
+    reader.abort();
+    (rets, w.written(), w.skipped(), owed_at_write)
+}
+
+/// Mechanism test (c) (u3c-plan.md 1.4, C9): on DelayStream at P2 under B1, through TLS 1.3 and tungstenite on
+/// loopback, the shipped writer keeps outstanding <= N(srtt then) x size at every return (from the per-return record)
+/// and finds owed = 0 at each write. Counts: 2 faithful connections and one per bite, run together; 2 bursts each
+/// (1 s, at 1.5 s and 4.5 s plus a phase of 0, 11, 17 or 29 ms); 230 ticks (7.7 s). Identities, so no band. Bites (d):
+/// budget_scale 2 and "outstanding = unsent only" (SIOCOUTQNSD) each break it at a return.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn c_the_writer_keeps_outstanding_within_n_snapshots_at_every_return() {
+    const TICKS: u64 = 230;
+    let at = |phase_ms: u64| [1_500 * MS + phase_ms * MS, 4_500 * MS + phase_ms * MS];
+    let (a, b, x2, unsent) = tokio::join!(
+        writer_run(41, 0, None, false, at(0), TICKS),
+        writer_run(42, 1, None, false, at(11), TICKS),
+        writer_run(43, 2, Some(Bite::BudgetX2), false, at(17), TICKS),
+        writer_run(44, 3, None, true, at(29), TICKS),
+    );
+    let over = |rets: &[(Return, u64)]| {
+        rets.iter()
+            .filter(|(r, n)| r.outstanding > n * SNAP)
+            .count()
+    };
+    for (name, (rets, written, skipped, owed)) in [
+        ("faithful A", &a),
+        ("faithful B", &b),
+        ("budget x2", &x2),
+        ("unsent only", &unsent),
+    ] {
+        let shown: Vec<String> = rets
+            .iter()
+            .map(|(r, n)| format!("{} B vs {} B (N {n})", r.outstanding, n * SNAP))
+            .collect();
+        println!(
+            "(c) {name}: {written} written, {skipped} skipped, owed at a write {owed}; at each return: {}",
+            shown.join("; ")
+        );
+    }
+    for (rets, _, _, owed) in [&a, &b] {
+        assert_eq!(rets.len(), 2, "both bursts returned");
+        assert_eq!(over(rets), 0, "outstanding within N x size at every return");
+        assert_eq!(*owed, 0, "owed = 0 at each write");
+    }
+    assert!(over(&x2.0) > 0, "the budget x2 bite breaks (c)");
+    assert!(over(&unsent.0) > 0, "the unsent-only bite breaks (c)");
+}
diff --git a/spikes/netcode-proof/crates/net/src/l2/tls_test.rs b/spikes/netcode-proof/crates/net/src/l2/tls_test.rs
new file mode 100644
index 0000000..8cf1d94
--- /dev/null
+++ b/spikes/netcode-proof/crates/net/src/l2/tls_test.rs
@@ -0,0 +1,158 @@
+//! The loopback tests' TLS, shared by the WebTransport routes (wt_tests) and DelayStream's WebSocket path
+//! (delay_tests); moved here from wt_tests.rs at U3c so the WebSocket tests need no WebTransport feature.
+//!
+//! The certificate is test-only and made here (no new dependency: rcgen is not in web-transport-quinn's closure): an
+//! Ed25519 key from a fixed seed, loaded and used through the caller's own rustls provider, and an X.509 v3
+//! certificate written in DER by hand. The client pins it (as `serverCertificateHashes` would) with a verifier that
+//! still checks the handshake's signature. rustls is the one pinned 0.23.46, reached through tokio-rustls (quinn's
+//! re-export is the same crate).
+
+use std::sync::Arc;
+use tokio_rustls::rustls;
+use tokio_rustls::rustls::client::danger::{
+    HandshakeSignatureValid, ServerCertVerified, ServerCertVerifier,
+};
+use tokio_rustls::rustls::crypto::CryptoProvider;
+use tokio_rustls::rustls::pki_types::{
+    CertificateDer, PrivateKeyDer, PrivatePkcs8KeyDer, ServerName, UnixTime,
+};
+use tokio_rustls::rustls::{DigitallySignedStruct, SignatureScheme};
+
+/// A DER element: tag, definite length, content.
+fn der(tag: u8, content: &[u8]) -> Vec<u8> {
+    let mut v = vec![tag];
+    let n = content.len();
+    if n < 0x80 {
+        v.push(n as u8);
+    } else {
+        let bytes: Vec<u8> = n
+            .to_be_bytes()
+            .into_iter()
+            .skip_while(|&b| b == 0)
+            .collect();
+        v.push(0x80 | bytes.len() as u8);
+        v.extend(bytes);
+    }
+    v.extend_from_slice(content);
+    v
+}
+
+fn seq(parts: &[&[u8]]) -> Vec<u8> {
+    der(0x30, &parts.concat())
+}
+
+/// A self-signed Ed25519 certificate and its key, signed through `provider`'s own key provider.
+pub(crate) fn self_signed(
+    provider: &CryptoProvider,
+) -> (CertificateDer<'static>, PrivateKeyDer<'static>) {
+    // PKCS#8 v1 for Ed25519 (RFC 8410): a fixed prefix and the 32-byte seed.
+    let mut pkcs8 = vec![
+        0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04,
+        0x20,
+    ];
+    pkcs8.extend((0u8..32).map(|i| i.wrapping_mul(37).wrapping_add(11)));
+    let key = PrivateKeyDer::Pkcs8(PrivatePkcs8KeyDer::from(pkcs8));
+    let signing = provider
+        .key_provider
+        .load_private_key(key.clone_key())
+        .expect("the provider loads an Ed25519 key");
+    let spki = signing.public_key().expect("its public key").to_vec();
+    let ed25519 = seq(&[&der(0x06, &[0x2b, 0x65, 0x70])]);
+    let cn = der(0x0c, b"npt-l2 loopback test");
+    let name = seq(&[&der(0x31, &seq(&[&der(0x06, &[0x55, 0x04, 0x03]), &cn]))]);
+    // SubjectAltName: IP 127.0.0.1, DNS localhost.
+    let san = seq(&[&der(0x87, &[127, 0, 0, 1]), &der(0x82, b"localhost")]);
+    let ext = der(
+        0xa3,
+        &seq(&[&seq(&[&der(0x06, &[0x55, 0x1d, 0x11]), &der(0x04, &san)])]),
+    );
+    let validity = seq(&[&der(0x17, b"260101000000Z"), &der(0x17, b"360101000000Z")]);
+    let tbs = seq(&[
+        &der(0xa0, &der(0x02, &[2])),
+        &der(0x02, &[0x01, 0x23, 0x45]),
+        &ed25519,
+        &name,
+        &validity,
+        &name,
+        &spki,
+        &ext,
+    ]);
+    let signer = signing
+        .choose_scheme(&[SignatureScheme::ED25519])
+        .expect("an Ed25519 signer");
+    let sig = signer.sign(&tbs).expect("signed");
+    let mut bits = vec![0u8];
+    bits.extend(sig);
+    let cert = seq(&[&tbs, &ed25519, &der(0x03, &bits)]);
+    (CertificateDer::from(cert), key)
+}
+
+/// Accepts exactly one certificate and checks the handshake's signature with the provider's algorithms.
+#[derive(Debug)]
+struct Pinned {
+    cert: CertificateDer<'static>,
+    provider: Arc<CryptoProvider>,
+}
+
+impl ServerCertVerifier for Pinned {
+    fn verify_server_cert(
+        &self,
+        end_entity: &CertificateDer<'_>,
+        _intermediates: &[CertificateDer<'_>],
+        _server_name: &ServerName<'_>,
+        _ocsp: &[u8],
+        _now: UnixTime,
+    ) -> Result<ServerCertVerified, rustls::Error> {
+        if end_entity.as_ref() == self.cert.as_ref() {
+            Ok(ServerCertVerified::assertion())
+        } else {
+            Err(rustls::Error::General("not the pinned certificate".into()))
+        }
+    }
+
+    fn verify_tls12_signature(
+        &self,
+        _message: &[u8],
+        _cert: &CertificateDer<'_>,
+        _dss: &DigitallySignedStruct,
+    ) -> Result<HandshakeSignatureValid, rustls::Error> {
+        Err(rustls::Error::General("TLS 1.2 is not offered".into()))
+    }
+
+    fn verify_tls13_signature(
+        &self,
+        message: &[u8],
+        cert: &CertificateDer<'_>,
+        dss: &DigitallySignedStruct,
+    ) -> Result<HandshakeSignatureValid, rustls::Error> {
+        rustls::crypto::verify_tls13_signature(
+            message,
+            cert,
+            dss,
+            &self.provider.signature_verification_algorithms,
+        )
+    }
+
+    fn supported_verify_schemes(&self) -> Vec<SignatureScheme> {
+        self.provider
+            .signature_verification_algorithms
+            .supported_schemes()
+    }
+}
+
+/// The client's TLS: TLS 1.3, ALPN `alpn`, the server's certificate pinned.
+pub(crate) fn client_tls(
+    provider: CryptoProvider,
+    cert: CertificateDer<'static>,
+    alpn: &[u8],
+) -> rustls::ClientConfig {
+    let provider = Arc::new(provider);
+    let mut tls = rustls::ClientConfig::builder_with_provider(Arc::clone(&provider))
+        .with_protocol_versions(&[&rustls::version::TLS13])
+        .expect("TLS 1.3")
+        .dangerous()
+        .with_custom_certificate_verifier(Arc::new(Pinned { cert, provider }))
+        .with_no_client_auth();
+    tls.alpn_protocols = vec![alpn.to_vec()];
+    tls
+}
diff --git a/spikes/netcode-proof/crates/net/src/l2/ws_frame.rs b/spikes/netcode-proof/crates/net/src/l2/ws_frame.rs
new file mode 100644
index 0000000..8f1fb4e
--- /dev/null
+++ b/spikes/netcode-proof/crates/net/src/l2/ws_frame.rs
@@ -0,0 +1,505 @@
+//! The WebSocket request and frame scanner DelayStream runs on both directions' plaintext (u3c-plan.md 1.2, C6).
+//!
+//! It finds the boundaries DelayStream cuts records at (the upgrade request or response, then each frame, RFC 6455
+//! §5.2) and, on the client's direction, applies the size limits before any of a frame's payload is buffered (plan
+//! §4.4: limits before any delay buffering). A client's stream closes, with a counted [`Reason`], on:
+//! - a frame whose payload, or a fragmented message's running payload total, is above the limit (`ws_max_message_bytes`,
+//!   the catalogue's 513 B);
+//! - an unmasked frame (§5.1: a client masks every frame);
+//! - a control frame above 125 B, or a fragmented one (§5.5);
+//! - a 64-bit length with its most significant bit set (§5.2);
+//! - an upgrade request longer than its cap (`ws_max_request_bytes`, 8,192 B) without its blank line.
+//!
+//! Anything else (reserved bits or opcodes, a continuation with no message open, UTF-8) is left to tungstenite, which
+//! closes on it. The server's direction is scanned the same way for its message ends (the per-return record's "first
+//! whole message", S12), with no limit applied: tungstenite writes it. The scanner keeps a fixed state (at most a
+//! 14 B header) and never allocates; it is a fuzz target at U5 (-34).
+
+/// Why a client's stream was closed (each its own counter: `ws_close_<reason>_count`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Reason {
+    /// The upgrade request reached its cap without its blank line.
+    Request = 0,
+    /// A frame's payload above the limit.
+    Frame = 1,
+    /// A fragmented message's running payload total above the limit.
+    Message = 2,
+    /// A client frame without a mask (§5.1).
+    Unmasked = 3,
+    /// A control frame above 125 B, or fragmented (§5.5).
+    Control = 4,
+    /// A 64-bit payload length with its most significant bit set (§5.2).
+    Length = 5,
+}
+
+pub(crate) const REASONS: usize = 6;
+
+impl Reason {
+    pub(crate) fn text(self) -> &'static str {
+        match self {
+            Reason::Request => "the upgrade request is above its cap",
+            Reason::Frame => "a frame is above the message limit",
+            Reason::Message => "a fragmented message is above the message limit",
+            Reason::Unmasked => "an unmasked client frame",
+            Reason::Control => "a control frame above 125 B or fragmented",
+            Reason::Length => "a 64-bit length with its top bit set",
+        }
+    }
+}
+
+/// A boundary the scanner found.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Boundary {
+    /// The end of the upgrade request (client) or response (server): its blank line.
+    Head,
+    /// The end of a frame; `message_end` when it ends a data message (FIN on a text, binary or continuation frame).
+    Frame { message_end: bool },
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum State {
+    /// In the HTTP head: its length so far and its last four bytes (to find "\r\n\r\n").
+    Head { len: u64, tail: u32 },
+    /// In a frame header: the bytes so far.
+    Header { buf: [u8; 14], have: usize },
+    /// In a frame's payload: bytes left, and whether the frame ends a data message.
+    Payload { left: u64, message_end: bool },
+    /// After a close: nothing more is scanned.
+    Closed,
+}
+
+/// The largest client frame header: 2 B, an 8 B extended length, a 4 B mask key.
+pub(crate) const MAX_HEADER: usize = 14;
+/// RFC 6455 §5.5: a control frame's payload is at most 125 B.
+const MAX_CONTROL: u64 = 125;
+
+/// One direction's scanner.
+#[derive(Debug, Clone)]
+pub(crate) struct Scanner {
+    /// The client's direction: limits applied, masks required.
+    client: bool,
+    max_payload: u64,
+    max_head: u64,
+    state: State,
+    /// The open data message's payload so far (a fragmented message's running total).
+    message: u64,
+}
+
+impl Scanner {
+    /// The client's direction: `max_payload` per frame and per message, `max_head` for the request.
+    pub(crate) fn client(max_payload: u64, max_head: u64) -> Scanner {
+        Scanner {
+            client: true,
+            max_payload,
+            max_head,
+            state: State::Head { len: 0, tail: 0 },
+            message: 0,
+        }
+    }
+
+    /// The server's direction: boundaries only, no limit.
+    pub(crate) fn server() -> Scanner {
+        Scanner {
+            client: false,
+            max_payload: u64::MAX,
+            max_head: u64::MAX,
+            state: State::Head { len: 0, tail: 0 },
+            message: 0,
+        }
+    }
+
+    /// Whether the scanner is still in the HTTP head.
+    pub(crate) fn in_head(&self) -> bool {
+        matches!(self.state, State::Head { .. })
+    }
+
+    /// Scans `input` up to the first boundary or close: returns the bytes consumed and what ended the scan (None: all
+    /// of `input` consumed with no boundary). After a close it consumes nothing.
+    pub(crate) fn scan(&mut self, input: &[u8]) -> (usize, Option<Result<Boundary, Reason>>) {
+        let mut i = 0;
+        while i < input.len() {
+            match &mut self.state {
+                State::Closed => return (i, None),
+                State::Head { len, tail } => {
+                    let b = input[i];
+                    i += 1;
+                    *len += 1;
+                    *tail = (*tail << 8) | u32::from(b);
+                    if *tail == 0x0d0a_0d0a {
+                        self.state = State::Header {
+                            buf: [0; MAX_HEADER],
+                            have: 0,
+                        };
+                        return (i, Some(Ok(Boundary::Head)));
+                    }
+                    if *len >= self.max_head {
+                        self.state = State::Closed;
+                        return (i, Some(Err(Reason::Request)));
+                    }
+                }
+                State::Header { buf, have } => {
+                    buf[*have] = input[i];
+                    *have += 1;
+                    i += 1;
+                    if *have < 2 {
+                        continue;
+                    }
+                    let masked = buf[1] & 0x80 != 0;
+                    let len7 = buf[1] & 0x7f;
+                    let need =
+                        2 + match len7 {
+                            126 => 2,
+                            127 => 8,
+                            _ => 0,
+                        } + if masked { 4 } else { 0 };
+                    if *have < need {
+                        continue;
+                    }
+                    let (b0, buf) = (buf[0], *buf);
+                    match self.header(b0, masked, len7, &buf) {
+                        Ok(Some(b)) => return (i, Some(Ok(b))),
+                        Ok(None) => {}
+                        Err(r) => {
+                            self.state = State::Closed;
+                            return (i, Some(Err(r)));
+                        }
+                    }
+                }
+                State::Payload { left, message_end } => {
+                    let take = (*left).min((input.len() - i) as u64);
+                    i += take as usize;
+                    *left -= take;
+                    if *left == 0 {
+                        let message_end = *message_end;
+                        self.state = State::Header {
+                            buf: [0; MAX_HEADER],
+                            have: 0,
+                        };
+                        return (i, Some(Ok(Boundary::Frame { message_end })));
+                    }
+                }
+            }
+        }
+        (i, None)
+    }
+
+    /// A complete header: the checks, then the payload state (or the frame's end at once for an empty payload).
+    fn header(
+        &mut self,
+        b0: u8,
+        masked: bool,
+        len7: u8,
+        buf: &[u8; MAX_HEADER],
+    ) -> Result<Option<Boundary>, Reason> {
+        let fin = b0 & 0x80 != 0;
+        let opcode = b0 & 0x0f;
+        let len = match len7 {
+            126 => u64::from(u16::from_be_bytes([buf[2], buf[3]])),
+            127 => {
+                let mut b = [0u8; 8];
+                b.copy_from_slice(&buf[2..10]);
+                let v = u64::from_be_bytes(b);
+                if v >> 63 != 0 && self.client {
+                    return Err(Reason::Length);
+                }
+                v
+            }
+            n => u64::from(n),
+        };
+        let control = opcode & 0x08 != 0;
+        if self.client {
+            if !masked {
+                return Err(Reason::Unmasked);
+            }
+            if control && (len > MAX_CONTROL || !fin) {
+                return Err(Reason::Control);
+            }
+            if len > self.max_payload {
+                return Err(Reason::Frame);
+            }
+        }
+        let mut message_end = false;
+        if !control {
+            // A text or binary frame opens a message; a continuation adds to it (tungstenite closes on one with no
+            // message open).
+            self.message = if opcode == 0 {
+                self.message.saturating_add(len)
+            } else {
+                len
+            };
+            if self.client && self.message > self.max_payload {
+                return Err(Reason::Message);
+            }
+            if fin {
+                message_end = true;
+                self.message = 0;
+            }
+        }
+        if len == 0 {
+            self.state = State::Header {
+                buf: [0; MAX_HEADER],
+                have: 0,
+            };
+            return Ok(Some(Boundary::Frame { message_end }));
+        }
+        self.state = State::Payload {
+            left: len,
+            message_end,
+        };
+        Ok(None)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rand_chacha::ChaCha8Rng;
+    use rand_core::{Rng, SeedableRng};
+
+    const LIMIT: u64 = 513;
+    const HEAD: u64 = 8_192;
+
+    /// A client frame: masked (or not), with the shortest length encoding unless `long` forces the 64-bit one.
+    fn frame(fin: bool, opcode: u8, masked: bool, payload: usize, long: bool) -> Vec<u8> {
+        let mut v = vec![(u8::from(fin) << 7) | opcode];
+        let m = if masked { 0x80 } else { 0 };
+        if long {
+            v.push(m | 127);
+            v.extend((payload as u64).to_be_bytes());
+        } else if payload < 126 {
+            v.push(m | payload as u8);
+        } else if payload <= 0xffff {
+            v.push(m | 126);
+            v.extend((payload as u16).to_be_bytes());
+        } else {
+            v.push(m | 127);
+            v.extend((payload as u64).to_be_bytes());
+        }
+        if masked {
+            v.extend([1, 2, 3, 4]);
+        }
+        v.extend(std::iter::repeat_n(0x5a, payload));
+        v
+    }
+
+    const REQUEST: &[u8] = b"GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\n\r\n";
+
+    /// Every boundary and close in `input`, fed in chunks of `chunk` bytes, with the offsets they end at.
+    fn all(s: &mut Scanner, input: &[u8], chunk: usize) -> Vec<(usize, Result<Boundary, Reason>)> {
+        let mut out = Vec::new();
+        let mut at = 0;
+        for c in input.chunks(chunk.max(1)) {
+            let mut i = 0;
+            while i < c.len() {
+                let (n, ev) = s.scan(&c[i..]);
+                i += n;
+                if let Some(e) = ev {
+                    out.push((at + i, e));
+                    if e.is_err() {
+                        return out;
+                    }
+                } else if n == 0 {
+                    return out;
+                }
+            }
+            at += c.len();
+        }
+        out
+    }
+
+    #[test]
+    fn the_request_then_each_frame_is_a_boundary_in_any_chunking() {
+        let mut input = REQUEST.to_vec();
+        let frames = [
+            frame(true, 2, true, 513, false),
+            frame(false, 2, true, 200, false),
+            frame(true, 9, true, 125, false),
+            frame(true, 0, true, 313, false),
+            frame(true, 1, true, 0, false),
+        ];
+        let mut ends = vec![REQUEST.len()];
+        for f in &frames {
+            input.extend(f);
+            ends.push(input.len());
+        }
+        for chunk in [1, 2, 3, 7, 64, 10_000] {
+            let mut s = Scanner::client(LIMIT, HEAD);
+            let got = all(&mut s, &input, chunk);
+            let at: Vec<usize> = got.iter().map(|g| g.0).collect();
+            assert_eq!(at, ends, "chunk {chunk}");
+            let kinds: Vec<Result<Boundary, Reason>> = got.iter().map(|g| g.1).collect();
+            assert_eq!(
+                kinds,
+                vec![
+                    Ok(Boundary::Head),
+                    Ok(Boundary::Frame { message_end: true }),
+                    Ok(Boundary::Frame { message_end: false }),
+                    Ok(Boundary::Frame { message_end: false }),
+                    Ok(Boundary::Frame { message_end: true }),
+                    Ok(Boundary::Frame { message_end: true }),
+                ]
+            );
+        }
+    }
+
+    /// Each close reason, found at the header's last byte, before any of the payload.
+    #[test]
+    fn each_limit_closes_at_the_header() {
+        let cases: [(Vec<u8>, Reason); 7] = [
+            (frame(true, 2, true, 514, false), Reason::Frame),
+            (
+                [
+                    frame(false, 2, true, 300, false),
+                    frame(true, 0, true, 214, false),
+                ]
+                .concat(),
+                Reason::Message,
+            ),
+            (frame(true, 2, false, 10, false), Reason::Unmasked),
+            (frame(true, 9, true, 126, false), Reason::Control),
+            (frame(false, 9, true, 5, false), Reason::Control),
+            (
+                {
+                    let mut f = frame(true, 2, true, 0, true);
+                    f[2] = 0x80;
+                    f
+                },
+                Reason::Length,
+            ),
+            (frame(true, 2, true, 70_000, false), Reason::Frame),
+        ];
+        for (f, why) in cases {
+            let mut s = Scanner::client(LIMIT, HEAD);
+            let input = [REQUEST, &f].concat();
+            let got = all(&mut s, &input, 1);
+            let (at, last) = *got.last().unwrap();
+            assert_eq!(last, Err(why));
+            // The close comes at a header's end: the payload (if any) is never consumed.
+            let header_len = |b1: u8| {
+                2 + match b1 & 0x7f {
+                    126 => 2,
+                    127 => 8,
+                    _ => 0,
+                } + if b1 & 0x80 != 0 { 4 } else { 0 }
+            };
+            let last_start = if why == Reason::Message {
+                REQUEST.len() + frame(false, 2, true, 300, false).len()
+            } else {
+                REQUEST.len()
+            };
+            assert_eq!(
+                at,
+                last_start + header_len(input[last_start + 1]),
+                "{why:?}"
+            );
+            // Nothing more is scanned after a close.
+            assert_eq!(s.scan(&[0x82, 0x80, 0, 0, 0, 0]), (0, None));
+        }
+    }
+
+    #[test]
+    fn a_request_without_its_blank_line_closes_at_its_cap() {
+        let mut s = Scanner::client(LIMIT, 64);
+        let long = vec![b'a'; 100];
+        let (n, ev) = s.scan(&long);
+        assert_eq!((n, ev), (64, Some(Err(Reason::Request))));
+        // A request of exactly the cap, ending with its blank line, passes.
+        let mut s = Scanner::client(LIMIT, REQUEST.len() as u64);
+        assert_eq!(s.scan(REQUEST), (REQUEST.len(), Some(Ok(Boundary::Head))));
+    }
+
+    #[test]
+    fn the_server_direction_applies_no_limit() {
+        let mut s = Scanner::server();
+        let resp = b"HTTP/1.1 101 Switching Protocols\r\n\r\n";
+        let input = [&resp[..], &frame(true, 2, false, 65_541, false)].concat();
+        let got = all(&mut s, &input, 4_096);
+        assert_eq!(
+            got,
+            vec![
+                (resp.len(), Ok(Boundary::Head)),
+                (input.len(), Ok(Boundary::Frame { message_end: true }))
+            ]
+        );
+    }
+
+    /// C6: the seeded random-input test. Random bytes, and valid streams with random corruption, in random chunks:
+    /// the scanner never panics, never consumes more than it is given, never reports a frame (with its header) above
+    /// the limit plus 14 B or a head above its cap, and makes progress (a call that consumes nothing has closed).
+    #[test]
+    fn random_input_never_panics_and_stays_within_its_bounds() {
+        let mut rng = ChaCha8Rng::seed_from_u64(0x6e70_745f_6672_616d);
+        let mut below = |n: u64| ((u128::from(rng.next_u64()) * u128::from(n)) >> 64) as u64;
+        let (mut boundaries, mut closes) = (0u64, [0u64; REASONS]);
+        for case in 0..20_000u64 {
+            let mut input = Vec::new();
+            if case % 2 == 0 {
+                let n = below(3_000) as usize;
+                input.extend((0..n).map(|_| below(256) as u8));
+                if below(2) == 0 {
+                    input.splice(0..0, REQUEST.iter().copied());
+                }
+            } else {
+                input.extend(REQUEST);
+                for _ in 0..below(20) {
+                    let opcode = [0, 1, 2, 8, 9, 10, 3][below(7) as usize];
+                    let len = [0, 1, 125, 126, 513, 514, 65_535, 70_000][below(8) as usize];
+                    input.extend(frame(
+                        below(4) != 0,
+                        opcode,
+                        below(10) != 0,
+                        len.min(600),
+                        below(9) == 0,
+                    ));
+                }
+                for _ in 0..below(4) {
+                    if !input.is_empty() {
+                        let at = below(input.len() as u64) as usize;
+                        input[at] = below(256) as u8;
+                    }
+                }
+            }
+            let mut s = Scanner::client(LIMIT, 512 + below(HEAD));
+            let max_head = s.max_head;
+            let mut i = 0;
+            let mut since = 0usize;
+            while i < input.len() {
+                let chunk = 1 + below(700) as usize;
+                let end = (i + chunk).min(input.len());
+                let (n, ev) = s.scan(&input[i..end]);
+                assert!(n <= end - i);
+                i += n;
+                since += n;
+                match ev {
+                    Some(Ok(b)) => {
+                        boundaries += 1;
+                        let cap = match b {
+                            Boundary::Head => max_head,
+                            Boundary::Frame { .. } => LIMIT + MAX_HEADER as u64,
+                        };
+                        assert!(
+                            since as u64 <= cap,
+                            "case {case}: a {b:?} record of {since} B"
+                        );
+                        since = 0;
+                    }
+                    Some(Err(r)) => {
+                        closes[r as usize] += 1;
+                        assert!(
+                            since as u64 <= max_head.max(LIMIT + MAX_HEADER as u64),
+                            "case {case}: {since} B held before a close"
+                        );
+                        break;
+                    }
+                    None => assert!(n > 0 || end == i, "no progress without a close"),
+                }
+            }
+        }
+        println!("random input: {boundaries} boundaries, closes by reason {closes:?}");
+        assert!(boundaries > 10_000);
+        assert!(
+            closes.iter().all(|&c| c > 0),
+            "every reason reached: {closes:?}"
+        );
+    }
+}
diff --git a/spikes/netcode-proof/crates/net/src/ws_config.rs b/spikes/netcode-proof/crates/net/src/ws_config.rs
new file mode 100644
index 0000000..854e149
--- /dev/null
+++ b/spikes/netcode-proof/crates/net/src/ws_config.rs
@@ -0,0 +1,58 @@
+//! The WebSocket server's configurations (u3c-plan.md 1.1 and 1.2; C6, C7):
+//! - **TLS** (M16; Mustafa's U3-Q5: tokio-rustls pinned in U3, audited at U5, plan §4.8): tokio-rustls 0.26.6 over the
+//!   pinned rustls 0.23.46, the ring provider chosen explicitly for this configuration with `builder_with_provider`
+//!   (never a process default, so it lives beside wt-wtq's aws-lc-rs and wtransport's ring in one process: M7), TLS 1.3
+//!   only, ALPN `http/1.1`. Ring because it is the one provider npt-net always has (quinn's default rustls-ring).
+//!   DelayStream sits above the stream it makes, tokio-tungstenite above DelayStream (U3-Q4 (b)).
+//! - **tungstenite** (the catalogue, docs/design/netcode-proof-messages.md:61-78): one source for the size limits,
+//!   L2Config's `ws_max_message_bytes` (513 B), as both `max_frame_size` and `max_message_size`; a 128 KB write buffer
+//!   bound (it must hold a 65,541 B FullState); `write_buffer_size` 0, so each message is written through to the
+//!   stream at once (fix 1's gate then sees what tungstenite still holds as owed bytes).
+
+use std::io;
+use std::sync::Arc;
+use tokio_rustls::rustls;
+use tokio_rustls::rustls::pki_types::{CertificateDer, PrivateKeyDer};
+use tokio_tungstenite::tungstenite::protocol::WebSocketConfig;
+
+/// The catalogue's write buffer bound: the largest room message (a 65,541 B FullState) with room to spare.
+pub(crate) const MAX_WRITE_BUFFER_BYTES: usize = 128 * 1024;
+
+/// The provider: ring, explicitly.
+pub(crate) fn provider() -> rustls::crypto::CryptoProvider {
+    rustls::crypto::ring::default_provider()
+}
+
+/// The server's TLS: TLS 1.3 only, ALPN `http/1.1`, the ring provider (no process default).
+pub(crate) fn tls_config(
+    chain: Vec<CertificateDer<'static>>,
+    key: PrivateKeyDer<'static>,
+) -> io::Result<rustls::ServerConfig> {
+    let mut tls = rustls::ServerConfig::builder_with_provider(Arc::new(provider()))
+        .with_protocol_versions(&[&rustls::version::TLS13])
+        .map_err(io::Error::other)?
+        .with_no_client_auth()
+        .with_single_cert(chain, key)
+        .map_err(io::Error::other)?;
+    tls.alpn_protocols = vec![b"http/1.1".to_vec()];
+    Ok(tls)
+}
+
+/// The accept path's TLS acceptor over `tls_config`.
+pub(crate) fn acceptor(
+    chain: Vec<CertificateDer<'static>>,
+    key: PrivateKeyDer<'static>,
+) -> io::Result<tokio_rustls::TlsAcceptor> {
+    Ok(tokio_rustls::TlsAcceptor::from(Arc::new(tls_config(
+        chain, key,
+    )?)))
+}
+
+/// tungstenite's server configuration with the size limit `max_message_bytes` (L2Config's `ws_max_message_bytes`).
+pub(crate) fn ws_config(max_message_bytes: usize) -> WebSocketConfig {
+    WebSocketConfig::default()
+        .max_frame_size(Some(max_message_bytes))
+        .max_message_size(Some(max_message_bytes))
+        .max_write_buffer_size(MAX_WRITE_BUFFER_BYTES)
+        .write_buffer_size(0)
+}
diff --git a/spikes/netcode-proof/crates/net/src/ws_gate.rs b/spikes/netcode-proof/crates/net/src/ws_gate.rs
new file mode 100644
index 0000000..1415bd3
--- /dev/null
+++ b/spikes/netcode-proof/crates/net/src/ws_gate.rs
@@ -0,0 +1,160 @@
+//! Fix 1's send gate on the WebSocket fallback (Mustafa, 2026-11-06: newest snapshot only with a small send buffer;
+//! advisor-ws-docs-r2.md U3c (2), (3); the verifier's W22; u3c-plan.md 1.3 and C9). Shipped code: U6's WsServer calls
+//! these on every tick (no copy), and `tcp_model::fixes`'s adaptive limit calls [`snapshot_budget`], so the model's
+//! harness and the build cannot drift (mechanism test (e)).
+//!
+//! - [`snapshot_budget`]: N, the snapshots the budget holds: ceil(3 x srtt / (2 x tick)) + 1, at least 3, with srtt
+//!   100 ms before the first sample (fixes.rs's rule since harness v1).
+//! - [`may_write`]: a tick's snapshot is written only when all three of fixes.rs's conditions hold (fixes.rs's room
+//!   step, W22): nothing is owed above the kernel socket; the socket has room for the whole snapshot; and what is
+//!   outstanding (unsent plus unacknowledged: SIOCOUTQ, tcp.c:630) plus the snapshot fits in N snapshots.
+//! - [`TickWriter`]: the per-tick decision. Each tick it is offered that tick's snapshot, the newest, and either
+//!   writes it now or skips it, counted; it holds nothing, so a skipped snapshot can never be written later and at
+//!   most one snapshot (the one owed to the socket) is ever above the socket (PM-0001-31's reading, R13).
+//!
+//! `size` is the whole tick's snapshot in the model's bytes: every message of the tick, written all or none, each
+//! counted as its payload plus its WebSocket frame header plus TLS 1.3's 22 B per record (S0), as fixes.rs's
+//! SNAP = 1,050 counts a 1,024 B snapshot.
+
+/// srtt before the first sample (fixes.rs:166's 100 ms).
+pub(crate) const NO_SAMPLE_SRTT_NS: u64 = 100_000_000;
+/// The budget's floor in snapshots.
+pub(crate) const MIN_SNAPSHOTS: u64 = 3;
+
+/// N: snapshots for 1.5 smoothed round trips plus one, at least 3 (srtt 100 ms before the first sample).
+pub(crate) fn snapshot_budget(srtt_ns: Option<u64>, tick_ns: u64) -> u64 {
+    let srtt = srtt_ns.unwrap_or(NO_SAMPLE_SRTT_NS);
+    let n = srtt
+        .saturating_mul(3)
+        .div_ceil(tick_ns.saturating_mul(2).max(1))
+        .saturating_add(1);
+    n.max(MIN_SNAPSHOTS)
+}
+
+/// Whether a snapshot of `size` bytes may be written now (W22: fixes.rs's three conditions): nothing `owed` above the
+/// kernel socket; `free` (the socket's room) holds the whole snapshot; `outstanding` plus it fits in `n` snapshots.
+pub(crate) fn may_write(outstanding: u64, owed: u64, free: u64, size: u64, n: u64) -> bool {
+    owed == 0 && free >= size && outstanding.saturating_add(size) <= n.saturating_mul(size)
+}
+
+/// What the gate reads each tick, from the connection's socket (DelayStream's model on L2; TCP_INFO and SIOCOUTQ on
+/// the plain path, U6).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct Inputs {
+    /// The down direction's smoothed RTT (tcpi_rtt, tcp.c:3842), None before the first sample.
+    pub(crate) srtt_ns: Option<u64>,
+    /// Unsent plus unacknowledged bytes (SIOCOUTQ: write_seq − snd_una, tcp.c:630).
+    pub(crate) outstanding: u64,
+    /// Bytes held above the kernel socket (tungstenite's buffer; on the plain path rustls's unsent TLS too).
+    pub(crate) owed: u64,
+    /// The socket's room for new bytes (the send-buffer space npt-room gets: plan §4.4).
+    pub(crate) free: u64,
+}
+
+/// One tick's snapshot: its id (the tick it was made on) and its size in the model's bytes.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct Snap {
+    pub(crate) id: u64,
+    pub(crate) size: u64,
+}
+
+/// The planted defects of the mechanism tests (u3c-plan.md 1.4 (d)); never in a build that runs.
+#[cfg(test)]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Bite {
+    /// A budget twice the formula's (budget_scale 2): fails (a) and (c).
+    BudgetX2,
+    /// A queueing writer: a skipped snapshot is kept and written later, oldest first: fails (b) and PM-0001-31's "at
+    /// most one snapshot above the socket".
+    Queueing,
+}
+
+/// The per-tick writer decision (fix 1): newest only, a skip counted, never written later.
+#[derive(Debug)]
+pub(crate) struct TickWriter {
+    tick_ns: u64,
+    written: u64,
+    skipped: u64,
+    #[cfg(test)]
+    bite: Option<Bite>,
+    /// The queueing bite's held snapshots (always empty otherwise).
+    #[cfg(test)]
+    queue: std::collections::VecDeque<Snap>,
+}
+
+impl TickWriter {
+    pub(crate) fn new(tick_ns: u64) -> TickWriter {
+        TickWriter {
+            tick_ns,
+            written: 0,
+            skipped: 0,
+            #[cfg(test)]
+            bite: None,
+            #[cfg(test)]
+            queue: std::collections::VecDeque::new(),
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn with_bite(mut self, bite: Bite) -> TickWriter {
+        self.bite = Some(bite);
+        self
+    }
+
+    /// N at this srtt (the bite doubles it).
+    pub(crate) fn budget(&self, srtt_ns: Option<u64>) -> u64 {
+        let n = snapshot_budget(srtt_ns, self.tick_ns);
+        #[cfg(test)]
+        if self.bite == Some(Bite::BudgetX2) {
+            return 2 * n;
+        }
+        n
+    }
+
+    /// This tick's snapshot `snap`, the newest: `Some` of the snapshot to write now, or `None` to skip it (counted;
+    /// the caller drops it, so it is never written later). The caller calls this once per tick and nowhere else.
+    pub(crate) fn on_tick(&mut self, snap: Snap, inp: Inputs) -> Option<Snap> {
+        let n = self.budget(inp.srtt_ns);
+        #[cfg(test)]
+        if self.bite == Some(Bite::Queueing) {
+            // Everything goes through a queue; the oldest leaves when the gate lets it.
+            self.queue.push_back(snap);
+            let front = self.queue.front().copied()?;
+            if may_write(inp.outstanding, inp.owed, inp.free, front.size, n) {
+                self.written += 1;
+                return self.queue.pop_front();
+            }
+            self.skipped += 1;
+            return None;
+        }
+        if may_write(inp.outstanding, inp.owed, inp.free, snap.size, n) {
+            self.written += 1;
+            Some(snap)
+        } else {
+            self.skipped += 1;
+            None
+        }
+    }
+
+    /// Snapshots written so far.
+    pub(crate) fn written(&self) -> u64 {
+        self.written
+    }
+
+    /// Snapshots skipped so far (WsServer reports them to npt-room as BufferFull: plan §4.4).
+    pub(crate) fn skipped(&self) -> u64 {
+        self.skipped
+    }
+
+    /// Snapshots the writer itself holds above the socket: none (the queueing bite holds its queue).
+    pub(crate) fn held(&self) -> usize {
+        #[cfg(test)]
+        return self.queue.len();
+        #[cfg(not(test))]
+        0
+    }
+}
+
+#[cfg(test)]
+#[path = "ws_gate_tests.rs"]
+mod tests;
diff --git a/spikes/netcode-proof/crates/net/src/ws_gate_tests.rs b/spikes/netcode-proof/crates/net/src/ws_gate_tests.rs
new file mode 100644
index 0000000..dfb5229
--- /dev/null
+++ b/spikes/netcode-proof/crates/net/src/ws_gate_tests.rs
@@ -0,0 +1,236 @@
+//! Mechanism tests (a) and (b) on the shipped gate (u3c-plan.md 1.4, C9), with their bites. (c) runs on DelayStream
+//! through TLS and tungstenite (l2::delay_tests), (e) in tcp_model::fixes.
+
+use super::*;
+use rand_chacha::ChaCha8Rng;
+use rand_core::{Rng, SeedableRng};
+use std::collections::BTreeSet;
+
+const MS: u64 = 1_000_000;
+/// The room's 30 Hz tick (fixes.rs's TICK).
+const TICK: u64 = 33_333_333;
+const BUDGET: u64 = 64 * 1024;
+const TABLE: [u64; 6] = [6, 3, 4, 6, 8, 15];
+
+/// N at no sample, 20, 50, 100, 150 and 300 ms.
+fn table(budget: impl Fn(Option<u64>) -> u64) -> [u64; 6] {
+    [
+        None,
+        Some(20 * MS),
+        Some(50 * MS),
+        Some(100 * MS),
+        Some(150 * MS),
+        Some(300 * MS),
+    ]
+    .map(budget)
+}
+
+/// (a) The table at TICK = 33,333,333 ns (advisor-ws-docs-r2.md:385; V10 recomputed it: 2 x TICK = 66,666,666).
+#[test]
+fn a_the_budget_table_at_30_hz() {
+    assert_eq!(table(|s| snapshot_budget(s, TICK)), TABLE);
+    // The writer's own N is the same function.
+    let w = TickWriter::new(TICK);
+    assert_eq!(table(|s| w.budget(s)), TABLE);
+}
+
+/// (d) budget_scale 2 fails (a).
+#[test]
+fn bite_a_budget_twice_the_formula_fails_a() {
+    let w = TickWriter::new(TICK).with_bite(Bite::BudgetX2);
+    assert_ne!(table(|s| w.budget(s)), TABLE);
+}
+
+/// (b) N never decreases as srtt grows and never falls below 3: every whole µs from 0 to 3 s, and seeded large values.
+#[test]
+fn b_the_budget_never_decreases_and_never_falls_below_3() {
+    let mut last = 0;
+    for us in 0..=3_000_000u64 {
+        let n = snapshot_budget(Some(us * 1_000), TICK);
+        assert!(n >= MIN_SNAPSHOTS, "{n} at {us} µs");
+        assert!(n >= last, "N fell from {last} to {n} at {us} µs");
+        last = n;
+    }
+    let mut rng = ChaCha8Rng::seed_from_u64(0x6e70_745f_6761_7465);
+    let mut v: Vec<u64> = (0..100_000).map(|_| rng.next_u64() >> 20).collect();
+    v.sort_unstable();
+    let ns: Vec<u64> = v.iter().map(|&s| snapshot_budget(Some(s), TICK)).collect();
+    assert!(ns.windows(2).all(|w| w[0] <= w[1]));
+    assert!(ns.iter().all(|&n| n >= MIN_SNAPSHOTS));
+}
+
+/// What one seeded sweep saw: writes, and the skips by the first condition that failed.
+#[derive(Debug, Default)]
+struct Seen {
+    writes: u64,
+    skip_owed: u64,
+    skip_free: u64,
+    skip_budget: u64,
+}
+
+/// (b) One seeded sweep of the shipped writer over `ticks` ticks of a simulated socket: the network acknowledges a
+/// random share each tick, srtt has no sample at first and then wanders from 5 ms to 2 s, a resume's FullState now and
+/// then leaves bytes owed above the socket for a few ticks, the room is sometimes short, and each tick's snapshot is
+/// 100 B to 4 KB. Returns the first broken property, if any.
+fn sweep(bite: Option<Bite>, seed: u64, ticks: u64) -> Result<Seen, String> {
+    let mut rng = ChaCha8Rng::seed_from_u64(seed);
+    let mut w = TickWriter::new(TICK);
+    if let Some(b) = bite {
+        w = w.with_bite(b);
+    }
+    let mut below = |n: u64| ((u128::from(rng.next_u64()) * u128::from(n)) >> 64) as u64;
+    let (mut outstanding, mut owed) = (0u64, 0u64);
+    let mut srtt: Option<u64> = None;
+    let mut skipped = BTreeSet::new();
+    let mut seen = Seen::default();
+    for tick in 0..ticks {
+        // The network: up to everything outstanding acknowledged this tick (often nothing: a burst).
+        if below(4) != 0 {
+            outstanding -= below(outstanding + 1);
+        }
+        if tick > 30 && (srtt.is_none() || below(10) == 0) {
+            srtt = Some(5 * MS + below(2_000 * MS));
+        }
+        if below(60) == 0 {
+            owed = 1 + below(70_000);
+        } else {
+            owed = owed.saturating_sub(below(20_000));
+        }
+        let size = 100 + below(4_000);
+        let room = BUDGET.saturating_sub(outstanding);
+        let free = if below(15) == 0 {
+            below(room + 1)
+        } else {
+            room
+        };
+        let inp = Inputs {
+            srtt_ns: srtt,
+            outstanding,
+            owed,
+            free,
+        };
+        // The three conditions, restated here (fixes.rs's room step; W22).
+        let n = snapshot_budget(srtt, TICK);
+        let cond = owed == 0 && free >= size && outstanding + size <= n * size;
+        let got = w.on_tick(Snap { id: tick, size }, inp);
+        if got.is_some() != cond {
+            return Err(format!(
+                "tick {tick}: wrote {} but the conditions say {cond} ({inp:?}, size {size}, N {n})",
+                got.is_some()
+            ));
+        }
+        match got {
+            Some(s) => {
+                if s.id != tick {
+                    return Err(format!(
+                        "tick {tick}: wrote snapshot {}, not the newest",
+                        s.id
+                    ));
+                }
+                if skipped.contains(&s.id) {
+                    return Err(format!("tick {tick}: wrote skipped snapshot {}", s.id));
+                }
+                outstanding += s.size;
+                if outstanding > n * s.size {
+                    return Err(format!(
+                        "tick {tick}: outstanding {outstanding} above N x size after a write"
+                    ));
+                }
+                seen.writes += 1;
+            }
+            None => {
+                skipped.insert(tick);
+                if owed > 0 {
+                    seen.skip_owed += 1;
+                } else if free < size {
+                    seen.skip_free += 1;
+                } else {
+                    seen.skip_budget += 1;
+                }
+            }
+        }
+        // PM-0001-31's "at most one snapshot above the socket": the writer holds none; the socket may owe one.
+        let above = w.held() + usize::from(owed > 0);
+        if above > 1 {
+            return Err(format!("tick {tick}: {above} snapshots above the socket"));
+        }
+    }
+    if w.written() != seen.writes || w.skipped() != ticks - seen.writes {
+        return Err(format!(
+            "counts {} written, {} skipped; seen {seen:?}",
+            w.written(),
+            w.skipped()
+        ));
+    }
+    Ok(seen)
+}
+
+/// (b) Seeded sweeps (proptest is not in the workspace): 64 seeds x 20,000 ticks. Every property holds, and each
+/// skip reason is exercised.
+#[test]
+fn b_the_writer_writes_iff_the_three_conditions_hold_and_only_the_newest() {
+    let mut total = Seen::default();
+    for seed in 0..64 {
+        let s = sweep(None, seed, 20_000).unwrap_or_else(|e| panic!("seed {seed}: {e}"));
+        total.writes += s.writes;
+        total.skip_owed += s.skip_owed;
+        total.skip_free += s.skip_free;
+        total.skip_budget += s.skip_budget;
+    }
+    println!("(b) 64 x 20,000 ticks: {total:?}");
+    assert!(total.writes > 100_000, "{total:?}");
+    assert!(
+        total.skip_owed > 1_000 && total.skip_free > 1_000 && total.skip_budget > 1_000,
+        "every reason exercised: {total:?}"
+    );
+}
+
+/// (d) A queueing writer fails (b) (a skipped snapshot written later, not the newest) and -31's "at most one snapshot
+/// above the socket".
+#[test]
+fn bite_a_queueing_writer_fails_b() {
+    let e = sweep(Some(Bite::Queueing), 1, 20_000).expect_err("the queueing writer is caught");
+    assert!(
+        e.contains("not the newest")
+            || e.contains("skipped snapshot")
+            || e.contains("above the socket"),
+        "{e}"
+    );
+    // And -31's check on its own: a writer that queues holds more than one snapshot once two ticks are skipped.
+    let mut w = TickWriter::new(TICK).with_bite(Bite::Queueing);
+    let full = Inputs {
+        srtt_ns: None,
+        outstanding: BUDGET,
+        owed: 0,
+        free: 0,
+    };
+    for id in 0..3 {
+        assert_eq!(w.on_tick(Snap { id, size: 1_050 }, full), None);
+    }
+    assert_eq!(w.held(), 3);
+    // The faithful writer holds none.
+    let mut f = TickWriter::new(TICK);
+    for id in 0..3 {
+        assert_eq!(f.on_tick(Snap { id, size: 1_050 }, full), None);
+    }
+    assert_eq!((f.held(), f.skipped()), (0, 3));
+}
+
+/// (d) budget_scale 2 also breaks (b)'s "write iff the three conditions hold".
+#[test]
+fn bite_a_budget_twice_the_formula_fails_b() {
+    let e = sweep(Some(Bite::BudgetX2), 2, 20_000).expect_err("caught");
+    assert!(e.contains("conditions say false"), "{e}");
+}
+
+/// The three conditions one by one (W22).
+#[test]
+fn may_write_needs_all_three_conditions() {
+    let n = 6;
+    assert!(may_write(5 * 1_050, 0, 1_050, 1_050, n));
+    assert!(!may_write(5 * 1_050 + 1, 0, 1_050, 1_050, n), "the budget");
+    assert!(!may_write(0, 1, 65_536, 1_050, n), "owed");
+    assert!(!may_write(0, 0, 1_049, 1_050, n), "the room");
+    // W22's case: N x size above 64 KB (N >= 63 at 1,050 B) and the room short: the room decides.
+    assert!(!may_write(60_000, 0, 1_000, 1_050, 70));
+}
diff --git a/spikes/netcode-proof/results/u3c-kernel-check/compare.py b/spikes/netcode-proof/results/u3c-kernel-check/compare.py
new file mode 100644
index 0000000..3d3fc38
--- /dev/null
+++ b/spikes/netcode-proof/results/u3c-kernel-check/compare.py
@@ -0,0 +1,164 @@
+# U3c's kernel cross-check: applies run.sh's written rule (its header) to the kernel runs and the model's runs alike.
+#   python3 -I compare.py summary <kernel-runN.json>   one kernel run's numbers
+#   python3 -I compare.py rtt <out-dir>                the model's RTT: the mean client tcpi_rtt over the runs, in ns
+#   python3 -I compare.py judge <out-dir>              the verdict (verdict.json beside it)
+import glob
+import json
+import math
+import os
+import sys
+
+GAP = 33_333_333
+HALF_GAP = GAP // 2
+SLOP = 2_000_000
+JITTER = 1_000_000
+P50_WITHIN = 2_000_000
+LEVEL = 0.99
+
+
+def p50(values):
+    s = sorted(values)
+    return s[(len(s) + 1) // 2 - 1]
+
+
+def episodes(n, base, late, threshold):
+    """Lengths (delay - base) of the first message of each maximal run of messages more than `threshold` above base.
+    `late` maps a message index to its delay, for every message more than 1 ms above base (the rest are below any
+    threshold used here)."""
+    out = []
+    prev = False
+    for k in range(n):
+        d = late.get(k)
+        above = d is not None and d - base > threshold
+        if above and not prev:
+            out.append(d - base)
+        prev = above
+    return out
+
+
+def classify(eps, rtt):
+    bound = rtt + GAP + SLOP + JITTER
+    rack = [e for e in eps if e <= bound]
+    return rack, len(eps) - len(rack)
+
+
+def kernel_run(path):
+    r = json.load(open(path))
+    delays = r["delay_ns"]
+    got = [d for d in delays if d is not None]
+    base = p50(got)
+    late = {k: d for k, d in enumerate(delays) if d is not None and d > base + 1_000_000}
+    lat = sorted(abs(x) for x in r["send_late_ns"])
+    return r, base, late, lat[min(len(lat) - 1, math.ceil(0.99 * len(lat)) - 1)]
+
+
+def model_runs(path):
+    runs = []
+    for line in open(path):
+        if line.startswith("KCMODEL "):
+            m = json.loads(line[len("KCMODEL "):])
+            m["late_map"] = {k: d for k, d in m["late"]}
+            runs.append(m)
+    return runs
+
+
+def band(n, p, level):
+    tail = (1 - level) / 2
+    pmf = [math.comb(n, k) * p**k * (1 - p) ** (n - k) for k in range(n + 1)]
+    lo, below = 0, 0.0
+    for k, x in enumerate(pmf):
+        if below + x > tail:
+            lo = k
+            break
+        below += x
+    hi, above = n, 0.0
+    for k in range(n, -1, -1):
+        if above + pmf[k] > tail:
+            hi = k
+            break
+        above += pmf[k]
+    return lo, hi
+
+
+def kernel_rtt(out):
+    rtts = [json.load(open(p))["tcp_info_client"]["rtt_us"] for p in sorted(glob.glob(os.path.join(out, "kernel-run*.json")))]
+    return round(1000 * sum(rtts) / len(rtts))
+
+
+def main():
+    cmd = sys.argv[1]
+    if cmd == "summary":
+        r, base, late, lat99 = kernel_run(sys.argv[2])
+        eps = episodes(r["messages"], base, late, HALF_GAP)
+        print(
+            f"{os.path.basename(sys.argv[2])}: delivered {r['delivered']} of {r['messages']}; base {base} ns; "
+            f"{len(eps)} stall episodes; send lateness p99 {lat99} ns; cc {r['cc_client']}/{r['cc_server']} "
+            f"{r['cc_errors']}; tcp_info {r['tcp_info_client']}"
+        )
+        return
+    out = sys.argv[2]
+    if cmd == "rtt":
+        print(kernel_rtt(out))
+        return
+    assert cmd == "judge", cmd
+    rtt = kernel_rtt(out)
+    problems = []
+    k_eps, k_eps_gap = [], 0
+    for path in sorted(glob.glob(os.path.join(out, "kernel-run*.json"))):
+        r, base, late, lat99 = kernel_run(path)
+        name = os.path.basename(path)
+        if r["delivered"] != r["messages"]:
+            problems.append(f"{name}: delivered {r['delivered']} of {r['messages']}")
+        if lat99 > JITTER:
+            problems.append(f"{name}: INVALID, send lateness p99 {lat99} ns > the 1 ms allowance")
+        if r["cc_client"] != "cubic" or r["cc_server"] != "cubic":
+            problems.append(f"{name}: cubic not set (client {r['cc_client']}, server {r['cc_server']}): recorded")
+        k_eps += episodes(r["messages"], base, late, HALF_GAP)
+        k_eps_gap += len(episodes(r["messages"], base, late, GAP))
+    m_eps, m_eps_gap, m_rep = [], 0, [0, 0, 0]
+    runs = model_runs(os.path.join(out, "model.txt"))
+    if not runs:
+        problems.append("model.txt holds no KCMODEL line")
+    for m in runs:
+        m_eps += episodes(m["n"], m["p50_ns"], m["late_map"], HALF_GAP)
+        m_eps_gap += len(episodes(m["n"], m["p50_ns"], m["late_map"], GAP))
+        m_rep = [a + b for a, b in zip(m_rep, m["repairs"])]
+    k_rack, k_other = classify(k_eps, rtt)
+    m_rack, m_other = classify(m_eps, rtt)
+    verdict = {"rtt_ns": rtt, "kernel_episodes": len(k_eps), "model_episodes": len(m_eps), "problems": problems}
+    lines = [f"loopback RTT (mean client tcpi_rtt) {rtt} ns; RACK bound L <= {rtt + GAP + SLOP + JITTER} ns"]
+    ok = not [p for p in problems if "cubic" not in p]
+    if k_rack and m_rack:
+        kp, mp = p50(k_rack), p50(m_rack)
+        within = abs(kp - mp) <= P50_WITHIN
+        verdict.update(kernel_rack_p50_ns=kp, model_rack_p50_ns=mp, rack_pass=within)
+        lines.append(
+            f"(1) RACK-path stall p50: kernel {kp / 1e6:.3f} ms ({len(k_rack)} episodes), model {mp / 1e6:.3f} ms "
+            f"({len(m_rack)}): {'PASS' if within else 'MISS'} (within 2 ms)"
+        )
+        ok &= within
+    else:
+        lines.append(f"(1) no RACK-path episodes (kernel {len(k_rack)}, model {len(m_rack)}): MISS")
+        ok = False
+    if m_eps:
+        p = m_other / len(m_eps)
+        lo, hi = band(len(k_eps), p, LEVEL)
+        inside = lo <= k_other <= hi
+        verdict.update(kernel_other=k_other, model_other_share=p, band=[lo, hi], other_pass=inside)
+        lines.append(
+            f"(2) probe-or-timeout share: kernel {k_other} of {len(k_eps)}, model {m_other} of {len(m_eps)} "
+            f"(p {p:.4f}); 99 % band {lo}-{hi}: {'PASS' if inside else 'MISS'}"
+        )
+        ok &= inside
+    lines.append(
+        f"reported, not judged: episodes at a one-gap threshold kernel {k_eps_gap} (vs {len(k_eps)}), model "
+        f"{m_eps_gap} (vs {len(m_eps)}); the model's own repairs rack/probe/timeout {m_rep}"
+    )
+    lines += [f"problem: {p}" for p in problems]
+    lines.append("VERDICT: PASS" if ok else "VERDICT: MISS (to the advisor before U3c closes)")
+    verdict["pass"] = ok
+    json.dump(verdict, open(os.path.join(out, "verdict.json"), "w"), indent=1)
+    print("\n".join(lines))
+
+
+main()
diff --git a/spikes/netcode-proof/results/u3c-kernel-check/probe.py b/spikes/netcode-proof/results/u3c-kernel-check/probe.py
new file mode 100644
index 0000000..12a39a9
--- /dev/null
+++ b/spikes/netcode-proof/results/u3c-kernel-check/probe.py
@@ -0,0 +1,115 @@
+# U3c's kernel cross-check, the kernel side (run.sh's header holds the pattern and the pass rule). Adapted from the
+# scout's u3-tcp-stall-probe.py: loopback TCP, client -> server, one 200 B message every 33,333,333 ns with
+# TCP_NODELAY, TCP_CONGESTION set to cubic on the listener and both sockets (read back and recorded). Loss comes from
+# run.sh's iptables rule, never from here. Prints one JSON object: every message's send lateness and delay (ns), the
+# congestion control each socket ended with, and the client's tcp_info at the end.
+# Run: python3 -I probe.py <port> <messages>
+import json
+import socket
+import struct
+import sys
+import threading
+import time
+
+PORT = int(sys.argv[1])
+N = int(sys.argv[2])
+SIZE = 200
+PERIOD_NS = 33_333_333
+TCP_CONGESTION = getattr(socket, "TCP_CONGESTION", 13)
+
+
+def set_cc(s, errors, who):
+    try:
+        s.setsockopt(socket.IPPROTO_TCP, TCP_CONGESTION, b"cubic")
+    except OSError as e:
+        errors.append(f"{who}: {e}")
+
+
+def get_cc(s):
+    return s.getsockopt(socket.IPPROTO_TCP, TCP_CONGESTION, 16).split(b"\0", 1)[0].decode()
+
+
+errors = []
+recv_at = [None] * N
+sent_at = [None] * N
+server_cc = []
+
+
+def server(ls):
+    c, _ = ls.accept()
+    set_cc(c, errors, "accepted")
+    server_cc.append(get_cc(c))
+    c.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+    buf = b""
+    got = 0
+    while got < N:
+        d = c.recv(65536)
+        if not d:
+            break
+        now = time.monotonic_ns()
+        buf += d
+        while len(buf) >= SIZE:
+            seq, sent = struct.unpack_from("<QQ", buf, 0)
+            buf = buf[SIZE:]
+            recv_at[seq] = now
+            got += 1
+    c.close()
+
+
+ls = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+ls.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+set_cc(ls, errors, "listener")
+ls.bind(("127.0.0.1", PORT))
+ls.listen(1)
+t = threading.Thread(target=server, args=(ls,))
+t.start()
+cs = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+set_cc(cs, errors, "client")
+cs.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+cs.connect(("127.0.0.1", PORT))
+client_cc = get_cc(cs)
+start = time.monotonic_ns()
+late = []
+for i in range(N):
+    due = start + i * PERIOD_NS
+    while True:
+        now = time.monotonic_ns()
+        if now >= due:
+            break
+        time.sleep(min(0.005, (due - now) / 1e9))
+    stamp = time.monotonic_ns()
+    sent_at[i] = stamp
+    late.append(stamp - due)
+    cs.sendall(struct.pack("<QQ", i, stamp).ljust(SIZE, b"\0"))
+info = cs.getsockopt(socket.IPPROTO_TCP, socket.TCP_INFO, 256)
+cs.close()
+t.join()
+ls.close()
+# struct tcp_info (include/uapi/linux/tcp.h): 8 u8 fields, then u32 rto, ato, snd_mss, rcv_mss, unacked, sacked, lost,
+# retrans, fackets, last_data_sent, last_ack_sent, last_data_recv, last_ack_recv, pmtu, rcv_ssthresh, rtt, rttvar,
+# snd_ssthresh, snd_cwnd, advmss, reordering, rcv_rtt, rcv_space, total_retrans.
+u32 = struct.unpack_from("<24I", info, 8)
+delays = [None if r is None else r - s for r, s in zip(recv_at, sent_at)]
+print(
+    json.dumps(
+        {
+            "port": PORT,
+            "messages": N,
+            "size_bytes": SIZE,
+            "period_ns": PERIOD_NS,
+            "cc_client": client_cc,
+            "cc_server": server_cc[0] if server_cc else None,
+            "cc_errors": errors,
+            "delivered": sum(1 for d in delays if d is not None),
+            "send_late_ns": late,
+            "delay_ns": delays,
+            "tcp_info_client": {
+                "rto_us": u32[0],
+                "rtt_us": u32[15],
+                "rttvar_us": u32[16],
+                "snd_cwnd": u32[18],
+                "total_retrans": u32[23],
+            },
+        }
+    )
+)
diff --git a/spikes/netcode-proof/results/u3c-kernel-check/run.sh b/spikes/netcode-proof/results/u3c-kernel-check/run.sh
new file mode 100755
index 0000000..6dcc06d
--- /dev/null
+++ b/spikes/netcode-proof/results/u3c-kernel-check/run.sh
@@ -0,0 +1,131 @@
+#!/usr/bin/env bash
+# U3c's kernel cross-check (u3c-plan.md 1.6, C11; the advisor's S13): the Linux-faithful TCP model against this
+# container's real kernel on loopback, on the scout's pattern (u3-tcp-stall-probe.py). An evidence run outside
+# check.mjs: it needs root and iptables. The main session runs it after the merge, one evidence run at a time, with
+# nothing else on loopback; a build agent never runs it. R1's S14 check on RS (veth + netem, kernel 6.8) stays the
+# binding one: this container runs 6.18.44, not 6.8, and has no tc.
+#
+# ---- Fixed in writing before any run (C11) ----------------------------------------------------------------------
+# PATTERN. Loopback TCP from a client to a server on PORT (default 47999), 200 B messages every 33,333,333 ns
+#   (30 Hz), TCP_NODELAY on both sockets, TCP_CONGESTION set to cubic on both probe sockets and the listener (this
+#   container defaults to bbr, u3-scout-timing.md:388; if cubic cannot be set, the congestion control read back is
+#   recorded and the verdict says so). 3,000 messages per run, 3 runs. Loss: one iptables rule,
+#     INPUT -i lo -p tcp --dport PORT -m statistic --mode random --probability 0.02 -j DROP
+#   so 2 % of client-to-server packets of the probe's port only (data; the server's ACKs come from PORT and pass).
+#   The model (tcp_model::tests::kernel_cross_check_model, release build): the same pattern, 100 seeds, no jitter,
+#   loss 2 % on the data direction only (the cfg(test) knob with_loss_from), at the loopback's measured RTT: the mean
+#   over the 3 runs of the client's tcpi_rtt read at the run's end.
+# DELAY. A message's delay is its arrival at the server minus its send stamp (both CLOCK_MONOTONIC in one process; the
+#   model: its in-order release minus its write). BASE is the run's median delay (nearest rank, the ceil(n/2)-th).
+# STALL. An episode is a maximal run of consecutive messages each more than HALF A SEND GAP (16,666,666 ns) above
+#   BASE; its length L is its first message's delay minus BASE (the first delayed message per stall, as the scout
+#   counted; the messages queued behind it are the same episode). Why half a gap and not the plan's "more than one
+#   send gap": a RACK repair's L on loopback is one gap plus the RTT (about 0.1-0.2 ms) plus the difference of two
+#   sends' pacing lateness (tens of µs, either sign), so a one-gap threshold sits inside its own noise; half a gap is
+#   far from both the no-loss delays (under 1 ms) and the shortest repair (one gap). The count at one gap is reported
+#   beside it, not judged.
+# REPAIR PATH. An episode is RACK if L <= RTT + gap + 2 ms + J, with RTT the measured RTT above, gap 33,333,333 ns,
+#   2 ms RACK's reorder-timer slop (TCP_TIMEOUT_MIN) and J = 1 ms the jitter allowance for the sender's pacing; else it
+#   is the probe-or-timeout path (on loopback the probe's timer, 2 x srtt + 200 ms with one segment out, is capped by
+#   the RTO, so these are timeouts; the model's own counters tell probe from timeout on the same pattern and are
+#   reported). Two messages lost in a row also land above the bound (their episode is two gaps long), on both sides
+#   alike: the rule is applied to the kernel's and the model's delays by the same code (compare.py), so the shares
+#   compare like with like. J holds only if the probe's send lateness (send stamp minus due time) has p99 <= 1 ms in every kernel
+#   run: else the run is INVALID and the verdict says so.
+# PASS (both):
+#   (1) the RACK-path stall length's p50, kernel (3 runs pooled) against model (100 seeds pooled): within 2 ms;
+#   (2) the timeout-path share: the kernel's count of probe-or-timeout episodes k out of its n episodes lies inside the
+#       99 % two-sided band of Binomial(n, p), p the model's pooled share (the band: the smallest lo and hi with
+#       P(X < lo) <= 0.005 and P(X > hi) <= 0.005).
+#   A MISS goes to the advisor before U3c closes; so does an INVALID run or a run that did not deliver all 3,000.
+# RECORDED: uname -r, CONFIG_HZ (from /proc/config.gz), and the sysctls tcp_recovery, tcp_early_retrans, tcp_sack,
+#   tcp_frto, tcp_rto_min_us, tcp_thin_linear_timeouts, tcp_timestamps, tcp_dsack, tcp_congestion_control,
+#   tcp_available_congestion_control.
+# SAFETY: the rule matches only PORT on lo; it is added before each run and removed after it, and a trap removes any
+#   copy left on every exit; `iptables -S` is saved before and after and must read the same (else exit 3, loudly);
+#   the script refuses to start if a rule on PORT already exists or PORT is in use.
+# ------------------------------------------------------------------------------------------------------------------
+#
+# Use (root, from anywhere; cargo +1.99.1 on PATH; CARGO_TARGET_DIR as the session sets it):
+#   bash spikes/netcode-proof/results/u3c-kernel-check/run.sh [out-dir]
+# Output: out-dir (default: this folder's out-<UTC stamp>/): kernel.txt, iptables-before.txt, iptables-after.txt,
+# kernel-run{1,2,3}.json, model.txt, verdict.txt and verdict.json.
+
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+SPIKE="$(cd "$HERE/../.." && pwd)"
+PORT="${PORT:-47999}"
+MESSAGES=3000
+RUNS=3
+MODEL_RUNS=100
+OUT="${1:-$HERE/out-$(date -u +%Y%m%dT%H%M%SZ)}"
+
+if [ "$(id -u)" -ne 0 ]; then
+  echo "run.sh: needs root for iptables" >&2
+  exit 2
+fi
+command -v iptables >/dev/null || { echo "run.sh: no iptables" >&2; exit 2; }
+command -v python3 >/dev/null || { echo "run.sh: no python3" >&2; exit 2; }
+mkdir -p "$OUT"
+
+RULE=(INPUT -i lo -p tcp --dport "$PORT" -m statistic --mode random --probability 0.02 -j DROP)
+
+iptables -S > "$OUT/iptables-before.txt"
+if grep -q -- "--dport $PORT " "$OUT/iptables-before.txt"; then
+  echo "run.sh: a rule on port $PORT exists already; refusing" >&2
+  exit 2
+fi
+if ! python3 -I -c 'import socket,sys; s=socket.socket(); s.bind(("127.0.0.1", int(sys.argv[1]))); s.close()' "$PORT"; then
+  echo "run.sh: port $PORT is in use; refusing" >&2
+  exit 2
+fi
+
+cleanup() {
+  while iptables -D "${RULE[@]}" 2>/dev/null; do :; done
+  iptables -S > "$OUT/iptables-after.txt"
+  if ! diff -u "$OUT/iptables-before.txt" "$OUT/iptables-after.txt"; then
+    echo "run.sh: iptables -S DIFFERS after the run: check the firewall now" >&2
+    exit 3
+  fi
+}
+trap cleanup EXIT
+trap 'exit 130' INT TERM
+
+{
+  echo "uname_r $(uname -r)"
+  if [ -r /proc/config.gz ]; then
+    echo "config_hz $(zcat /proc/config.gz | grep -E '^CONFIG_HZ=' | cut -d= -f2)"
+  else
+    echo "config_hz unknown"
+  fi
+  for s in tcp_recovery tcp_early_retrans tcp_sack tcp_frto tcp_rto_min_us tcp_thin_linear_timeouts tcp_timestamps \
+           tcp_dsack tcp_congestion_control tcp_available_congestion_control; do
+    if [ -r "/proc/sys/net/ipv4/$s" ]; then
+      echo "$s $(cat "/proc/sys/net/ipv4/$s")"
+    else
+      echo "$s absent"
+    fi
+  done
+  echo "port $PORT"
+  echo "started_utc $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} > "$OUT/kernel.txt"
+cat "$OUT/kernel.txt"
+
+for run in $(seq 1 "$RUNS"); do
+  iptables -A "${RULE[@]}"
+  python3 -I "$HERE/probe.py" "$PORT" "$MESSAGES" > "$OUT/kernel-run$run.json"
+  iptables -D "${RULE[@]}"
+  python3 -I "$HERE/compare.py" summary "$OUT/kernel-run$run.json"
+done
+
+RTT_NS="$(python3 -I "$HERE/compare.py" rtt "$OUT")"
+echo "model at the measured loopback RTT: $RTT_NS ns"
+(
+  cd "$SPIKE"
+  NPT_KC_RTT_NS="$RTT_NS" NPT_KC_MESSAGES="$MESSAGES" NPT_KC_RUNS="$MODEL_RUNS" \
+    cargo +1.99.1 test --release --locked -p npt-net --lib tcp_model::tests::kernel_cross_check_model \
+    -- --ignored --nocapture --exact
+) > "$OUT/model.txt"
+
+python3 -I "$HERE/compare.py" judge "$OUT" | tee "$OUT/verdict.txt"
