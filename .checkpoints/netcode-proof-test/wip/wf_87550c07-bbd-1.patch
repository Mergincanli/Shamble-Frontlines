+/// The message traffic of the burst and replay tests: the client writes the request and then a 60 B frame every
+/// tick, and reads S throughout; the test writes 1,000 B down every tick. Returns once `ticks` have passed.
+async fn traffic(ds: &mut DelayStream<DuplexStream>, client: DuplexStream, ticks: u64) {
+    let (mut cr, mut cw) = tokio::io::split(client);
+    let up = tokio::spawn(async move {
+        cw.write_all(REQUEST).await.expect("the request");
+        let mut iv = tokio::time::interval(Duration::from_nanos(TICK));
+        for _ in 0..ticks {
+            iv.tick().await;
+            cw.write_all(&frame(true, 2, true, &[9; 60], false))
+                .await
+                .expect("a frame");
+        }
+        cw
+    });
+    let rd = tokio::spawn(async move {
+        let mut buf = vec![0u8; 1 << 16];
+        while cr.read(&mut buf).await.is_ok_and(|n| n > 0) {}
+    });
+    let mut iv = tokio::time::interval(Duration::from_nanos(TICK));
+    let mut buf = vec![0u8; 1 << 16];
+    for _ in 0..ticks {
+        iv.tick().await;
+        ds.write_all(&[0x82; 1_000]).await.expect("down");
+        while let Ok(Ok(n)) = tokio::time::timeout(Duration::ZERO, ds.read(&mut buf)).await {
+            if n == 0 {
+                break;
+            }
+        }
+    }
+    let _cw = up.await.expect("the client's writes");
+    rd.abort();
+}
+
+/// C4: a burst added after the wrap loses every transmission inside it, both ways, and nothing outside it is lost
+/// (quiet P2). Refused before the model's now. 60 ticks (2 s), one 600 ms burst.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn an_added_burst_loses_every_transmission_inside_it_both_ways() {
+    let (client, server) = tokio::io::duplex(1 << 20);
+    let mut ds =
+        DelayStream::wrap(server, &cfg(quiet(Profile::p2()), 5), 0, now()).expect("wrapped");
+    let start = now() + 500 * MS;
+    ds.add_burst(start, 600 * MS).expect("added");
+    assert_eq!(
+        ds.add_burst(now().saturating_sub(MS), SEC)
+            .expect_err("refused")
+            .kind(),
+        io::ErrorKind::InvalidInput
+    );
+    traffic(&mut ds, client, 60).await;
+    let (origin, counters, _) = ds.model_state();
+    let (s, e) = (start - origin, start - origin + 600 * MS);
+    let log = ds.sent_log();
+    let mut inside = [0u64; 2];
+    for &(end, _, _, t, lost) in &log {
+        if t >= s && t < e {
+            assert!(lost, "a transmission at {t} inside the burst got through");
+            inside[end] += 1;
+        } else {
+            assert!(
+                !lost,
+                "a transmission at {t} outside the burst was lost (quiet profile)"
+            );
+        }
+    }
+    println!("inside the burst: {inside:?} data transmissions lost (down, up)");
+    assert!(inside[DOWN] > 0 && inside[UP] > 0, "both ways: {inside:?}");
+    assert_eq!([counters[DOWN].lost_burst, counters[UP].lost_burst], inside);
+}
