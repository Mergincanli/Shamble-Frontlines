+/// 1.5's loopback test: TLS 1.3 (tokio-rustls, ring) + DelayStream + tungstenite at P2, 30 Hz both ways for 300 ticks
+/// (10 s; 1,024 B down, 60 B up). Judged on identities: every message arrives in order; the 101 left the model one
+/// delay after the request's release; each message's release is at or after its write plus the profile's least
+/// one-way delay, and its receipt at or after its release (the receipt minus the release is the lateness plus the
+/// rest of the real path: printed); every stall is a first-transmission loss and their count sits in its 99.9 %
+/// two-sided binomial band at 2 %. Lateness printed with condition 10's trigger.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn loopback_tls_tungstenite_at_p2_30_hz_both_ways() {
+    const TICKS: u64 = 300;
+    let c = cfg(Profile::p2(), 21);
+    let request_at = now();
+    let (mut server, mut client, got101, _) = pair(&c, 0).await;
+    let client_task = tokio::spawn(async move {
+        let mut recv = Vec::new();
+        run_ticks(
+            &mut client,
+            TICKS,
+            Duration::from_secs(3),
+            |b| recv.push((unstamp(b), now())),
+            |k, ws| send(ws, stamped(k, 60)),
+        )
+        .await;
+        recv
+    });
+    let mut recv_up = Vec::new();
+    run_ticks(
+        &mut server,
+        TICKS,
+        Duration::from_secs(3),
+        |b| recv_up.push((unstamp(b), now())),
+        |k, ws| send(ws, stamped(k, 1_024)),
+    )
+    .await;
+    let recv_down = client_task.await.expect("the client");
+    let ds = &server.get_ref().io;
+    let logs = ds.logs();
+    let (origin, counters, _) = ds.model_state();
+    let least = c.profile.one_way_ns() - c.profile.half_jitter_ns();
+    // The 101: written after the request's release, released at least one least delay later, received after that.
+    let first = |d: usize| {
+        logs.releases
+            .iter()
+            .find(|r| r.0 == d)
+            .expect("a release")
+            .2
+    };
+    let (req, resp) = (first(UP), first(DOWN));
+    assert!(origin + req >= request_at);
+    assert!(
+        resp >= req + least,
+        "the 101 left the model a delay after the request"
+    );
+    assert!(
+        got101 >= origin + resp,
+        "the client had the 101 only after its release"
+    );
+    for (dir, recv) in [(DOWN, &recv_down), (UP, &recv_up)] {
+        let idx: Vec<u64> = recv.iter().map(|r| r.0.0).collect();
+        assert_eq!(
+            idx,
+            (0..TICKS).collect::<Vec<_>>(),
+            "dir {dir}: every message, in order"
+        );
+        let rel = &logs.messages[dir];
+        assert!(rel.len() as u64 >= TICKS);
+        let mut extra: Vec<u64> = Vec::new();
+        for (k, &((_, wrote), got)) in recv.iter().enumerate() {
+            let r = rel[k];
+            assert!(
+                r >= wrote + least,
+                "dir {dir} message {k}: released before a least delay"
+            );
+            assert!(
+                got >= r,
+                "dir {dir} message {k}: received before its release"
+            );
+            extra.push(got - r);
+        }
+        extra.sort_unstable();
+        let q = |p: usize| extra[(extra.len() * p / 1_000).min(extra.len() - 1)] as f64 / 1e6;
+        println!(
+            "dir {dir}: receipt − release (lateness + TLS, TCP and tungstenite): p50 {:.3} ms p99 {:.3} ms max {:.3} ms",
+            q(500),
+            q(990),
+            q(1_000)
+        );
+        let k = &counters[dir];
+        assert_eq!(
+            k.stalls, k.first_lost,
+            "dir {dir}: every first-transmission loss stalls, nothing else does"
+        );
+        let (lo, hi) = band(k.segments, 0.02, 0.999);
+        println!(
+            "dir {dir}: {} segments, {} stalls (99.9 % band {lo}-{hi}), repairs rack {} probe {} timeout {}",
+            k.segments, k.stalls, k.repairs_rack, k.repairs_probe, k.repairs_timeout
+        );
+        assert!(
+            (lo..=hi).contains(&k.stalls),
+            "dir {dir}: {} stalls outside {lo}-{hi}",
+            k.stalls
+        );
+    }
+    let s = ds.run_summary();
+    for (d, name) in [(DOWN, "down"), (UP, "up")] {
+        let get = |i: usize| value(&s, names::LATE[d][i]);
+        let sum = Summary {
+            n: get(0),
+            p50: get(1),
+            p99: get(2),
+            p999: get(3),
+            max: get(4),
+            excess: get(5),
+            over: get(6),
+        };
+        println!(
+            "{}",
+            late_line(&format!("lateness {name} (P2, 30 Hz, 10 s)"), &sum)
+        );
+    }
+}
