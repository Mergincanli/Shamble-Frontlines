+/// One case of the limits: after the request (unless `head` replaces it), `bad`; returns the close reason, the up
+/// model bytes written, and whether the client side saw S closed.
+async fn limit_case(
+    cfg: L2Config,
+    head: Option<Vec<u8>>,
+    bad: Vec<u8>,
+) -> (Option<Reason>, Vec<u64>, bool) {
+    let (mut client, server) = tokio::io::duplex(1 << 16);
+    let mut ds = DelayStream::wrap(server, &cfg, 0, now()).expect("wrapped");
+    let first = head.unwrap_or_else(|| REQUEST.to_vec());
+    client.write_all(&first).await.expect("the head");
+    client.write_all(&bad).await.expect("the frame");
+    let done = until(Duration::from_secs(3), || ds.probe().0).await;
+    let (_, closed, _, _) = ds.probe();
+    let ups = writes(&ds.logs(), UP);
+    // S closed: the client's read ends.
+    let mut buf = [0u8; 64];
+    let eof = done
+        && matches!(
+            tokio::time::timeout(Duration::from_secs(2), client.read(&mut buf)).await,
+            Ok(Ok(0)) | Ok(Err(_))
+        );
+    if closed.is_some() {
+        // tungstenite's side reads the request's release, then the close.
+        let mut sink = vec![0u8; 16_384];
+        let mut err = None;
+        for _ in 0..100 {
+            match tokio::time::timeout(Duration::from_secs(2), ds.read(&mut sink)).await {
+                Ok(Ok(0)) => break,
+                Ok(Ok(_)) => {}
+                Ok(Err(e)) => {
+                    err = Some(e.kind());
+                    break;
+                }
+                Err(_) => break,
+            }
+        }
+        assert_eq!(err, Some(io::ErrorKind::InvalidData));
+    }
+    (closed, ups, eof)
+}
+
+/// C6: each limit closes the connection, counted by reason, before any of the bad frame's payload enters the model
+/// (only the request's record was written up), and S is dropped. Bite: with the limit raised the same frame's payload
+/// enters the model.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn each_limit_closes_before_buffering_and_is_counted() {
+    let c = cfg(quiet(Profile::p1()), 4);
+    let request = REQUEST.len() as u64 + OVERHEAD;
+    let mut top = frame(true, 2, true, &[], true);
+    top[2] = 0x80;
+    let cases: Vec<(Option<Vec<u8>>, Vec<u8>, Reason)> = vec![
+        (None, frame(true, 2, true, &[1; 514], false), Reason::Frame),
+        (
+            None,
+            [
+                frame(false, 2, true, &[1; 300], false),
+                frame(true, 0, true, &[1; 214], false),
+            ]
+            .concat(),
+            Reason::Message,
+        ),
+        (
+            None,
+            frame(true, 2, false, &[1; 10], false),
+            Reason::Unmasked,
+        ),
+        (
+            None,
+            frame(true, 9, true, &[1; 126], false),
+            Reason::Control,
+        ),
+        (None, frame(false, 9, true, &[1; 5], false), Reason::Control),
+        (None, top, Reason::Length),
+        (Some(vec![b'a'; 9_000]), Vec::new(), Reason::Request),
+    ];
+    for (head, bad, why) in cases {
+        let (closed, ups, eof) = limit_case(c.clone(), head.clone(), bad.clone()).await;
+        assert_eq!(closed, Some(why), "{why:?}");
+        let before: u64 = match why {
+            Reason::Request => 0,
+            // The fragmented message's first frame was within the limit and entered.
+            Reason::Message => request + 2 + 2 + 4 + 300 + OVERHEAD,
+            _ => request,
+        };
+        assert_eq!(
+            ups.iter().sum::<u64>(),
+            before,
+            "{why:?}: nothing of the bad frame entered"
+        );
+        assert!(eof, "{why:?}: S was dropped");
+    }
+    // The bite: the limit raised to 16,000 B lets the 514 B frame's payload into the model.
+    let mut open = c.clone();
+    open.ws_max_message_bytes = 16_000;
+    let (closed, ups, _) = limit_case(open, None, frame(true, 2, true, &[1; 514], false)).await;
+    assert_eq!(closed, None);
+    assert!(
+        ups.iter().sum::<u64>() > request,
+        "the payload entered: {ups:?}"
+    );
+}
