+/// C3: dropping DelayStream ends the pump and drops S at once (the client side reads EOF); its clock entry is gone.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn dropping_it_ends_the_pump_and_drops_s() {
+    let (mut client, server) = tokio::io::duplex(1 << 16);
+    let mut ds = DelayStream::wrap(server, &cfg(fixed(2_000), 6), 0, now()).expect("wrapped");
+    ds.write_all(&[0x82; 4_000]).await.expect("written");
+    let (sh, key) = (Arc::clone(&ds.sh), ds.clock_key());
+    assert!(
+        until(Duration::from_secs(2), || delay_clock::clock()
+            .census(key)
+            .3)
+        .await
+    );
+    drop(ds);
+    assert!(until(Duration::from_secs(2), || sh.lock().pump_done).await);
+    let mut buf = [0u8; 64];
+    let n = tokio::time::timeout(Duration::from_secs(2), client.read(&mut buf))
+        .await
+        .expect("S closed")
+        .expect("read");
+    assert_eq!(n, 0, "nothing was released (2 s round trip), and S is gone");
+    assert!(!delay_clock::clock().census(key).3);
+}
