+    // A real session negotiates TLS 1.3 and http/1.1.
+    let (_s, _c, _, negotiated) = pair(&cfg(quiet(Profile::p1()), 12), 0).await;
+    assert_eq!(
+        negotiated,
+        "Some(TLSv1_3) Some([104, 116, 116, 112, 47, 49, 46, 49])"
