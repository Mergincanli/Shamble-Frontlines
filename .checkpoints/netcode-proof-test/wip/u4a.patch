+fn input_bytes(commands: &[Command]) -> Vec<u8> {
+    encoded(&Message::Input(Input {
+        ack_tick: 65_535,
+        ack_groups: 0xff,
+        commands: commands.to_vec(),
+    }))
+    .expect("encodes")
+}
