+/// Whether `text` shows `byte` in decimal or in hex.
+fn shows(text: &str, byte: u8) -> bool {
+    let text = text.to_lowercase();
+    text.contains(&byte.to_string()) || text.contains(&format!("{byte:02x}"))
+}
