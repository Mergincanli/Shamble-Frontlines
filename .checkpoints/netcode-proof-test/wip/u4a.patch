+/// The doc's words for npt-proto's channel and direction values.
+fn channel_word(c: Channel) -> &'static str {
+    match c {
+        Channel::Datagram => "datagram",
+        Channel::Control => "control stream",
+        Channel::FullState => "full-state stream",
+    }
