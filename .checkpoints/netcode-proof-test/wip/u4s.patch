@@ -0,0 +1,36 @@
+//! npt-client's planted defects (bites builds only; u4-build-plan.md §4.14: each planted where its code lives). U4s
+//! plants PM-0001-17/client-rounding's id here, at the client's call into the wire grid; U4e's endpoint adds the rest.
+#![cfg(feature = "bites")]
+
+use npt_sim::grid::{Config, POSITION_XY};
+
+#[test]
+fn pm_0001_17_client_rounding_is_planted_here_alone_and_moves_about_half_of_all_positions() {
+    let id = "PM-0001-17/client-rounding";
+    assert_eq!(npt_client::BITES, [id]);
+    let bitten = npt_client::grid_with_bite(id).expect("the client plants -17's");
+    assert_eq!(bitten, Config::floor_rounding());
+    // No id of another site: the own-copy snap's (-41), the encoder's (-57), an unknown one.
+    for other in [
+        "PM-0001-41/server-quant-differs",
+        "PM-0001-57/pos-4cm",
+        "PM-0001-57/yaw-12bit",
+        "PM-0001-57/pitch-8bit",
+        "PM-0001-17/no-such-bite",
+    ] {
+        assert!(npt_client::grid_with_bite(other).is_none(), "{other}");
+    }
+    // u4-build-plan.md §4.14's unit proof: the floor variant differs from the wire grid on about half of all position
+    // values (from 0 to 20 m, in sixteenths of a centimetre).
+    let wire = Config::default();
+    let (mut differ, mut all) = (0u32, 0u32);
+    for k in 0..2_000 {
+        for sixteenth in 0..16 {
+            let x = ((f64::from(k) + f64::from(sixteenth) / 16.0) / 100.0) as f32;
+            differ += u32::from(bitten.to_grid(POSITION_XY, x) != wire.to_grid(POSITION_XY, x));
+            all += 1;
+        }
+    }
+    let share = f64::from(differ) / f64::from(all);
+    assert!((0.45..=0.6).contains(&share), "{share}");
+}
diff --git a/spikes/netcode-proof/crates/sim/src/grid.rs b/spikes/netcode-proof/crates/sim/src/grid.rs
new file mode 100644
index 0000000..a5e1709
--- /dev/null
+++ b/spikes/netcode-proof/crates/sim/src/grid.rs
@@ -0,0 +1,201 @@
+//! The wire grid (u4-build-plan.md §4.4; the advisor's Q23 ruling): one function each way between the sim's values and
+//! the integers the wire carries, per field kind. The sim's own-copy snap, the room's encoder and the client all call
+//! it, so the three agree bit for bit; npt-proto's `Quant` packs its integers into their widths.
+//!
+//! - **To the grid** ([`Config::to_grid`]): one multiply by the field's scale, in f64 (exact for the centimetre fields:
+//!   an f32 times 100 needs at most 31 significant bits), then the nearest integer, **a tie rounding away from zero**
+//!   (`f64::round`, on ADR 0004's float allow-list), then integers only: a range field saturates at its ends, yaw wraps
+//!   around the turn. NaN maps to 0, an infinity to the end of a range field it points past and to one fixed yaw
+//!   integer; the sim never holds either (plan §4.5), and no input of any kind panics.
+//! - **From the grid** ([`Config::from_grid`]): the integer divided by the same scale in f64, rounded once to f32. Every
+//!   integer of a field comes back from the grid as itself (the tests run all of them).
+//!
+//! Positions are metres, angles radians, velocities metres per second. A field's integers are `min()..=max()`, which
+//! fit in `bits()` bits. [`Field::integer`] describes the record fields the sim holds as integers (flag bits, a tick),
+//! so one type names every field of an entity's layout (`EntityKind::layout`).
+//!
+//! **Fixed for wave 1:** the five field constants below are fixed as built while U4a (npt-proto's `Quant` and field
+//! table) and U4d (npt-sim) build in parallel; [`VELOCITY`]'s step included. A change to any of them waits for U4d's
+//! merge and goes through its own change, so both lanes build against one grid.
+//!
+//! The grid's one planted defect, bites builds only, is the float side's: `Config::floor_rounding`, chosen through
+//! the [`Config`] value a caller passes, never a static (u4-build-plan.md §4.11). It carries no bite id: each bite id
+//! lives in the crate of its site, which maps it to the defect (u4-build-plan.md §4.14: "planted where its code
+//! lives"): npt-client's PM-0001-17/client-rounding (`npt_client::BITES`), the authority step's own-copy snap's
+//! PM-0001-41/server-quant-differs (`npt_sim::OWN_COPY_SNAP_BITES`). PM-0001-57's coarsening bites act on integers, in
+//! npt-proto's `Quant` (U4a).
+
+use core::f64::consts::{FRAC_PI_2, TAU};
+
+/// Which values a field carries; part of a field's identity, so two fields of one range but different kinds differ.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Kind {
+    Position,
+    Yaw,
+    Pitch,
+    Velocity,
+    /// A value the sim holds as an integer: no scale.
+    Integer,
+}
+
+/// One field kind of the wire grid: its scale (grid steps per sim unit), its integers and its width.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Field {
+    kind: Kind,
+    scale: f64,
+    min: i32,
+    max: i32,
+    bits: u32,
+    wraps: bool,
+}
+
+impl Field {
+    /// A field the sim holds as an integer (flag bits, a tick by its u32 bits, a weapon id): no scale, the integers
+    /// `min..=max`, in the fewest bits that hold them, never wrapping. Its value is never a float, so an entity
+    /// record's `raw` is 0 for it.
+    ///
+    /// # Panics
+    /// If `min` is not below `max` (a field of one value carries nothing); in a const, a compile error.
+    pub const fn integer(min: i32, max: i32) -> Field {
+        assert!(min < max, "an integer field holds at least two values");
+        let span = (max as i64 - min as i64) as u64;
+        Field {
+            kind: Kind::Integer,
+            scale: 1.0,
+            min,
+            max,
+            bits: u64::BITS - span.leading_zeros(),
+            wraps: false,
+        }
+    }
+
+    /// The field's lowest integer.
+    pub const fn min(self) -> i32 {
+        self.min
+    }
+
+    /// The field's highest integer.
+    pub const fn max(self) -> i32 {
+        self.max
+    }
+
+    /// The field's width on the wire, in bits.
+    pub const fn bits(self) -> u32 {
+        self.bits
+    }
+
+    /// Whether the field wraps around (yaw) rather than saturating at its ends.
+    pub const fn wraps(self) -> bool {
+        self.wraps
+    }
+
+    /// An integer on the grid's line brought into the field: wrapped around the turn (an integer `rem_euclid` over a
+    /// power-of-two span, never a float one), or saturated at the field's ends.
+    fn fit(self, k: i64) -> i32 {
+        let (min, max) = (i64::from(self.min), i64::from(self.max));
+        let k = if self.wraps {
+            k.wrapping_sub(min).rem_euclid(max - min + 1) + min
+        } else {
+            k.clamp(min, max)
+        };
+        k as i32
+    }
+}
+
+/// Horizontal position (x and y), metres: 1 cm steps in 16 bits, -327.68 m to 327.67 m (ADR 0001 part 6, E3).
+pub const POSITION_XY: Field = Field {
+    kind: Kind::Position,
+    scale: 100.0,
+    min: -32_768,
+    max: 32_767,
+    bits: 16,
+    wraps: false,
+};
+
+/// Height (z), metres: 1 cm steps in 12 bits, 0 to 40.95 m (ADR 0001 part 6, E3).
+pub const POSITION_Z: Field = Field {
+    kind: Kind::Position,
+    scale: 100.0,
+    min: 0,
+    max: 4_095,
+    bits: 12,
+    wraps: false,
+};
+
+/// Yaw, radians: 16 bits over the whole turn (steps of about 0.0055 degrees), the integers -32,768 (-π) to 32,767; it
+/// wraps, so π and -π are one integer (ADR 0001 part 6, E3; PM-0001-57's bound is 0.01 degrees).
+pub const YAW: Field = Field {
+    kind: Kind::Yaw,
+    scale: 65_536.0 / TAU,
+    min: -32_768,
+    max: 32_767,
+    bits: 16,
+    wraps: true,
+};
+
+/// Pitch, radians: 10 bits over ±90 degrees, the integers -511 to 511, so both ends are exact (steps of about 0.176
+/// degrees, inside PM-0001-57's one 0.18 degree step). The 10-bit code -512 is not a pitch.
+pub const PITCH: Field = Field {
+    kind: Kind::Pitch,
+    scale: 511.0 / FRAC_PI_2,
+    min: -511,
+    max: 511,
+    bits: 10,
+    wraps: false,
+};
+
+/// Velocity, metres per second: 1 cm/s steps in 16 bits, -327.68 to 327.67 m/s. u4-build-plan.md §4.4 left velocity's
+/// step to U4a's field table, and the own-copy snap needs one now: this step is fixed for wave 1 as built (the module
+/// text above), so U4a's table states it as given; a different step waits for U4d's merge and changes only this
+/// constant.
+pub const VELOCITY: Field = Field {
+    kind: Kind::Velocity,
+    scale: 100.0,
+    min: -32_768,
+    max: 32_767,
+    bits: 16,
+    wraps: false,
+};
+
+/// The grid a caller uses: in a measured build always the wire grid; in a bites build it may hold the grid's one
+/// planted defect, `Config::floor_rounding`, for that caller alone.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Config {
+    /// Rounds down in place of to the nearest (bites builds only).
+    #[cfg(feature = "bites")]
+    floor: bool,
+}
+
+impl Config {
+    /// `x` on the field's grid: one scale multiply, the nearest integer (a tie away from zero), then the field's
+    /// range in integers.
+    pub fn to_grid(self, field: Field, x: f32) -> i32 {
+        let scaled = f64::from(x) * field.scale;
+        #[cfg(feature = "bites")]
+        if self.floor {
+            return field.fit(scaled.floor() as i64);
+        }
+        field.fit(scaled.round() as i64)
+    }
+
+    /// The value of the field's integer `k`: `k` over the field's scale, rounded once to f32.
+    pub fn from_grid(self, field: Field, k: i32) -> f32 {
+        (f64::from(k) / field.scale) as f32
+    }
+
+    /// `x` snapped to the field's grid: [`Config::from_grid`] of [`Config::to_grid`]. The sim's own-copy snap
+    /// (the advisor's Q23 ruling).
+    pub fn snap(self, field: Field, x: f32) -> f32 {
+        self.from_grid(field, self.to_grid(field, x))
+    }
+}
+
+#[cfg(feature = "bites")]
+impl Config {
+    /// The grid's one planted defect (bites builds only): [`Config::to_grid`] rounds down in place of to the nearest,
+    /// which moves about half of all values one step off the wire grid; [`Config::from_grid`] is unchanged. It names
+    /// no bite: the sites that plant it map their own ids to it (the module text).
+    pub const fn floor_rounding() -> Config {
+        Config { floor: true }
+    }
+}
diff --git a/spikes/netcode-proof/crates/sim/src/history.rs b/spikes/netcode-proof/crates/sim/src/history.rs
new file mode 100644
index 0000000..ae1cbf5
--- /dev/null
+++ b/spikes/netcode-proof/crates/sim/src/history.rs
@@ -0,0 +1,98 @@
+//! The ring of past hit volumes (u4-build-plan.md §4.2, §4.9; the advisor's Q2 ruling).
+
+use crate::seam::HitVolumes;
+
+/// A fixed ring of [`HitVolumes`], one entry per tick, oldest evicted. The room owns its instance, pushes
+/// `world.hit_volumes()` after each step and lends it to the next; the replay driver does the same, so a recording
+/// needs no volumes. Its span is set at construction in milliseconds (U4h's test cap plus its margin:
+/// u4-build-plan.md §4.9), turned into ticks by [`crate::ticks_for_ms`] alone, so no tick count is ever written for it
+/// (A5); it never changes.
+#[derive(Clone, Debug)]
+pub struct HitHistory {
+    /// The entries, allocated once; until the ring is full they are in push order.
+    slots: Vec<HitVolumes>,
+    /// Where the next push goes once the ring is full: the oldest entry.
+    next: usize,
+    capacity: usize,
+}
+
+impl HitHistory {
+    /// An empty ring covering `span_ms` milliseconds: [`crate::ticks_for_ms`]`(span_ms)` ticks, rounded up, so any span
+    /// above 0 holds at least one tick. `None` for a span of 0 ms, which would hold none.
+    pub fn for_ms(span_ms: u32) -> Option<HitHistory> {
+        let capacity = crate::ticks_for_ms(span_ms) as usize;
+        if capacity == 0 {
+            return None;
+        }
+        Some(HitHistory {
+            slots: Vec::with_capacity(capacity),
+            next: 0,
+            capacity,
+        })
+    }
+
+    /// The ticks the ring holds when full.
+    pub fn capacity(&self) -> u32 {
+        self.capacity as u32
+    }
+
+    /// The ticks it holds now.
+    pub fn len(&self) -> u32 {
+        self.slots.len() as u32
+    }
+
+    /// Whether it holds no tick yet.
+    pub fn is_empty(&self) -> bool {
+        self.slots.is_empty()
+    }
+
+    /// Copies one tick's volumes in as the newest, evicting the oldest once the ring is full. Ticks come one at a time,
+    /// in order. A full ring copies into the evicted entry with `clone_from`, so volumes whose `Clone` implements it
+    /// field by field reuse that entry's storage.
+    pub fn push(&mut self, volumes: &HitVolumes) {
+        debug_assert!(
+            self.newest()
+                .is_none_or(|v| volumes.tick == v.tick.wrapping_add(1)),
+            "hit volumes are pushed one tick at a time, in order"
+        );
+        if self.slots.len() < self.capacity {
+            self.slots.push(volumes.clone());
+        } else {
+            self.slots[self.next].clone_from(volumes);
+        }
+        self.next += 1;
+        if self.next == self.capacity {
+            self.next = 0;
+        }
+    }
+
+    /// The volumes of `tick`, if the ring holds it.
+    pub fn get(&self, tick: u32) -> Option<&HitVolumes> {
+        let newest = self.newest_index()?;
+        let age = self.slots[newest].tick.wrapping_sub(tick) as usize;
+        if age >= self.slots.len() {
+            return None;
+        }
+        let at = if age <= newest {
+            newest - age
+        } else {
+            newest + self.capacity - age
+        };
+        let volumes = &self.slots[at];
+        (volumes.tick == tick).then_some(volumes)
+    }
+
+    fn newest(&self) -> Option<&HitVolumes> {
+        self.newest_index().map(|i| &self.slots[i])
+    }
+
+    fn newest_index(&self) -> Option<usize> {
+        if self.slots.is_empty() {
+            None
+        } else if self.next == 0 {
+            Some(self.slots.len() - 1)
+        } else {
+            Some(self.next - 1)
+        }
+    }
+}
diff --git a/spikes/netcode-proof/crates/sim/src/seam.rs b/spikes/netcode-proof/crates/sim/src/seam.rs
new file mode 100644
index 0000000..17b8b63
--- /dev/null
+++ b/spikes/netcode-proof/crates/sim/src/seam.rs
@@ -0,0 +1,287 @@
+//! The seam between the room and the sim (u4-build-plan.md §4.2; plan §4.6; the advisor's Q1 and Q2 rulings): one
+//! trait, [`SimCore`], with one implementation (`World`, built in U4d), and the plain-data types that cross it.
+//!
+//! npt-room is generic over `SimCore` and owns the [`HitHistory`] it lends to each step. Everything the room builds or
+//! reads here is integers (npt-room is float-free: u4-build-plan.md §4.11), and a recording holds the input field by
+//! field (§4.15). U4d's `World` adds what only it decides: the volumes inside [`HitVolumes`], and the spawns,
+//! teleports and scripted attribute changes that §4.2 also routes through [`TickInput`].
+
+use crate::grid::{Field, PITCH, POSITION_XY, POSITION_Z, VELOCITY, YAW};
+use crate::history::HitHistory;
+
+/// One soldier's command for one tick, as the room accepted it: the decoded `Input` command after the room's checks
+/// (plan §4.4), and what a recording holds for it (u4-build-plan.md §4.15). Integers only.
+///
+/// **What the sim reads:** `slot`, `seq`, `buttons`, `presses`, `move_xy` and `aim`, and nothing else. `tick`,
+/// `view_tick` and `view_fraction` are what the client claimed: they belong to the room (its strictly-newer tick check
+/// and `rewind_at`) and to the recording (-30's pre-check re-encodes them as `Input`: u4-build-plan.md §4.15). For lag
+/// compensation the sim uses the command's [`Rewind`], the view time the room accepted, never the claimed one (the
+/// advisor's condition 1: the sim keeps what the server accepted), so two commands that differ only in these three
+/// fields step to equal state hashes (U4d's test).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Command {
+    /// The soldier's slot.
+    pub slot: u8,
+    /// The tick the client stamped the command for: the room's and the recording's, never read by the sim.
+    pub tick: u32,
+    /// The command's sequence number (16 bits, compared wrap-aware: PM-0001-58).
+    pub seq: u16,
+    /// The buttons held, one bit each.
+    pub buttons: u16,
+    /// Each pressable button's running press counter (wrapping: PM-0001-58); the sim takes press edges from them.
+    pub presses: [u8; 4],
+    /// The move vector, each component in -127..=127 (127 is full speed); the room has checked x² + y² ≤ 127².
+    pub move_xy: [i8; 2],
+    /// The aim point in the position grid's integers (cm): [`crate::grid::POSITION_XY`] for x and y,
+    /// [`crate::grid::POSITION_Z`] for z. The sim clamps a point beyond the weapon's reach (§4.2).
+    pub aim: [i32; 3],
+    /// The client's view time as the command claims it: the tick of the older snapshot it drew ...
+    pub view_tick: u32,
+    /// ... and the blend from that tick toward the next, in 256ths. The room turns the pair into a [`Rewind`] (or
+    /// replaces it by its estimate); the sim never reads either.
+    pub view_fraction: u8,
+}
+
+/// R-10's two cover variants (OQ-0001-9; plan.md:1382): the state a lag-compensated shot sees cover items in.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CoverVariant {
+    /// Doors, the wall stand-in and vehicle parts rewound with the victim, to the shooter's view time.
+    Rewound,
+    /// Cover items as they are at the tick the shot runs.
+    Present,
+}
+
+/// How a lag-compensated shot sees the past (u4-build-plan.md §4.2; the advisor's Q2 ruling): the room's `rewind_at`
+/// turns a command's accepted view time into these integers, and the sim blends the two history ticks linearly, as the
+/// client's Interp drew them. It rides with each command that holds fire or presses it.
+///
+/// **A tick the lent ring does not hold:** the ring lacks `tick_a`, or `fraction` is above 0 and the ring lacks
+/// `tick_a + 1` (wrapping), the tick the blend reaches toward; at `fraction` 0 only `tick_a` is read. Such a Rewind is
+/// refused and counted by the sim, in [`InputReports::rewind_outside`] and never in the hash.
+///
+/// **A refused Rewind behaves as `None`:** the command steps exactly as the same command with no Rewind, on that tick
+/// and after (D-10's twin is the forged command with only the refused part removed, so the two must give equal state
+/// hashes). What a command that holds or presses fire does without a Rewind is `World`'s rule, U4d's; it is one rule
+/// for both.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Rewind {
+    /// The older of the two history ticks the view time falls between.
+    pub tick_a: u32,
+    /// The blend from `tick_a` toward `tick_a + 1`, in 256ths (0 is `tick_a` itself).
+    pub fraction: u8,
+    /// Which state the shot's cover items take.
+    pub cover: CoverVariant,
+}
+
+/// Everything one step takes from outside the sim (u4-build-plan.md §4.2, §4.15). The room fills one per tick and the
+/// replay driver reads one per tick from a recording.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct TickInput {
+    /// The tick this input steps: the world's next tick.
+    pub tick: u32,
+    /// The accepted commands, each with the [`Rewind`] the room computed for it (present when the command holds or
+    /// presses fire), in **the canonical order**: slot ascending, then, within one slot, command tick strictly
+    /// ascending, compared wrap-aware (`b` comes after `a` when `b.wrapping_sub(a) as i32 > 0`). The room sorts into
+    /// it, a recording holds it and the sim runs the commands in it, so legs that received the same commands in
+    /// different arrival orders step alike (-30's per-tick hash comparison). U4d's `World` debug-asserts it.
+    pub commands: Vec<(Command, Option<Rewind>)>,
+}
+
+/// What kind of entity a record describes; an entity's id is its kind, index and generation (ADR 0001 part 6).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub enum EntityKind {
+    Soldier,
+    Vehicle,
+    /// One part of a vehicle, as its own record (the stress scene's 4 large vehicles have at least 20: §4.13).
+    VehiclePart,
+    /// A trajectory record (type, start tick, start position, velocity, fuse: ADR 0001 part 6).
+    Projectile,
+    Door,
+    /// The destructible-wall stand-in (R-10).
+    Wall,
+    /// One of S1's effect rows (8 per soldier, §4.13), in its owner's own-state section.
+    Effect,
+}
+
+/// Eight flag bits, for stance and actions (the catalogue's remote-soldier row).
+const FLAGS: Field = Field::integer(0, 255);
+/// A tick by its u32 bits, held as i32 (a projectile's start tick).
+const TICK: Field = Field::integer(i32::MIN, i32::MAX);
+/// A door's state: 0 closed, 1 open.
+const OPEN: Field = Field::integer(0, 1);
+/// A position: x, y, z.
+const XYZ: [Field; 3] = [POSITION_XY, POSITION_XY, POSITION_Z];
+const SOLDIER: [Field; 9] = [
+    XYZ[0], XYZ[1], XYZ[2], YAW, PITCH, VELOCITY, VELOCITY, VELOCITY, FLAGS,
+];
+/// A transform on the ground: x, y, z and yaw (a hull, a part).
+const TRANSFORM: [Field; 4] = [XYZ[0], XYZ[1], XYZ[2], YAW];
+const PROJECTILE: [Field; 7] = [TICK, XYZ[0], XYZ[1], XYZ[2], VELOCITY, VELOCITY, VELOCITY];
+const DOOR: [Field; 1] = [OPEN];
+
+impl EntityKind {
+    /// Every kind, in declaration order: npt-proto builds its field-group table for each.
+    pub const ALL: [EntityKind; 7] = [
+        EntityKind::Soldier,
+        EntityKind::Vehicle,
+        EntityKind::VehiclePart,
+        EntityKind::Projectile,
+        EntityKind::Door,
+        EntityKind::Wall,
+        EntityKind::Effect,
+    ];
+
+    /// The kind's field layout: what each entry of an [`EntityRecord`]'s `grid` and `raw` holds, in order. The one
+    /// home of that order (the arch review's F2): U4d's `World` fills records in it, and npt-proto's field-group table
+    /// and its `EntityRecord` ↔ wire mapping are built from this function, never from a copy, so a change here needs
+    /// no edit in npt-proto.
+    ///
+    /// U4s's lists are the catalogue's spatial rows (docs/design/netcode-proof-messages.md §3): a soldier's position,
+    /// yaw, pitch, velocity and 8 flag bits; a hull's and a part's transform; a projectile's start tick, start position
+    /// and velocity; a door's state. U4d completes them (health, weapon id and state, a projectile's type and fuse, the
+    /// wall's and the effect rows' fields) with the grid's fields and [`Field::integer`], within
+    /// [`EntityRecord::FIELDS`] (a const assert below holds every layout to it).
+    pub const fn layout(self) -> &'static [Field] {
+        match self {
+            EntityKind::Soldier => &SOLDIER,
+            EntityKind::Vehicle | EntityKind::VehiclePart => &TRANSFORM,
+            EntityKind::Projectile => &PROJECTILE,
+            EntityKind::Door => &DOOR,
+            EntityKind::Wall | EntityKind::Effect => &[],
+        }
+    }
+}
+
+/// One entity's snapshot fields, read out after a step (u4-build-plan.md §4.2): the encoder codes them, npt-proto
+/// maps them to and from the wire (one home, §4.4), and -57's log takes the pre-grid values. The room copies `raw` and
+/// never computes with it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct EntityRecord {
+    pub kind: EntityKind,
+    /// The entity's index among its kind (a soldier's slot, a pool index).
+    pub index: u16,
+    /// Its generation: a change is a removal and an addition (ADR 0001 part 6).
+    pub generation: u16,
+    /// The area it is in (the static graph's numbering), for interest.
+    pub area: u16,
+    /// Its fields as integers, in its kind's [`EntityKind::layout`] order; entries past the layout 0. A float field's
+    /// entry is the **wire** grid's `Config::default().to_grid(field, value)` of the value `raw` holds, computed apart
+    /// from the own-copy snap and its own [`crate::grid::Config`], so a snap that rounds otherwise
+    /// (PM-0001-41/server-quant-differs) shows as this entry differing from the snapped copy; an integer field's entry
+    /// is the integer itself, a tick by its u32 bits.
+    pub grid: [i32; EntityRecord::FIELDS],
+    /// The same fields' values **before the own-copy snap**, each f32 by its bits (`to_bits`), for -57's log, which
+    /// pairs them with what the client decoded (u4-build-plan.md §4.6, T20); 0 for a field that is not a float.
+    pub raw: [u32; EntityRecord::FIELDS],
+}
+
+impl EntityRecord {
+    /// Fields per record: U4d's full soldier (position, yaw, pitch, velocity, health, flags, weapon and weapon state)
+    /// fills 12.
+    pub const FIELDS: usize = 12;
+}
+
+// Every kind's layout fits a record.
+const _: () = {
+    let mut i = 0;
+    while i < EntityKind::ALL.len() {
+        assert!(
+            EntityKind::ALL[i].layout().len() <= EntityRecord::FIELDS,
+            "every kind's layout fits EntityRecord::FIELDS"
+        );
+        i += 1;
+    }
+};
+
+/// One tick's hit volumes for lag compensation (u4-build-plan.md §4.2, §4.9), as the world reads them out after a
+/// step: the room pushes them into its [`HitHistory`], and the replay driver does the same. U4s fixes their tick; the
+/// volumes themselves (soldiers, vehicle parts and R-10's cover items) are `World`'s, added in U4d with the hitscan,
+/// as plain data the room copies and never reads.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct HitVolumes {
+    /// The tick the volumes are from.
+    pub tick: u32,
+}
+
+/// Each portal of the static graph, open or closed (u4-build-plan.md §4.2, A2): the room's AreaFlood re-floods when
+/// these change, with no float and no sim internals.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct PortalStates {
+    /// One entry per portal, in the static graph's order: true when open.
+    pub open: Vec<bool>,
+}
+
+/// One event of a step, in the tick's event list (u4-build-plan.md §4.2): the list is state and in the hash
+/// (ADR 0004:544-561). The room numbers and queues them per client (§4.7). Clamp reports and refusals are never events
+/// ([`InputReports`]).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SimEvent {
+    /// Cosmetic: `slot` fired the shot of its command `seq`; sent once, never to the shooter's own client
+    /// (ADR 0001 part 6).
+    Shot { slot: u8, seq: u16 },
+    /// Gameplay: the shot of `shooter`'s command `seq` hit soldier `victim` for `damage`; resent until acknowledged,
+    /// and the shooter's hit confirmation.
+    Hit {
+        shooter: u8,
+        seq: u16,
+        victim: u8,
+        damage: u16,
+    },
+    /// Gameplay: `killer` killed `victim`.
+    Kill { killer: u8, victim: u8 },
+}
+
+/// A point beyond the weapon's reach, moved along its own ray to exactly the reach and snapped to the grid
+/// (u4-build-plan.md §4.2, Q25): never refused, never counted as a refusal, never an event, never in the hash.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ClampReport {
+    pub slot: u8,
+    pub seq: u16,
+    /// The point the shot used, in the position grid's integers (cm).
+    pub point: [i32; 3],
+}
+
+/// What the sim did with refused or clamped input, outside `state_hash` and outside the hashed event list (the
+/// advisor's condition 1): the room reads it through [`SimCore::reports`] alone and logs it. Refused input leaves no
+/// trace in the state.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct InputReports {
+    /// This tick's clamp reports, in the order the shots ran.
+    pub clamps: Vec<ClampReport>,
+    /// Running refusal counters since the world began, one per kind: a fire edge in the weapon's cooldown ...
+    pub cooldown: u64,
+    /// ... a fire edge with no ammunition ...
+    pub ammunition: u64,
+    /// ... a reload edge the weapon's state refuses ...
+    pub reload: u64,
+    /// ... a non-finite command component: always 0 while [`Command`] holds integers only, since no integer is
+    /// non-finite; kept because u4-build-plan.md §4.2 lists the kind and D-4 tests it (whether to drop both is the
+    /// advisor's question) ...
+    pub non_finite: u64,
+    /// ... a [`Rewind`] naming a tick the lent ring does not hold ...
+    pub rewind_outside: u64,
+    /// ... and an action refused because its pool was full (pools have fixed capacity: §4.2).
+    pub pool_full: u64,
+}
+
+/// The seam: the one trait the room drives the sim through (u4-build-plan.md §4.2). One implementation, `World`.
+pub trait SimCore {
+    /// Runs one tick on `input`, the room's ring of past hit volumes lent for its lag-compensated shots; returns the
+    /// tick's event list.
+    fn step(&mut self, input: &TickInput, history: &HitHistory) -> &[SimEvent];
+
+    /// The state's canonical hash (plan §4.5): its event list included; [`InputReports`] never.
+    fn state_hash(&self) -> u64;
+
+    /// Every entity's snapshot fields after the last step.
+    fn entity_records(&self) -> &[EntityRecord];
+
+    /// The hit volumes after the last step, for the room's [`HitHistory`].
+    fn hit_volumes(&self) -> &HitVolumes;
+
+    /// Each portal open or closed after the last step.
+    fn portal_states(&self) -> &PortalStates;
+
+    /// The last step's clamp reports and the running refusal counters.
+    fn reports(&self) -> &InputReports;
+}
diff --git a/spikes/netcode-proof/crates/sim/src/ticks.rs b/spikes/netcode-proof/crates/sim/src/ticks.rs
new file mode 100644
index 0000000..756b066
--- /dev/null
+++ b/spikes/netcode-proof/crates/sim/src/ticks.rs
@@ -0,0 +1,98 @@
+//! The tick constant and every tick-counted value derived from it (u4-build-plan.md §4.3; plan §4.6; RQ6).
+//!
+//! `TICK_HZ` is the one build-time tick constant. Every tick-counted value is a const fn of a tick rate, and each
+//! constant below is its own function at `TICK_HZ`, written `<name>_at(TICK_HZ)` and never a literal: the tests pin
+//! every function at 30 and at 60 Hz, a const assert holds each constant equal to its function at whatever `TICK_HZ`
+//! is (so the 60 Hz run's build refuses to compile a constant that drifted from its function), and check.mjs's deps
+//! step refuses these names set in any other form. The `_at` forms take the rate as an argument, for those tests and for
+//! the 60 Hz run's change-set; everything else uses the constants.
+
+/// The tick rate in ticks per second: the one tick constant (plan §4.6). The 60 Hz run's own change-set replaces
+/// npt-sim through the seam and changes no other crate. A const assert below holds it in 1 to 1,000.
+pub const TICK_HZ: u32 = 30;
+
+/// The highest tick rate the build may set: at it, `ack_ring_ticks_at`'s `32 × tick_hz` is 32,000, far inside u32, and
+/// `ticks_for_ms_at` works in u64, so no derived constant overflows.
+const MAX_TICK_HZ: u32 = 1_000;
+
+const _: () = assert!(
+    TICK_HZ >= 1 && TICK_HZ <= MAX_TICK_HZ,
+    "TICK_HZ is 1 to 1,000 ticks per second"
+);
+
+/// The ticks that cover `ms` milliseconds at `tick_hz`, rounded up: ⌈ms × tick_hz / 1,000⌉ (u4-build-plan.md §4.3).
+/// Worked in u64 and saturated at `u32::MAX`, so it never overflows.
+pub const fn ticks_for_ms_at(tick_hz: u32, ms: u32) -> u32 {
+    let ticks = (ms as u64 * tick_hz as u64).div_ceil(1_000);
+    if ticks > u32::MAX as u64 {
+        u32::MAX
+    } else {
+        ticks as u32
+    }
+}
+
+/// [`ticks_for_ms_at`] at [`TICK_HZ`]: how every millisecond bound becomes a tick count.
+pub const fn ticks_for_ms(ms: u32) -> u32 {
+    ticks_for_ms_at(TICK_HZ, ms)
+}
+
+/// The loop's catch-up cap at `tick_hz`: at most ⌊0.25 × tick_hz⌋ ticks run in one wake (plan §4.6: 7 at 30 Hz, 15
+/// at 60 Hz; ADR 0004 part 5's S17). The other cap, commands per client per tick, is the redundancy cap and is not
+/// derived from the tick rate (`CMD_CATCHUP`, npt-room).
+pub const fn loop_catchup_at(tick_hz: u32) -> u32 {
+    tick_hz / 4
+}
+
+/// [`loop_catchup_at`] at [`TICK_HZ`]: what npt-server's `Schedule` and the Worker's host pass as the catch-up cap.
+pub const LOOP_CATCHUP: u32 = loop_catchup_at(TICK_HZ);
+
+/// The FullState acknowledgement bound at `tick_hz`: a forced resync not acknowledged within 2 s ends in
+/// Kick(overflow) (u4-build-plan.md §4.7): [`ticks_for_ms_at`] of 2,000 (60 ticks at 30 Hz, 120 at 60 Hz).
+pub const fn full_state_ack_ticks_at(tick_hz: u32) -> u32 {
+    ticks_for_ms_at(tick_hz, 2_000)
+}
+
+/// [`full_state_ack_ticks_at`] at [`TICK_HZ`], [`ticks_for_ms`] of 2,000.
+pub const FULL_STATE_ACK_TICKS: u32 = full_state_ack_ticks_at(TICK_HZ);
+
+/// The length in ticks of the room's AckRing and of the client's ring of complete frames at `tick_hz`: 32 × tick_hz
+/// / 30, so the ring keeps ages 0 to 31 at 30 Hz, about 1.067 s (u4-build-plan.md §4.5; ADR 0001 part 6). At most
+/// 1,066 within `TICK_HZ`'s asserted range.
+///
+/// # Panics
+/// Above 134,217,727 ticks per second `32 × tick_hz` overflows u32 (a panic where overflow checks are on, a compile
+/// error in a const); `TICK_HZ`'s const assert keeps the build's own rate far below that.
+pub const fn ack_ring_ticks_at(tick_hz: u32) -> u32 {
+    32 * tick_hz / 30
+}
+
+/// [`ack_ring_ticks_at`] at [`TICK_HZ`].
+pub const ACK_RING_TICKS: u32 = ack_ring_ticks_at(TICK_HZ);
+
+/// ClientSettings' step at `tick_hz`: the interpolation delay moves by at most one interval per second, so one step
+/// every `tick_hz` ticks (u4-build-plan.md §4.3).
+pub const fn settings_step_ticks_at(tick_hz: u32) -> u32 {
+    tick_hz
+}
+
+/// [`settings_step_ticks_at`] at [`TICK_HZ`].
+pub const SETTINGS_STEP_TICKS: u32 = settings_step_ticks_at(TICK_HZ);
+
+// Each derived constant is its own function at TICK_HZ, at every TICK_HZ: written so, check.mjs refuses any other
+// form, and these hold it should the form be evaded (the 60 Hz build then fails here, naming the constant).
+const _: () = assert!(
+    LOOP_CATCHUP == loop_catchup_at(TICK_HZ),
+    "LOOP_CATCHUP is loop_catchup_at(TICK_HZ)"
+);
+const _: () = assert!(
+    FULL_STATE_ACK_TICKS == full_state_ack_ticks_at(TICK_HZ),
+    "FULL_STATE_ACK_TICKS is full_state_ack_ticks_at(TICK_HZ)"
+);
+const _: () = assert!(
+    ACK_RING_TICKS == ack_ring_ticks_at(TICK_HZ),
+    "ACK_RING_TICKS is ack_ring_ticks_at(TICK_HZ)"
+);
+const _: () = assert!(
+    SETTINGS_STEP_TICKS == settings_step_ticks_at(TICK_HZ),
+    "SETTINGS_STEP_TICKS is settings_step_ticks_at(TICK_HZ)"
+);
diff --git a/spikes/netcode-proof/crates/sim/tests/seam.rs b/spikes/netcode-proof/crates/sim/tests/seam.rs
new file mode 100644
index 0000000..12373e2
--- /dev/null
+++ b/spikes/netcode-proof/crates/sim/tests/seam.rs
@@ -0,0 +1,577 @@
+//! U4s's tests (u4-build-plan.md §5 U4s): s1 the tick constants at 30 and 60 Hz, s2 the wire grid each way, s3 its tie
+//! rule, s4 the hit history's ring (and s4b its refusal of a zero span), s5 the seam types are `Send`, s6 each entity
+//! kind's field layout; and, in bites builds, the grid's one planted defect and the own-copy snap's bite id.
+
+use npt_sim::grid::{self, Config, Field, PITCH, POSITION_XY, POSITION_Z, VELOCITY, YAW};
+use npt_sim::{
+    ACK_RING_TICKS, ClampReport, Command, CoverVariant, EntityKind, EntityRecord,
+    FULL_STATE_ACK_TICKS, HitHistory, HitVolumes, InputReports, LOOP_CATCHUP, PortalStates, Rewind,
+    SETTINGS_STEP_TICKS, SimCore, SimEvent, TICK_HZ, TickInput, ack_ring_ticks_at,
+    full_state_ack_ticks_at, loop_catchup_at, settings_step_ticks_at, ticks_for_ms,
+    ticks_for_ms_at,
+};
+
+/// A derived constant's name, its value, its function of the tick rate, and the function's values at 30 and 60 Hz.
+type Derived = (&'static str, u32, fn(u32) -> u32, u32, u32);
+
+/// Each derived constant, its function of the tick rate, and that function's pinned values at 30 and at 60 Hz
+/// (u4-build-plan.md §4.3). check.mjs's deps step holds each constant's initializer to `<name>_at(TICK_HZ)`, and
+/// ticks.rs's const asserts hold each constant equal to its function at whatever TICK_HZ is, so the function's value at
+/// 60 Hz is the constant the 60 Hz build gets.
+const DERIVED: [Derived; 4] = [
+    ("LOOP_CATCHUP", LOOP_CATCHUP, loop_catchup_at, 7, 15),
+    (
+        "FULL_STATE_ACK_TICKS",
+        FULL_STATE_ACK_TICKS,
+        full_state_ack_ticks_at,
+        60,
+        120,
+    ),
+    ("ACK_RING_TICKS", ACK_RING_TICKS, ack_ring_ticks_at, 32, 64),
+    (
+        "SETTINGS_STEP_TICKS",
+        SETTINGS_STEP_TICKS,
+        settings_step_ticks_at,
+        30,
+        60,
+    ),
+];
+
+const FIELDS: [(&str, Field); 5] = [
+    ("POSITION_XY", grid::POSITION_XY),
+    ("POSITION_Z", grid::POSITION_Z),
+    ("YAW", grid::YAW),
+    ("PITCH", grid::PITCH),
+    ("VELOCITY", grid::VELOCITY),
+];
+
+/// Each field's scale in grid steps per sim unit, as u4-build-plan.md §4.4 states the grid: 1 cm (and 1 cm/s), yaw's
+/// 16 bits over the turn, pitch's ±511 over ±90 degrees. s2 checks `from_grid` against it for every integer.
+fn scale(f: Field) -> f64 {
+    if f == grid::YAW {
+        65_536.0 / core::f64::consts::TAU
+    } else if f == grid::PITCH {
+        511.0 / core::f64::consts::FRAC_PI_2
+    } else {
+        100.0
+    }
+}
+
+/// One tick's hit volumes, as the tests push them (U4d's World gives them their volumes).
+fn volumes(tick: u32) -> HitVolumes {
+    HitVolumes { tick }
+}
+
+/// One unit in the last place of a finite f64, by its bits (std's next_up is outside the sim's float allow-list).
+fn ulp(s: f64) -> f64 {
+    let a = s.abs();
+    f64::from_bits(a.to_bits() + 1) - a
+}
+
+/// The grid's error at `x`, in steps: the integer the grid gives less the scaled value, around the turn for yaw.
+fn error_in_steps(f: Field, x: f32, k: i32) -> f64 {
+    let s = f64::from(x) * scale(f);
+    let d = f64::from(k) - s;
+    if f.wraps() {
+        let turn = f64::from(f.max()) - f64::from(f.min()) + 1.0;
+        d - turn * (d / turn).round()
+    } else {
+        d
+    }
+}
+
+#[test]
+fn s1_every_tick_constant_is_its_function_of_the_tick_rate_at_30_and_60_hz() {
+    // Each derived constant is its function at TICK_HZ, and the function is pinned at both rates (u4-build-plan.md
+    // §4.3): catch-up 7 and 15, the FullState bound 60 and 120, the AckRing 32 and 64, the ClientSettings step 30 and 60.
+    for (name, constant, at, at_30, at_60) in DERIVED {
+        assert_eq!(constant, at(TICK_HZ), "{name} is its function at TICK_HZ");
+        assert_eq!(at(30), at_30, "{name} at 30 Hz");
+        assert_eq!(at(60), at_60, "{name} at 60 Hz");
+    }
+    // The FullState bound is 2 s at every rate, and the AckRing stays small at the highest rate TICK_HZ may take.
+    for hz in [1, 30, 60, 1_000] {
+        assert_eq!(full_state_ack_ticks_at(hz), ticks_for_ms_at(hz, 2_000));
+    }
+    assert_eq!(ack_ring_ticks_at(1_000), 1_066);
+    // ticks_for_ms rounds up, at both rates.
+    for (hz, ms, ticks) in [
+        (30, 0, 0),
+        (30, 1, 1),
+        (30, 33, 1),
+        (30, 34, 2),
+        (30, 1_000, 30),
+        (60, 16, 1),
+        (60, 17, 2),
+        (60, 1_000, 60),
+    ] {
+        assert_eq!(ticks_for_ms_at(hz, ms), ticks, "{ms} ms at {hz} Hz");
+    }
+    assert_eq!(
+        ticks_for_ms_at(1_000, u32::MAX),
+        u32::MAX,
+        "no overflow at the largest rate"
+    );
+    // The build's rate is 30, and ticks_for_ms is ticks_for_ms_at at it.
+    assert_eq!(TICK_HZ, 30);
+    for ms in [0, 1, 33, 34, 2_000, 100_000] {
+        assert_eq!(ticks_for_ms(ms), ticks_for_ms_at(TICK_HZ, ms));
+    }
+}
+
+#[test]
+fn s2_from_then_to_returns_every_integer_of_every_field() {
+    let g = Config::default();
+    let mut seen = 0u64;
+    for (name, f) in FIELDS {
+        assert!(f.min() < f.max());
+        let span = i64::from(f.max()) - i64::from(f.min()) + 1;
+        assert!(
+            span <= 1 << f.bits(),
+            "{name}: {span} integers in {} bits",
+            f.bits()
+        );
+        for k in f.min()..=f.max() {
+            let x = g.from_grid(f, k);
+            assert_eq!(
+                x.to_bits(),
+                ((f64::from(k) / scale(f)) as f32).to_bits(),
+                "{name}: {k}'s value"
+            );
+            assert_eq!(g.to_grid(f, x), k, "{name}: {k} came back from {x:e}");
+            assert_eq!(
+                g.snap(f, x).to_bits(),
+                x.to_bits(),
+                "{name}: a grid value snaps to itself"
+            );
+            seen += 1;
+        }
+    }
+    // Every integer of every field: 65,536 + 4,096 + 65,536 + 1,023 + 65,536.
+    assert_eq!(seen, 201_727);
+}
+
+#[test]
+fn s2_to_errs_by_at_most_half_a_step_plus_one_ulp_over_the_half_steps_and_the_range_ends() {
+    let g = Config::default();
+    let mut points = 0u64;
+    for (name, f) in FIELDS {
+        let sc = scale(f);
+        // Every integer of the narrow fields, every 7th of the wide ones, and always both ends and their neighbours.
+        let stride = if f.bits() > 12 { 7 } else { 1 };
+        let mut ks: Vec<i32> = (f.min()..=f.max()).step_by(stride).collect();
+        ks.extend([f.min(), f.min() + 1, f.max() - 1, f.max()]);
+        for k in ks {
+            // The grid point, the quarter steps and the half steps on both sides, each as the nearest f32 and its two
+            // neighbours.
+            for quarter in -3..=3 {
+                let at = (f64::from(k) + f64::from(quarter) / 4.0) / sc;
+                let x = at as f32;
+                for x in [
+                    x,
+                    f32::from_bits(x.to_bits().wrapping_add(1)),
+                    f32::from_bits(x.to_bits().wrapping_sub(1)),
+                ] {
+                    if !x.is_finite() {
+                        continue;
+                    }
+                    let s = f64::from(x) * sc;
+                    // Past the range's half steps the grid saturates: not an error bound.
+                    if !f.wraps() && (s < f64::from(f.min()) - 0.5 || s > f64::from(f.max()) + 0.5)
+                    {
+                        continue;
+                    }
+                    let got = g.to_grid(f, x);
+                    let e = error_in_steps(f, x, got);
+                    assert!(
+                        e.abs() <= 0.5 + ulp(s),
+                        "{name}: {x:e} (scaled {s}) went to {got}, {e} steps off"
+                    );
+                    points += 1;
+                }
+            }
+        }
+    }
+    assert!(points > 300_000, "{points} points");
+    // Past the ends: a range field saturates, yaw wraps, NaN is 0.
+    assert_eq!(g.to_grid(grid::POSITION_Z, -1.0), 0);
+    assert_eq!(g.to_grid(grid::POSITION_Z, 100.0), 4_095);
+    assert_eq!(g.to_grid(grid::POSITION_XY, f32::INFINITY), 32_767);
+    assert_eq!(g.to_grid(grid::POSITION_XY, f32::NEG_INFINITY), -32_768);
+    assert_eq!(g.to_grid(grid::PITCH, 2.0), 511);
+    assert_eq!(g.to_grid(grid::VELOCITY, f32::NAN), 0);
+    assert_eq!(
+        g.to_grid(grid::YAW, core::f32::consts::PI),
+        -32_768,
+        "π is -π around the turn"
+    );
+    assert_eq!(g.to_grid(grid::YAW, -core::f32::consts::PI), -32_768);
+    assert_eq!(
+        g.to_grid(grid::YAW, 3.0 * core::f32::consts::FRAC_PI_2),
+        -16_384
+    );
+}
+
+#[test]
+fn s3_a_tie_rounds_away_from_zero() {
+    let g = Config::default();
+    // Metres whose centimetre value is exactly k + 0.5 (dyadic, so the f32 and the f64 product are exact): ties away
+    // from zero, not to even (12.5 → 13, 62.5 → 63) and not upward (-12.5 → -13).
+    for (x, k) in [
+        (0.125, 13),
+        (-0.125, -13),
+        (0.375, 38),
+        (-0.375, -38),
+        (0.625, 63),
+        (-0.625, -63),
+        (1.125, 113),
+        (-1.125, -113),
+    ] {
+        for f in [grid::POSITION_XY, grid::VELOCITY] {
+            assert_eq!(g.to_grid(f, x), k, "{x}");
+        }
+        if x > 0.0 {
+            assert_eq!(g.to_grid(grid::POSITION_Z, x), k, "{x}");
+        }
+    }
+    // Yaw's and pitch's scales are not dyadic, so no f32 lands exactly on their half steps: the same rounding serves
+    // them (s2 bounds their error).
+}
