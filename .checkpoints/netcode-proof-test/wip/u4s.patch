diff --git a/spikes/netcode-proof/crates/sim/src/grid.rs b/spikes/netcode-proof/crates/sim/src/grid.rs
new file mode 100644
index 0000000..92d7de0
--- /dev/null
+++ b/spikes/netcode-proof/crates/sim/src/grid.rs
@@ -0,0 +1,217 @@
+//! The wire grid (u4-build-plan.md §4.4; the advisor's Q23 ruling): one function each way between the sim's values and
+//! the integers the wire carries, per field kind. The sim's own-copy snap, the room's encoder and the client all call
+//! it, so the three agree bit for bit; npt-proto's `Quant` packs its integers into their widths.
+//!
+//! - **To the grid** ([`Config::to_grid`]): one multiply by the field's scale, in f64 (exact for the centimetre fields:
+//!   an f32 times 100 needs at most 31 significant bits), then the nearest integer, **a tie rounding away from zero**
+//!   (`f64::round`, on ADR 0004's float allow-list), then integers only: a range field saturates at its ends, yaw wraps
+//!   around the turn. NaN maps to 0, an infinity to the end of a range field it points past and to one fixed yaw
+//!   integer; the sim never holds either (plan §4.5), and no input of any kind panics.
+//! - **From the grid** ([`Config::from_grid`]): the integer divided by the same scale in f64, rounded once to f32. Every
+//!   integer of a field comes back from the grid as itself (the tests run all of them).
+//!
+//! Positions are metres, angles radians, velocities metres per second. A field's integers are `min()..=max()`, which
+//! fit in `bits()` bits.
+//!
+//! Bites (bites builds only) are chosen through the [`Config`] value a caller passes, never a static
+//! (u4-build-plan.md §4.11): a client, the sim's own-copy snap or the encoder each holds its own.
+
+use core::f64::consts::{FRAC_PI_2, TAU};
+
+/// Which values a field carries, for the bites that coarsen one kind.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Kind {
+    Position,
+    Yaw,
+    Pitch,
+    Velocity,
+}
+
+/// One field kind of the wire grid: its scale (grid steps per sim unit), its integers and its width.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Field {
+    kind: Kind,
+    scale: f64,
+    min: i32,
+    max: i32,
+    bits: u32,
+    wraps: bool,
+}
+
+impl Field {
+    /// The field's lowest integer.
+    pub const fn min(self) -> i32 {
+        self.min
+    }
+
+    /// The field's highest integer.
+    pub const fn max(self) -> i32 {
+        self.max
+    }
+
+    /// The field's width on the wire, in bits.
+    pub const fn bits(self) -> u32 {
+        self.bits
+    }
+
+    /// Whether the field wraps around (yaw) rather than saturating at its ends.
+    pub const fn wraps(self) -> bool {
+        self.wraps
+    }
+
+    /// An integer on the grid's line brought into the field: wrapped around the turn (an integer `rem_euclid` over a
+    /// power-of-two span, never a float one), or saturated at the field's ends.
+    fn fit(self, k: i64) -> i32 {
+        let (min, max) = (i64::from(self.min), i64::from(self.max));
+        let k = if self.wraps {
+            k.wrapping_sub(min).rem_euclid(max - min + 1) + min
+        } else {
+            k.clamp(min, max)
+        };
+        k as i32
+    }
+}
+
+/// Horizontal position (x and y), metres: 1 cm steps in 16 bits, -327.68 m to 327.67 m (ADR 0001 part 6, E3).
+pub const POSITION_XY: Field = Field {
+    kind: Kind::Position,
+    scale: 100.0,
+    min: -32_768,
+    max: 32_767,
+    bits: 16,
+    wraps: false,
+};
+
+/// Height (z), metres: 1 cm steps in 12 bits, 0 to 40.95 m (ADR 0001 part 6, E3).
+pub const POSITION_Z: Field = Field {
+    kind: Kind::Position,
+    scale: 100.0,
+    min: 0,
+    max: 4_095,
+    bits: 12,
+    wraps: false,
+};
+
+/// Yaw, radians: 16 bits over the whole turn (steps of about 0.0055 degrees), the integers -32,768 (-π) to 32,767; it
+/// wraps, so π and -π are one integer (ADR 0001 part 6, E3; PM-0001-57's bound is 0.01 degrees).
+pub const YAW: Field = Field {
+    kind: Kind::Yaw,
+    scale: 65_536.0 / TAU,
+    min: -32_768,
+    max: 32_767,
+    bits: 16,
+    wraps: true,
+};
+
+/// Pitch, radians: 10 bits over ±90 degrees, the integers -511 to 511, so both ends are exact (steps of about 0.176
+/// degrees, inside PM-0001-57's one 0.18 degree step). The 10-bit code -512 is not a pitch.
+pub const PITCH: Field = Field {
+    kind: Kind::Pitch,
+    scale: 511.0 / FRAC_PI_2,
+    min: -511,
+    max: 511,
+    bits: 10,
+    wraps: false,
+};
+
+/// Velocity, metres per second: 1 cm/s steps in 16 bits, -327.68 to 327.67 m/s. Provisional: u4-build-plan.md §4.4
+/// leaves velocity's step to U4a's field table, and the own-copy snap needs one now; U4a's table states it, and a
+/// different step changes only this constant.
+pub const VELOCITY: Field = Field {
+    kind: Kind::Velocity,
+    scale: 100.0,
+    min: -32_768,
+    max: 32_767,
+    bits: 16,
+    wraps: false,
+};
+
+/// The grid a caller uses: in a measured build always the wire grid; in a bites build it may hold one planted defect,
+/// chosen by [`Config::with_bite`] for that caller alone.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Config {
+    #[cfg(feature = "bites")]
+    bite: Option<Bite>,
+}
+
+impl Config {
+    /// `x` on the field's grid: one scale multiply, the nearest integer (a tie away from zero), then the field's
+    /// range in integers.
+    pub fn to_grid(self, field: Field, x: f32) -> i32 {
+        let scaled = f64::from(x) * field.scale;
+        #[cfg(feature = "bites")]
+        if let Some(bite) = self.bite {
+            return field.fit(bite.to_line(field.kind, scaled));
+        }
+        field.fit(scaled.round() as i64)
+    }
+
+    /// The value of the field's integer `k`: `k` over the field's scale, rounded once to f32.
+    pub fn from_grid(self, field: Field, k: i32) -> f32 {
+        (f64::from(k) / field.scale) as f32
+    }
+
+    /// `x` snapped to the field's grid: [`Config::from_grid`] of [`Config::to_grid`]. The sim's own-copy snap
+    /// (the advisor's Q23 ruling).
+    pub fn snap(self, field: Field, x: f32) -> f32 {
+        self.from_grid(field, self.to_grid(field, x))
+    }
+}
+
+/// The grid's planted defects (bites builds only).
+#[cfg(feature = "bites")]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Bite {
+    /// Rounds down in place of to the nearest.
+    Floor,
+    /// Positions to 4 cm.
+    Pos4cm,
+    /// Yaw to 12 bits (every 16th integer).
+    Yaw12bit,
+    /// Pitch to 8 bits (every 4th integer).
+    Pitch8bit,
+}
+
+#[cfg(feature = "bites")]
+impl Bite {
+    /// The scaled value's integer under this defect, before the field's range.
+    fn to_line(self, kind: Kind, scaled: f64) -> i64 {
+        let every: i64 = match (self, kind) {
+            (Bite::Floor, _) => return scaled.floor() as i64,
+            (Bite::Pos4cm, Kind::Position) => 4,
+            (Bite::Yaw12bit, Kind::Yaw) => 16,
+            (Bite::Pitch8bit, Kind::Pitch) => 4,
+            _ => 1,
+        };
+        ((scaled / every as f64).round() as i64).saturating_mul(every)
+    }
+}
+
+/// The grid's bites, by their marks.json ids: the site is the caller's (u4-build-plan.md §4.14): PM-0001-17's in
+/// npt-client's call, PM-0001-41's in the authority step's own-copy snap, PM-0001-57's three in the encoder's.
+#[cfg(feature = "bites")]
+const BITE_IDS: [(&str, Bite); 5] = [
+    ("PM-0001-17/client-rounding", Bite::Floor),
+    ("PM-0001-41/server-quant-differs", Bite::Floor),
+    ("PM-0001-57/pos-4cm", Bite::Pos4cm),
+    ("PM-0001-57/yaw-12bit", Bite::Yaw12bit),
+    ("PM-0001-57/pitch-8bit", Bite::Pitch8bit),
+];
+
+#[cfg(feature = "bites")]
+impl Config {
+    /// The bite ids the grid plants (bites builds only).
+    pub const BITES: [&'static str; 5] = [
+        BITE_IDS[0].0,
+        BITE_IDS[1].0,
+        BITE_IDS[2].0,
+        BITE_IDS[3].0,
+        BITE_IDS[4].0,
+    ];
+
+    /// A grid with one planted defect, by its marks.json id (bites builds only); `None` for an id it does not plant.
+    pub fn with_bite(bite: &str) -> Option<Config> {
+        let (_, b) = BITE_IDS.iter().find(|(id, _)| *id == bite)?;
+        Some(Config { bite: Some(*b) })
+    }
+}
