+    assert.deepEqual(run((f) => (f[file] = plant)), [roomFloat(`${file}:1`, token)], plant);
+  }
+  assert.deepEqual(run((f) => (f[file] = "\n\nfn g(x: f32) -> f64 {\n    f64::from(x) * 0.5\n}\n")), [roomFloat(`${file}:3`, "f32", 4)]);
+});
