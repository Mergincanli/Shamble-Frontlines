+/**
+ * The tick constant's one home (plan §4.6, RQ6: "`TICK_HZ` one constant"): npt-sim's sources. Every tick-counted value
+ * is a const fn of it (u4-build-plan.md §4.3), and TICK_DERIVED are the constants those functions give at TICK_HZ.
+ */
+export const TICK_HZ_HOME = "crates/sim/src/";
+export const TICK_DERIVED = ["LOOP_CATCHUP", "FULL_STATE_ACK_TICKS", "ACK_RING_TICKS", "SETTINGS_STEP_TICKS"];
+/** A `const` or `static` item (associated ones too) named TICK_HZ or a TICK_DERIVED name: its name and initializer. */
+const TICK_ITEM = new RegExp(`\\b(?:const|static)\\s+(?:mut\\s+)?(TICK_HZ|${TICK_DERIVED.join("|")})\\b\\s*(?::[^=;]*)?=([^;]*);`, "g");
+
+/**
+ * Every tick-counted name set from a literal under crates/ (u4-build-plan.md §4.3: "a check.mjs grep refuses those
+ * names set from a literal"; plan §4.6: "no literal 7 anywhere"), as a sentence, read in lexRust's mask (comments and
+ * strings blanked). A TICK_DERIVED item's initializer must name TICK_HZ, call `ticks_for_ms` (the TICK_HZ form), or
+ * be a path to the same name (`npt_sim::LOOP_CATCHUP`); anything else (`7`, `30 / 4`, `SEVEN`, `loop_catchup_at(30)`)
+ * is refused. TICK_HZ is set from a literal once, in TICK_HZ_HOME; any other TICK_HZ item must be a path to it.
+ * Known limit: a grep, not rustc's name resolution. It reads items by these names only, so a tick count under another
+ * name (a struct field, a `let`, a literal passed to a function) is review's and the tests' (s1 evaluates every tick
+ * function at 30 and 60 Hz).
+ */
+export function tickConstantProblems(files, read) {
+  const problems = [];
+  let home = null;
+  for (const f of files) {
+    if (!f.startsWith("crates/") || !f.endsWith(".rs")) continue;
+    const { mask } = lexRust(read(f));
+    for (const m of mask.matchAll(TICK_ITEM)) {
+      const [, name, raw] = m;
+      const init = raw.trim().replace(/\s+/g, " ");
+      const at = `${f}:${lineAt(mask, m.index)}`;
+      const isPath = new RegExp(`^(?:[A-Za-z_]\\w*\\s*::\\s*)*${name}$`).test(init);
+      if (name === "TICK_HZ") {
+        if (isPath) continue;
+        if (f.startsWith(TICK_HZ_HOME) && home === null) {
+          home = at;
+          continue;
+        }
+        const where = f.startsWith(TICK_HZ_HOME) ? `a second time (the first: ${home})` : `outside ${TICK_HZ_HOME}`;
+        problems.push(`${at} sets TICK_HZ from \`${init}\` ${where}: npt_sim::TICK_HZ is the one tick constant (plan §4.6)`);
