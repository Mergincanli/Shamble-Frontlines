@@ -0,0 +1,58 @@
+//! The tick constant and every tick-counted value derived from it (u4-build-plan.md §4.3; plan §4.6; RQ6).
+//!
+//! `TICK_HZ` is the one build-time tick constant. Every tick-counted value is a const fn of a tick rate, and each
+//! constant below is that function at `TICK_HZ`, never a literal: the tests evaluate every function at 30 and at 60 Hz,
+//! and check.mjs's deps step refuses these names set from a literal anywhere under crates/. The `_at` forms take the
+//! rate as an argument, for those tests and for the 60 Hz run's change-set; everything else uses the constants.
+//! Rates are at most 1,000 ticks per second, so no result overflows.
+
+/// The tick rate in ticks per second: the one tick constant (plan §4.6). The 60 Hz run's own change-set replaces
+/// npt-sim through the seam and changes no other crate.
+pub const TICK_HZ: u32 = 30;
+
+/// The ticks that cover `ms` milliseconds at `tick_hz`, rounded up: ⌈ms × tick_hz / 1,000⌉ (u4-build-plan.md §4.3).
+pub const fn ticks_for_ms_at(tick_hz: u32, ms: u32) -> u32 {
+    let ticks = (ms as u64 * tick_hz as u64).div_ceil(1_000);
+    if ticks > u32::MAX as u64 {
+        u32::MAX
+    } else {
+        ticks as u32
+    }
+}
+
+/// [`ticks_for_ms_at`] at [`TICK_HZ`]: how every millisecond bound becomes a tick count.
+pub const fn ticks_for_ms(ms: u32) -> u32 {
+    ticks_for_ms_at(TICK_HZ, ms)
+}
+
+/// The loop's catch-up cap at `tick_hz`: at most ⌊0.25 × tick_hz⌋ ticks run in one wake (plan §4.6: 7 at 30 Hz, 15
+/// at 60 Hz; ADR 0004 part 5's S17). The other cap, commands per client per tick, is the redundancy cap and is not
+/// derived from the tick rate (`CMD_CATCHUP`, npt-room).
+pub const fn loop_catchup_at(tick_hz: u32) -> u32 {
+    tick_hz / 4
+}
+
+/// [`loop_catchup_at`] at [`TICK_HZ`]: what npt-server's `Schedule` and the Worker's host pass as the catch-up cap.
+pub const LOOP_CATCHUP: u32 = loop_catchup_at(TICK_HZ);
+
+/// The FullState acknowledgement bound: a forced resync not acknowledged within 2 s ends in Kick(overflow)
+/// (u4-build-plan.md §4.7): [`ticks_for_ms`] of 2,000 (60 ticks at 30 Hz, 120 at 60 Hz).
+pub const FULL_STATE_ACK_TICKS: u32 = ticks_for_ms(2_000);
+
+/// The length in ticks of the room's AckRing and of the client's ring of complete frames at `tick_hz`: 32 × tick_hz
+/// / 30, so the ring keeps ages 0 to 31 at 30 Hz, about 1.067 s (u4-build-plan.md §4.5; ADR 0001 part 6).
+pub const fn ack_ring_ticks_at(tick_hz: u32) -> u32 {
+    32 * tick_hz / 30
+}
+
+/// [`ack_ring_ticks_at`] at [`TICK_HZ`].
+pub const ACK_RING_TICKS: u32 = ack_ring_ticks_at(TICK_HZ);
+
+/// ClientSettings' step at `tick_hz`: the interpolation delay moves by at most one interval per second, so one step
+/// every `tick_hz` ticks (u4-build-plan.md §4.3).
+pub const fn settings_step_ticks_at(tick_hz: u32) -> u32 {
+    tick_hz
+}
+
+/// [`settings_step_ticks_at`] at [`TICK_HZ`].
+pub const SETTINGS_STEP_TICKS: u32 = settings_step_ticks_at(TICK_HZ);
diff --git a/spikes/netcode-proof/crates/sim/tests/seam.rs b/spikes/netcode-proof/crates/sim/tests/seam.rs
new file mode 100644
index 0000000..464fc48
--- /dev/null
+++ b/spikes/netcode-proof/crates/sim/tests/seam.rs
@@ -0,0 +1,459 @@
+//! U4s's tests (u4-build-plan.md §5 U4s): s1 the tick constants at 30 and 60 Hz, s2 the wire grid each way, s3 its tie
+//! rule, s4 the hit history's ring, s5 the seam types are `Send`; and, in bites builds, the grid's planted defects.
+
+use npt_sim::grid::{self, Config, Field};
+use npt_sim::{
+    ACK_RING_TICKS, ClampReport, Command, CoverVariant, EntityKind, EntityRecord,
+    FULL_STATE_ACK_TICKS, HitHistory, HitVolumes, InputReports, LOOP_CATCHUP, PortalStates, Rewind,
+    SETTINGS_STEP_TICKS, SimCore, SimEvent, TICK_HZ, TickInput, ack_ring_ticks_at, loop_catchup_at,
+    settings_step_ticks_at, ticks_for_ms, ticks_for_ms_at,
+};
+
+const FIELDS: [(&str, Field); 5] = [
+    ("POSITION_XY", grid::POSITION_XY),
+    ("POSITION_Z", grid::POSITION_Z),
+    ("YAW", grid::YAW),
+    ("PITCH", grid::PITCH),
+    ("VELOCITY", grid::VELOCITY),
+];
+
+/// Each field's scale in grid steps per sim unit, as u4-build-plan.md §4.4 states the grid: 1 cm (and 1 cm/s), yaw's
+/// 16 bits over the turn, pitch's ±511 over ±90 degrees. s2 checks `from_grid` against it for every integer.
+fn scale(f: Field) -> f64 {
+    if f == grid::YAW {
+        65_536.0 / core::f64::consts::TAU
+    } else if f == grid::PITCH {
+        511.0 / core::f64::consts::FRAC_PI_2
+    } else {
+        100.0
+    }
+}
+
+/// One tick's hit volumes, as the tests push them (U4d's World gives them their volumes).
+fn volumes(tick: u32) -> HitVolumes {
+    HitVolumes { tick }
+}
+
+/// One unit in the last place of a finite f64, by its bits (std's next_up is outside the sim's float allow-list).
+fn ulp(s: f64) -> f64 {
+    let a = s.abs();
+    f64::from_bits(a.to_bits() + 1) - a
+}
+
+/// The grid's error at `x`, in steps: the integer the grid gives less the scaled value, around the turn for yaw.
+fn error_in_steps(f: Field, x: f32, k: i32) -> f64 {
+    let s = f64::from(x) * scale(f);
+    let d = f64::from(k) - s;
+    if f.wraps() {
+        let turn = f64::from(f.max()) - f64::from(f.min()) + 1.0;
+        d - turn * (d / turn).round()
+    } else {
+        d
+    }
+}
+
+#[test]
+fn s1_every_tick_constant_is_its_function_of_the_tick_rate_at_30_and_60_hz() {
+    // The functions at both rates, pinned (u4-build-plan.md §4.3): catch-up 7 and 15, the FullState bound 60 and 120,
+    // the AckRing 32 and 64, the ClientSettings step 30 and 60.
+    for (hz, catchup, full_state, ring, step) in [(30, 7, 60, 32, 30), (60, 15, 120, 64, 60)] {
+        assert_eq!(loop_catchup_at(hz), catchup, "LOOP_CATCHUP at {hz} Hz");
+        assert_eq!(
+            ticks_for_ms_at(hz, 2_000),
+            full_state,
+            "the FullState bound at {hz} Hz"
+        );
+        assert_eq!(ack_ring_ticks_at(hz), ring, "the AckRing at {hz} Hz");
+        assert_eq!(
+            settings_step_ticks_at(hz),
+            step,
+            "the ClientSettings step at {hz} Hz"
+        );
+    }
+    // ticks_for_ms rounds up, at both rates.
+    for (hz, ms, ticks) in [
+        (30, 0, 0),
+        (30, 1, 1),
+        (30, 33, 1),
+        (30, 34, 2),
+        (30, 1_000, 30),
+        (60, 16, 1),
+        (60, 17, 2),
+        (60, 1_000, 60),
+    ] {
+        assert_eq!(ticks_for_ms_at(hz, ms), ticks, "{ms} ms at {hz} Hz");
+    }
+    assert_eq!(
+        ticks_for_ms_at(1_000, u32::MAX),
+        u32::MAX,
+        "no overflow at the largest rate"
+    );
+    // The build's constants are those functions at TICK_HZ, 30 here.
+    assert_eq!(TICK_HZ, 30);
+    assert_eq!(LOOP_CATCHUP, loop_catchup_at(TICK_HZ));
+    assert_eq!(FULL_STATE_ACK_TICKS, ticks_for_ms_at(TICK_HZ, 2_000));
+    assert_eq!(ACK_RING_TICKS, ack_ring_ticks_at(TICK_HZ));
+    assert_eq!(SETTINGS_STEP_TICKS, settings_step_ticks_at(TICK_HZ));
+    for ms in [0, 1, 33, 34, 2_000, 100_000] {
+        assert_eq!(ticks_for_ms(ms), ticks_for_ms_at(TICK_HZ, ms));
+    }
+}
+
+#[test]
+fn s2_from_then_to_returns_every_integer_of_every_field() {
+    let g = Config::default();
+    let mut seen = 0u64;
+    for (name, f) in FIELDS {
+        assert!(f.min() < f.max());
+        let span = i64::from(f.max()) - i64::from(f.min()) + 1;
+        assert!(
+            span <= 1 << f.bits(),
+            "{name}: {span} integers in {} bits",
+            f.bits()
+        );
+        for k in f.min()..=f.max() {
+            let x = g.from_grid(f, k);
+            assert_eq!(
+                x.to_bits(),
+                ((f64::from(k) / scale(f)) as f32).to_bits(),
+                "{name}: {k}'s value"
+            );
+            assert_eq!(g.to_grid(f, x), k, "{name}: {k} came back from {x:e}");
+            assert_eq!(
+                g.snap(f, x).to_bits(),
+                x.to_bits(),
+                "{name}: a grid value snaps to itself"
+            );
+            seen += 1;
+        }
+    }
+    // Every integer of every field: 65,536 + 4,096 + 65,536 + 1,023 + 65,536.
+    assert_eq!(seen, 201_727);
+}
+
+#[test]
+fn s2_to_errs_by_at_most_half_a_step_plus_one_ulp_over_the_half_steps_and_the_range_ends() {
+    let g = Config::default();
+    let mut points = 0u64;
+    for (name, f) in FIELDS {
+        let sc = scale(f);
+        // Every integer of the narrow fields, every 7th of the wide ones, and always both ends and their neighbours.
+        let stride = if f.bits() > 12 { 7 } else { 1 };
+        let mut ks: Vec<i32> = (f.min()..=f.max()).step_by(stride).collect();
+        ks.extend([f.min(), f.min() + 1, f.max() - 1, f.max()]);
+        for k in ks {
+            // The grid point, the quarter steps and the half steps on both sides, each as the nearest f32 and its two
+            // neighbours.
+            for quarter in -3..=3 {
+                let at = (f64::from(k) + f64::from(quarter) / 4.0) / sc;
+                let x = at as f32;
+                for x in [
+                    x,
+                    f32::from_bits(x.to_bits().wrapping_add(1)),
+                    f32::from_bits(x.to_bits().wrapping_sub(1)),
+                ] {
+                    if !x.is_finite() {
+                        continue;
+                    }
+                    let s = f64::from(x) * sc;
+                    // Past the range's half steps the grid saturates: not an error bound.
+                    if !f.wraps() && (s < f64::from(f.min()) - 0.5 || s > f64::from(f.max()) + 0.5)
+                    {
+                        continue;
+                    }
+                    let got = g.to_grid(f, x);
+                    let e = error_in_steps(f, x, got);
+                    assert!(
+                        e.abs() <= 0.5 + ulp(s),
+                        "{name}: {x:e} (scaled {s}) went to {got}, {e} steps off"
+                    );
+                    points += 1;
+                }
+            }
+        }
+    }
+    assert!(points > 300_000, "{points} points");
+    // Past the ends: a range field saturates, yaw wraps, NaN is 0.
+    assert_eq!(g.to_grid(grid::POSITION_Z, -1.0), 0);
+    assert_eq!(g.to_grid(grid::POSITION_Z, 100.0), 4_095);
+    assert_eq!(g.to_grid(grid::POSITION_XY, f32::INFINITY), 32_767);
+    assert_eq!(g.to_grid(grid::POSITION_XY, f32::NEG_INFINITY), -32_768);
+    assert_eq!(g.to_grid(grid::PITCH, 2.0), 511);
+    assert_eq!(g.to_grid(grid::VELOCITY, f32::NAN), 0);
+    assert_eq!(
+        g.to_grid(grid::YAW, core::f32::consts::PI),
+        -32_768,
+        "π is -π around the turn"
+    );
+    assert_eq!(g.to_grid(grid::YAW, -core::f32::consts::PI), -32_768);
+    assert_eq!(
+        g.to_grid(grid::YAW, 3.0 * core::f32::consts::FRAC_PI_2),
+        -16_384
+    );
+}
+
+#[test]
+fn s3_a_tie_rounds_away_from_zero() {
+    let g = Config::default();
+    // Metres whose centimetre value is exactly k + 0.5 (dyadic, so the f32 and the f64 product are exact): ties away
+    // from zero, not to even (12.5 → 13, 62.5 → 63) and not upward (-12.5 → -13).
+    for (x, k) in [
+        (0.125, 13),
+        (-0.125, -13),
+        (0.375, 38),
+        (-0.375, -38),
+        (0.625, 63),
+        (-0.625, -63),
+        (1.125, 113),
+        (-1.125, -113),
+    ] {
+        for f in [grid::POSITION_XY, grid::VELOCITY] {
+            assert_eq!(g.to_grid(f, x), k, "{x}");
+        }
+        if x > 0.0 {
+            assert_eq!(g.to_grid(grid::POSITION_Z, x), k, "{x}");
+        }
+    }
+    // Yaw's and pitch's scales are not dyadic, so no f32 lands exactly on their half steps: the same rounding serves
+    // them (s2 bounds their error).
+}
+
+#[test]
+fn s4_the_hit_history_keeps_exactly_its_capacity_and_evicts_the_oldest() {
+    for capacity in [64, 32, 2, 1] {
+        let mut h = HitHistory::new(capacity);
+        assert!(h.is_empty());
+        // Ticks that cross the u32 wrap.
+        let start = u32::MAX - 40;
+        for i in 0..capacity + 50 {
+            let tick = start.wrapping_add(i);
+            h.push(&volumes(tick));
+            let held = (i + 1).min(capacity);
+            assert_eq!(
+                h.len(),
+                held,
+                "capacity {capacity}: {held} held after {} pushes",
+                i + 1
+            );
+            let oldest = tick.wrapping_sub(held - 1);
+            for t in 0..held {
+                let t = oldest.wrapping_add(t);
+                assert_eq!(
+                    h.get(t).map(|v| v.tick),
+                    Some(t),
+                    "capacity {capacity}: tick {t} held"
+                );
+            }
+            if i >= capacity {
+                assert!(
+                    h.get(oldest.wrapping_sub(1)).is_none(),
+                    "capacity {capacity}: the oldest evicted"
+                );
+            }
+            assert!(h.get(tick.wrapping_add(1)).is_none(), "no future tick");
+            assert!(!h.is_empty());
+        }
+        assert_eq!(h.capacity(), capacity);
+    }
+}
+
+/// A stand-in implementation: the seam is a trait a sim can implement with these types, and a room generic over it.
+struct Stub {
+    events: Vec<SimEvent>,
+    records: Vec<EntityRecord>,
+    volumes: HitVolumes,
+    portals: PortalStates,
+    reports: InputReports,
+}
+
+impl SimCore for Stub {
+    fn step(&mut self, input: &TickInput, history: &HitHistory) -> &[SimEvent] {
+        self.events.clear();
+        for (c, rewind) in &input.commands {
+            if rewind.is_some_and(|r| history.get(r.tick_a).is_some()) {
+                self.events.push(SimEvent::Shot {
+                    slot: c.slot,
+                    seq: c.seq,
+                });
+            }
+        }
+        self.volumes.tick = input.tick;
+        &self.events
+    }
+
+    fn state_hash(&self) -> u64 {
+        u64::from(self.volumes.tick)
+    }
+
+    fn entity_records(&self) -> &[EntityRecord] {
+        &self.records
+    }
+
+    fn hit_volumes(&self) -> &HitVolumes {
+        &self.volumes
+    }
+
+    fn portal_states(&self) -> &PortalStates {
+        &self.portals
+    }
+
+    fn reports(&self) -> &InputReports {
+        &self.reports
+    }
+}
+
+/// What a room does each tick: step, then push the new volumes into its ring.
+fn room_tick<S: SimCore + Send>(sim: &mut S, history: &mut HitHistory, input: &TickInput) -> usize {
+    let n = sim.step(input, history).len();
+    history.push(sim.hit_volumes());
+    n
+}
+
+#[test]
+fn s5_the_seam_types_are_send() {
+    fn send<T: Send>() {}
+    send::<Command>();
+    send::<CoverVariant>();
+    send::<Rewind>();
+    send::<TickInput>();
+    send::<EntityKind>();
+    send::<EntityRecord>();
+    send::<HitVolumes>();
+    send::<HitHistory>();
+    send::<PortalStates>();
+    send::<SimEvent>();
+    send::<ClampReport>();
+    send::<InputReports>();
+    send::<Field>();
+    send::<Config>();
+    send::<Stub>();
+    // And the trait carries a tick: a shot whose Rewind the lent ring holds runs; one outside it does not.
+    let mut sim = Stub {
+        events: Vec::new(),
+        records: vec![EntityRecord {
+            kind: EntityKind::Soldier,
+            index: 0,
+            generation: 0,
+            area: 0,
+            grid: [0; EntityRecord::FIELDS],
+            raw: [0; EntityRecord::FIELDS],
+        }],
+        volumes: HitVolumes::default(),
+        portals: PortalStates::default(),
+        reports: InputReports::default(),
+    };
+    let mut history = HitHistory::new(4);
+    history.push(&volumes(0));
+    let fire = |tick_a| Rewind {
+        tick_a,
+        fraction: 128,
+        cover: CoverVariant::Rewound,
+    };
+    let input = TickInput {
+        tick: 1,
+        commands: vec![
+            (
+                Command {
+                    slot: 1,
+                    seq: 7,
+                    ..Command::default()
+                },
+                Some(fire(0)),
+            ),
+            (
+                Command {
+                    slot: 2,
+                    seq: 9,
+                    ..Command::default()
+                },
+                Some(fire(99)),
+            ),
+            (
+                Command {
+                    slot: 3,
+                    ..Command::default()
+                },
+                None,
+            ),
+        ],
+    };
+    assert_eq!(room_tick(&mut sim, &mut history, &input), 1);
+    assert_eq!(sim.events, [SimEvent::Shot { slot: 1, seq: 7 }]);
+    assert_eq!(history.get(1).map(|v| v.tick), Some(1));
+    assert_eq!(sim.state_hash(), 1);
+    assert_eq!(sim.entity_records().len(), 1);
+    assert!(sim.portal_states().open.is_empty() && sim.reports().clamps.is_empty());
+}
+
+#[cfg(feature = "bites")]
+#[test]
+fn the_grids_bites_are_listed_chosen_per_value_and_each_moves_values_off_the_wire_grid() {
+    assert_eq!(Config::BITES.len(), 5);
+    for id in Config::BITES {
+        assert!(
+            Config::with_bite(id).is_some_and(|c| c != Config::default()),
+            "{id}"
+        );
+    }
+    assert!(Config::with_bite("PM-0001-17/no-such-bite").is_none());
+    let wire = Config::default();
+    // Floor rounding (-17's client site, -41's own-copy snap): it differs from the nearest on about half of all
+    // position values (u4-build-plan.md §4.14's unit proof for PM-0001-17/client-rounding).
+    for id in [
+        "PM-0001-17/client-rounding",
+        "PM-0001-41/server-quant-differs",
+    ] {
+        let floor = Config::with_bite(id).unwrap();
+        let (mut differ, mut all) = (0u32, 0u32);
+        for k in 0..2_000 {
+            for sixteenth in 0..16 {
+                let x = ((f64::from(k) + f64::from(sixteenth) / 16.0) / 100.0) as f32;
+                differ += u32::from(
+                    floor.to_grid(grid::POSITION_XY, x) != wire.to_grid(grid::POSITION_XY, x),
+                );
+                all += 1;
+            }
+        }
+        let share = f64::from(differ) / f64::from(all);
+        assert!((0.45..=0.6).contains(&share), "{id}: {share}");
+    }
+    // The coarse bites (-57's encoder sites): the stated steps, on their own kind only, never past the field.
+    for (id, f, every, other) in [
+        ("PM-0001-57/pos-4cm", grid::POSITION_XY, 4, grid::YAW),
+        ("PM-0001-57/pos-4cm", grid::POSITION_Z, 4, grid::PITCH),
+        ("PM-0001-57/yaw-12bit", grid::YAW, 16, grid::POSITION_XY),
+        ("PM-0001-57/pitch-8bit", grid::PITCH, 4, grid::VELOCITY),
+    ] {
+        let bite = Config::with_bite(id).unwrap();
+        let mut worst = 0.0f64;
+        for k in (f.min()..=f.max()).step_by(3) {
+            let x = wire.from_grid(f, k);
+            let got = bite.to_grid(f, x);
+            // A multiple of the coarse step, or a field end where the step's multiple fell outside.
+            assert!(
+                got % every == 0 || got == f.min() || got == f.max(),
+                "{id}: {k} → {got}"
+            );
+            assert!((f.min()..=f.max()).contains(&got), "{id}: {k} → {got}");
+            let e = error_in_steps(f, x, got).abs();
+            if e > worst {
+                worst = e;
+            }
+            assert_eq!(
+                bite.to_grid(other, wire.from_grid(other, 0)),
+                0,
+                "{id} leaves other kinds alone"
+            );
+            assert_eq!(
+                bite.from_grid(f, k).to_bits(),
+                x.to_bits(),
+                "{id}: from_grid unchanged"
+            );
+        }
+        let half = f64::from(every) / 2.0;
+        assert!(
+            worst > half - 1.0 && worst <= half + 0.01,
+            "{id}: worst error {worst} steps"
+        );
+    }
+}
