+        let mut went_dense = false;
+        for (i, (samples, spread)) in [
+            (40, 300_000u64),
+            (1_000, 2_000_000),
+            (5_000, 9_000_000),
+            (30, 200_000),
+            (0, 1),
+            (2_000, 60_000_000),
+            (300, 150_000),
