+#[test]
+fn u4j_ws_practice_puts_the_practice_runs_numbers_in_force() {
+    let (part, v) = ws_part(&ws_base());
+    assert_eq!(part.verdict, VerdictKind::Pass, "{:?}", part.why);
+    let checks = &part.runs[0].checks;
+    let median = checks.iter().find(|c| c.name.starts_with("WebSocket: half")).expect("check c");
+    assert_eq!(median.value.as_deref(), Some("690000000"));
+    assert!(median.needs.starts_with("<= 697000000 (X 670000000 x f 1.039755 = 697000000"), "{}", median.needs);
+    assert!(median.needs.contains("M_p 680000000 / M_m 654000000"), "{}", median.needs);
+    let over = checks.iter().find(|c| c.name.starts_with("WebSocket: at most")).expect("check d");
+    assert_eq!(over.value.as_deref(), Some("0"), "none over Y' = 2.6 s (6 over the unmoved 2.5 s)");
+    let bite = v.bites.iter().find(|b| b.id == "PM-0001-18/ws-budget-x2").expect("the WebSocket bite");
