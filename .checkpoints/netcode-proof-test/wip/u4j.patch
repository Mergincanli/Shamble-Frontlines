+            "run {} and its twin {} hashed no tick",
+            run.id, twin.id
+        )));
+    }
+    let differ = ticks
+        .iter()
+        .filter(|t| own.get(t) != other.get(t))
+        .count();
+    Ok(Ratio::int(differ as i128))
