+#[test]
+fn u4j_ws_practice_refuses_every_number_not_set_by_its_rules() {
+    let field = |name: &'static str, value: Value| {
+        move |w: &mut Ws| {
+            for f in &mut w.record {
+                if f.0 == name {
+                    f.1 = value.clone();
+                }
+            }
+        }
+    };
+    let bound = |from: &'static str, to: &'static str| field("bound", json!(WS_BOUND.replacen(from, to, 1)));
+    type Edit = Box<dyn Fn(&mut Ws)>;
+    let cases: Vec<(Edit, &str)> = vec![
+        (Box::new(|w| w.practice_binary = "b"), "holds no practice run of run ws-1's build"),
+        (Box::new(|w| w.practice_started = "2026-11-20T22:00:00Z"), "did not start before run ws-1"),
+        (Box::new(|w| w.counted_started = None), "run ws-1 has no params.started_utc"),
+        (Box::new(|w| w.counted_started = Some("20 Nov 2026 21:00")), "is not YYYY-MM-DDTHH:MM:SSZ"),
+        (Box::new(|w| w.practice_scene = "ES"), "ran another scene or profile"),
+        (Box::new(|w| w.practice_spacing = 20_000_000_000), "ran another burst spacing"),
+        (Box::new(|w| w.practice_footer = false), "practice run ws-practice is invalid: complete:"),
+        (Box::new(|w| w.records = 0), "holds 0 ws_practice records, not 1"),
+        (Box::new(|w| w.records = 2), "holds 2 ws_practice records, not 1"),
+        (Box::new(field("class", json!("BEYOND"))), "is \"BEYOND\" at s = 1.039755"),
+        (Box::new(field("class", json!("INVALID"))), "is \"INVALID\""),
+        (Box::new(field("m_p_ns", json!(681_000_000))), "the record's m_p_ns is not practice run ws-practice's median"),
+        (Box::new(field("x_moved_ns", json!(700_000_000))), "the record's x_moved_ns is not the judge's X 670000000"),
+        (Box::new(field("k_count", json!(6))), "the record's k_count is not the bound's"),
+        (Box::new(bound(r#""tolerance":"1.10""#, r#""tolerance":"1.05""#)), "the bound's tolerance 1.05 is not marks.json's 1.1"),
+        (Box::new(bound(r#""x_ns":670000000"#, r#""x_ns":680000000"#)), "holds 670000000 as the bound's X, the bound line says 680000000"),
+        (Box::new(bound(r#""k_count":5"#, r#""k_count":4"#)), "allows 5 over Y, the bound's k is 4"),
+        (Box::new(bound("npt-ws-bound v1 ", "npt-ws-bound ")), "the bound line does not start with"),
+        (Box::new(|w| w.practice = heals(680_000_000, 6, 2_610_000_000)), "but practice run ws-practice has 6 heals over 2600000000 ns"),
+        (
+            Box::new(|w| {
+                // M_p 740 ms: s = 740/654 = 1.1315, beyond the tolerance (the 240th of 480 heals, 750 ms above it).
+                let mut v = vec![600_000_000; 239];
+                v.push(740_000_000);
+                v.extend(std::iter::repeat_n(750_000_000, 235));
+                v.extend(std::iter::repeat_n(2_590_000_000, 5));
+                w.practice = v;
+                w.record[1].1 = json!(740_000_000);
+            }),
+            "is \"IN TOLERANCE\" at s = 1.131498",
+        ),
+    ];
+    for (edit, expected) in cases {
+        let mut w = ws_base();
+        edit(&mut w);
+        let (part, v) = ws_part(&w);
+        assert_eq!(part.verdict, VerdictKind::Invalid, "{expected}: {:?}", part.why);
+        assert!(says(&part.why, expected), "{expected}: {:?}", part.why);
+        assert_eq!(v.verdict, VerdictKind::Invalid, "{expected}");
+    }
+    // BEYOND with the advisor's chance ruling (a lone count or maximum failure, s within the tolerance) counts.
+    let mut w = ws_base();
+    field("class", json!("BEYOND"))(&mut w);
+    w.record.push(("chance_ruling", json!("advisor-r3.md:20")));
+    assert_eq!(ws_part(&w).0.verdict, VerdictKind::Pass);
+}
