+
+fn ws_log(run: &'static str, role: &'static str, binary: &'static str, started: Option<&'static str>, heals: &[i64]) -> LogSpec {
+    let mut s = LogSpec::room(run, "set-ws", "PM-0001-18");
+    s.role = role;
+    s.machine_role = "LG";
+    s.process = "bots";
+    s.profile = "B1";
+    s.binary = binary;
+    s.params = vec![("transport", json!("ws")), ("burst_spacing_ns", json!(30_000_000_000_i64))];
+    if let Some(t) = started {
+        s.params.push(("started_utc", json!(t)));
+    }
+    s.events = heals
+        .iter()
+        .enumerate()
+        .map(|(i, h)| {
+            EventRecord::new("burst_heal", Phase::Measured)
+                .with("after_link_ns", *h)
+                .with("slot", i as i64 % 48)
+                .with("burst", i as i64 / 48)
+        })
+        .collect();
+    s
