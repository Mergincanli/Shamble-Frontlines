+    let cpu_ns = value(&r, "l2_release_cpu_ns");
+    let send_secs = send_ns as f64 / 1e9;
+
+    // ---- Prints, every one before any assert.
+    println!(
+        "U3d self-test: P1 (seed 11), {n} per direction in {send_secs:.3} s = {:.0} pps each way; received down \
