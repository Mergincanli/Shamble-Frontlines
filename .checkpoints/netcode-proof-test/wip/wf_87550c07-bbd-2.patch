+[package]
+name = "npt-tcpinfo"
+description = "Two readings of a Linux TCP socket for the plain WebSocket path: tcpi_rtt (TCP_INFO) and SIOCOUTQ"
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+publish.workspace = true
+
+# The workspace lints, unsafe_code = "deny" included: the crate's two functions carry their own #[allow] with its
+# reason (ADR 0002:264-265; u3c-plan.md 1.8 (a)), never a crate-wide one. check.mjs's deps step checks it.
+[lints]
+workspace = true
+
+# libc is the only dependency, and only on Linux; the other targets build the stub (check.mjs's deps step).
+[target.'cfg(target_os = "linux")'.dependencies]
+libc.workspace = true
+
+[dev-dependencies]
+# Tests and the root-run probe only; already in Cargo.lock (tokio's). "all" opens TCP_QUICKACK, TCP_CONGESTION and
+# raw sockets (the probe's sock_diag query); a feature is not recorded in Cargo.lock.
+socket2 = { version = "=0.6.5", features = ["all"] }
diff --git a/spikes/netcode-proof/crates/tcpinfo/examples/siocoutq_probe.rs b/spikes/netcode-proof/crates/tcpinfo/examples/siocoutq_probe.rs
new file mode 100644
index 0000000..da59b55
--- /dev/null
+++ b/spikes/netcode-proof/crates/tcpinfo/examples/siocoutq_probe.rs
@@ -0,0 +1,577 @@
+//! The probe behind u3c-plan.md 1.8 (e)'s root run, which tells SIOCOUTQ (`write_seq - snd_una`, tcp.c:630) from
+//! SIOCOUTQNSD (`write_seq - snd_nxt`, tcp.c:632-640): it needs bytes that are sent but not acknowledged, so the ACK
+//! direction is dropped for about 1 s while the server end writes. The script
+//! `spikes/netcode-proof/results/u3c-kernel-check/siocoutq-root-check.sh` adds and removes the iptables rule (this
+//! program never touches the network's configuration) and holds the pass rule, which this program evaluates.
+//!
+//! Modes:
+//! - `siocoutq_probe lockstep --port P`: the script's protocol. stdout: `INFO`, then `READY`; stdin: `GO` (the rule is
+//!   in); stdout: one `SAMPLE` per write and per hold step, then `HOLD-END`; stdin: `RELEASED` (the rule is out);
+//!   stdout: the release sample, one `RULE` line per rule and `VERDICT PASS|FAIL|VOID`. Exit 0 pass, 1 fail, 2 void.
+//! - `siocoutq_probe zero-window`: a check without root of the sock_diag reader below: a client that never reads,
+//!   with a small receive buffer, closes its window; then nothing is in flight, so tcpi_notsent_bytes must equal
+//!   SIOCOUTQ, /proc's tx_queue and sock_diag's wqueue, all non-zero. Exit 0 pass, 1 fail.
+//!
+//! tcpi_notsent_bytes (`write_seq - snd_nxt`, tcp.c:3854) is read independently of npt-tcpinfo: a NETLINK_SOCK_DIAG
+//! dump with INET_DIAG_INFO, the kernel's own tcp_info for the socket, through socket2's safe calls (no unsafe code).
+
+use std::process::ExitCode;
+
+fn main() -> ExitCode {
+    #[cfg(target_os = "linux")]
+    {
+        probe::main()
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        eprintln!("siocoutq_probe: Linux only");
+        ExitCode::from(2)
+    }
+}
+
+#[cfg(target_os = "linux")]
+mod probe {
+    use std::io::{self, BufRead, Read, Write};
+    use std::mem::offset_of;
+    use std::net::{SocketAddr, TcpListener, TcpStream};
+    use std::os::fd::AsFd;
+    use std::process::ExitCode;
+    use std::sync::Arc;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::thread;
+    use std::time::{Duration, Instant};
+
+    use npt_tcpinfo::{srtt_us, unacked_and_unsent};
+    use socket2::{Domain, Protocol, SockRef, Socket, Type};
+
+    /// The run's fixed shape (the script's header states the same numbers).
+    const MSG: usize = 200;
+    const WRITES: u64 = 20;
+    const GAP: Duration = Duration::from_millis(5);
+    const HOLD_FIRST: Duration = Duration::from_millis(200);
+    const HOLD_STEP: Duration = Duration::from_millis(100);
+    const HOLD_END: Duration = Duration::from_millis(1_000);
+    /// "Near 0": at most one message's bytes not yet sent.
+    const NOTSENT_NEAR: u32 = MSG as u32;
+    /// Waits that only stop a hang (never a pass criterion).
+    const DELIVERY_WAIT: Duration = Duration::from_millis(100);
+    const SETTLE_WAIT: Duration = Duration::from_secs(2);
+    const RELEASE_WAIT: Duration = Duration::from_secs(5);
+
+    // include/uapi/linux/netlink.h, sock_diag.h, inet_diag.h, tcp_states.h (libc's Linux module lacks these).
+    const NETLINK_SOCK_DIAG: i32 = 4;
+    const NLM_F_REQUEST: u16 = 0x1;
+    const NLM_F_DUMP: u16 = 0x300;
+    const NLMSG_ERROR: u16 = 2;
+    const NLMSG_DONE: u16 = 3;
+    const SOCK_DIAG_BY_FAMILY: u16 = 20;
+    const INET_DIAG_INFO: u16 = 2;
+    const TCP_ESTABLISHED: u32 = 1;
+    /// struct nlmsghdr (16 B), then struct inet_diag_msg (72 B), then the attributes.
+    const NLMSG_HDR: usize = 16;
+    const DIAG_MSG: usize = 72;
+
+    /// One socket's sock_diag reading: inet_diag_msg's queues and the kernel's tcp_info fields this run needs.
+    #[derive(Debug, Clone, Copy)]
+    struct Diag {
+        /// inet_diag_msg.idiag_wqueue: `write_seq - snd_una` for an established TCP socket (tcp_diag_get_info).
+        wqueue: u32,
+        notsent: u32,
+        unacked_pkts: u32,
+        total_retrans: u32,
+        rto_us: u32,
+        rtt_us: u32,
+        backoff: u8,
+        ca_state: u8,
+    }
+
+    fn u32_at(b: &[u8], at: usize) -> Option<u32> {
+        b.get(at..at + 4)
+            .and_then(|s| s.try_into().ok())
+            .map(u32::from_ne_bytes)
+    }
+
+    fn u16_at(b: &[u8], at: usize) -> Option<u16> {
+        b.get(at..at + 2)
+            .and_then(|s| s.try_into().ok())
+            .map(u16::from_ne_bytes)
+    }
+
+    /// The tcp_info fields at their offset_of! in the attribute's bytes; None if the attribute is too short.
+    fn tcp_info_fields(info: &[u8], wqueue: u32) -> Option<Diag> {
+        Some(Diag {
+            wqueue,
+            notsent: u32_at(info, offset_of!(libc::tcp_info, tcpi_notsent_bytes))?,
+            unacked_pkts: u32_at(info, offset_of!(libc::tcp_info, tcpi_unacked))?,
+            total_retrans: u32_at(info, offset_of!(libc::tcp_info, tcpi_total_retrans))?,
+            rto_us: u32_at(info, offset_of!(libc::tcp_info, tcpi_rto))?,
+            rtt_us: u32_at(info, offset_of!(libc::tcp_info, tcpi_rtt))?,
+            backoff: *info.get(offset_of!(libc::tcp_info, tcpi_backoff))?,
+            ca_state: *info.get(offset_of!(libc::tcp_info, tcpi_ca_state))?,
+        })
+    }
+
+    /// The established IPv4 TCP socket bound to `sport` and connected to `dport`, read through a NETLINK_SOCK_DIAG
+    /// dump (every established IPv4 TCP socket in this network namespace, filtered here by its ports).
+    fn diag(sport: u16, dport: u16) -> io::Result<Option<Diag>> {
+        let nl = Socket::new(
+            Domain::from(libc::AF_NETLINK),
+            Type::RAW,
+            Some(Protocol::from(NETLINK_SOCK_DIAG)),
+        )?;
+        let mut req = Vec::with_capacity(NLMSG_HDR + 56);
+        req.extend_from_slice(&((NLMSG_HDR + 56) as u32).to_ne_bytes());
+        req.extend_from_slice(&SOCK_DIAG_BY_FAMILY.to_ne_bytes());
+        req.extend_from_slice(&(NLM_F_REQUEST | NLM_F_DUMP).to_ne_bytes());
+        req.extend_from_slice(&1u32.to_ne_bytes()); // nlmsg_seq
+        req.extend_from_slice(&0u32.to_ne_bytes()); // nlmsg_pid
+        // struct inet_diag_req_v2: family, protocol, ext (the INET_DIAG_INFO bit), pad, states, then a 48 B sockid a
+        // dump ignores.
+        req.extend_from_slice(&[
+            libc::AF_INET as u8,
+            libc::IPPROTO_TCP as u8,
+            1 << (INET_DIAG_INFO - 1),
+            0,
+        ]);
+        req.extend_from_slice(&(1u32 << TCP_ESTABLISHED).to_ne_bytes());
+        req.extend_from_slice(&[0u8; 48]);
+        nl.send(&req)?;
+        let mut buf = vec![0u8; 1 << 16];
+        let mut found = None;
+        loop {
+            let n = (&nl).read(&mut buf)?;
+            let mut at = 0;
+            while at + NLMSG_HDR <= n {
+                let len = u32_at(&buf, at).unwrap_or(0) as usize;
+                let kind = u16_at(&buf, at + 4).unwrap_or(0);
+                if len < NLMSG_HDR || at + len > n {
+                    return Err(io::Error::new(
+                        io::ErrorKind::InvalidData,
+                        "a truncated netlink message",
+                    ));
+                }
+                let msg = &buf[at + NLMSG_HDR..at + len];
+                match kind {
+                    NLMSG_DONE => return Ok(found),
+                    NLMSG_ERROR => {
+                        let errno = msg
+                            .get(..4)
+                            .and_then(|s| s.try_into().ok())
+                            .map(i32::from_ne_bytes)
+                            .unwrap_or(0);
+                        return Err(io::Error::from_raw_os_error(-errno));
+                    }
+                    SOCK_DIAG_BY_FAMILY if msg.len() >= DIAG_MSG => {
+                        // inet_diag_msg: family, state, timer, retrans; the sockid (sport, dport in network order);
+                        // expires, rqueue, wqueue, uid, inode.
+                        let sp = u16::from_be_bytes([msg[4], msg[5]]);
+                        let dp = u16::from_be_bytes([msg[6], msg[7]]);
+                        if sp == sport && dp == dport {
+                            let wqueue = u32_at(msg, 60).unwrap_or(0);
+                            let mut a = DIAG_MSG;
+                            while a + 4 <= msg.len() {
+                                let rlen = usize::from(u16_at(msg, a).unwrap_or(0));
+                                let rtype = u16_at(msg, a + 2).unwrap_or(0);
+                                if rlen < 4 || a + rlen > msg.len() {
+                                    break;
+                                }
+                                if rtype == INET_DIAG_INFO {
+                                    found = tcp_info_fields(&msg[a + 4..a + rlen], wqueue);
+                                }
+                                a += rlen.next_multiple_of(4);
+                            }
+                        }
+                    }
+                    _ => {}
+                }
+                at += len.next_multiple_of(4);
+            }
+        }
+    }
+
+    fn outq(s: &TcpStream) -> io::Result<u32> {
+        unacked_and_unsent(s.as_fd())
+    }
+
+    /// /proc/net/tcp's tx_queue for the IPv4 socket bound to `local` and connected to `remote` (tcp_ipv4.c:2899).
+    fn proc_tx_queue(local: u16, remote: u16) -> io::Result<Option<u32>> {
+        let table = std::fs::read_to_string("/proc/net/tcp")?;
+        for row in table.lines().skip(1) {
+            let f: Vec<&str> = row.split_whitespace().collect();
+            let port = |i: usize| {
+                f.get(i)
+                    .and_then(|a| a.rsplit(':').next())
+                    .and_then(|p| u16::from_str_radix(p, 16).ok())
+            };
+            if port(1) == Some(local) && port(2) == Some(remote) {
+                let tx = f
+                    .get(4)
+                    .and_then(|q| q.split_once(':'))
+                    .and_then(|(tx, _)| u32::from_str_radix(tx, 16).ok());
+                return Ok(tx);
+            }
+        }
+        Ok(None)
+    }
+
+    fn wait_until(limit: Duration, mut done: impl FnMut() -> bool) -> bool {
+        let end = Instant::now() + limit;
+        loop {
+            if done() {
+                return true;
+            }
+            if Instant::now() >= end {
+                return false;
+            }
+            thread::sleep(Duration::from_micros(200));
+        }
+    }
+
+    fn kernel_release() -> String {
+        std::fs::read_to_string("/proc/sys/kernel/osrelease")
+            .map_or_else(|e| format!("unknown ({e})"), |s| s.trim().to_owned())
+    }
+
+    pub(crate) fn main() -> ExitCode {
+        let args: Vec<String> = std::env::args().skip(1).collect();
+        let result = match args.first().map(String::as_str) {
+            Some("lockstep") => match (
+                args.get(1).map(String::as_str),
+                args.get(2).map(|p| p.parse::<u16>()),
+            ) {
+                (Some("--port"), Some(Ok(port))) if port != 0 => lockstep(port),
+                _ => Err(io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    "lockstep needs --port <1-65535>",
+                )),
+            },
+            Some("zero-window") => zero_window(),
+            _ => Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "usage: siocoutq_probe lockstep --port P | zero-window",
+            )),
+        };
+        match result {
+            Ok(code) => code,
+            Err(e) => {
+                println!("VERDICT VOID probe error: {e}");
+                ExitCode::from(2)
+            }
+        }
+    }
+
+    /// One reading: SIOCOUTQ, sock_diag, SIOCOUTQ again (the two agree when no ACK arrived in between).
+    struct Sample {
+        phase: &'static str,
+        k: u64,
+        t_us: u128,
+        written: u64,
+        q1: u32,
+        q2: u32,
+        delivered: u64,
+        diag: Option<Diag>,
+    }
+
+    impl Sample {
+        fn line(&self) -> String {
+            let d = self.diag.map_or_else(
+                || "diag=none".to_owned(),
+                |d| {
+                    format!(
+                        "notsent={} wqueue={} unacked_pkts={} total_retrans={} rto_us={} rtt_us={} backoff={} ca_state={}",
+                        d.notsent, d.wqueue, d.unacked_pkts, d.total_retrans, d.rto_us, d.rtt_us, d.backoff, d.ca_state
+                    )
+                },
+            );
+            format!(
+                "SAMPLE phase={} k={} t_us={} written={} siocoutq={} siocoutq_again={} delivered={} {d}",
+                self.phase, self.k, self.t_us, self.written, self.q1, self.q2, self.delivered
+            )
+        }
+    }
+
+    fn say(line: &str) {
+        let mut out = io::stdout().lock();
+        // A closed pipe means the script is gone; the probe then ends at its next read of stdin.
+        let _ = writeln!(out, "{line}");
+        let _ = out.flush();
+    }
+
+    fn expect_command(
+        lines: &mut impl Iterator<Item = io::Result<String>>,
+        want: &str,
+    ) -> io::Result<()> {
+        match lines.next() {
+            Some(Ok(l)) if l.trim() == want => Ok(()),
+            Some(Ok(l)) => Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                format!("expected {want}, got {l:?}"),
+            )),
+            Some(Err(e)) => Err(e),
+            None => Err(io::Error::new(
+                io::ErrorKind::UnexpectedEof,
+                format!("stdin closed before {want}"),
+            )),
+        }
+    }
+
+    fn lockstep(port: u16) -> io::Result<ExitCode> {
+        let listener = TcpListener::bind(SocketAddr::from(([127, 0, 0, 1], port)))?;
+        let client = TcpStream::connect(listener.local_addr()?)?;
+        let (server, _) = listener.accept()?;
+        server.set_nodelay(true)?;
+        let cport = client.local_addr()?.port();
+        // The model the cross-checks compare with is Cubic; this container defaults to bbr (u3-scout-timing.md:388).
+        let cc_set = SockRef::from(&server).set_tcp_congestion(b"cubic");
+        let cc = SockRef::from(&server).tcp_congestion().map(|b| {
+            String::from_utf8_lossy(&b)
+                .trim_end_matches('\0')
+                .to_owned()
+        });
+
+        // The client reads everything, counting the bytes, until the server closes.
+        let delivered = Arc::new(AtomicU64::new(0));
+        let reader = {
+            let delivered = Arc::clone(&delivered);
+            let mut client = client.try_clone()?;
+            thread::spawn(move || {
+                let mut buf = [0u8; 4_096];
+                while let Ok(n) = client.read(&mut buf) {
+                    if n == 0 {
+                        break;
+                    }
+                    delivered.fetch_add(n as u64, Ordering::SeqCst);
+                }
+            })
+        };
+
+        // Warm-up: RTT samples, then everything acknowledged.
+        let mut server_w = server.try_clone()?;
+        for _ in 0..WRITES {
+            server_w.write_all(&[5; MSG])?;
+        }
+        let warm = WRITES * MSG as u64;
+        let warm_ok = wait_until(SETTLE_WAIT, || delivered.load(Ordering::SeqCst) == warm)
+            && wait_until(SETTLE_WAIT, || outq(&server).is_ok_and(|q| q == 0));
+        let srtt = srtt_us(server.as_fd())?;
+        let d0 = diag(port, cport)?;
+        say(&format!(
+            "INFO kernel={} port={port} client_port={cport} congestion={} congestion_set={} srtt_us={srtt:?} \
+             siocoutq={} notsent={:?} rto_us={:?} total_retrans={:?} notsent_offset={} rtt_offset={}",
+            kernel_release(),
+            cc.as_deref().unwrap_or("unknown"),
+            if cc_set.is_ok() { "ok" } else { "refused" },
+            outq(&server)?,
+            d0.map(|d| d.notsent),
+            d0.map(|d| d.rto_us),
+            d0.map(|d| d.total_retrans),
+            offset_of!(libc::tcp_info, tcpi_notsent_bytes),
+            offset_of!(libc::tcp_info, tcpi_rtt),
+        ));
+        // npt-tcpinfo's srtt_us must agree with the kernel's tcp_info read through sock_diag (0 reads as None). The
+        // connection is idle, so tcpi_rtt cannot move between the two reads. It is not required to be above 0:
+        // loopback's RTT is a few us and tcpi_rtt is in whole us.
+        let r0 = warm_ok
+            && d0.is_some_and(|d| {
+                d.notsent == 0 && d.wqueue == 0 && srtt == Some(d.rtt_us).filter(|&us| us != 0)
+            });
+        let Some(d0) = d0.filter(|_| r0) else {
+            say(
+                "RULE R0 fail setup: warm-up not acknowledged, no sock_diag reading, or srtt_us disagrees with it",
+            );
+            say("VERDICT VOID setup");
+            return Ok(ExitCode::from(2));
+        };
+        say("RULE R0 pass");
+        say("READY");
+
+        let stdin = io::stdin();
+        let mut lines = stdin.lock().lines();
+        expect_command(&mut lines, "GO")?;
+        let t0 = Instant::now();
+        let base = delivered.load(Ordering::SeqCst);
+        let mut samples = Vec::new();
+        let sample = |phase, k, written, samples: &mut Vec<Sample>| -> io::Result<()> {
+            let q1 = outq(&server)?;
+            let diag = diag(port, cport)?;
+            let q2 = outq(&server)?;
+            let s = Sample {
+                phase,
+                k,
+                t_us: t0.elapsed().as_micros(),
+                written,
+                q1,
+                q2,
+                delivered: delivered.load(Ordering::SeqCst) - base,
+                diag,
+            };
+            say(&s.line());
+            samples.push(s);
+            Ok(())
+        };
+
+        // The write phase: WRITES x MSG at GAP, all inside the first RTO (checked below).
+        let mut last_write_us = 0;
+        for k in 1..=WRITES {
+            let due = t0 + GAP * u32::try_from(k - 1).unwrap_or(u32::MAX);
+            if let Some(wait) = due.checked_duration_since(Instant::now()) {
+                thread::sleep(wait);
+            }
+            server_w.write_all(&[6; MSG])?;
+            last_write_us = t0.elapsed().as_micros();
+            let written = k * MSG as u64;
+            wait_until(DELIVERY_WAIT, || {
+                delivered.load(Ordering::SeqCst) - base >= written
+            });
+            sample("write", k, written, &mut samples)?;
+        }
+        // The hold: the drop stays in until about HOLD_END after GO.
+        let total = WRITES * MSG as u64;
+        let mut next = HOLD_FIRST;
+        let mut i = 0;
+        while next <= HOLD_END {
+            if let Some(wait) = (t0 + next).checked_duration_since(Instant::now()) {
+                thread::sleep(wait);
+            }
+            i += 1;
+            sample("hold", i, total, &mut samples)?;
+            next += HOLD_STEP;
+        }
+        say("HOLD-END");
+        expect_command(&mut lines, "RELEASED")?;
+        let released = Instant::now();
+        let zero = wait_until(RELEASE_WAIT, || outq(&server).is_ok_and(|q| q == 0));
+        let release_ms = released.elapsed().as_millis();
+        sample("release", 1, total, &mut samples)?;
+
+        // The rule, as the script's header states it.
+        let mut fails = Vec::new();
+        let mut void = Vec::new();
+        if last_write_us >= u128::from(d0.rto_us) {
+            void.push(format!(
+                "the last write came {last_write_us} us after GO, not before the first RTO ({} us)",
+                d0.rto_us
+            ));
+        }
+        for s in samples.iter().filter(|s| s.phase != "release") {
+            let Some(d) = s.diag else {
+                void.push(format!("{} {}: no sock_diag reading", s.phase, s.k));
+                continue;
+            };
+            let want = u32::try_from(s.written).unwrap_or(u32::MAX);
+            let rule = if s.phase == "write" { "R1" } else { "R2" };
+            if s.q1 != want || s.q2 != want {
+                fails.push(format!(
+                    "{rule} {} {}: SIOCOUTQ {} then {}, not {want}",
+                    s.phase, s.k, s.q1, s.q2
+                ));
+            }
+            if s.delivered < s.written {
+                fails.push(format!(
+                    "{rule} {} {}: the peer read {} of {}",
+                    s.phase, s.k, s.delivered, s.written
+                ));
+            }
+            if d.notsent > NOTSENT_NEAR {
+                fails.push(format!(
+                    "{rule} {} {}: tcpi_notsent_bytes {} > {NOTSENT_NEAR}",
+                    s.phase, s.k, d.notsent
+                ));
+            }
+        }
+        let retrans_end = samples
+            .iter()
+            .filter(|s| s.phase == "hold")
+            .filter_map(|s| s.diag)
+            .map(|d| d.total_retrans)
+            .next_back();
+        if !retrans_end.is_some_and(|r| r > d0.total_retrans) {
+            fails.push(format!(
+                "R3: tcpi_total_retrans {} at GO, {retrans_end:?} at the hold's end: no retransmission, so no ACK was dropped",
+                d0.total_retrans
+            ));
+        }
+        if !zero {
+            fails.push(format!(
+                "R4: SIOCOUTQ not 0 within {} s of RELEASED",
+                RELEASE_WAIT.as_secs()
+            ));
+        }
+        for r in ["R1", "R2", "R3", "R4"] {
+            let mine: Vec<&String> = fails.iter().filter(|f| f.starts_with(r)).collect();
+            if mine.is_empty() {
+                say(&format!("RULE {r} pass"));
+            } else {
+                say(&format!(
+                    "RULE {r} fail ({} findings; first: {})",
+                    mine.len(),
+                    mine[0]
+                ));
+            }
+        }
+        say(&format!(
+            "INFO release_ms={release_ms} last_write_us={last_write_us}"
+        ));
+
+        drop(server_w);
+        let _ = server.shutdown(std::net::Shutdown::Both);
+        let _ = reader.join();
+        Ok(if !void.is_empty() {
+            say(&format!("VERDICT VOID {}", void.join("; ")));
+            ExitCode::from(2)
+        } else if fails.is_empty() {
+            say("VERDICT PASS");
+            ExitCode::SUCCESS
+        } else {
+            say(&format!("VERDICT FAIL {} findings", fails.len()));
+            ExitCode::from(1)
+        })
+    }
+
+    /// The sock_diag reader's own check, without root: a closed window leaves nothing in flight, so the unsent bytes
+    /// equal the unacknowledged ones, and four readings must agree.
+    fn zero_window() -> io::Result<ExitCode> {
+        let listener = TcpListener::bind("127.0.0.1:0")?;
+        let to = listener.local_addr()?;
+        let c = Socket::new(Domain::IPV4, Type::STREAM, None)?;
+        c.set_recv_buffer_size(4_096)?;
+        c.connect(&to.into())?;
+        let client: TcpStream = c.into();
+        let (mut server, _) = listener.accept()?;
+        server.set_nodelay(true)?;
+        server.set_nonblocking(true)?;
+        let (sp, cp) = (to.port(), client.local_addr()?.port());
+        let mut written = 0u64;
+        loop {
+            match server.write(&[1; 1_000]) {
+                Ok(n) => written += n as u64,
+                Err(e) if e.kind() == io::ErrorKind::WouldBlock => break,
+                Err(e) => return Err(e),
+            }
+        }
+        let mut last = None;
+        let agree = wait_until(Duration::from_secs(5), || {
+            let (Ok(q1), Ok(Some(d)), Ok(Some(tx)), Ok(q2)) = (
+                outq(&server),
+                diag(sp, cp),
+                proc_tx_queue(sp, cp),
+                outq(&server),
+            ) else {
+                return false;
+            };
+            last = Some((q1, q2, d.notsent, d.wqueue, tx));
+            q1 == q2 && q1 > 0 && d.notsent == q1 && d.wqueue == q1 && tx == q1
+        });
+        say(&format!(
+            "SELFCHECK written={written} (SIOCOUTQ, again, tcpi_notsent_bytes, wqueue, tx_queue)={last:?}"
+        ));
+        drop(client);
+        Ok(if agree {
+            say("SELFCHECK PASS");
+            ExitCode::SUCCESS
+        } else {
+            say("SELFCHECK FAIL");
+            ExitCode::from(1)
+        })
+    }
+}
diff --git a/spikes/netcode-proof/crates/tcpinfo/src/lib.rs b/spikes/netcode-proof/crates/tcpinfo/src/lib.rs
new file mode 100644
index 0000000..ca0b4f2
--- /dev/null
+++ b/spikes/netcode-proof/crates/tcpinfo/src/lib.rs
@@ -0,0 +1,43 @@
+//! npt-tcpinfo: two readings of a Linux TCP socket's send side, for npt-net's WebSocket server on the plain path (P0
+//! and ML run without DelayStream), where fix 1's send gate reads the kernel instead of the TCP model (u3c-plan.md 1.3
+//! and 1.8; R20 (a)).
+//!
+//! - [`srtt_us`]: the smoothed round-trip time, `tcpi_rtt` from getsockopt(IPPROTO_TCP, TCP_INFO), which Linux fills
+//!   as `tp->srtt_us >> 3` (v6.8 net/ipv4/tcp.c:3842).
+//! - [`unacked_and_unsent`]: ioctl SIOCOUTQ, `write_seq - snd_una` (tcp.c:630): every byte written to the socket and
+//!   not yet acknowledged, sent or not. Not SIOCOUTQNSD (`write_seq - snd_nxt`, tcp.c:632-640), which counts only the
+//!   bytes not yet sent; /proc/net/tcp's tx_queue is the same `write_seq - snd_una` (tcp_ipv4.c:2899).
+//!
+//! **The spike's second `unsafe` exception** (the first is npt-client-wasm's), granted by the advisor under ADR
+//! 0002:264-265's rule: "an exception needs a written invariant, a test and an `#[allow]` with its reason". The
+//! `#[allow(unsafe_code)]` sits on the two functions only, never on the crate. Each unsafe block holds one unsafe
+//! operation and a SAFETY comment stating its invariant (the two clippy lints below are errors). The `tcp_info`
+//! field is read from the bytes the kernel wrote at `offset_of!`, with no further unsafe code. libc is the only
+//! dependency, and only npt-net uses the crate: check.mjs's deps step checks both, and that `allow(unsafe_code`
+//! appears in no crate but npt-client-wasm and this one.
+//!
+//! **What the caller must pass:** a TCP socket's descriptor. SIOCOUTQ shares its number with TIOCOUTQ, so on a
+//! terminal the same call reads the terminal's output queue, and on a UDP socket its queued bytes; npt-net's caller
+//! passes a `tokio::net::TcpStream`'s descriptor only.
+//!
+//! **Linux only.** On every other target the two functions are stubs that return `ErrorKind::Unsupported`, so the
+//! workspace still builds there.
+
+#![deny(
+    clippy::undocumented_unsafe_blocks,
+    clippy::multiple_unsafe_ops_per_block
+)]
+
+#[cfg(target_os = "linux")]
+mod linux;
+#[cfg(target_os = "linux")]
+pub use linux::{srtt_us, unacked_and_unsent};
+
+// The stub is the other targets' implementation; on Linux it is compiled for its own test only.
+#[cfg(any(not(target_os = "linux"), test))]
+mod stub;
+#[cfg(not(target_os = "linux"))]
+pub use stub::{srtt_us, unacked_and_unsent};
+
+#[cfg(all(test, target_os = "linux"))]
+mod tests;
diff --git a/spikes/netcode-proof/crates/tcpinfo/src/linux.rs b/spikes/netcode-proof/crates/tcpinfo/src/linux.rs
new file mode 100644
index 0000000..407bddf
--- /dev/null
+++ b/spikes/netcode-proof/crates/tcpinfo/src/linux.rs
@@ -0,0 +1,97 @@
+//! The two Linux calls. Each unsafe block holds one unsafe operation (the foreign call) and states the invariant that
+//! makes it sound; everything around the calls is safe code.
+
+use std::io;
+use std::mem::offset_of;
+use std::os::fd::{AsRawFd, BorrowedFd};
+
+/// The ioctl request: Linux's SIOCOUTQ, which include/uapi/linux/sockios.h defines as TIOCOUTQ: 0x5411 on x86-64 and
+/// aarch64 (include/uapi/asm-generic/ioctls.h), with other values on mips, powerpc and sparc, which libc carries. Not
+/// SIOCOUTQNSD (0x894B).
+pub(crate) const SIOCOUTQ: libc::Ioctl = libc::TIOCOUTQ;
+
+/// Where `tcpi_rtt` sits in the bytes TCP_INFO writes, and the length the kernel's answer must reach to hold it.
+const RTT_AT: usize = offset_of!(libc::tcp_info, tcpi_rtt);
+const RTT_END: usize = RTT_AT + size_of::<u32>();
+
+/// The socket's smoothed round-trip time in microseconds: `tcpi_rtt`, which Linux fills as `tp->srtt_us >> 3` (v6.8
+/// net/ipv4/tcp.c:3842). `None` when it is 0, before the first RTT sample (a new socket's `srtt_us` is 0): fix 1's
+/// gate then takes its 100 ms default.
+///
+/// The kernel writes into a zeroed buffer the size of `libc::tcp_info`; the field is read at its `offset_of!` from the
+/// bytes written, so no second unsafe operation is needed.
+///
+/// # Errors
+/// The getsockopt error (for example ENOTSOCK, or ENOPROTOOPT on a socket that is not TCP), or
+/// `ErrorKind::Unsupported` when the kernel's answer is too short to hold `tcpi_rtt`.
+#[allow(
+    unsafe_code,
+    reason = "getsockopt(TCP_INFO) has no safe wrapper in std or in the pinned crates (socket2 0.6.5, rustix 1.1.6, \
+              nix 0.31.3): one foreign call writing into a buffer this function owns (ADR 0002:264-265; R20 (a))"
+)]
+pub fn srtt_us(fd: BorrowedFd<'_>) -> io::Result<Option<u32>> {
+    let mut info = [0u8; size_of::<libc::tcp_info>()];
+    let Ok(mut len) = libc::socklen_t::try_from(info.len()) else {
+        return Err(io::Error::from(io::ErrorKind::Unsupported));
+    };
+    // SAFETY: `fd` is an open descriptor for the whole call (BorrowedFd's guarantee). `info` is a live, writable buffer
+    // of exactly `len` bytes owned by this function, and `len` is a live socklen_t holding that size, so the kernel
+    // writes at most `len` bytes into memory we own and stores how many it wrote in `len`. Any bytes are a valid
+    // `[u8]`, and u8 needs no alignment, so the buffer stays valid whatever the kernel writes.
+    let rc = unsafe {
+        libc::getsockopt(
+            fd.as_raw_fd(),
+            libc::IPPROTO_TCP,
+            libc::TCP_INFO,
+            info.as_mut_ptr().cast(),
+            &raw mut len,
+        )
+    };
+    if rc != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    rtt_from(&info, usize::try_from(len).unwrap_or(0))
+}
+
+/// The bytes written to the socket and not yet acknowledged by the peer, sent or not: ioctl SIOCOUTQ, which Linux
+/// answers as `write_seq - snd_una` (v6.8 net/ipv4/tcp.c:630), 0 while the handshake runs (:627-628).
+///
+/// # Errors
+/// The ioctl error: EINVAL on a listening socket (tcp.c:624-625), ENOTTY on a descriptor that is neither a socket nor
+/// a terminal. `ErrorKind::InvalidData` if the kernel's int were negative.
+#[allow(
+    unsafe_code,
+    reason = "ioctl(SIOCOUTQ) has no safe wrapper in std or in the pinned crates (socket2 0.6.5, rustix 1.1.6, \
+              nix 0.31.3): one foreign call writing one int this function owns (ADR 0002:264-265; R20 (a))"
+)]
+pub fn unacked_and_unsent(fd: BorrowedFd<'_>) -> io::Result<u32> {
+    let mut answ: libc::c_int = 0;
+    // SAFETY: `fd` is an open descriptor for the whole call (BorrowedFd's guarantee). SIOCOUTQ's argument is an
+    // `int *`: tcp_ioctl stores one int (tcp.c:646, `*karg = answ`) and the socket layer copies exactly that int out
+    // to the pointer (TIOCOUTQ on a terminal writes one int too). `answ` is a live, aligned, writable c_int owned by
+    // this function, and the variadic argument is passed as a pointer to it.
+    let rc = unsafe { libc::ioctl(fd.as_raw_fd(), SIOCOUTQ, &raw mut answ) };
+    if rc < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    u32::try_from(answ)
+        .map_err(|_| io::Error::new(io::ErrorKind::InvalidData, format!("SIOCOUTQ gave {answ}")))
+}
+
+/// `tcpi_rtt` from the bytes getsockopt wrote: `Unsupported` unless the `written` length covers the whole field
+/// (a kernel or a sandbox with a shorter `tcp_info`); 0 maps to `None`.
+pub(crate) fn rtt_from(info: &[u8], written: usize) -> io::Result<Option<u32>> {
+    let field: Option<[u8; 4]> = if written >= RTT_END {
+        info.get(RTT_AT..RTT_END).and_then(|b| b.try_into().ok())
+    } else {
+        None
+    };
+    let Some(bytes) = field else {
+        return Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            format!("TCP_INFO wrote {written} bytes; tcpi_rtt needs {RTT_END}"),
+        ));
+    };
+    let rtt = u32::from_ne_bytes(bytes);
+    Ok((rtt != 0).then_some(rtt))
+}
diff --git a/spikes/netcode-proof/crates/tcpinfo/src/stub.rs b/spikes/netcode-proof/crates/tcpinfo/src/stub.rs
new file mode 100644
index 0000000..0317763
--- /dev/null
+++ b/spikes/netcode-proof/crates/tcpinfo/src/stub.rs
@@ -0,0 +1,28 @@
+//! Every target but Linux: the same two names, which report `ErrorKind::Unsupported` and nothing else. They take any
+//! handle (a `BorrowedFd` on another Unix, a `BorrowedSocket` on Windows, anything on a target with neither), so a
+//! caller compiles everywhere. No unsafe code here.
+
+use std::io;
+
+/// The stub of the Linux `srtt_us`: always `ErrorKind::Unsupported`.
+///
+/// # Errors
+/// Always `ErrorKind::Unsupported`.
+pub fn srtt_us<H>(_fd: H) -> io::Result<Option<u32>> {
+    Err(unsupported())
+}
+
+/// The stub of the Linux `unacked_and_unsent`: always `ErrorKind::Unsupported`.
+///
+/// # Errors
+/// Always `ErrorKind::Unsupported`.
+pub fn unacked_and_unsent<H>(_fd: H) -> io::Result<u32> {
+    Err(unsupported())
+}
+
+fn unsupported() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::Unsupported,
+        "npt-tcpinfo reads Linux TCP sockets only",
+    )
+}
diff --git a/spikes/netcode-proof/crates/tcpinfo/src/tests.rs b/spikes/netcode-proof/crates/tcpinfo/src/tests.rs
new file mode 100644
index 0000000..687279b
--- /dev/null
+++ b/spikes/netcode-proof/crates/tcpinfo/src/tests.rs
@@ -0,0 +1,310 @@
+//! The crate's tests (u3c-plan.md 1.8 (e)), on real loopback sockets. Each is judged on identities between two kernel
+//! readings of the same quantity (SIOCOUTQ against /proc/net/tcp's tx_queue, both `write_seq - snd_una`: tcp.c:630,
+//! tcp_ipv4.c:2899), never on a wall-clock threshold; a time limit only stops a wait from hanging. The root-only
+//! check (the ACK direction dropped by iptables) is the probe example's, run by
+//! results/u3c-kernel-check/siocoutq-root-check.sh.
+
+use std::io::{ErrorKind, Read, Write};
+use std::mem::offset_of;
+use std::net::{SocketAddr, TcpListener, TcpStream};
+use std::os::fd::AsFd;
+use std::time::{Duration, Instant};
+
+use socket2::{Domain, SockRef, Socket, Type};
+
+use crate::linux::{SIOCOUTQ, rtt_from};
+use crate::{srtt_us, unacked_and_unsent};
+
+/// A connected loopback pair: (listener, the accepted server end S, the client end C). The client's SO_RCVBUF is set
+/// before connect when given, so the window it advertises is small from the handshake on.
+fn pair(client_rcvbuf: Option<usize>) -> (TcpListener, TcpStream, TcpStream) {
+    let listener = TcpListener::bind("127.0.0.1:0").expect("bind");
+    let to: SocketAddr = listener.local_addr().expect("listener address");
+    let client = Socket::new(Domain::IPV4, Type::STREAM, None).expect("socket");
+    if let Some(bytes) = client_rcvbuf {
+        client.set_recv_buffer_size(bytes).expect("SO_RCVBUF");
+    }
+    client.connect(&to.into()).expect("connect");
+    let (server, _) = listener.accept().expect("accept");
+    server.set_nodelay(true).expect("TCP_NODELAY");
+    (listener, server, client.into())
+}
+
+fn port(s: &TcpStream) -> u16 {
+    s.local_addr().expect("local address").port()
+}
+
+fn outq(s: &TcpStream) -> u32 {
+    unacked_and_unsent(s.as_fd()).expect("SIOCOUTQ")
+}
+
+/// One read of /proc/net/tcp: (tx_queue, rx_queue) of the IPv4 socket bound to `local` and connected to `remote`, and
+/// of its peer, the socket bound to `remote` and connected to `local`. tx_queue is `write_seq - snd_una`, rx_queue
+/// `rcv_nxt - copied_seq` (tcp_ipv4.c:2893-2900).
+fn proc_queues(local: u16, remote: u16) -> ((u32, u32), (u32, u32)) {
+    let table = std::fs::read_to_string("/proc/net/tcp").expect("/proc/net/tcp");
+    let mut mine = None;
+    let mut peer = None;
+    for row in table.lines().skip(1) {
+        let f: Vec<&str> = row.split_whitespace().collect();
+        let hex_port = |field: &str| {
+            field
+                .rsplit(':')
+                .next()
+                .and_then(|p| u16::from_str_radix(p, 16).ok())
+        };
+        let (Some(l), Some(r), Some(q)) = (f.get(1), f.get(2), f.get(4)) else {
+            continue;
+        };
+        let Some((tx, rx)) = q.split_once(':') else {
+            continue;
+        };
+        let queues = (
+            u32::from_str_radix(tx, 16).expect("tx_queue"),
+            u32::from_str_radix(rx, 16).expect("rx_queue"),
+        );
+        match (hex_port(l), hex_port(r)) {
+            (Some(a), Some(b)) if a == local && b == remote => mine = Some(queues),
+            (Some(a), Some(b)) if a == remote && b == local => peer = Some(queues),
+            _ => {}
+        }
+    }
+    (
+        mine.expect("the socket's row"),
+        peer.expect("its peer's row"),
+    )
+}
+
+/// Polls `done` every 0.5 ms until it holds or `limit` passes; whether it held. The limit only stops a hang.
+fn wait_until(limit: Duration, mut done: impl FnMut() -> bool) -> bool {
+    let end = Instant::now() + limit;
+    loop {
+        if done() {
+            return true;
+        }
+        if Instant::now() >= end {
+            return false;
+        }
+        std::thread::sleep(Duration::from_micros(500));
+    }
+}
+
+/// Ping-pongs `rounds` 100 B messages each way, so both ends have RTT samples and every byte is acknowledged.
+fn exchange(s: &mut TcpStream, c: &mut TcpStream, rounds: usize) {
+    let mut buf = [0u8; 100];
+    for _ in 0..rounds {
+        s.write_all(&[7; 100]).expect("server write");
+        c.read_exact(&mut buf).expect("client read");
+        c.write_all(&[8; 100]).expect("client write");
+        s.read_exact(&mut buf).expect("server read");
+    }
+}
+
+#[test]
+fn the_request_is_siocoutq_0x5411_not_siocoutqnsd() {
+    #[cfg(any(target_arch = "x86_64", target_arch = "aarch64"))]
+    assert_eq!(
+        SIOCOUTQ, 0x5411,
+        "SIOCOUTQ = TIOCOUTQ = 0x5411 (asm-generic/ioctls.h)"
+    );
+    assert_ne!(
+        SIOCOUTQ, 0x894B,
+        "SIOCOUTQNSD counts only the unsent bytes (tcp.c:632-640)"
+    );
+}
+
+#[test]
+fn siocoutq_on_a_listening_socket_is_einval() {
+    let listener = TcpListener::bind("127.0.0.1:0").expect("bind");
+    let err = unacked_and_unsent(listener.as_fd()).expect_err("a listener has no send queue");
+    assert_eq!(
+        err.raw_os_error(),
+        Some(libc::EINVAL),
+        "tcp.c:624-625: {err}"
+    );
+}
+
+#[test]
+fn tcpi_rtt_is_none_before_a_sample_and_some_after_traffic() {
+    let fresh = Socket::new(Domain::IPV4, Type::STREAM, None).expect("socket");
+    assert_eq!(
+        srtt_us(fresh.as_fd()).expect("TCP_INFO on a new socket"),
+        None,
+        "a new socket's srtt_us is 0: no sample yet"
+    );
+    let (_listener, mut s, mut c) = pair(None);
+    exchange(&mut s, &mut c, 20);
+    let quick = (
+        srtt_us(s.as_fd()).expect("TCP_INFO"),
+        srtt_us(c.as_fd()).expect("TCP_INFO"),
+    );
+    // Loopback's RTT is about 2 us here (it read 1 us in one of 20 runs), and tcpi_rtt is in whole microseconds, so an
+    // RTT under 1 us would read 0. Five samples each way through a peer in delayed-ACK mode (its ACK waits for the
+    // delayed-ACK timer, tens of ms) put the srtt well above that floor, so the test does not depend on the CPU's speed.
+    for _ in 0..5 {
+        delayed_ack_sample(&mut s, &mut c);
+        delayed_ack_sample(&mut c, &mut s);
+    }
+    let server = srtt_us(s.as_fd()).expect("TCP_INFO");
+    let client = srtt_us(c.as_fd()).expect("TCP_INFO");
+    eprintln!(
+        "tcpi_rtt after 20 round trips: server {:?} us, client {:?} us; after 5 delayed-ACK samples each way: server \
+         {server:?} us, client {client:?} us",
+        quick.0, quick.1
+    );
+    assert!(server.is_some_and(|us| us > 0), "server {server:?}");
+    assert!(client.is_some_and(|us| us > 0), "client {client:?}");
+}
+
+/// One RTT sample for `writer` that includes the peer's delayed-ACK wait: the reader leaves quick-ACK mode, the writer
+/// sends 200 B, the reader does not read until the writer's SIOCOUTQ shows the ACK came, then reads.
+fn delayed_ack_sample(writer: &mut TcpStream, reader: &mut TcpStream) {
+    SockRef::from(&*reader)
+        .set_tcp_quickack(false)
+        .expect("TCP_QUICKACK");
+    writer.write_all(&[9; 200]).expect("write");
+    assert!(
+        wait_until(Duration::from_secs(2), || outq(writer) == 0),
+        "the delayed ACK came"
+    );
+    reader.read_exact(&mut [0; 200]).expect("read");
+}
+
+#[test]
+fn tcpi_rtt_is_read_only_when_the_answer_covers_it() {
+    let at = offset_of!(libc::tcp_info, tcpi_rtt);
+    // Linux's uapi layout (include/uapi/linux/tcp.h): 8 bytes of u8 fields, then u32 tcpi_rto .. tcpi_rtt, the 16th.
+    assert_eq!(
+        at, 68,
+        "libc's tcp_info places tcpi_rtt where the kernel writes it"
+    );
+    let _is_u32: fn(&libc::tcp_info) -> u32 = |i| i.tcpi_rtt;
+    let mut info = [0u8; size_of::<libc::tcp_info>()];
+    info[at..at + 4].copy_from_slice(&1_234u32.to_ne_bytes());
+    assert_eq!(rtt_from(&info, at + 4).expect("covers"), Some(1_234));
+    assert_eq!(rtt_from(&info, info.len()).expect("covers"), Some(1_234));
+    for short in [0, at, at + 3] {
+        let err = rtt_from(&info, short).expect_err("too short");
+        assert_eq!(err.kind(), ErrorKind::Unsupported, "{short} bytes: {err}");
+    }
+    let err = rtt_from(&info[..at + 2], info.len()).expect_err("buffer too short");
+    assert_eq!(err.kind(), ErrorKind::Unsupported);
+    info[at..at + 4].fill(0);
+    assert_eq!(
+        rtt_from(&info, info.len()).expect("covers"),
+        None,
+        "0 is no sample"
+    );
+}
+
+#[test]
+fn the_stub_reports_unsupported() {
+    let listener = TcpListener::bind("127.0.0.1:0").expect("bind");
+    let a = crate::stub::srtt_us(listener.as_fd()).expect_err("stub");
+    let b = crate::stub::unacked_and_unsent(()).expect_err("stub");
+    assert_eq!(a.kind(), ErrorKind::Unsupported);
+    assert_eq!(b.kind(), ErrorKind::Unsupported);
+}
+
+/// The non-reading peer with a small SO_RCVBUF (u3c-plan.md 1.8 (e)). S writes 1,000 B chunks without blocking until
+/// its send buffer is full. SIOCOUTQ grows; at a quiescent point it equals /proc's tx_queue, read between two
+/// SIOCOUTQ readings that agree, and the bytes written less the peer's rx_queue (snd_una = the peer's rcv_nxt).
+/// It cannot tell SIOCOUTQ from SIOCOUTQNSD: with the window closed nothing is in flight, so both read the same. The
+/// delayed-ACK test below and the root run do.
+#[test]
+fn siocoutq_grows_with_a_non_reading_peer_and_equals_proc_tx_queue() {
+    const CHUNK: usize = 1_000;
+    const CAP: usize = 8 << 20;
+    let (_listener, mut s, c) = pair(Some(4_096));
+    let (sp, cp) = (port(&s), port(&c));
+    s.set_nonblocking(true).expect("non-blocking");
+    let mut written = 0usize;
+    let mut readings = Vec::new();
+    loop {
+        match s.write(&[1; CHUNK]) {
+            Ok(n) => written += n,
+            Err(e) if e.kind() == ErrorKind::WouldBlock => break,
+            Err(e) => panic!("write: {e}"),
+        }
+        let q = outq(&s);
+        assert!(q as usize <= written, "SIOCOUTQ {q} > {written} written");
+        readings.push(q);
+        assert!(written < CAP, "the send buffer never filled");
+    }
+    let mut last = None;
+    let quiet = wait_until(Duration::from_secs(5), || {
+        let q1 = outq(&s);
+        let ((tx, _), (_, rx)) = proc_queues(sp, cp);
+        let q2 = outq(&s);
+        last = Some((q1, q2, tx, rx));
+        q1 == q2 && q1 == tx && q1 as usize + rx as usize == written
+    });
+    let (q, _, tx, rx) = last.expect("one reading");
+    eprintln!(
+        "non-reading peer: {} writes, {written} B written; SIOCOUTQ first {} final {q}; tx_queue {tx}; peer rx_queue {rx}",
+        readings.len(),
+        readings[0]
+    );
+    assert!(
+        quiet,
+        "no quiescent reading: last (SIOCOUTQ, again, tx_queue, peer rx_queue) = {last:?}, written {written}"
+    );
+    assert!(
+        q > readings[0],
+        "SIOCOUTQ grows: first {} final {q}",
+        readings[0]
+    );
+    drop(c);
+}
+
+/// The receiver in delayed-ACK mode (TCP_QUICKACK 0): right after a 200 B write the peer already holds the bytes (its
+/// rx_queue is 200) but has not acknowledged them yet, so they are sent and unacked: notsent = write_seq - snd_nxt =
+/// 0, which SIOCOUTQNSD would read, while SIOCOUTQ reads 200. Judged on identities: in every attempt whose two
+/// SIOCOUTQ readings agree they equal tx_queue, and at least one attempt shows the state (a Python prototype on this
+/// kernel caught it in 200 of 200).
+#[test]
+fn siocoutq_counts_sent_but_unacked_bytes() {
+    const MSG: usize = 200;
+    const ATTEMPTS: usize = 50;
+    let (_listener, mut s, mut c) = pair(None);
+    let (sp, cp) = (port(&s), port(&c));
+    exchange(&mut s, &mut c, 20);
+    assert!(
+        wait_until(Duration::from_secs(2), || outq(&s) == 0),
+        "warm-up acknowledged"
+    );
+    let (mut stable, mut caught) = (0, 0);
+    let mut buf = [0u8; MSG];
+    for _ in 0..ATTEMPTS {
+        SockRef::from(&c)
+            .set_tcp_quickack(false)
+            .expect("TCP_QUICKACK");
+        s.write_all(&[3; MSG]).expect("write");
+        let q1 = outq(&s);
+        let ((tx, _), (_, rx)) = proc_queues(sp, cp);
+        let q2 = outq(&s);
+        if q1 == q2 {
+            stable += 1;
+            assert_eq!(q1, tx, "SIOCOUTQ = tx_queue = write_seq - snd_una");
+            assert!(
+                q1 == 0 || q1 as usize == MSG,
+                "one 200 B segment, acked whole: {q1}"
+            );
+            if q1 as usize == MSG && rx as usize == MSG {
+                caught += 1;
+            }
+        }
+        c.read_exact(&mut buf).expect("read");
+        assert!(
+            wait_until(Duration::from_secs(2), || outq(&s) == 0),
+            "acknowledged after the read"
+        );
+    }
+    eprintln!(
+        "sent-but-unacked state caught in {caught} of {ATTEMPTS} attempts ({stable} with agreeing readings)"
+    );
+    assert!(
+        caught >= 1,
+        "never caught the sent-but-unacked state ({stable} stable readings)"
+    );
+}
