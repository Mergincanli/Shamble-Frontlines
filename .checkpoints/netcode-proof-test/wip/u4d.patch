+/// Statistics of a stress-scene run, per tick and per second (PM-0001-2's series).
+#[derive(Default)]
+struct Load {
+    ticks: u32,
+    min_soldiers: usize,
+    min_team: usize,
+    min_vehicles: usize,
+    min_large: usize,
+    min_projectiles: usize,
+    effects: [usize; 2],
+    shots: u64,
+    portal_changes: u64,
+}
