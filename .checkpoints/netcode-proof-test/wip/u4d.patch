+/// An input of `commands` alone, for the world's next tick.
+fn input(world: &World, commands: Vec<(Command, Option<Rewind>)>) -> TickInput {
+    TickInput {
+        tick: world.next_tick(),
+        commands,
+        ..TickInput::default()
+    }
+}
