+    assert!(load.other_in >= 5_199, "the other vehicles: {} cm out", load.other_in);
+    assert!(load.start_out <= 1_200, "stand-ins start {} cm out", load.start_out);
+    assert!(load.min_soldiers >= 48, "soldiers: {}", load.min_soldiers);
+    assert!(load.min_team >= 16, "smallest team: {}", load.min_team);
+    assert!(
+        load.min_vehicles >= 15,
