+/// Slot `slot`'s record of `kind`.
+fn record_of(world: &World, kind: EntityKind, slot: u8) -> EntityRecord {
+    *world
+        .entity_records()
+        .iter()
+        .find(|r| r.kind == kind && r.index == u16::from(slot))
+        .expect("every slot has a record of each soldier kind")
+}
