diff --git a/spikes/netcode-proof/crates/sim/src/greybox.rs b/spikes/netcode-proof/crates/sim/src/greybox.rs
new file mode 100644
index 0000000..a204aca
--- /dev/null
+++ b/spikes/netcode-proof/crates/sim/src/greybox.rs
@@ -0,0 +1,184 @@
+//! The greybox: the static world every scene stands in (plan E1: "a DM_Tri-sized greybox with enterable buildings,
+//! areas, portals, doors at 1/s, and a destructible-wall stand-in (R-10)"; ADR 0001:1470-1474). All of it is fixed at
+//! construction; what changes (the doors, the wall) is `World`'s state.
+
+/// A box with its faces on the axes: in metres for collision and rays, and in the position grid's centimetres it was
+/// given in.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct Aabb {
+    pub(crate) min: [f32; 3],
+    pub(crate) max: [f32; 3],
+    pub(crate) min_cm: [i32; 3],
+    pub(crate) max_cm: [i32; 3],
+}
+
+impl Aabb {
+    /// The box from `min` to `max`, both in the position grid's centimetres, each corner on the wire grid.
+    pub(crate) fn cm(min: [i32; 3], max: [i32; 3]) -> Aabb {
+        let m = |c: i32| crate::grid::Config::default().from_grid(crate::grid::POSITION_XY, c);
+        Aabb {
+            min: min.map(m),
+            max: max.map(m),
+            min_cm: min,
+            max_cm: max,
+        }
+    }
+}
+
+/// The areas of the static graph (plan.md:567; u4-build-plan.md §4.2), as plain integer data the room's interest reads:
+/// area 0 is the open map, area `i + 1` the inside of building `i`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Areas {
+    /// Each area's footprint, `[x_min, y_min, x_max, y_max]` in the position grid's centimetres; a point inside no
+    /// building's footprint is in area 0.
+    pub rects: Vec<[i32; 4]>,
+}
+
+/// The portals of the static graph: portal `i` is door `i`, open or closed in [`crate::PortalStates`].
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Portals {
+    /// The two areas each portal joins.
+    pub joins: Vec<[u16; 2]>,
+}
+
+/// The DM_Tri-sized greybox (docs/LEGACY_INVENTORY.md CM4: bases 92 m out from the centre field; here a 256 m square
+/// centred on the origin): six enterable buildings round the centre field, each with one door, a few crates, and the
+/// destructible-wall stand-in in the field.
+#[derive(Clone, Debug)]
+pub struct Greybox {
+    areas: Areas,
+    portals: Portals,
+    /// Everything that never moves: the map's edge, the buildings' walls, the crates.
+    pub(crate) solids: Vec<Aabb>,
+    /// Each door's box when closed; door `i` is portal `i` and fills a gap in building `i`'s wall.
+    pub(crate) doors: Vec<Aabb>,
+    /// The wall stand-in's box while it stands.
+    pub(crate) wall: Aabb,
+    /// The building footprints in centimetres, building `i` being area `i + 1`.
+    footprints: Vec<[i32; 4]>,
+}
+
+/// The map's half width, cm: 128 m.
+const HALF_MAP: i32 = 12_800;
+/// A building's inside half width, cm.
+const ROOM: i32 = 400;
+/// A wall's thickness, cm.
+const THICK: i32 = 30;
+/// A wall's height, cm.
+const WALL_HEIGHT: i32 = 300;
+/// A door gap's half width, cm.
+const DOOR_HALF: i32 = 100;
+
+/// Which side of its building a door is on.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Side {
+    West,
+    East,
+    South,
+    North,
+}
+
+impl Greybox {
+    /// The one greybox every scene uses.
+    pub fn dm_tri() -> Greybox {
+        let mut solids = Vec::new();
+        // The map's edge: four walls 1 m thick and 5 m high.
+        let (h, t) = (HALF_MAP, 100);
+        solids.push(Aabb::cm([-h - t, -h - t, 0], [h + t, -h, 500]));
+        solids.push(Aabb::cm([-h - t, h, 0], [h + t, h + t, 500]));
+        solids.push(Aabb::cm([-h - t, -h, 0], [-h, h, 500]));
+        solids.push(Aabb::cm([h, -h, 0], [h + t, h, 500]));
+        // Six buildings round the centre field, 22 m out, each door facing the centre.
+        let buildings: [([i32; 2], Side); 6] = [
+            ([2_200, 0], Side::West),
+            ([1_100, 1_905], Side::South),
+            ([-1_100, 1_905], Side::South),
+            ([-2_200, 0], Side::East),
+            ([-1_100, -1_905], Side::North),
+            ([1_100, -1_905], Side::North),
+        ];
+        let mut doors = Vec::new();
+        let mut footprints = Vec::new();
+        for ([cx, cy], door_side) in buildings {
+            let (x0, y0, x1, y1) = (cx - ROOM, cy - ROOM, cx + ROOM, cy + ROOM);
+            footprints.push([x0, y0, x1, y1]);
+            let sides = [Side::West, Side::East, Side::South, Side::North];
+            for side in sides {
+                // The wall's box, and the gap's span along it when the door is on this side.
+                let (min, max) = match side {
+                    Side::West => ([x0 - THICK, y0, 0], [x0, y1, WALL_HEIGHT]),
+                    Side::East => ([x1, y0, 0], [x1 + THICK, y1, WALL_HEIGHT]),
+                    Side::South => ([x0 - THICK, y0 - THICK, 0], [x1 + THICK, y0, WALL_HEIGHT]),
+                    Side::North => ([x0 - THICK, y1, 0], [x1 + THICK, y1 + THICK, WALL_HEIGHT]),
+                };
+                if side != door_side {
+                    solids.push(Aabb::cm(min, max));
+                    continue;
+                }
+                match side {
+                    Side::West | Side::East => {
+                        solids.push(Aabb::cm(min, [max[0], cy - DOOR_HALF, max[2]]));
+                        solids.push(Aabb::cm([min[0], cy + DOOR_HALF, min[2]], max));
+                        doors.push(Aabb::cm(
+                            [min[0], cy - DOOR_HALF, 0],
+                            [max[0], cy + DOOR_HALF, WALL_HEIGHT],
+                        ));
+                    }
+                    Side::South | Side::North => {
+                        solids.push(Aabb::cm(min, [cx - DOOR_HALF, max[1], max[2]]));
+                        solids.push(Aabb::cm([cx + DOOR_HALF, min[1], min[2]], max));
+                        doors.push(Aabb::cm(
+                            [cx - DOOR_HALF, min[1], 0],
+                            [cx + DOOR_HALF, max[1], WALL_HEIGHT],
+                        ));
+                    }
+                }
+            }
+        }
+        // Eight crates, 1 m cubes, in the centre field.
+        for [x, y] in [
+            [600, 600],
+            [-600, 600],
+            [600, -600],
+            [-600, -600],
+            [0, 900],
+            [0, -900],
+            [900, 0],
+            [-900, 0],
+        ] {
+            solids.push(Aabb::cm([x - 50, y - 50, 0], [x + 50, y + 50, 100]));
+        }
+        let mut rects = vec![[-HALF_MAP, -HALF_MAP, HALF_MAP, HALF_MAP]];
+        rects.extend_from_slice(&footprints);
+        let joins = (1..=footprints.len() as u16).map(|a| [0, a]).collect();
+        Greybox {
+            areas: Areas { rects },
+            portals: Portals { joins },
+            solids,
+            doors,
+            // The wall stand-in: 6 m long, 40 cm thick, 3 m high, 12 m north of the centre.
+            wall: Aabb::cm([-300, 1_180, 0], [300, 1_220, WALL_HEIGHT]),
+            footprints,
+        }
+    }
+
+    /// The areas (plain integer data, for the room's interest).
+    pub fn areas(&self) -> &Areas {
+        &self.areas
+    }
+
+    /// The portals (plain integer data, for the room's AreaFlood): portal `i` is door `i`.
+    pub fn portals(&self) -> &Portals {
+        &self.portals
+    }
+
+    /// The area a point is in, the point in the position grid's centimetres (x, y).
+    pub(crate) fn area_of(&self, x: i32, y: i32) -> u16 {
+        for (i, [x0, y0, x1, y1]) in self.footprints.iter().enumerate() {
+            if x >= *x0 && x < *x1 && y >= *y0 && y < *y1 {
+                return i as u16 + 1;
+            }
+        }
+        0
+    }
+}
diff --git a/spikes/netcode-proof/crates/sim/src/hash.rs b/spikes/netcode-proof/crates/sim/src/hash.rs
new file mode 100644
index 0000000..6d79f44
--- /dev/null
+++ b/spikes/netcode-proof/crates/sim/src/hash.rs
@@ -0,0 +1,152 @@
+//! The canonical serialization, its hash and its dump (plan §4.5: "computed by canonical serialization: field by field,
+//! fixed-width little-endian, no `usize`, floats by `to_bits`, a fixed unseeded hash, never std's `Hasher`"; the hash
+//! function is spike-local: the sim core spike picks the real one, ADR 0004:350-351).
+//!
+//! `World` writes its state as 32-bit words to a [`Sink`], each word named by its section, its index there and its
+//! field. Three sinks read the one walk: the hash (FNV-1a-64 over the words' little-endian bytes), the dump (the words
+//! and their names) and the finite check (D-4: every float, read by `to_bits` as the hash reads it). So the dump holds
+//! exactly what the hash hashes (carry 38), and nothing else: never [`crate::InputReports`], never the commands' claimed
+//! press counters.
+
+/// Where the canonical walk writes: one call per 32-bit word, in order.
+pub(crate) trait Sink {
+    /// One word: `section` (`"soldier"`), the entity's `index` in it, the `field` (`"pos.x"`).
+    fn word(&mut self, section: &'static str, index: u32, field: &'static str, w: u32);
+
+    /// A float, by its bits.
+    fn float(&mut self, section: &'static str, index: u32, field: &'static str, x: f32) {
+        self.word(section, index, field, x.to_bits());
+    }
+
+    /// A 64-bit value, low word first.
+    fn wide(&mut self, section: &'static str, index: u32, field: &'static str, v: u64) {
+        self.word(section, index, field, v as u32);
+        self.word(section, index, field, (v >> 32) as u32);
+    }
+}
+
+/// FNV-1a-64's offset basis and prime.
+const FNV_OFFSET: u64 = 0xcbf2_9ce4_8422_2325;
+const FNV_PRIME: u64 = 0x0000_0100_0000_01b3;
+
+/// FNV-1a-64 over the words' little-endian bytes.
+pub(crate) struct Fnv(pub(crate) u64);
+
+impl Fnv {
+    pub(crate) fn new() -> Fnv {
+        Fnv(FNV_OFFSET)
+    }
+
+    pub(crate) fn bytes(&mut self, bytes: &[u8]) {
+        for b in bytes {
+            self.0 = (self.0 ^ u64::from(*b)).wrapping_mul(FNV_PRIME);
+        }
+    }
+}
+
+impl Sink for Fnv {
+    fn word(&mut self, _: &'static str, _: u32, _: &'static str, w: u32) {
+        self.bytes(&w.to_le_bytes());
+    }
+}
+
+/// One word's name: section, index, field.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Name {
+    section: &'static str,
+    index: u32,
+    field: &'static str,
+}
+
+/// A world's state as the hash reads it (plan §4.5's "field diff"; u4-build-plan.md §4.15): the canonical words, each
+/// named. Its words are exactly what `state_hash` hashes, so [`StateDump::hash`] equals the world's state hash, and a
+/// diff between two dumps names the first field that differs. Another process's or target's dump arrives as words
+/// alone (npt-hash-wasm's `dump_word`), and this dump names them.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct StateDump {
+    words: Vec<u32>,
+    names: Vec<Name>,
+}
+
+/// The first word two dumps differ at (u4-build-plan.md §5 U4d, D-2: "a mismatch names the first tick and the field").
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct FieldDiff {
+    /// The word's index in the dump.
+    pub word: usize,
+    /// Its field, as `section[index].field` (`soldier[3].pos.x`), or `end` where one dump is longer.
+    pub field: String,
+    /// This dump's word (0 past its end).
+    pub ours: u32,
+    /// The other's (0 past its end).
+    pub theirs: u32,
+}
+
+impl StateDump {
+    pub(crate) fn new() -> StateDump {
+        StateDump {
+            words: Vec::new(),
+            names: Vec::new(),
+        }
+    }
+
+    /// The words, in canonical order: what npt-hash-wasm's `dump_word` exports one by one.
+    pub fn words(&self) -> &[u32] {
+        &self.words
+    }
+
+    /// The hash of the words: the world's state hash at that tick.
+    pub fn hash(&self) -> u64 {
+        let mut h = Fnv::new();
+        for w in &self.words {
+            h.bytes(&w.to_le_bytes());
+        }
+        h.0
+    }
+
+    /// Word `i`'s field, as `section[index].field`, or `None` past the end.
+    pub fn field(&self, i: usize) -> Option<String> {
+        self.names
+            .get(i)
+            .map(|n| format!("{}[{}].{}", n.section, n.index, n.field))
+    }
+
+    /// The first word where this dump and `theirs` (another dump's words) differ, named by this dump; `None` when
+    /// they are equal word for word.
+    pub fn first_difference(&self, theirs: &[u32]) -> Option<FieldDiff> {
+        let n = self.words.len().max(theirs.len());
+        (0..n).find_map(|i| {
+            let (a, b) = (self.words.get(i), theirs.get(i));
+            (a != b).then(|| FieldDiff {
+                word: i,
+                field: self.field(i).unwrap_or_else(|| "end".to_string()),
+                ours: a.copied().unwrap_or(0),
+                theirs: b.copied().unwrap_or(0),
+            })
+        })
+    }
+}
+
+impl Sink for StateDump {
+    fn word(&mut self, section: &'static str, index: u32, field: &'static str, w: u32) {
+        self.words.push(w);
+        self.names.push(Name {
+            section,
+            index,
+            field,
+        });
+    }
+}
+
+/// The finite check (D-4): the first float that is NaN or infinite, by name.
+pub(crate) struct Finite(pub(crate) Option<String>);
+
+impl Sink for Finite {
+    fn word(&mut self, _: &'static str, _: u32, _: &'static str, _: u32) {}
+
+    fn float(&mut self, section: &'static str, index: u32, field: &'static str, x: f32) {
+        // By its bits, as the hash reads it: every exponent bit set is an infinity or a NaN.
+        if self.0.is_none() && x.to_bits() & 0x7f80_0000 == 0x7f80_0000 {
+            self.0 = Some(format!("{section}[{index}].{field}"));
+        }
+    }
+}
diff --git a/spikes/netcode-proof/crates/sim/src/replay.rs b/spikes/netcode-proof/crates/sim/src/replay.rs
new file mode 100644
index 0000000..3d30d95
--- /dev/null
+++ b/spikes/netcode-proof/crates/sim/src/replay.rs
@@ -0,0 +1,695 @@
+//! Recordings and their one replay driver (u4-build-plan.md §4.15; the advisor's Q4 ruling; A12).
+//!
+//! A recording is a header and each tick's [`TickInput`], fixed-width little-endian and never a `usize` (plan.md:527-
+//! 529). The sim replays it alone: [`Replayer`] takes it as 32-bit words (npt-hash-wasm's `feed`), steps a [`World`]
+//! per tick against the ring of past hit volumes it rebuilds itself, and gives each tick's hash and dump. npt-lab's
+//! `hash` subcommand runs it natively and npt-hash-wasm's exports wrap it (U4d2); D-1 and D-2 run it here.
+//!
+//! **The byte layout.** The header, 15 words: magic `NPTR`, version 1, scene id, seed (low word, high word), `TICK_HZ`,
+//! first tick, tick count, the ring's span in ms (carry 14; nit b), the generator's version (0 for a runner's
+//! recording), and the scene's pools (soldiers, vehicles, parts, projectile capacity, effect rows per soldier). Then per
+//! tick: the tick (4 B), the counts of commands, spawns, teleports and attribute changes (2 B each), then the entries:
+//! a command is 39 B (slot 1, tick 4, sequence 2, buttons 2, press counters 4, move 2, aim 12, view tick 4, view
+//! fraction 1, and its Rewind: present 1, tick_a 4, fraction 1, cover 1); a spawn or teleport 13 B (slot 1, position
+//! 12); an attribute change 6 B (slot 1, attribute 1, value 4). Words are the bytes little-endian; the last word is
+//! padded with zeros.
+
+use rand_chacha::ChaCha8Rng;
+use rand_core::{Rng, SeedableRng};
+
+use crate::scene::{LARGE_PARTS, SMALL_PARTS, Scene};
+use crate::seam::{
+    Attribute, AttributeChange, Command, CoverVariant, Placement, Rewind, SimCore, TickInput,
+};
+use crate::{HitHistory, StateDump, TICK_HZ, World, ticks_for_ms};
+
+const MAGIC: u32 = u32::from_le_bytes(*b"NPTR");
+const VERSION: u32 = 1;
+const HEADER_WORDS: usize = 15;
+const HEADER_BYTES: usize = HEADER_WORDS * 4;
+/// A tick's own header: the tick and four counts.
+const TICK_HEADER_BYTES: usize = 12;
+/// One command with its Rewind, as recorded.
+pub(crate) const COMMAND_BYTES: usize = 39;
+const PLACEMENT_BYTES: usize = 13;
+const ATTRIBUTE_BYTES: usize = 6;
+
+/// A recording (u4-build-plan.md §4.15): what one run's sim took from outside, tick by tick.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Recording {
+    /// The scene's id ([`Scene::id`]).
+    pub scene: u8,
+    /// The host's seed.
+    pub seed: u64,
+    /// The tick of its first step.
+    pub first_tick: u32,
+    /// The span of the hit-volume ring the run lent each step, ms ([`HitHistory::for_ms`]).
+    pub span_ms: u32,
+    /// The synthetic generator's version that wrote it ([`Recording::GENERATOR`]), or 0 for a runner's.
+    pub generator: u32,
+    /// Each tick's input, from the first tick on.
+    pub ticks: Vec<TickInput>,
+}
+
+/// The pools a scene's header states, checked against the build's scene on decode.
+fn pools(scene: &Scene) -> [u32; 5] {
+    let parts = usize::from(scene.large_vehicles) * LARGE_PARTS
+        + usize::from(scene.vehicles - scene.large_vehicles) * SMALL_PARTS;
+    [
+        u32::from(scene.slots),
+        u32::from(scene.vehicles),
+        parts as u32,
+        u32::from(scene.projectile_capacity),
+        u32::from(scene.effect_rows),
+    ]
+}
+
+/// The fixed-width little-endian reader over a byte slice.
+struct Reader<'a> {
+    b: &'a [u8],
+    at: usize,
+}
+
+impl Reader<'_> {
+    fn take<const N: usize>(&mut self) -> Option<[u8; N]> {
+        let out = self.b.get(self.at..self.at + N)?.try_into().ok()?;
+        self.at += N;
+        Some(out)
+    }
+
+    fn u8(&mut self) -> Option<u8> {
+        self.take::<1>().map(|b| b[0])
+    }
+
+    fn u16(&mut self) -> Option<u16> {
+        self.take().map(u16::from_le_bytes)
+    }
+
+    fn u32(&mut self) -> Option<u32> {
+        self.take().map(u32::from_le_bytes)
+    }
+
+    fn i32(&mut self) -> Option<i32> {
+        self.take().map(i32::from_le_bytes)
+    }
+
+    fn i8(&mut self) -> Option<i8> {
+        self.take().map(i8::from_le_bytes)
+    }
+}
+
+/// A recording's header, as read.
+#[derive(Clone, Copy, Debug)]
+struct Header {
+    scene: u8,
+    seed: u64,
+    first_tick: u32,
+    ticks: u32,
+    span_ms: u32,
+    generator: u32,
+}
+
+fn read_header(r: &mut Reader) -> Result<Header, &'static str> {
+    let mut w = [0u32; HEADER_WORDS];
+    for x in &mut w {
+        *x = r.u32().ok_or("a recording's header is 60 bytes")?;
+    }
+    if w[0] != MAGIC || w[1] != VERSION {
+        return Err("not a version 1 npt-sim recording");
+    }
+    let scene = u8::try_from(w[2])
+        .ok()
+        .and_then(Scene::by_id)
+        .ok_or("the header names no scene")?;
+    if w[5] != TICK_HZ {
+        return Err("the recording's TICK_HZ is not this build's");
+    }
+    if w[10..15] != pools(&scene) {
+        return Err("the recording's pools are not its scene's");
+    }
+    Ok(Header {
+        scene: scene.id(),
+        seed: u64::from(w[3]) | u64::from(w[4]) << 32,
+        first_tick: w[6],
+        ticks: w[7],
+        span_ms: w[8],
+        generator: w[9],
+    })
+}
+
+/// The bytes a tick needs past its own header, from its four counts.
+fn tick_body_len(counts: [u16; 4]) -> usize {
+    usize::from(counts[0]) * COMMAND_BYTES
+        + (usize::from(counts[1]) + usize::from(counts[2])) * PLACEMENT_BYTES
+        + usize::from(counts[3]) * ATTRIBUTE_BYTES
+}
+
+/// The four counts of the tick header at the reader's position, without moving it.
+fn peek_counts(b: &[u8]) -> Option<[u16; 4]> {
+    let mut r = Reader { b, at: 4 };
+    Some([r.u16()?, r.u16()?, r.u16()?, r.u16()?])
+}
+
+fn read_placement(r: &mut Reader) -> Option<Placement> {
+    Some(Placement {
+        slot: r.u8()?,
+        position: [r.i32()?, r.i32()?, r.i32()?],
+    })
+}
+
+/// One tick into `into` (its vectors reused).
+fn read_tick(r: &mut Reader, into: &mut TickInput) -> Result<(), &'static str> {
+    const CUT: &str = "a recording cut inside a tick";
+    into.tick = r.u32().ok_or(CUT)?;
+    let counts = [
+        r.u16().ok_or(CUT)?,
+        r.u16().ok_or(CUT)?,
+        r.u16().ok_or(CUT)?,
+        r.u16().ok_or(CUT)?,
+    ];
+    into.commands.clear();
+    for _ in 0..counts[0] {
+        let c = Command {
+            slot: r.u8().ok_or(CUT)?,
+            tick: r.u32().ok_or(CUT)?,
+            seq: r.u16().ok_or(CUT)?,
+            buttons: r.u16().ok_or(CUT)?,
+            presses: r.take().ok_or(CUT)?,
+            move_xy: [r.i8().ok_or(CUT)?, r.i8().ok_or(CUT)?],
+            aim: [
+                r.i32().ok_or(CUT)?,
+                r.i32().ok_or(CUT)?,
+                r.i32().ok_or(CUT)?,
+            ],
+            view_tick: r.u32().ok_or(CUT)?,
+            view_fraction: r.u8().ok_or(CUT)?,
+        };
+        let present = r.u8().ok_or(CUT)?;
+        let rewind = Rewind {
+            tick_a: r.u32().ok_or(CUT)?,
+            fraction: r.u8().ok_or(CUT)?,
+            cover: match r.u8().ok_or(CUT)? {
+                0 => CoverVariant::Rewound,
+                1 => CoverVariant::Present,
+                _ => return Err("a Rewind's cover is 0 or 1"),
+            },
+        };
+        let rewind = match present {
+            0 => None,
+            1 => Some(rewind),
+            _ => return Err("a Rewind's presence is 0 or 1"),
+        };
+        into.commands.push((c, rewind));
+    }
+    into.spawns.clear();
+    for _ in 0..counts[1] {
+        into.spawns.push(read_placement(r).ok_or(CUT)?);
+    }
+    into.teleports.clear();
+    for _ in 0..counts[2] {
+        into.teleports.push(read_placement(r).ok_or(CUT)?);
+    }
+    into.attributes.clear();
+    for _ in 0..counts[3] {
+        let slot = r.u8().ok_or(CUT)?;
+        let attribute = match r.u8().ok_or(CUT)? {
+            0 => Attribute::MoveSpeed,
+            1 => Attribute::FireInterval,
+            _ => return Err("an attribute is 0 or 1"),
+        };
+        let value = r.u32().ok_or(CUT)?;
+        into.attributes.push(AttributeChange {
+            slot,
+            attribute,
+            value,
+        });
+    }
+    Ok(())
+}
+
+fn count(n: usize) -> [u8; 2] {
+    u16::try_from(n)
+        .expect("a tick holds at most 65,535 entries of each kind")
+        .to_le_bytes()
+}
+
+fn write_tick(out: &mut Vec<u8>, t: &TickInput) {
+    out.extend_from_slice(&t.tick.to_le_bytes());
+    out.extend_from_slice(&count(t.commands.len()));
+    out.extend_from_slice(&count(t.spawns.len()));
+    out.extend_from_slice(&count(t.teleports.len()));
+    out.extend_from_slice(&count(t.attributes.len()));
+    for (c, rewind) in &t.commands {
+        out.push(c.slot);
+        out.extend_from_slice(&c.tick.to_le_bytes());
+        out.extend_from_slice(&c.seq.to_le_bytes());
+        out.extend_from_slice(&c.buttons.to_le_bytes());
+        out.extend_from_slice(&c.presses);
+        out.extend_from_slice(&c.move_xy.map(|m| m.to_le_bytes()[0]));
+        for a in c.aim {
+            out.extend_from_slice(&a.to_le_bytes());
+        }
+        out.extend_from_slice(&c.view_tick.to_le_bytes());
+        out.push(c.view_fraction);
+        let r = rewind.unwrap_or(Rewind {
+            tick_a: 0,
+            fraction: 0,
+            cover: CoverVariant::Rewound,
+        });
+        out.push(u8::from(rewind.is_some()));
+        out.extend_from_slice(&r.tick_a.to_le_bytes());
+        out.push(r.fraction);
+        out.push(match r.cover {
+            CoverVariant::Rewound => 0,
+            CoverVariant::Present => 1,
+        });
+    }
+    for p in t.spawns.iter().chain(&t.teleports) {
+        out.push(p.slot);
+        for k in p.position {
+            out.extend_from_slice(&k.to_le_bytes());
+        }
+    }
+    for a in &t.attributes {
+        out.push(a.slot);
+        out.push(match a.attribute {
+            Attribute::MoveSpeed => 0,
+            Attribute::FireInterval => 1,
+        });
+        out.extend_from_slice(&a.value.to_le_bytes());
+    }
+}
+
+impl Recording {
+    /// The synthetic generator's version: a recordings manifest names it beside each recording's seed (§4.15).
+    pub const GENERATOR: u32 = 1;
+
+    /// The recording's bytes (the module's layout).
+    ///
+    /// # Panics
+    /// If the scene id is unknown, or a tick holds more than 65,535 entries of one kind.
+    pub fn encode(&self) -> Vec<u8> {
+        let scene = Scene::by_id(self.scene).expect("a recording names a known scene");
+        let mut out = Vec::with_capacity(HEADER_BYTES + self.ticks.len() * 1_900);
+        let head: [u32; 10] = [
+            MAGIC,
+            VERSION,
+            u32::from(self.scene),
+            self.seed as u32,
+            (self.seed >> 32) as u32,
+            TICK_HZ,
+            self.first_tick,
+            u32::try_from(self.ticks.len()).expect("at most u32::MAX ticks"),
+            self.span_ms,
+            self.generator,
+        ];
+        for w in head.iter().chain(&pools(&scene)) {
+            out.extend_from_slice(&w.to_le_bytes());
+        }
+        for t in &self.ticks {
+            write_tick(&mut out, t);
+        }
+        out
+    }
+
+    /// A recording from its bytes; trailing bytes past the last tick are refused unless they are a final word's
+    /// zero padding (up to 3 zero bytes).
+    pub fn decode(bytes: &[u8]) -> Result<Recording, &'static str> {
+        let mut r = Reader { b: bytes, at: 0 };
+        let h = read_header(&mut r)?;
+        let mut ticks = Vec::with_capacity(h.ticks.min(1 << 20) as usize);
+        for _ in 0..h.ticks {
+            let mut t = TickInput::default();
+            read_tick(&mut r, &mut t)?;
+            ticks.push(t);
+        }
+        let rest = &bytes[r.at..];
+        if rest.len() > 3 || rest.iter().any(|b| *b != 0) {
+            return Err("bytes past the recording's last tick");
+        }
+        Ok(Recording {
+            scene: h.scene,
+            seed: h.seed,
+            first_tick: h.first_tick,
+            span_ms: h.span_ms,
+            generator: h.generator,
+            ticks,
+        })
+    }
+
+    /// The synthetic recording of `scene` from `seed` (u4-build-plan.md §4.15: "a seeded generator ... open-loop
+    /// commands, Rewinds drawn inside the ring", needing no room): `ticks` ticks from `first_tick`, its ring
+    /// `span_ms` long. Every non-plate soldier sends one command a tick (a function of the seed, the slot and the tick
+    /// alone), now and then holding one back and sending it beside the next (the catch-up case) or losing one; it moves
+    /// in a random walk steered toward its team's home by its own dead reckoning, aims at a point among the other
+    /// teams, holds fire (the stress and estimate scenes always; the courses in bursts) and presses fire and throw now
+    /// and then, and reload on the courses; a rare aim point lies beyond the weapon's reach (the clamp) and a rare
+    /// Rewind outside the
+    /// ring (the refusal). Each firing command's Rewind names ticks the ring holds, and its view time is that Rewind's.
+    /// Every few hundred ticks a soldier is spawned at its home, teleported there, or its move speed set. The commands
+    /// are written in the canonical order (carry 8).
+    pub fn synthetic(
+        scene: &Scene,
+        seed: u64,
+        first_tick: u32,
+        ticks: u32,
+        span_ms: u32,
+    ) -> Recording {
+        let mut key = *b"npt-sim synthetic recordings....";
+        key[..8].copy_from_slice(&seed.to_le_bytes());
+        let mut rng = ChaCha8Rng::from_seed(key);
+        rng.set_stream(u64::from(scene.id()));
+        let mut draw = |n: u32| ((u64::from(rng.next_u32()) * u64::from(n)) >> 32) as u32;
+        let capacity = ticks_for_ms(span_ms);
+        let slots = scene.slots;
+        let always_fire = scene.live_projectiles > 0 || scene.spawn_millihertz > 0;
+        #[derive(Clone, Copy, Default)]
+        struct Client {
+            seq: u16,
+            presses: [u8; 4],
+            mv: [i8; 2],
+            buttons: u16,
+            turn_at: u32,
+            est: [f32; 2],
+            held_back: Option<(Command, Option<Rewind>)>,
+        }
+        let homes = scene.homes;
+        let home_of =
+            |slot: u8| -> [i32; 2] { homes[usize::from(scene.team(slot).unwrap_or(0)).min(2)] };
+        let mut clients: Vec<Client> = (0..slots)
+            .map(|s| Client {
+                est: home_of(s).map(|k| k as f32 / 100.0),
+                ..Client::default()
+            })
+            .collect();
+        let speed = scene.move_speed as f32 / 100.0;
+        let reach = scene.weapon.reach_cm as i32;
+        let mut out = Vec::with_capacity(ticks as usize);
+        for e in 0..ticks {
+            let tick = first_tick.wrapping_add(e);
+            let mut input = TickInput {
+                tick,
+                ..TickInput::default()
+            };
+            for slot in 0..slots {
+                if scene.is_plate(slot) {
+                    continue;
+                }
+                let c = &mut clients[usize::from(slot)];
+                // A new heading every 0.5 to 2 s: home when it has wandered more than 8 m, else at random.
+                if e >= c.turn_at {
+                    c.turn_at = e + ticks_for_ms(500 + draw(1_500));
+                    let home = home_of(slot).map(|k| k as f32 / 100.0);
+                    let to = [home[0] - c.est[0], home[1] - c.est[1]];
+                    let far = to[0] * to[0] + to[1] * to[1] > 64.0;
+                    let heading = if far {
+                        to
+                    } else if draw(5) == 0 {
+                        [0.0, 0.0]
+                    } else {
+                        [draw(255) as f32 - 127.0, draw(255) as f32 - 127.0]
+                    };
+                    // At most full speed: the length the room accepts.
+                    let n = (heading[0] * heading[0] + heading[1] * heading[1]).sqrt();
+                    c.mv = if n > 0.0 {
+                        let k = 127.0 / n;
+                        [(heading[0] * k) as i8, (heading[1] * k) as i8]
+                    } else {
+                        [0, 0]
+                    };
+                    let fire = always_fire || draw(3) > 0;
+                    c.buttons = if fire { Command::FIRE } else { 0 };
+                    match draw(10) {
+                        0 => c.buttons |= Command::CROUCH,
+                        1 | 2 => c.buttons |= Command::SPRINT,
+                        _ => {}
+                    }
+                }
+                c.est[0] += f32::from(c.mv[0]) / 127.0 * speed / TICK_HZ as f32;
+                c.est[1] += f32::from(c.mv[1]) / 127.0 * speed / TICK_HZ as f32;
+                if draw(40) == 0 {
+                    c.presses[Command::PRESS_FIRE] = c.presses[Command::PRESS_FIRE].wrapping_add(1);
+                }
+                // Reloads: the courses only (a stress or estimate soldier's magazine outlasts the run, and a reload
+                // would pause its fire for 2 s).
+                if !always_fire && draw(300) == 0 {
+                    c.presses[Command::PRESS_RELOAD] =
+                        c.presses[Command::PRESS_RELOAD].wrapping_add(1);
+                }
+                if draw(400) == 0 {
+                    c.presses[Command::PRESS_THROW] =
+                        c.presses[Command::PRESS_THROW].wrapping_add(1);
+                }
+                // The aim: a point among another team's soldiers, or rarely one beyond the weapon's reach.
+                let target = home_of((slot + 1 + draw(u32::from(slots.max(2) - 1)) as u8) % slots);
+                let aim = if draw(500) == 0 {
+                    [target[0] + 2 * reach, target[1], 100]
+                } else {
+                    [
+                        target[0] + draw(1_000) as i32 - 500,
+                        target[1] + draw(1_000) as i32 - 500,
+                        50 + draw(150) as i32,
+                    ]
+                };
+                c.seq = c.seq.wrapping_add(1);
+                let firing = c.buttons & Command::FIRE != 0;
+                // The Rewind: ticks the ring holds after e pushes (the newest is tick - 1), or rarely one it does not.
+                let held = e.min(capacity);
+                let rewind = if !firing || held < 2 {
+                    None
+                } else if draw(1_000) == 0 {
+                    Some(Rewind {
+                        tick_a: tick.wrapping_add(5),
+                        fraction: 0,
+                        cover: CoverVariant::Rewound,
+                    })
+                } else {
+                    Some(Rewind {
+                        tick_a: tick.wrapping_sub(2 + draw(held - 1)),
+                        fraction: draw(256) as u8,
+                        cover: if draw(2) == 0 {
+                            CoverVariant::Rewound
+                        } else {
+                            CoverVariant::Present
+                        },
+                    })
+                };
+                let cmd = Command {
+                    slot,
+                    tick,
+                    seq: c.seq,
+                    buttons: c.buttons,
+                    presses: c.presses,
+                    move_xy: c.mv,
+                    aim,
+                    view_tick: rewind.map_or(tick.wrapping_sub(3), |r| r.tick_a),
+                    view_fraction: rewind.map_or(0, |r| r.fraction),
+                };
+                if let Some(back) = c.held_back.take() {
+                    input.commands.push(back);
+                    input.commands.push((cmd, rewind));
+                } else {
+                    match draw(64) {
+                        0 => c.held_back = Some((cmd, rewind)),
+                        1 => {}
+                        _ => input.commands.push((cmd, rewind)),
+                    }
+                }
+            }
+            if e % 311 == 157 {
+                let slot = draw(u32::from(slots)) as u8;
+                if !scene.is_plate(slot) {
+                    input.attributes.push(AttributeChange {
+                        slot,
+                        attribute: Attribute::MoveSpeed,
+                        value: 400 + draw(400),
+                    });
+                }
+            }
+            if e % 457 == 300 || e % 997 == 500 {
+                let slot = draw(u32::from(slots)) as u8;
+                if !scene.is_plate(slot) {
+                    let home = home_of(slot);
+                    let p = Placement {
+                        slot,
+                        position: [home[0], home[1], 0],
+                    };
+                    clients[usize::from(slot)].est = home.map(|k| k as f32 / 100.0);
+                    if e % 457 == 300 {
+                        input.teleports.push(p);
+                    } else {
+                        input.spawns.push(p);
+                    }
+                }
+            }
+            out.push(input);
+        }
+        Recording {
+            scene: scene.id(),
+            seed,
+            first_tick,
+            span_ms,
+            generator: Recording::GENERATOR,
+            ticks: out,
+        }
+    }
+}
+
+/// What [`Replayer::step`] did.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Step {
+    /// It ran this tick.
+    Stepped(u32),
+    /// The words fed so far hold no whole next tick (or no whole header yet).
+    NeedMore,
+    /// Every tick the header counts has run.
+    Done,
+    /// The recording is not one this build can replay; nothing more runs.
+    Failed(&'static str),
+}
+
+/// The one replay driver (A12; u4-build-plan.md §4.15): fed a recording as 32-bit words, it builds the [`World`] and
+/// the ring of past hit volumes from the header ([`HitHistory::for_ms`] of the header's span: carry 14), and steps one
+/// tick per [`Replayer::step`], pushing the world's volumes into its ring after each, as the room does. The commands
+/// go to the world as recorded, in the order recorded (carry 8).
+#[derive(Debug)]
+pub struct Replayer {
+    bytes: Vec<u8>,
+    read: usize,
+    header: Option<Header>,
+    world: Option<World>,
+    history: Option<HitHistory>,
+    stepped: u32,
+    input: TickInput,
+    failed: Option<&'static str>,
+    #[cfg(feature = "bites")]
+    bite: Option<(&'static str, u32)>,
+}
+
+impl Default for Replayer {
+    fn default() -> Replayer {
+        Replayer::new()
+    }
+}
+
+impl Replayer {
+    /// An empty driver, waiting for its first words.
+    pub fn new() -> Replayer {
+        Replayer {
+            bytes: Vec::new(),
+            read: 0,
+            header: None,
+            world: None,
+            history: None,
+            stepped: 0,
+            input: TickInput::default(),
+            failed: None,
+            #[cfg(feature = "bites")]
+            bite: None,
+        }
+    }
+
+    /// A driver whose world carries the planted defect `bite`, armed at `arm_tick` ([`World::with_bite`]; bites builds
+    /// only); `None` for an id `World` does not plant.
+    #[cfg(feature = "bites")]
+    pub fn with_bite(bite: &str, arm_tick: u32) -> Option<Replayer> {
+        let id = World::BITES.into_iter().find(|id| *id == bite)?;
+        let mut r = Replayer::new();
+        r.bite = Some((id, arm_tick));
+        Some(r)
+    }
+
+    /// The recording's next 4 bytes, little-endian.
+    pub fn feed(&mut self, word: u32) {
+        self.bytes.extend_from_slice(&word.to_le_bytes());
+    }
+
+    /// The world as of the last tick run (`None` before the header).
+    pub fn world(&self) -> Option<&World> {
+        self.world.as_ref()
+    }
+
+    /// The last tick's state hash (`None` before the header).
+    pub fn state_hash(&self) -> Option<u64> {
+        self.world.as_ref().map(SimCore::state_hash)
+    }
+
+    /// The last tick's dump (`None` before the header).
+    pub fn dump(&self) -> Option<StateDump> {
+        self.world.as_ref().map(World::dump)
+    }
+
+    /// Runs the next tick if the words fed hold it whole.
+    pub fn step(&mut self) -> Step {
+        if let Some(why) = self.failed {
+            return Step::Failed(why);
+        }
+        let step = self.try_step();
+        if let Step::Failed(why) = step {
+            self.failed = Some(why);
+        }
+        if self.read > 1 << 16 {
+            self.bytes.drain(..self.read);
+            self.read = 0;
+        }
+        step
+    }
+
+    fn try_step(&mut self) -> Step {
+        let Some(h) = self.header else {
+            if self.bytes.len() - self.read < HEADER_BYTES {
+                return Step::NeedMore;
+            }
+            let mut r = Reader {
+                b: &self.bytes[self.read..],
+                at: 0,
+            };
+            let h = match read_header(&mut r) {
+                Ok(h) => h,
+                Err(why) => return Step::Failed(why),
+            };
+            self.read += HEADER_BYTES;
+            let Some(history) = HitHistory::for_ms(h.span_ms) else {
+                return Step::Failed("the header's ring span is 0 ms or above 1 MB of volumes");
+            };
+            let scene = Scene::by_id(h.scene).unwrap_or_else(Scene::stress);
+            #[cfg(feature = "bites")]
+            if let Some((bite, arm)) = self.bite {
+                self.world = World::with_bite(&scene, h.seed, h.first_tick, bite, arm);
+            }
+            if self.world.is_none() {
+                self.world = Some(World::new(&scene, h.seed, h.first_tick));
+            }
+            self.history = Some(history);
+            self.header = Some(h);
+            return self.try_step();
+        };
+        if self.stepped == h.ticks {
+            return Step::Done;
+        }
+        let rest = &self.bytes[self.read..];
+        let Some(counts) = peek_counts(rest) else {
+            return Step::NeedMore;
+        };
+        let len = TICK_HEADER_BYTES + tick_body_len(counts);
+        if rest.len() < len {
+            return Step::NeedMore;
+        }
+        let mut r = Reader {
+            b: &rest[..len],
+            at: 0,
+        };
+        if let Err(why) = read_tick(&mut r, &mut self.input) {
+            return Step::Failed(why);
+        }
+        self.read += len;
+        let (Some(world), Some(history)) = (&mut self.world, &mut self.history) else {
+            return Step::Failed("no world");
+        };
+        let tick = world.next_tick();
+        world.step(&self.input, history);
+        history.push(world.hit_volumes());
+        self.stepped += 1;
+        Step::Stepped(tick)
+    }
+}
diff --git a/spikes/netcode-proof/crates/sim/src/rng.rs b/spikes/netcode-proof/crates/sim/src/rng.rs
new file mode 100644
index 0000000..8139741
--- /dev/null
+++ b/spikes/netcode-proof/crates/sim/src/rng.rs
@@ -0,0 +1,72 @@
+//! The sim's random streams (plan §4.5: `ChaCha8Rng`, pinned; the seed passed in by the host; our own sampling
+//! functions; the authority-only spread stream kept apart).
+
+use rand_chacha::ChaCha8Rng;
+use rand_core::{Rng, SeedableRng};
+
+/// One of the sim's random streams: ChaCha8 keyed by the host's seed, one ChaCha stream number per purpose, so a draw
+/// on one never moves another (a soldier's spread never shifts the effect rows' rolls). Every stream's position is
+/// state and in the state hash; the client-held hash leaves the authority-only ones out (plan §4.5).
+///
+/// The sampling functions are the sim's own (integers only, the same on every target), never `rand`'s distributions.
+/// The world's alone: nothing outside npt-sim draws from its streams, so it is not public.
+#[derive(Clone, Debug)]
+pub(crate) struct SimRng {
+    rng: ChaCha8Rng,
+}
+
+/// The purposes, each its own ChaCha stream number.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Stream {
+    /// Authority-only: each shot's spread (SEC-SPREAD (a)); the client's prediction never draws from it.
+    Spread = 1,
+    /// The effect rows' kinds, durations and magnitudes (S1's stand-in).
+    Effects = 2,
+    /// The stand-in projectiles' starts and fuses.
+    Projectiles = 3,
+    /// Where a soldier respawns.
+    Respawn = 4,
+}
+
+/// Every stream, in the state's order.
+pub(crate) const STREAMS: [Stream; 4] = [
+    Stream::Spread,
+    Stream::Effects,
+    Stream::Projectiles,
+    Stream::Respawn,
+];
+
+impl SimRng {
+    /// The stream `stream` of the run whose seed is `seed`: the 32-byte ChaCha key is the seed, little-endian, in its
+    /// first 8 bytes and a fixed tag after them.
+    pub(crate) fn new(seed: u64, stream: Stream) -> SimRng {
+        let mut key = *b"npt-sim seed....stand-in sim key";
+        key[..8].copy_from_slice(&seed.to_le_bytes());
+        let mut rng = ChaCha8Rng::from_seed(key);
+        rng.set_stream(stream as u64);
+        SimRng { rng }
+    }
+
+    /// The next 32 random bits.
+    pub(crate) fn next_u32(&mut self) -> u32 {
+        self.rng.next_u32()
+    }
+
+    /// A draw in `0..n` (`n` above 0), by the multiply-shift of a 32-bit draw: integers only.
+    pub(crate) fn below(&mut self, n: u32) -> u32 {
+        debug_assert!(n > 0, "a draw below 0");
+        ((u64::from(self.next_u32()) * u64::from(n)) >> 32) as u32
+    }
+
+    /// A draw in `lo..=hi` (`lo` at most `hi`).
+    pub(crate) fn between(&mut self, lo: i32, hi: i32) -> i32 {
+        let span = (i64::from(hi) - i64::from(lo) + 1) as u64;
+        let k = (u64::from(self.next_u32()) * span) >> 32;
+        (i64::from(lo) + k as i64) as i32
+    }
+
+    /// The stream's position in 32-bit words since its start: its whole state, given the key and the stream number.
+    pub(crate) fn position(&self) -> u128 {
+        self.rng.get_word_pos()
+    }
+}
diff --git a/spikes/netcode-proof/crates/sim/src/scene.rs b/spikes/netcode-proof/crates/sim/src/scene.rs
