+fn d3_prediction_equals_authority_for_one_slot_bit_for_bit() {
+    let mut blocked = 0u32;
+    for scene in [Scene::course(), Scene::stress()] {
+        let mut authority = World::new(&scene, 7, 500);
+        let mut history = ring();
+        let mut presses = [0u8; 4];
