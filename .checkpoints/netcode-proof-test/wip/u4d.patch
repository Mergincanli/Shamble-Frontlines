+        assert!(
+            snapped.len() > 40,
+            "{} ticks off the record's grid",
+            snapped.len()
+        );
+        assert!(!predicted.is_empty() && predicted.iter().all(|&k| k >= 50));
+        let (_, snapped) = walk_both(World::new(&scene, 7, 0), 300);
