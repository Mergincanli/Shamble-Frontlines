+//! The scenes, as data (u4-build-plan.md §4.13; ADR 0001:1470-1482): SS the stress scene, ES R2's estimate scene, CO
+//! the correction course and TC the target course. Each is recorded in a run's header by its id.
+
+use crate::TICK_HZ;
+
+/// S1's CPU stand-ins as data (ADR 0004's S1; PM-0001-2: "384 effect rows with the effect step's 1 ms ceiling burned
+/// per tick, and the remainder topped up to 2.80 ms at 30 Hz and 0.30 ms at 60 Hz"). The sim has no clock, so it burns
+/// nothing itself: the server's tick loop reads these and burns them (U6). Off on L1 (u4-build-plan.md §4.13, Q26),
+/// recorded in `params.stand_ins`; the effect rows are state and stay in every scene that has them.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StandIns {
+    /// The effect step's ceiling, burned each tick, in ns (1 ms in the stress scene).
+    pub burn_ns: u32,
+    /// The rest of the sim step's share, topped up to each tick, in ns (2.80 ms at 30 Hz, 0.30 ms at 60 Hz).
+    pub top_up_ns: u32,
+}
+
+impl StandIns {
+    /// No CPU stand-in: what L1 runs with, and every scene but the stress scene.
+    pub const OFF: StandIns = StandIns {
+        burn_ns: 0,
+        top_up_ns: 0,
+    };
+
+    /// S1's numbers at the build's tick rate.
+    pub const fn s1() -> StandIns {
+        StandIns {
+            burn_ns: 1_000_000,
+            top_up_ns: top_up_ns_at(TICK_HZ),
+        }
+    }
+}
+
+/// S1's top-up at `tick_hz`: 2.80 ms at 30 Hz and 0.30 ms at 60 Hz, the two rates S1 states; 0 at any other rate.
+const fn top_up_ns_at(tick_hz: u32) -> u32 {
+    match tick_hz {
+        30 => 2_800_000,
+        60 => 300_000,
+        _ => 0,
+    }
+}
+
+/// The stand-in weapon (one weapon, id 0).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Weapon {
+    /// The interval between automatic shots, µs: the soldier's starting `Attribute::FireInterval`.
+    pub(crate) interval_us: u32,
+    /// Health points a hit takes.
+    pub(crate) damage: u16,
+    /// How far a shot reaches, cm.
+    pub(crate) reach_cm: u32,
+    /// Rounds per magazine.
+    pub(crate) magazine: u16,
+    /// A reload's length, ms.
+    pub(crate) reload_ms: u32,
+    /// The spread's half width, in millionths of the distance to the aim point (micro-radians).
+    pub(crate) spread_urad: u32,
+}
+
+/// One scene: what a world starts from and how it runs (u4-build-plan.md §4.13).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Scene {
+    id: u8,
+    name: &'static str,
+    pub(crate) slots: u8,
+    pub(crate) teams: u8,
+    /// TC's static targets: the slots from this one on are thin plates that never move or die (§4.13, Q17).
+    pub(crate) plates_from: u8,
+    /// Big vehicles, and how many of them are very large units of `LARGE_PARTS` parts (the rest have `SMALL_PARTS`).
+    pub(crate) vehicles: u8,
+    pub(crate) large_vehicles: u8,
+    /// Stand-in projectiles the sim keeps live (the stress scene's 300).
+    pub(crate) live_projectiles: u16,
+    /// Stand-in projectiles spawned per second, in thousandths (ES's 0.44 per player per second: 21,120).
+    pub(crate) spawn_millihertz: u32,
+    /// The stand-in projectiles' fuse range, ms.
+    pub(crate) fuse_ms: [u32; 2],
+    /// The projectile pool's fixed capacity (stand-ins and grenades).
+    pub(crate) projectile_capacity: u16,
+    /// Effect rows per soldier (S1's 8 in the stress scene).
+    pub(crate) effect_rows: u8,
+    pub(crate) weapon: Weapon,
+    /// The soldiers' starting walking speed, cm/s.
+    pub(crate) move_speed: u32,
+    pub(crate) health: u16,
+    /// How long a dead soldier waits to respawn, ms.
+    pub(crate) respawn_ms: u32,
+    /// Each team's home in the centre field, cm: its soldiers start and respawn on a grid round it.
+    pub(crate) homes: [[i32; 2]; 3],
+    stand_ins: StandIns,
+}
+
+/// Parts of a very large unit (the stress scene's 4 have at least 20: PM-0001-2).
+pub(crate) const LARGE_PARTS: usize = 20;
+/// Parts of any other big vehicle.
+pub(crate) const SMALL_PARTS: usize = 4;
+
+/// The stress scene's and the estimate scene's three team homes, 10 m out from the centre, 120 degrees apart.
+const CLUSTER: [[i32; 2]; 3] = [[1_000, 0], [-500, 866], [-500, -866]];
+
+impl Scene {
+    /// SS, the stress scene (u4-build-plan.md §4.13; net F113; PM-0001-2): 48 soldiers in 3 × 16 in one cluster in the
+    /// centre field; 15 big vehicles, 4 of them of 20 parts; 300 live stand-in projectiles as trajectory records; 384
+    /// effect rows (8 per soldier); the doors' one portal change a second; the wall stand-in; the weapon's interval set
+    /// for 700 shots per second with every soldier firing (48 × 30 ticks a second × 1,000,000 / (68,571 µs × 30) =
+    /// 700.0), a hit taking 1 of 1,000 health so that deaths, which pause a soldier's fire for the 1 s respawn, stay rare
+    /// (D-6 measures the mean with them counted), and a magazine that outlasts a 5-minute run (about 4,400 shots).
+    /// S1's CPU stand-ins at the build's rate.
+    pub fn stress() -> Scene {
+        Scene {
+            id: 1,
+            name: "SS",
+            slots: 48,
+            teams: 3,
+            plates_from: 48,
+            vehicles: 15,
+            large_vehicles: 4,
+            live_projectiles: 300,
+            spawn_millihertz: 0,
+            fuse_ms: [2_000, 6_000],
+            projectile_capacity: 320,
+            effect_rows: 8,
+            weapon: Weapon {
+                interval_us: 68_571,
+                damage: 1,
+                reach_cm: 6_000,
+                magazine: 10_000,
+                reload_ms: 2_000,
+                spread_urad: 5_000,
+            },
+            move_speed: 600,
+            health: 1_000,
+            respawn_ms: 1_000,
+            homes: CLUSTER,
+            stand_ins: StandIns::s1(),
+        }
+    }
+
+    /// ES, R2's estimate scene (ADR 0001:1474-1479): 48 soldiers and 15 big vehicles in view, 1.5 shots per player per
+    /// second (the weapon's interval 666,667 µs), 32 live projectiles at 0.44 spawns per player per second (21.12 a
+    /// second, each fusing after 1.515 s: 21.12 × 1.515 = 32.0), no effect rows.
+    pub fn estimate() -> Scene {
+        Scene {
+            id: 2,
+            name: "ES",
+            large_vehicles: 0,
+            live_projectiles: 0,
+            spawn_millihertz: 21_120,
+            fuse_ms: [1_515, 1_515],
+            projectile_capacity: 64,
+            effect_rows: 0,
+            weapon: Weapon {
+                interval_us: 666_667,
+                damage: 10,
+                ..Scene::stress().weapon
+            },
+            stand_ins: StandIns::OFF,
+            ..Scene::stress()
+        }
+    }
+
+    /// CO, the correction course (R2-SYNC-REC3 mark 1): one soldier and no other player, among the greybox's doors.
+    pub fn course() -> Scene {
+        Scene {
+            id: 3,
+            name: "CO",
+            slots: 1,
+            teams: 1,
+            plates_from: 1,
+            vehicles: 0,
+            large_vehicles: 0,
+            live_projectiles: 0,
+            spawn_millihertz: 0,
+            fuse_ms: [2_000, 2_000],
+            projectile_capacity: 16,
+            effect_rows: 0,
+            weapon: Weapon {
+                interval_us: 100_000,
+                damage: 10,
+                reach_cm: 6_000,
+                magazine: 30,
+                reload_ms: 2_000,
+                spread_urad: 5_000,
+            },
+            move_speed: 600,
+            health: 100,
+            respawn_ms: 1_000,
+            homes: [[0, -1_500], [0, -1_500], [0, -1_500]],
+            stand_ins: StandIns::OFF,
+        }
+    }
+
+    /// TC, the target course (ADR 0001:1480-1482; Q17): the shooter (slot 0), the target soldier (slot 1, sprinting at
+    /// 9 m/s: 600 cm/s × 1.5), and three static targets (slots 2 to 4): thin plates 2 cm thick, on the ground, at 2.5 m
+    /// and at 4 m, which never move or die.
+    pub fn targets() -> Scene {
+        Scene {
+            id: 4,
+            name: "TC",
+            slots: 5,
+            teams: 2,
+            plates_from: 2,
+            homes: [[-6_000, -1_000], [-6_000, 1_000], [-6_000, 1_000]],
+            ..Scene::course()
+        }
+    }
+
+    /// The scene of a header's id: 1 SS, 2 ES, 3 CO, 4 TC.
+    pub fn by_id(id: u8) -> Option<Scene> {
+        [
+            Scene::stress(),
+            Scene::estimate(),
+            Scene::course(),
+            Scene::targets(),
+        ]
+        .into_iter()
+        .find(|s| s.id == id)
+    }
+
+    /// Its id in a recording's header.
+    pub fn id(&self) -> u8 {
+        self.id
+    }
+
+    /// Its name in a run's header: SS, ES, CO or TC.
+    pub fn name(&self) -> &'static str {
+        self.name
+    }
+
+    /// Its soldier slots, 0 to `slots() - 1`.
+    pub fn slots(&self) -> u8 {
+        self.slots
+    }
+
+    /// The team of `slot`, or `None` for a slot the scene does not have.
+    pub fn team(&self, slot: u8) -> Option<u8> {
+        if slot >= self.slots {
+            None
+        } else if self.plates_from < self.slots {
+            // TC: the shooter against the rest.
+            Some(u8::from(slot != 0))
+        } else {
+            Some(slot / (self.slots / self.teams))
+        }
+    }
+
+    /// S1's CPU stand-ins this scene runs with.
+    pub fn stand_ins(&self) -> StandIns {
+        self.stand_ins
+    }
+
+    /// The same scene with other CPU stand-ins (`StandIns::OFF` on L1: §4.13). The state is the same either way.
+    pub fn with_stand_ins(self, stand_ins: StandIns) -> Scene {
+        Scene { stand_ins, ..self }
+    }
+
+    /// Whether `slot` is one of TC's plates.
+    pub(crate) fn is_plate(&self, slot: u8) -> bool {
+        slot >= self.plates_from && slot < self.slots
+    }
+
+    /// Where a plate stands: TC's three, 3 m apart, 30 m north of the shooter, their bottoms at 0, 2.5 m and 4 m.
+    pub(crate) fn plate_position(&self, slot: u8) -> [i32; 3] {
+        let k = i32::from(slot - self.plates_from);
+        let base = [0, 250, 400];
+        [-6_300 + 300 * k, 2_000, base[(k as usize).min(2)]]
+    }
+}
diff --git a/spikes/netcode-proof/crates/sim/src/trajectory.rs b/spikes/netcode-proof/crates/sim/src/trajectory.rs
new file mode 100644
index 0000000..3ccd8d4
--- /dev/null
+++ b/spikes/netcode-proof/crates/sim/src/trajectory.rs
@@ -0,0 +1,26 @@
+//! The one trajectory function (plan E1: "300 live projectiles as trajectory records through one shared function";
+//! ADR 0001 part 6): a projectile is its record (start tick, start position, velocity), and where it is at any tick is
+//! this closed form, the same on the server, the client and both targets (PM-0004-73).
+
+use crate::TICK_HZ;
+
+/// Gravity, m/s².
+pub(crate) const GRAVITY: f32 = 9.81;
+
+/// Where a projectile started at `start` (metres) with `velocity` (m/s) is `ticks` ticks later: the ballistic arc
+/// under gravity, stopped where it meets the ground (z = 0), where it stays. Closed form, `+ - * /` and `sqrt` only (ADR
+/// 0004's float allow-list), so it needs no step and no transcendental; a start below the ground is taken as on it.
+pub fn trajectory_at(start: [f32; 3], velocity: [f32; 3], ticks: u32) -> [f32; 3] {
+    let t = ticks as f32 / TICK_HZ as f32;
+    let z0 = if start[2] > 0.0 { start[2] } else { 0.0 };
+    let vz = velocity[2];
+    // The time it lands: the larger root of z0 + vz t - g t² / 2 = 0.
+    let land = (vz + (vz * vz + 2.0 * GRAVITY * z0).sqrt()) / GRAVITY;
+    let t = if t < land { t } else { land };
+    let z = z0 + vz * t - 0.5 * GRAVITY * t * t;
+    [
+        start[0] + velocity[0] * t,
+        start[1] + velocity[1] * t,
+        if z > 0.0 { z } else { 0.0 },
+    ]
+}
diff --git a/spikes/netcode-proof/crates/sim/src/world.rs b/spikes/netcode-proof/crates/sim/src/world.rs
new file mode 100644
index 0000000..1158077
--- /dev/null
+++ b/spikes/netcode-proof/crates/sim/src/world.rs
@@ -0,0 +1,1878 @@
+//! `World`, the stand-in sim's one implementation of the seam (u4-build-plan.md §5 U4d, §4.2; plan E1).
+//!
+//! **One step, in phases** (each a function below, in this order):
+//! 0. the tick's spawns, teleports and attribute changes ([`TickInput`]);
+//! 1. the movers: the wall stand-in falls or rises, one door toggles each second, the vehicles drive their loops; their
+//!    records are written, and the soldiers' collision movers are read back from those records' grid integers, so the
+//!    authority collides against exactly what a client decodes ([`World::load_movers`]);
+//! 2. the commands, in the canonical order: per command, the soldier's move (one tick of it), the own-copy snap, its
+//!    aim (the clamp) and its weapon (fire, reload, throw);
+//! 3. the present hit volumes;
+//! 4. the shots: each against the lent ring blended at its [`Rewind`], or at the present;
+//! 5. the projectiles: blasts at their fuse, the stand-ins kept live;
+//! 6. S1's effect rows;
+//! 7. respawns;
+//! 8. the records, the volumes and the portals of the tick.
+//!
+//! **Rules the tests hold** (D-1 to D-10; the carries of u4s-carries.md):
+//! - The state reads, of a [`Command`], `slot`, `seq`, `buttons`, `presses`, `move_xy` and `aim`, nothing else; the
+//!   order assert reads `tick` (carry 7, 8).
+//! - **A command that holds or presses fire and has no Rewind fires at the present**: its shot meets the soldiers and
+//!   the cover as they are after this tick's moves. A refused Rewind (a tick the lent ring does not hold, or a blend
+//!   toward one: [`Rewind`]'s rule) is counted and the command then runs exactly as with `None`: one rule for both
+//!   (carry 10).
+//! - **Refused input leaves no trace in the state** (the advisor's condition 1): a fire press in the cooldown or with
+//!   no ammunition, a reload press the weapon refuses, a throw into a full pool and a Rewind outside the ring are
+//!   counted in [`InputReports`] and change nothing hashed; a clamped aim point is reported there and the shot uses
+//!   the clamped point. The commands' press counters are the client's claim: the world keeps the last counter it saw
+//!   per button to find the press edges, outside the hash and the dump, so a refused press is gone once seen. Its twin
+//!   is the same command stream with that press removed: that button's counter one lower from that command on.
+//! - Integers come in widened before any arithmetic (`move_xy` to i32, `aim` to f64), so no recorded command trips an
+//!   overflow check (carry 15); every float the state holds is finite, asserted each tick in debug builds (D-4).
+//! - `HitVolumes::tick` is the world's own tick counter, never `TickInput::tick` (carry 15).
+//! - The own-copy snap (the advisor's Q23 ruling) ends every command's move, in `step` and in [`World::predict`] alike;
+//!   each soldier record carries the values before it in `raw` and the wire grid's integers of them in `grid` (carry 9).
+
+use core::f32::consts::{FRAC_PI_2, TAU};
+
+use crate::greybox::{Aabb, Greybox};
+use crate::grid::{Config, Field, PITCH, POSITION_XY, POSITION_Z, VELOCITY, YAW};
+use crate::hash::{Finite, Fnv, Sink, StateDump};
+use crate::history::HitHistory;
+use crate::rng::{STREAMS, SimRng, Stream};
+use crate::scene::{LARGE_PARTS, SMALL_PARTS, Scene};
+use crate::seam::{
+    Attribute, ClampReport, Command, CoverVariant, EntityKind, EntityRecord, HitVolumes,
+    InputReports, PortalStates, Rewind, SimCore, SimEvent, TickInput, VolumeBox,
+};
+use crate::{TICK_HZ, ticks_for_ms, trajectory_at};
+
+/// The weapon's clock: one tick is this many units, so one µs is `TICK_HZ` units and an interval of `i` µs costs
+/// `i × TICK_HZ` units at any tick rate (u4-build-plan.md §4.13: "the stand-in weapon's interval in integer sub-tick
+/// units").
+const UNITS_PER_TICK: i64 = 1_000_000;
+/// One tick, in seconds.
+const DT: f32 = 1.0 / TICK_HZ as f32;
+
+/// A soldier's half width (x and y) and height, metres, for collision.
+const RADIUS: f32 = 0.4;
+const HEIGHT: f32 = 1.8;
+/// The fire origin's height above the soldier's feet, metres.
+const CHEST: f32 = 1.4;
+/// A soldier's hit box, half extents in cm (80 × 80 × 180 cm), and a plate's (100 × 2 × 100 cm: TC's thin targets).
+const SOLDIER_HALF: [u16; 3] = [40, 40, 90];
+const PLATE_HALF: [u16; 3] = [50, 1, 50];
+/// A vehicle part: a 1 m cube whose centre is 1 m up.
+const PART_HALF_CM: i32 = 50;
+const PART_Z_CM: i32 = 100;
+const PART_HEALTH: u16 = 200;
+/// A box blocks a move only past this overlap, metres, so a soldier pushed to touch it slides along it.
+const SKIN: f32 = 0.001;
+/// A box the soldier starts more than this far inside, metres, never blocks it (a door that closed on it, the wall
+/// that rose round it): it walks out.
+const INSIDE: f32 = 0.01;
+/// The clamp's slack, metres: one grid cell's half-diagonal, √3/2 cm = 0.866 cm, rounded up (§4.2).
+const CLAMP_SLACK: f64 = 0.0087;
+/// A grenade: its throw speed and lift (m/s), its fuse (ms), its blast's radius (m) and damage.
+const THROW_SPEED: f32 = 14.0;
+const THROW_LIFT: f32 = 4.0;
+const GRENADE_FUSE_MS: u32 = 2_000;
+const BLAST_RADIUS: f32 = 4.0;
+const BLAST_DAMAGE: u16 = 50;
+/// Projectile types (the record's type field).
+const STAND_IN: u8 = 0;
+const GRENADE: u8 = 1;
+/// The wall stand-in's health, and how long it stays down once destroyed (ms).
+const WALL_HEALTH: u16 = 500;
+const WALL_DOWN_MS: u32 = 10_000;
+
+/// The soldier record's flag bits (its 8 flag bits for stance and actions).
+const FLAG_CROUCH: u8 = 1 << 0;
+const FLAG_SPRINT: u8 = 1 << 1;
+const FLAG_FIRED: u8 = 1 << 2;
+const FLAG_RELOADING: u8 = 1 << 3;
