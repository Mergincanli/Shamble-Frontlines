+/// Slot `slot`'s record.
+fn soldier(world: &World, slot: u8) -> EntityRecord {
+    *world
+        .entity_records()
+        .iter()
+        .find(|r| r.kind == EntityKind::Soldier && r.index == u16::from(slot))
+        .expect("every slot has a record")
+}
