+    /// its own value (each field set apart, 1 to 20, in `ROOM_COUNTS`' order).
+    #[test]
+    fn f14_every_refusal_field_of_client_counters_is_written() {
+        let k = ClientCounters {
+            late: 1,
+            press_refused: 2,
+            buffer_full: 3,
+            rewinds_refused: 4,
+            events_queued: 5,
+            overflow_resyncs: 6,
+            lead_refused: 7,
+            not_newer: 8,
+            seq_refused: 9,
+            move_refused: 10,
+            aim_refused: 11,
+            ack_refused: 12,
+            ack_refused_commands: 13,
+            acks_old: 14,
+            seq_outside_window: 15,
+            rejoin_overlap: 16,
+            commands_repeat: 17,
+            resyncs_dropped: 18,
+            resyncs_limited: 19,
+            kicked: 20,
+            ..ClientCounters::default()
+        };
+        let e = counts(EventRecord::new("t", Phase::After), Some(&k), None);
