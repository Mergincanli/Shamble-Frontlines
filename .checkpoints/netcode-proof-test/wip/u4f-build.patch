+
+    /// f14 (SA-5), the pump's struct: `counts` writes every refusal field of npt-server's `Counters` (all but the pings
+    /// and pongs sent), each `pump_<field>_count` with its own value (1 to 21, in `PUMP_COUNTS`' order).
+    #[test]
+    fn f14_every_refusal_field_of_the_pumps_counters_is_written() {
+        let d = Counters {
+            too_large: 1,
+            truncated: 2,
+            bad_length: 3,
+            unknown_type: 4,
+            wrong_direction: 5,
+            wrong_channel: 6,
+            trailing_bytes: 7,
+            unknown_field: 8,
+            out_of_range: 9,
+            malformed: 10,
+            before_join: 11,
+            input_limited: 12,
+            ping_limited: 13,
+            pong_unknown: 14,
+            first_not_join: 15,
+            joining_dropped: 16,
+            stream_malformed: 17,
