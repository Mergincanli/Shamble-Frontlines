+/// `e` with a session's counts: the room slot's (`ROOM_COUNTS`) and the pump's (`PUMP_COUNTS`), each when given.
+pub(crate) fn counts(
+    mut e: EventRecord,
+    room: Option<&ClientCounters>,
+    pump: Option<&Counters>,
+) -> EventRecord {
+    for (name, get) in ROOM_COUNTS {
+        if let Some(k) = room {
+            e = e.with(name, get(k));
+        }
+    }
+    for (name, get) in PUMP_COUNTS {
+        if let Some(d) = pump {
+            e = e.with(name, get(d));
+        }
+    }
+    e
