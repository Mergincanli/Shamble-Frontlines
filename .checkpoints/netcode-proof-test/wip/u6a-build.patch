+    if let Some(why) = sibling_refusal(&c.settings, &machine.smt) {
+        return fail(EXIT_SETTINGS, &why);
+    }
+    let n = c.settings.clients as usize;
+    let tokens = match mint(n) {
+        Ok(t) => t,
+        Err(e) => return fail(EXIT_FAILED, &format!("minting the tokens: {e}")),
+    };
