+    let start = clock::now_ns();
+    while clock::now_ns() - start < 2_000 * MS {
+        for (link, endpoint) in &mut clients {
+            step_client(endpoint, link, clock::now_ns());
+        }
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    let ticks = tl.ticks();
+    assert_eq!(tl.stop().expect("the log ends"), Ended::Clean);
+    let text = sink
+        .0
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .clone();
+    let log = read_log(text.as_slice()).expect("the log reads back");
+    let overruns: i64 = log.ticks.iter().map(|t| t.v["overrun"]).sum();
+    let wake_max = log.ticks.iter().map(|t| t.v["wake_ticks_count"]).max();
+    let jitter_max = log.ticks.iter().map(|t| t.v["start_jitter_ns"]).max();
+    let newest: Vec<Option<u32>> = clients.iter().map(|c| c.1.newest_tick()).collect();
+    println!(
+        "smoke (container reading, not judged): {ticks} ticks in 2 s, {overruns} overruns, most ticks in a wake \
+         {wake_max:?}, largest start jitter {jitter_max:?} ns; the clients' newest ticks {newest:?}"
+    );
+    assert!(ticks > 0);
+    assert!(
+        log.ticks.len() as u64 >= ticks,
+        "one record per tick (ticks run after the count above are logged too)"
+    );
+    assert_eq!(log.footer.map(|f| f.ended), Some(Ended::Clean));
+    for (i, (_, e)) in clients.iter().enumerate() {
+        assert_eq!(e.slot(), Some(i as u8), "client {i} joined");
+        assert!(
+            e.newest_tick().is_some(),
+            "client {i} decoded the room's state"
+        );
+    }
+}
diff --git a/spikes/netcode-proof/crates/server/tests/binary.rs b/spikes/netcode-proof/crates/server/tests/binary.rs
new file mode 100644
index 0000000..a63c7be
--- /dev/null
+++ b/spikes/netcode-proof/crates/server/tests/binary.rs
@@ -0,0 +1,259 @@
+//! npt-server's binary from `CARGO_BIN_EXE_npt-server` (u6a-brief.md Block 3, section 3): the start to `OPEN` within the
+//! 5 s real-clock cap (the time printed: a container reading, no 2 s bar here), exit 0 when stdin closes, no token in
+//! the log, stdout or stderr, and the exit codes; in bites builds the two process-level bites, each failing its mark's
+//! check by name on the log it writes. The binary binds no socket (SEC-U6AD-4), so no client joins here.
+
+use std::io::{BufRead, BufReader, Read};
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::time::Duration;
+
+use npt_log::{Ended, Log, Machine, read_log};
+
+/// A folder in the system's temporary folder, new for this test.
+fn folder(name: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("npt-u6a-bin-{}-{name}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).expect("the test's folder");
+    dir
+}
+
+/// The settings file in `dir`: two slots of SS, the log and token file beside it, `extra` fields added.
+fn settings(dir: &Path, extra: &[(&str, serde_json::Value)]) -> PathBuf {
+    let mut v = serde_json::json!({
+        "run": "C-u6a-bin-1", "set": "C-u6a-bin", "role": "measured", "marks": ["PM-0001-16", "PM-0006-11"],
+        "date": "2026-11-22", "commit": "0123456789abcdef0123456789abcdef01234567",
+        "layer": "L2", "profile": "P0", "seed": 7, "scene": "SS", "clients": 2, "cmd_timing": "B",
+        "tick_hz": 30, "machine_role": "C", "machine_name": "C", "machine_plan": "container",
+        "machine_location": "here", "machine_address": "", "tick_vcpu": null, "io_vcpus": [],
+        "io_threads": 1, "duration_ms": 0, "warmup_ticks": 0, "first_cpu_model": ""
+    });
+    v["log"] = dir.join("room.jsonl").to_str().expect("utf-8").into();
+    v["token_file"] = dir.join("tokens").to_str().expect("utf-8").into();
+    for (k, x) in extra {
+        v[*k] = x.clone();
+    }
+    let path = dir.join("settings.json");
+    std::fs::write(&path, serde_json::to_vec(&v).expect("serializes")).expect("written");
+    path
+}
+
+fn spawn(settings: &Path) -> Child {
+    Command::new(env!("CARGO_BIN_EXE_npt-server"))
+        .args(["--settings", settings.to_str().expect("utf-8")])
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("the binary starts")
+}
+
+/// One start: spawn, the time to its first stdout line (the test's stand-in for npt-super's timer, which npt-server's
+/// tests cannot run: npt-super's own tests run it against fake children), a few ticks, stdin closed, the exit.
+/// Returns (the first line, spawn to that line in ns, the exit code, the rest of stdout, stderr).
+#[allow(
+    clippy::disallowed_types,
+    clippy::disallowed_methods,
+    reason = "the test times spawn to OPEN on the real clock (u6a-brief.md section 3); the room reads its own clock in \
+              one item"
+)]
+fn start(settings: &Path) -> (String, u64, Option<i32>, String, String) {
+    let t0 = std::time::Instant::now();
+    let mut child = spawn(settings);
+    let mut out = BufReader::new(child.stdout.take().expect("piped"));
+    // The first line on its own thread, awaited at most 5 s (TR-U6A-7): a room that never opens is killed and the test
+    // fails at the cap, never hangs.
+    let (tx, rx) = std::sync::mpsc::channel();
+    let reader = std::thread::spawn(move || {
+        let mut first = String::new();
+        let read = out.read_line(&mut first);
+        let open_ns = u64::try_from(t0.elapsed().as_nanos()).unwrap_or(u64::MAX);
+        let _ = tx.send((read.map(|_| first), open_ns));
+        out
+    });
+    let (first, open_ns) = match rx.recv_timeout(Duration::from_secs(5)) {
+        Ok((first, open_ns)) => (first.expect("stdout reads"), open_ns),
+        Err(e) => {
+            let _ = child.kill();
+            let _ = child.wait();
+            panic!("no first line within the 5 s cap ({e:?}): the room was killed");
+        }
+    };
+    let mut out = reader.join().expect("the reader");
+    std::thread::sleep(Duration::from_millis(300));
+    drop(child.stdin.take());
+    let status = child.wait().expect("the binary ends");
+    let mut rest = String::new();
+    out.read_to_string(&mut rest).expect("stdout reads");
+    let mut err = String::new();
+    child
+        .stderr
+        .take()
+        .expect("piped")
+        .read_to_string(&mut err)
+        .expect("stderr reads");
+    (first, open_ns, status.code(), rest, err)
+}
+
+fn log_of(dir: &Path) -> (Log, String) {
+    let text = std::fs::read_to_string(dir.join("room.jsonl")).expect("the room's log");
+    (read_log(text.as_bytes()).expect("the log reads back"), text)
+}
+
+/// The judge's `machine_named` (judge/src/figures.rs:742-764), as this test reads a header: every text field filled,
+/// every count above 0, an SMT map with every list filled, and a VM's day address.
+fn machine_named(m: &Machine) -> bool {
+    let texts = [
+        &m.role,
+        &m.name,
+        &m.plan,
+        &m.arch,
+        &m.cpu,
+        &m.location,
+        &m.kernel,
+    ];
+    texts.iter().all(|t| !t.is_empty())
+        && m.vcpus > 0
+        && m.mem_mb > 0
+        && m.threads_per_core > 0
+        && m.clock_res_ns > 0
+        && !m.smt.is_empty()
+        && m.smt.iter().all(|s| !s.is_empty())
+        && (!matches!(m.role.as_str(), "RS" | "LG" | "MV") || !m.address.is_empty())
+}
+
+#[test]
+fn s8a_the_binary_opens_within_5_s_exits_0_when_stdin_closes_and_no_token_leaves_the_token_file() {
+    let dir = folder("open");
+    let (first, open_ns, code, rest, err) = start(&settings(&dir, &[]));
+    println!(
+        "spawn to OPEN: {:.1} ms (container reading, not judged; the 5 s cap only)",
+        open_ns as f64 / 1e6
+    );
+    assert_eq!(first, "OPEN\n", "stderr: {err}");
+    assert!(
+        open_ns < 5_000_000_000,
+        "OPEN within the 5 s real-clock cap"
+    );
+    assert_eq!(code, Some(0), "stderr: {err}");
+    assert_eq!(rest, "", "one line on stdout");
+    let (log, text) = log_of(&dir);
+    assert_eq!(
+        (
+            log.header.process.as_str(),
+            log.header.clients,
+            log.header.scene.as_str()
+        ),
+        ("room", 2, "SS")
+    );
+    assert!(
+        machine_named(&log.header.machine),
+        "the container's header names its machine"
+    );
+    assert!(!log.ticks.is_empty());
+    assert_eq!(log.footer.map(|f| f.ended), Some(Ended::Clean));
+    assert!(
+        log.events
+            .iter()
+            .any(|e| e.ev == "cpu_read" && e.f["changed"] == 0),
+        "the first start's cpu_read"
+    );
+    let tokens = std::fs::read_to_string(dir.join("tokens")).expect("the token file");
+    let tokens: Vec<&str> = tokens
+        .lines()
+        .filter_map(|l| l.split_once(' ').map(|x| x.1))
+        .collect();
+    assert_eq!(tokens.len(), 2);
+    for t in &tokens {
+        let raw = t.trim_start_matches("nptj_");
+        for (what, s) in [("log", &text), ("stdout", &rest), ("stderr", &err)] {
+            assert!(!s.contains(raw), "a token in the {what}");
+        }
+    }
+    std::fs::remove_dir_all(&dir).expect("removed");
+}
+
+#[test]
+fn s8a_the_binary_exits_2_for_bad_settings_or_an_existing_token_file_or_log() {
+    let usage = Command::new(env!("CARGO_BIN_EXE_npt-server"))
+        .output()
+        .expect("runs");
+    assert_eq!(usage.status.code(), Some(2), "no settings");
+    let dir = folder("codes");
+    let unknown = settings(&dir, &[("extra", 1.into())]);
+    let out = Command::new(env!("CARGO_BIN_EXE_npt-server"))
+        .args(["--settings", unknown.to_str().expect("utf-8")])
+        .output()
+        .expect("runs");
+    assert_eq!(out.status.code(), Some(2), "an unknown field");
+    assert!(
+        !dir.join("tokens").exists(),
+        "nothing minted for bad settings"
+    );
+    let good = settings(&dir, &[]);
+    for existing in ["tokens", "room.jsonl"] {
+        std::fs::write(dir.join(existing), b"there").expect("written");
+        let out = Command::new(env!("CARGO_BIN_EXE_npt-server"))
+            .args(["--settings", good.to_str().expect("utf-8")])
+            .stdin(Stdio::null())
+            .output()
+            .expect("runs");
+        assert_eq!(out.status.code(), Some(2), "an existing {existing}");
+        assert_eq!(
+            std::fs::read(dir.join(existing)).expect("read"),
+            b"there",
+            "left as it was"
+        );
+        let _ = std::fs::remove_file(dir.join("tokens"));
+        let _ = std::fs::remove_file(dir.join("room.jsonl"));
+    }
+    std::fs::remove_dir_all(&dir).expect("removed");
+}
+
+/// The process-level bites (bites builds only), each failing its mark's check by name on the log it writes.
+#[cfg(feature = "bites")]
+mod bites {
+    use super::*;
+
+    /// PM-0001-16/double-load: the bitten start reads its settings twice more, each behind 1 s, so its OPEN comes
+    /// 2 s or more after the spawn, and its header names the bite in a bites build. -16's check on npt-super's own log
+    /// (process `super`, the run's bite in its header) is npt-super's test
+    /// `h_the_log_header_carries_the_runs_bite_scene_and_tick_rate` (TR-U6A-1).
+    #[test]
+    fn pm_0001_16_double_load_fails_every_start_under_2_s() {
+        let dir = folder("double-load");
+        let (first, open_ns, code, _, err) = start(&settings(
+            &dir,
+            &[("bite", "PM-0001-16/double-load".into())],
+        ));
+        assert_eq!(first, "OPEN\n", "stderr: {err}");
+        assert_eq!(code, Some(0));
+        let h = log_of(&dir).0.header;
+        assert_eq!(h.bite.as_deref(), Some("PM-0001-16/double-load"));
+        assert_eq!(h.build.features, ["bites"]);
+        println!("double-load: spawn to OPEN {:.1} ms", open_ns as f64 / 1e6);
+        assert!(
+            open_ns >= 2_000_000_000,
+            "the bitten start opens 2 s or more after its spawn: {open_ns} ns"
+        );
+        std::fs::remove_dir_all(&dir).expect("removed");
+    }
+
+    /// PM-0006-11/no-smt-map: the bitten room's header has no SMT map, so `machine_named` is 0 and PM-0006-11's check
+    /// "RS named: ... threads per core and the SMT sibling map" (machine_named == 1) fails; the clean start's names it.
+    #[test]
+    fn pm_0006_11_no_smt_map_fails_the_machine_named_check() {
+        let dir = folder("no-smt-map");
+        let (first, _, code, _, err) =
+            start(&settings(&dir, &[("bite", "PM-0006-11/no-smt-map".into())]));
+        assert_eq!(first, "OPEN\n", "stderr: {err}");
+        assert_eq!(code, Some(0));
+        let log = log_of(&dir).0;
+        assert!(log.header.machine.smt.is_empty(), "no SMT map");
+        assert!(
+            !machine_named(&log.header.machine),
+            "PM-0006-11's check 'RS named: ... and the SMT sibling map' fails: machine_named 0"
+        );
+        std::fs::remove_dir_all(&dir).expect("removed");
+    }
+}
diff --git a/spikes/netcode-proof/crates/server/tests/carry.rs b/spikes/netcode-proof/crates/server/tests/carry.rs
new file mode 100644
index 0000000..92c12b8
--- /dev/null
+++ b/spikes/netcode-proof/crates/server/tests/carry.rs
@@ -0,0 +1,229 @@
+//! C-U6-17's test (plan.md:1254; u6a-brief.md Block 7 and condition 5): "one 600 ms pong and a 10 ms path, under
+//! option B's buffer of 8, with no kind-10 refusal on the honest client". The honest client is a real endpoint under
+//! U4f's controller (max lead 9, the lab's), against a room and its decoder on an injected clock, over a test-local
+//! delaying `Link` on Loopback (common/mod.rs's `Gate` pattern: Loopback itself neither delays nor loses), never L1.
+//!
+//! The 600 ms exchange is run both ways round: slow on its way down (the `Pong` late) and slow on its way up (its
+//! `Ping` late). Both lift the client's upper one-way estimate past the controller's cap of 9; the slow way down also
+//! lifts its clock offset by about 15 ms (300 ms in the mean of about 20 samples), which by itself pulls its stamps
+//! back about half a tick on this path, so only the slow way up shows what the cap prevents (U6a's notes, P7: without
+//! the cap the slow way down still passes). Both ways run under option A as well, each option set on the room
+//! (TR-U6A-3).
+
+use std::collections::VecDeque;
+
+use npt_client::ClientEndpoint;
+use npt_link::{Channel, Link, LinkState, Loopback, Recv, SendResult};
+use npt_proto::{Direction, Join, Message, Quant, channel_of, decode};
+use npt_room::{CmdTiming, Room};
+use npt_server::{Decoder, RttSource};
+use npt_sim::replay::Recording;
+use npt_sim::{Scene, World};
+
+const MS: u64 = 1_000_000;
+const VERSION: u16 = 1;
+const CONTENT: [u8; 32] = [7; 32];
+
+/// A Loopback end whose received messages each arrive `delay` later, and the `slow`-th message of type `ty` (read in
+/// direction `way`) 600 ms later still, in arrival order (so the slow one holds nothing behind it).
+struct Delay {
+    inner: Loopback,
+    delay: u64,
+    way: Direction,
+    ty: &'static str,
+    slow: Option<usize>,
+    seen: usize,
+    held: VecDeque<Recv>,
+}
+
+impl Delay {
+    fn new(inner: Loopback, way: Direction, ty: &'static str, slow: Option<usize>) -> Delay {
+        Delay {
+            inner,
+            delay: 5 * MS,
+            way,
+            ty,
+            slow,
+            seen: 0,
+            held: VecDeque::new(),
+        }
+    }
+}
+
+impl Link for Delay {
+    fn send_unreliable(&mut self, bytes: &[u8], now_ns: u64) -> SendResult {
+        self.inner.send_unreliable(bytes, now_ns)
+    }
+    fn send_reliable(&mut self, channel: Channel, bytes: &[u8], now_ns: u64) -> SendResult {
+        self.inner.send_reliable(channel, bytes, now_ns)
+    }
+    fn poll_recv(&mut self, now_ns: u64) -> Option<Recv> {
+        // Every message sent so far (the lab is one thread), each given its arrival.
+        while let Some(mut r) = self.inner.poll_recv(u64::MAX) {
+            r.arrival_ns += self.delay;
+            if decode(self.way, r.channel, &r.bytes).is_ok_and(|m| m.name() == self.ty) {
+                self.seen += 1;
+                if Some(self.seen) == self.slow {
+                    r.arrival_ns += 600 * MS;
+                }
+            }
+            let at = self
+                .held
+                .iter()
+                .position(|h| h.arrival_ns > r.arrival_ns)
+                .unwrap_or(self.held.len());
+            self.held.insert(at, r);
+        }
+        if self.held.front().is_some_and(|r| r.arrival_ns <= now_ns) {
+            self.held.pop_front()
+        } else {
+            None
+        }
+    }
+    fn state(&self) -> LinkState {
+        self.inner.state()
+    }
+    fn rtt_ns(&self) -> Option<u64> {
+        self.inner.rtt_ns()
+    }
+    fn max_datagram_size(&self) -> usize {
+        self.inner.max_datagram_size()
+    }
+    fn unsent_unreliable(&self) -> usize {
+        self.inner.unsent_unreliable()
+    }
+}
+
+/// One run of 5 s under `timing`: the 3rd exchange's `Pong` 600 ms late (`up` false) or its `Ping` (`up` true).
+/// Returns the commands given and run, the kind-10 refusals, the largest lead and the slow messages' type count seen.
+fn run(timing: CmdTiming, up: bool) -> (usize, u64, u64, i64, usize) {
+    let scene = Scene::course();
+    let first = 1_000;
+    let world = World::new(&scene, 5, first);
+    let greybox = world.greybox().clone();
+    let token = [0x5a; 16];
+    let join = Join {
+        token,
+        bind: [0xa5; 16],
+        version: VERSION,
+        content_hash: CONTENT,
+    };
+    // Option A or B, set explicitly (TR-U6A-3).
+    let mut room = Room::new(world, &scene, &greybox, vec![token], 1, npt_sim::TICK_HZ)
+        .with_hashes(CONTENT, [0; 32])
+        .with_cmd_timing(timing);
+    let (s, c) = Loopback::pair(1_200);
+    // A 10 ms path: 5 ms each way; the 3rd exchange 600 ms slow, down or up.
+    let (down, rise) = if up { (None, Some(3)) } else { (Some(3), None) };
+    let mut server = Delay::new(s, Direction::ClientToRoom, "Ping", rise);
+    let mut client = Delay::new(c, Direction::RoomToClient, "Pong", down);
+    let base = 1_000_000_000;
+    let mut decoder = Decoder::new(
+        Quant::default(),
+        npt_sim::TICK_HZ,
+        base,
+        VERSION,
+        CONTENT,
+        RttSource::Link,
+    );
+    let mut e = ClientEndpoint::new(join, npt_sim::TICK_HZ).with_clock(9);
+    let commands: Vec<npt_sim::Command> = Recording::synthetic(&scene, 5, first, 200, 2_000)
+        .ticks
+        .iter()
+        .flat_map(|t| t.commands.iter().map(|(c, _)| *c))
+        .filter(|c| c.slot == 0)
+        .collect();
+    let mut given = 0usize;
+    let mut slot = None;
+    let mut lead_max = 0i64;
+    let tick_ns = |k: u64| base + k * 1_000_000_000 / u64::from(npt_sim::TICK_HZ);
+    for k in 0..150u64 {
+        let now = tick_ns(k);
+        let tick = room.last_tick().wrapping_add(1);
+        let mut msgs = Vec::new();
+        decoder.pump(&mut server, now, tick, &mut msgs);
+        for (m, _) in msgs {
+            match (&m, slot) {
+                (Message::Join(j), _) => {
+                    let (s, _) = room.join(j).expect("the roster takes it");
+                    decoder.accept();
+                    slot = Some(s);
+                }
+                (_, Some(s)) => room.receive(s, &m),
+                _ => {}
+            }
+        }
+        if let Some(s) = slot {
+            room.pump_report(s, decoder.take_sent_bytes(), server.max_datagram_size());
+        }
+        room.tick();
+        if let Some(s) = slot {
+            for d in room.take_datagrams(s) {
+                server.send_unreliable(&d, now);
+            }
+            for b in room.take_control(s) {
+                server.send_reliable(channel_of(&b).unwrap_or(Channel::Control), &b, now);
+            }
+        }
+        // The client steps 1 ms after each server tick.
+        let at = now + MS;
+        let mut got = Vec::new();
+        while let Some(r) = client.poll_recv(at) {
+            got.push((r.channel, r.bytes, r.arrival_ns));
+        }
+        e.input(None, &got, at);
+        for _ in 0..e.commands_due() {
+            e.input(Some(commands[given % commands.len()]), &[], at);
+            given += 1;
+        }
+        let out = e.step();
+        for d in &out.datagrams {
+            client.send_unreliable(d, at);
+        }
+        for (ch, b) in &out.reliable {
+            client.send_reliable(*ch, b, at);
+        }
+        lead_max = lead_max.max(e.lead_now().unwrap_or(0));
+    }
+    let k = room.client(0).expect("joined").counters().clone();
+    (
+        given,
+        k.commands_run,
+        k.buffer_full,
+        lead_max,
+        client.seen + server.seen,
+    )
+}
+
+/// Both legs under option B (C-U6-17's words) and option A (TR-U6A-3: C-U6-16 (b) keeps A selectable); every leg runs
+/// before the first assert, so a failure names each leg's refusals.
+#[test]
+fn c_u6_17_one_600_ms_pong_on_a_10_ms_path_brings_no_kind_10_refusal_under_option_b() {
+    let legs: Vec<_> = [CmdTiming::A, CmdTiming::B]
+        .into_iter()
+        .flat_map(|t| [(t, false), (t, true)])
+        .map(|(timing, up)| {
+            let way = if up {
+                "its ping slow (up)"
+            } else {
+                "the pong slow (down)"
+            };
+            (format!("{timing:?}, {way}"), run(timing, up))
+        })
+        .collect();
+    for (leg, (given, ran, refused, lead, seen)) in &legs {
+        println!(
+            "C-U6-17, {leg}: {given} commands given, {ran} run, {refused} refused as kind 10, largest lead {lead}, \
+             {seen} of the slow message's type seen"
+        );
+    }
+    let refusals: Vec<(&str, u64)> = legs.iter().map(|(l, r)| (l.as_str(), r.2)).collect();
+    for (leg, (_, ran, refused, _, seen)) in &legs {
+        assert!(*seen > 3, "{leg}: the slow one came and went");
+        assert!(*ran > 60, "{leg}: the honest client played");
+        assert_eq!(
+            *refused, 0,
+            "{leg}: no kind-10 refusal on the honest client (each leg's refusals: {refusals:?})"
+        );
+    }
+}
