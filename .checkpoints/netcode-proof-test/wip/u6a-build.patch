diff --git a/spikes/netcode-proof/crates/bots/tests/host_step.rs b/spikes/netcode-proof/crates/bots/tests/host_step.rs
new file mode 100644
index 0000000..bb58c62
--- /dev/null
+++ b/spikes/netcode-proof/crates/bots/tests/host_step.rs
@@ -0,0 +1,137 @@
+//! C-U6-18's test (EA-U4F-9; u6a-brief.md Block 8): `Behaviour::host_step` runs input, the endpoint's step and
+//! outgoing in that order. The never-acker's hook rewrites the `Input` the step made, so its acknowledgement is gone;
+//! an honest behaviour's step sends its acknowledgement as made; a kind-11 forger's reliable hook adds its message.
+
+use npt_bots::Behaviour;
+use npt_client::ClientEndpoint;
+use npt_link::Channel;
+use npt_proto::{
+    Direction, EntityDelta, FullState, Join, JoinAccepted, Message, Snapshot, decode, encode,
+};
+use npt_sim::{EntityKind, EntityRecord, Scene};
+
+fn bytes(m: &Message) -> Vec<u8> {
+    let mut out = Vec::new();
+    encode(m, &mut out).unwrap_or_else(|e| panic!("{}: {e}", m.name()));
+    out
+}
+
+fn soldier(index: u16, x: i32) -> EntityRecord {
+    let mut grid = [0; EntityRecord::FIELDS];
+    grid[0] = x;
+    grid[6] = 1_000;
+    EntityRecord {
+        kind: EntityKind::Soldier,
+        index,
+        generation: 0,
+        area: 0,
+        grid,
+        raw: [0; EntityRecord::FIELDS],
+    }
+}
+
+/// The room's `JoinAccepted` for slot 0 and full state at tick 100, then one snapshot group at tick 101.
+fn room() -> [Vec<(Channel, Vec<u8>, u64)>; 2] {
+    let joined = vec![
+        (
+            Channel::Control,
+            bytes(&Message::JoinAccepted(JoinAccepted {
+                slot: 0,
+                tick: 100,
+                ..JoinAccepted::default()
+            })),
+            0,
+        ),
+        (
+            Channel::FullState,
+            bytes(&Message::FullState(FullState {
+                tick: 100,
+                last_run: None,
+                own: vec![soldier(0, 0)],
+                entities: vec![soldier(1, 100)],
+            })),
+            0,
+        ),
+    ];
+    let delta = EntityDelta::between(&soldier(1, 150), Some(&soldier(1, 100))).expect("a change");
+    let snap = Message::Snapshot(Snapshot {
+        tick: 101,
+        baseline_age: 1,
+        group: 0,
+        groups: 1,
+        entities: vec![delta],
+        ..Snapshot::default()
+    });
+    [joined, vec![(Channel::Datagram, bytes(&snap), 0)]]
+}
+
+/// The `Input` a host step sent: its acknowledged tick (the wire's low 16 bits) and groups, and its commands' count.
+fn input(datagrams: &[Vec<u8>]) -> (u16, u8, usize) {
+    datagrams
+        .iter()
+        .find_map(
+            |d| match decode(Direction::ClientToRoom, Channel::Datagram, d) {
+                Ok(Message::Input(i)) => Some((i.ack_tick, i.ack_groups, i.commands.len())),
+                _ => None,
+            },
+        )
+        .expect("the step sent an Input")
+}
+
+#[test]
+fn c_u6_18_host_step_runs_input_then_the_endpoints_step_then_outgoing() {
+    let scene = Scene::stress();
+    let [joined, snap] = room();
+    for never_acks in [false, true] {
+        let mut b = Behaviour::brawl(&scene, 0, 7);
+        if never_acks {
+            b = b.never_acks();
+        }
+        let mut e = ClientEndpoint::new(Join::default(), npt_sim::TICK_HZ).with_lead(1);
+        let (given, _) = b.host_step(&mut e, &joined, 0, &[]);
+        assert!(given, "the full state's tick is the newest: a command");
+        let (given, out) = b.host_step(&mut e, &snap, 33, &[]);
+        assert!(given, "the newest tick moved: a command");
+        let (ack_tick, ack_groups, commands) = input(&out.datagrams);
+        assert!(
+            commands >= 1,
+            "input ran before the endpoint's step: its command is in the Input"
+        );
+        if never_acks {
+            assert_eq!(
+                (ack_tick, ack_groups),
+                (0, 0),
+                "outgoing ran after the endpoint's step: the never-acker's hook rewrote its Input"
+            );
+        } else {
+            assert_eq!(
+                (ack_tick, ack_groups),
+                (101, 1),
+                "an honest step acknowledges tick 101's group"
+            );
+        }
+    }
+    // The reliable hook acts after the endpoint's step too (TR-U6A-10): a kind-11 forger's second command brings its
+    // `Ping` framed for the control stream, which host_step puts last on the step's reliable messages.
+    let mut b = Behaviour::brawl(&scene, 0, 7)
+        .forger(11, 2, 12)
+        .expect("a kind-11 forger");
+    let mut e = ClientEndpoint::new(Join::default(), npt_sim::TICK_HZ).with_lead(1);
+    let (given, _) = b.host_step(&mut e, &joined, 0, &[]);
+    assert!(given, "the first command");
+    let (given, out) = b.host_step(&mut e, &snap, 33, &[]);
+    assert!(given, "the second command: the forged one");
+    let (channel, framed) = out.reliable.last().expect("a reliable message");
+    assert_eq!(*channel, Channel::Control);
+    assert!(
+        matches!(
+            decode(
+                Direction::ClientToRoom,
+                Channel::Datagram,
+                framed.get(2..).unwrap_or_default()
+            ),
+            Ok(Message::Ping(_))
+        ),
+        "the forged Ping, framed for the control stream, in out.reliable"
+    );
+}
diff --git a/spikes/netcode-proof/crates/proto/tests/channel.rs b/spikes/netcode-proof/crates/proto/tests/channel.rs
new file mode 100644
index 0000000..1d16fac
--- /dev/null
+++ b/spikes/netcode-proof/crates/proto/tests/channel.rs
@@ -0,0 +1,64 @@
+//! `channel_of` (C-U6-16 (c); U6a): the stream a framed reliable message travels on, read from its own framing.
+
+use npt_link::Channel;
+use npt_proto::{
+    EndReason, FullState, JoinAccepted, Kick, Limits, Message, RoomEnded, Snapshot, channel_of,
+    encode,
+};
+
+fn bytes(m: &Message) -> Vec<u8> {
+    let mut out = Vec::new();
+    encode(m, &mut out).unwrap_or_else(|e| panic!("{}: {e}", m.name()));
+    out
+}
+
+/// Every room → client stream message the room queues (`JoinAccepted`, `Kick`, `RoomEnded` on the control stream, a
+/// `FullState` on its own) is read on its row's channel; a datagram, a cut message and a frame whose length does not
+/// count its bytes are none; and a full-state frame above 262,144 B (built by hand: the room's own stay within
+/// `Limits::FULL_STATE`), whose length's third byte is a control type's (4, `Resync`), is still the full-state stream.
+#[test]
+fn channel_of_reads_each_stream_message_by_its_framing_at_any_length() {
+    let control = [
+        Message::JoinAccepted(JoinAccepted::default()),
+        Message::Kick(Kick::Replaced),
+        Message::RoomEnded(RoomEnded {
+            reason: EndReason::Crash,
+            final_tick: 70_000,
+        }),
+    ];
+    for m in &control {
+        assert_eq!(
+            channel_of(&bytes(m)),
+            Some(Channel::Control),
+            "{}",
+            m.name()
+        );
+    }
+    let full = bytes(&Message::FullState(FullState {
+        tick: 9,
+        last_run: None,
+        own: vec![],
+        entities: vec![],
+    }));
+    assert_eq!(channel_of(&full), Some(Channel::FullState));
+    let snap = bytes(&Message::Snapshot(Snapshot::default()));
+    assert_eq!(channel_of(&snap), None, "a datagram has no length prefix");
+    let kick = bytes(&Message::Kick(Kick::Overflow));
+    assert_eq!(channel_of(&kick[..kick.len() - 1]), None, "cut short");
+    assert_eq!(channel_of(&[]), None);
+    let mut longer = kick.clone();
+    longer.push(0);
+    assert_eq!(
+        channel_of(&longer),
+        None,
+        "a byte the length does not count"
+    );
+    // A full state of 262,148 B after its 4 B length: its length's bytes are [0x04, 0x00, 0x04, 0x00].
+    let body = 262_144 + 4;
+    let mut big = (body as u32).to_le_bytes().to_vec();
+    big.push(3);
+    big.resize(4 + body, 0);
+    assert_eq!(big[2], 4, "the third byte names Resync, a control type");
+    assert_eq!(Limits::TYPES[3].1, Channel::Control);
+    assert_eq!(channel_of(&big), Some(Channel::FullState));
+}
diff --git a/spikes/netcode-proof/crates/server/src/clock.rs b/spikes/netcode-proof/crates/server/src/clock.rs
