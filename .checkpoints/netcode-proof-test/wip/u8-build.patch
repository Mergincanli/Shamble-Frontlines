index 0000000..54cea0a
--- /dev/null
+++ b/spikes/netcode-proof/ops/sbin/npt-cert
@@ -0,0 +1,121 @@
+#!/bin/bash -p
+# npt-cert issue staging|production: the WebSocket leg's browser-trusted certificate by DNS-01 by hand
+# (u8-brief.md rev 1.1 section 1 Block 3; replan-units.md:107-118; Q-U8-4 as ruled). Root-owned, 0755.
+# 1. Opens npt-host's egress to the one ACME directory host (its addresses resolved here, each element timing out
+#    after 35 minutes); DNS goes over loopback to the local resolver, which nftables admits.
+# 2. Runs U6c's issue mode as npt-host, ONE process across both phases (no ACME key or order state on disk between
+#    them). Its interface (U6c's brief, C1 (a)): stdout `PROFILE <name>`, `TXT_NAME <name>`, `TXT_VALUE <value>`;
+#    then it reads `go` on stdin; then `SERIAL <hex>`, `SHA256 <hex>`, `DONE`. The directory's profile list goes to
+#    stderr as one line `PROFILES <name>,<name>…`, which this wrapper passes through, so the cert block's results keep
+#    it. It writes four files under /var/lib/npt/tls, the key (0640, group npt-room through the setgid directory) and
+#    then the chain: staging.key.pem and staging.chain.pem, or production.key.pem and production.chain.pem (one name
+#    for both orders would make the production order exit 2 on the existing path). Every room's WebSocket names the
+#    production pair; npt-host.path starts the page host once production.chain.pem exists. The issue mode requires
+#    `shortlived` in production (fails closed); this wrapper checks the PROFILE line too.
+# 3. Polls EVERY authoritative server of the zone (npt-ns.txt in the root-owned clone) with `dig +norecurse` every
+#    15 s and sends `go` only when all show the value (Let's Encrypt validates from several perspectives). One
+#    30-minute bound covers both phases; no retry loop: a failed order stops the run and comes back to Mustafa.
+# 4. Closes the egress, prints the serial and hash for the ledger. The TXT value goes to stdout only, never a file.
+if [ "${NPT_ENV_CLEARED:-}" != 1 ]; then
+  exec /usr/bin/env -i NPT_ENV_CLEARED=1 PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C /bin/bash -p /usr/local/sbin/npt-cert "$@"
+fi
+set -euo pipefail
+set -f
+umask 022
+. /usr/local/lib/npt/npt-lib.sh
+
+die() { printf 'npt-cert: %s\n' "$*" >&2; exit 2; }
+fail() { printf 'npt-cert: order FAILED: %s. The run stops; this comes back to Mustafa.\n' "$*" >&2; exit 3; }
+
+[ "$#" -eq 2 ] && [ "$1" = issue ] && npt_valid_word "$2" staging production || die "usage: npt-cert issue staging|production"
+[ "$(tr -d '\n' < /etc/npt/role)" = rs ] || die "RS only"
+readonly PROFILE=$2
+case $PROFILE in
+  staging) readonly ACME=acme-staging-v02.api.letsencrypt.org ;;
+  production) readonly ACME=acme-v02.api.letsencrypt.org ;;
+esac
+
+ns=()
+while read -r n; do
+  case $n in '' | '#'*) continue ;; esac
+  npt_valid_hostname "$n" || die "npt-ns.txt holds a bad name"
+  ns+=("$n")
+done < /usr/local/lib/npt/npt-ns.txt
+[ "${#ns[@]}" -ge 2 ] || die "npt-ns.txt must name every authoritative server of the zone"
+
+readonly DEADLINE=$(($(date +%s) + 1800))
+left() { printf '%s\n' $((DEADLINE - $(date +%s))); }
+ISSUE_PID=''
+cleanup() {
+  if [ -n "$ISSUE_PID" ]; then kill "$ISSUE_PID" 2>/dev/null || true; fi
+  nft flush set inet npt acme_v4 || true
+}
+trap cleanup EXIT
+
+addrs=()
+while read -r a; do npt_valid_ipv4 "$a" && addrs+=("$a timeout 35m"); done < <(dig +short +time=5 +tries=2 A "$ACME")
+[ "${#addrs[@]}" -ge 1 ] || fail "the ACME host did not resolve"
+elements=$(IFS=,; printf '%s' "${addrs[*]}")
+nft "add element inet npt acme_v4 { ${elements//,/, } }"
+
+coproc ISSUE {
+  umask 027
+  exec /usr/bin/setpriv --reuid=npt-host --regid=npt-host --clear-groups --no-new-privs --bounding-set=-all \
+    --inh-caps=-all --ambient-caps=-all --reset-env /opt/npt/bin/npt-host issue "$PROFILE"
+}
+
+VALUE=''
+expect() {
+  local t line
+  t=$(left)
+  ((t > 0)) || fail "30 minutes passed before $1"
+  IFS= read -r -t "$t" line <&"${ISSUE[0]}" || fail "the issue mode ended or stalled before $1"
+  if [ "$1" = DONE ]; then
+    [ "$line" = DONE ] || fail "unexpected line from the issue mode before DONE (not printed)"
+    return 0
+  fi
+  [[ $line =~ ^$1\ ([^[:space:]]+)$ ]] || fail "unexpected line from the issue mode before $1 (not printed)"
+  VALUE=${BASH_REMATCH[1]}
+}
+
+expect PROFILE
+if [ "$PROFILE" = production ] && [ "$VALUE" != shortlived ]; then
+  fail "production requires the shortlived profile (the order's: $(npt_comm_clean "$VALUE"))"
+fi
+order_profile=$VALUE
+expect TXT_NAME
+[ "$VALUE" = "$NPT_CHALLENGE_NAME" ] || fail "the challenge name is not $NPT_CHALLENGE_NAME"
+expect TXT_VALUE
+npt_valid_txt_value "$VALUE" || fail "the TXT value is malformed"
+txt=$VALUE
+printf 'Add in Cloudflare (zone shamblefrontlines.com): type TXT, name _acme-challenge.rs.nt, content %s, TTL 1 min.\n' "$txt"
+printf 'Polling %s every 15 s; at most until %s UTC.\n' "${ns[*]}" "$(date -u -d "@$DEADLINE" +%H:%M:%S)"
+
+while :; do
+  all=1
+  for n in "${ns[@]}"; do
+    got=$(dig +norecurse +short +time=5 +tries=1 TXT "$NPT_CHALLENGE_NAME" "@$n" 2>/dev/null | tr -d '"') || got=''
+    grep -qxF -- "$txt" <<< "$got" || all=0
+  done
+  [ "$all" = 1 ] && break
+  (($(left) > 15)) || fail "the TXT record did not show on every authoritative server within 30 minutes"
+  sleep 15
+done
+printf 'Every authoritative server shows it: readying the challenge.\n'
+printf 'go\n' >&"${ISSUE[1]}"
+
+expect SERIAL
+npt_valid_hex "$VALUE" || fail "the serial is malformed"
+serial=$VALUE
+expect SHA256
+[[ $VALUE =~ ^[0-9a-f]{64}$ ]] || fail "the hash is malformed"
+sha=$VALUE
+expect DONE
+pid=$ISSUE_PID
+for _ in $(seq 1 30); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
+kill -0 "$pid" 2>/dev/null && fail "the issue mode did not end after DONE"
+wait "$pid" || fail "the issue mode ended non-zero"
+ISSUE_PID=''
+nft flush set inet npt acme_v4
+printf 'npt-cert: issued (%s, profile %s); egress closed. Ledger: serial %s, sha256 %s.\n' "$PROFILE" "$order_profile" "$serial" "$sha"
+printf 'Delete the TXT record now; the session confirms its absence over DNS-over-HTTPS.\n'
diff --git a/spikes/netcode-proof/ops/sbin/npt-ctl b/spikes/netcode-proof/ops/sbin/npt-ctl
new file mode 100644
index 0000000..4f202ce
--- /dev/null
+++ b/spikes/netcode-proof/ops/sbin/npt-ctl
@@ -0,0 +1,211 @@
+#!/bin/bash -p
+# npt-ctl: the run's root controls (u8-brief.md rev 1.1 section 1 Block 3; C1, C4; Q-U8-1, -3, -7; L4).
+# Installed root-owned, 0755, at /usr/local/sbin/npt-ctl; `npt` reaches it only through sudoers.d/npt (RS) or npt-lg
+# (LG), each argument matched there by an anchored pattern and validated again here by npt-lib.sh.
+#   RS:  npt-ctl peers <LG IPv4> [<more LG IPv4s>]   metrics_src, PermitOpen <LG>:22, sshd -t, reload; VM addresses only
+#        npt-ctl cpus <tick vCPU>                     condition 4's housekeeping set (slices, workqueue mask, kthreads)
+#        npt-ctl rooms start NN                       `npt-super start` (its hold form) as npt-room in npt-rooms.slice,
+#                                                     its flags from the room's settings (stdin held)
+#        npt-ctl rooms tokens NN                      that room's token file, read as npt-room, to stdout only
+#        npt-ctl quic off|on                          UDP 30001-30032 dropped from all but metrics_src, 15 min at most
+#   LG:  npt-ctl loadkey <RS IPv4>                    RS's .pub (one line on stdin) for npt-load, forced command (C4)
+# No free argument reaches systemd-run, setpriv, taskset, nft, sshd or systemctl: each command line is built from
+# validated values and root-owned records only (Q-U8-1 term 2).
+if [ "${NPT_ENV_CLEARED:-}" != 1 ]; then
+  exec /usr/bin/env -i NPT_ENV_CLEARED=1 PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C /bin/bash -p /usr/local/sbin/npt-ctl "$@"
+fi
+set -euo pipefail
+set -f
+umask 022
+. /usr/local/lib/npt/npt-lib.sh
+
+readonly STATE=/var/lib/npt/state
+readonly SETPRIV_ROOM=(/usr/bin/setpriv --reuid=npt-room --regid=npt-room --clear-groups --no-new-privs
+  --bounding-set=-all --inh-caps=-all --ambient-caps=-all --reset-env)
+
+die() { printf 'npt-ctl: %s\n' "$*" >&2; exit 2; }
+role() { tr -d '\n' < /etc/npt/role; }
+need_role() { [ "$(role)" = "$1" ] || die "this verb runs on ${1^^} only"; }
+
+peers() {
+  need_role rs
+  [ "$#" -ge 1 ] && [ "$#" -le 4 ] || die "peers takes 1 to 4 LG addresses"
+  local a open=() rule
+  for a in "$@"; do npt_valid_ipv4 "$a" || die "not a public IPv4 in plain form"; open+=("$a:22"); done
+  rule=$(npt_metrics_rule "$@")
+  nft flush set inet npt metrics_src
+  nft "$rule"
+  local conf=/etc/ssh/sshd_config.d/00-npt-open.conf tmp
+  tmp=$(mktemp /etc/ssh/sshd_config.d/.npt-open.XXXXXX)
+  cp -p "$conf" "$conf.prev"
+  printf 'PermitOpen %s\n' "${open[*]}" > "$tmp"
+  chmod 0644 "$tmp"
+  mv -f "$tmp" "$conf"
+  if ! /usr/sbin/sshd -t; then
+    mv -f "$conf.prev" "$conf"
+    die "sshd -t refused the new PermitOpen; the previous file is back"
+  fi
+  rm -f "$conf.prev"
+  systemctl --no-pager reload ssh.service
+  printf 'lg=%s\n' "$*" > "$STATE/peers.tmp"
+  mv -f "$STATE/peers.tmp" "$STATE/peers"
+  printf 'peers: metrics_src {%s}; PermitOpen %s; sshd -t ok; reloaded\n' "$*" "${open[*]}"
+  # Bring-up's dry runs (plan.md:1151, u8-brief.md section 3): the effective sshd values of plan.md:1150-1155 and the
+  # loaded ruleset, for comparison with rs.yaml. VM addresses only.
+  printf -- '--- sshd -T (the plan'"'"'s keys)\n'
+  /usr/sbin/sshd -T | grep -Ei '^(passwordauthentication|kbdinteractiveauthentication|permitrootlogin|authenticationmethods|x11forwarding|allowagentforwarding|maxauthtries|logingracetime|allowusers|allowtcpforwarding|permitlisten|allowstreamlocalforwarding|permittunnel|gatewayports|permitopen) '
+  printf -- '--- nft list ruleset\n'
+  nft list ruleset
+}
+
+cpus() {
+  need_role rs
+  [ "$#" -eq 1 ] || die "cpus takes one tick vCPU"
+  local online n tick sib hk path refused=0 moved=0 left=0 counts=0 line
+  online=$(tr -d '\n' < /sys/devices/system/cpu/online)
+  npt_cpulist_valid "$online" || die "unreadable online CPU list"
+  n=$(npt_cpulist_count "$online")
+  npt_valid_vcpu "$1" "$n" || die "the tick vCPU must be an online CPU index"
+  tick=$((10#$1))
+  sib=$(tr -d '\n' < "/sys/devices/system/cpu/cpu$tick/topology/thread_siblings_list")
+  hk=$(npt_housekeeping "$online" "$tick" "$sib") || die "no housekeeping set would be left"
+  local rec="$STATE/cpus.tmp"
+  {
+    printf 'tick=%s\nsiblings=%s\nonline=%s\nhousekeeping=%s\n' "$tick" "$sib" "$online" "$hk"
+    for u in system.slice user.slice; do
+      systemctl --no-pager set-property --runtime "$u" "AllowedCPUs=$hk"
+      printf 'allowed.%s=%s\n' "$u" "$(systemctl --no-pager show -P AllowedCPUs "$u")"
+    done
+    # L4: systemd may refuse AllowedCPUs= on init.scope, or take it and leave PID 1's own list on the tick vCPU
+    # (INF-SB-9); PID 1's Cpus_allowed_list is read after it, and while it still holds the tick vCPU (or reads
+    # nothing) PID 1's threads are moved by taskset too. Both are recorded.
+    if systemctl --no-pager set-property --runtime init.scope "AllowedCPUs=$hk" 2>/dev/null; then
+      printf 'init.scope=AllowedCPUs %s\n' "$(systemctl --no-pager show -P AllowedCPUs init.scope)"
+    else
+      printf 'init.scope=set-property refused\n'
+    fi
+    line=$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' /proc/1/status)
+    printf 'pid1.allowed_after_set_property=%s\n' "$(npt_comm_clean "$line")"
+    if npt_pid1_needs_move "$line" "$tick"; then
+      local pid1=()
+      set +f
+      pid1=(/proc/1/task/[0-9]*)
+      set -f
+      for path in "${pid1[@]}"; do taskset -pc "$hk" "${path##*/}" >/dev/null; done
+      printf 'init.scope=taskset on PID 1 threads\npid1.allowed_after_taskset=%s\n' \
+        "$(npt_comm_clean "$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' /proc/1/status)")"
+    fi
+    printf '%s\n' "$(npt_cpumask_hex "$hk")" > /sys/devices/virtual/workqueue/cpumask
+    printf 'workqueue.cpumask=%s\n' "$(tr -d '\n' < /sys/devices/virtual/workqueue/cpumask)"
+    while read -r line; do
+      set -- $line
+      case $1 in
+        move)
+          if taskset -pc "$hk" "$2" >/dev/null 2>&1; then moved=$((moved + 1))
+          else refused=$((refused + 1)); printf 'kthread.refused=%s %s\n' "$2" "$3"; fi ;;
+        left) left=$((left + 1)) ;;
+        counts) counts=$((counts + 1)) ;;
+      esac
+    done < <(affinity_records | npt_affinity_scan "$tick")
+    printf 'kthreads.moved=%s\nkthreads.refused=%s\nkthreads.left_per_cpu=%s\n' "$moved" "$refused" "$left"
+    # The read-back: threads that would still count against `alone` after the moves (before any room starts).
+    printf 'tasks.on_tick_after_moves=%s\n' "$(affinity_records | npt_affinity_scan "$tick" | grep -c '^\(counts\|move\) ' || true)"
+    # IRQ affinity is read and recorded per vCPU, never changed (no mark asks it).
+    awk 'NR == 1 { n = NF; next } { for (i = 2; i <= n + 1; i++) if ($i ~ /^[0-9]+$/) s[i - 2] += $i }
+         END { for (c = 0; c < n; c++) printf "irq.cpu%d=%d\n", c, s[c] }' /proc/interrupts
+  } > "$rec"
+  chmod 0644 "$rec"
+  mv -f "$rec" "$STATE/cpus"
+  cat "$STATE/cpus"
+}
+
+# One record per thread for npt_affinity_scan: tid, stat flags, Cpus_allowed_list, a clean name.
+affinity_records() {
+  local t stat rest flags allowed comm tasks=()
+  set +f
+  tasks=(/proc/[0-9]*/task/[0-9]*)
+  set -f
+  for t in "${tasks[@]}"; do
+    stat=$(cat "$t/stat" 2>/dev/null) || continue
+    rest=${stat##*) }
+    set -- $rest
+    flags=${7:-}
+    allowed=$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' "$t/status" 2>/dev/null) || continue
+    comm=$(cat "$t/comm" 2>/dev/null) || continue
+    printf '%s %s %s %s\n' "${t##*/}" "$flags" "$allowed" "$(npt_comm_clean "$comm")"
+  done
+}
+
+housekeeping_record() {
+  local hk
+  [ -f "$STATE/cpus" ] && [ ! -L "$STATE/cpus" ] || die "run npt-ctl cpus first"
+  hk=$(sed -n 's/^housekeeping=//p' "$STATE/cpus")
+  npt_cpulist_valid "$hk" || die "the housekeeping record is unreadable"
+  printf '%s\n' "$hk"
+}
+
+rooms() {
+  need_role rs
+  [ "$#" -eq 2 ] && npt_valid_word "$1" start tokens && npt_valid_nn "$2" || die "rooms start|tokens NN"
+  local nn=$2
+  case $1 in
+    tokens)
+      # Q-U8-7 with Q-U8-1 term 4: read as npt-room, so a link the room plants reaches nothing npt-room cannot read.
+      exec "${SETPRIV_ROOM[@]}" /usr/bin/head -c 1048576 -- "/var/lib/npt/rooms/room-$nn.tok" ;;
+    start)
+      local hk vals=()
+      hk=$(housekeeping_record)
+      [ -f "/var/lib/npt/run/room-$nn.json" ] || die "no settings at /var/lib/npt/run/room-$nn.json"
+      # npt-super's flags from the room's own settings, read as npt-room and checked field by field (npt-lib.sh).
+      mapfile -t vals < <("${SETPRIV_ROOM[@]}" /usr/bin/python3 -I -c "$NPT_SETTINGS_PY" \
+        "/var/lib/npt/run/room-$nn.json" "$NPT_SUPER_FIELDS")
+      npt_super_args "$nn" "${vals[@]}" || die "the room's settings do not give npt-super's flags"
+      # A restart frees the room's token and hash paths as npt-room (U6a and U6b refuse an existing path).
+      "${SETPRIV_ROOM[@]}" /usr/bin/rm -f -- "/var/lib/npt/rooms/room-$nn.tok" "/var/lib/npt/hash/room-$nn.json"
+      # Condition 3 and Q-U8-1: npt-super's hold form (`start`, U6a's merged code) as npt-room in npt-rooms.slice
+      # (every CPU), started off the tick vCPU by taskset so only the room's tick thread pins itself onto it
+      # (Q-U6A-5); stdin passes through, and its close is npt-super's end (never a kill: a log with no footer
+      # makes the run INVALID).
+      exec systemd-run --quiet --scope --collect --slice=npt-rooms.slice --unit="npt-room-$nn-$$" \
+        "${SETPRIV_ROOM[@]}" /usr/bin/taskset -c "$hk" /opt/npt/bin/npt-super start "${NPT_SUPER_ARGS[@]}" ;;
+  esac
+}
+
+quic() {
+  need_role rs
+  [ "$#" -eq 1 ] && npt_valid_word "$1" off on || die "quic off|on"
+  if [ "$1" = off ]; then
+    nft list set inet npt metrics_src | grep -Eq 'elements = \{' || die "metrics_src is empty: run npt-ctl peers first"
+    nft "$NPT_QUIC_OFF_RULE"
+  else
+    nft "$NPT_QUIC_ON_RULE"
+  fi
+  nft list set inet npt quic_off | sed -n 's/^[[:space:]]*elements = /quic_off: /p'
+  printf 'quic %s\n' "$1"
+}
+
+loadkey() {
+  need_role lg
+  [ "$#" -eq 1 ] && npt_valid_ipv4 "$1" || die "loadkey takes RS's IPv4"
+  local key tmp
+  key=$(head -c 512 | head -n 1 | tr -d '\r')
+  npt_valid_pubkey "$key" || die "stdin is not one ed25519 public key line"
+  set -- "$1" $key
+  tmp=$(mktemp /etc/ssh/authorized_keys/.npt-load.XXXXXX)
+  printf 'from="%s",restrict,command="/usr/local/bin/npt-load-ctl" %s %s npt-rs-to-lg\n' "$1" "$2" "$3" > "$tmp"
+  chmod 0644 "$tmp"
+  mv -f "$tmp" /etc/ssh/authorized_keys/npt-load
+  ssh-keygen -l -f /etc/ssh/authorized_keys/npt-load
+}
+
+[ "$#" -ge 1 ] || die "a verb is needed"
+verb=$1
+shift
+case $verb in
+  peers) peers "$@" ;;
+  cpus) cpus "$@" ;;
+  rooms) rooms "$@" ;;
+  quic) quic "$@" ;;
+  loadkey) loadkey "$@" ;;
+  *) die "unknown verb" ;;
+esac
diff --git a/spikes/netcode-proof/ops/sbin/npt-lib.sh b/spikes/netcode-proof/ops/sbin/npt-lib.sh
new file mode 100644
index 0000000..1bef972
--- /dev/null
+++ b/spikes/netcode-proof/ops/sbin/npt-lib.sh
@@ -0,0 +1,240 @@
+# npt-lib.sh: validators and pure computations for U8's wrappers (u8-brief.md rev 1.1 section 1 Block 3).
+# No side effects: sourcing defines constants and functions only, reads no file and runs no command, so the container
+# tests (ops/tests/wrappers.test.sh) source it as the wrappers do. Installed root-owned, 0644, at
+# /usr/local/lib/npt/npt-lib.sh. Every validator takes exactly one argument and refuses anything else.
+
+readonly NPT_OCTET='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
+readonly NPT_PF_KTHREAD=$((0x00200000))
+readonly NPT_MAX_CPUS=32
+# Q-U8-3: the QUIC block. One interval element with a 15-minute timeout, so the block cannot stay on.
+readonly NPT_QUIC_OFF_RULE='add element inet npt quic_off { 30001-30032 timeout 15m }'
+readonly NPT_QUIC_ON_RULE='flush set inet npt quic_off'
+readonly NPT_DNS_NAME='rs.nt.shamblefrontlines.com'
+readonly NPT_CHALLENGE_NAME='_acme-challenge.rs.nt.shamblefrontlines.com'
+
+# A public IPv4 in plain dotted form: no leading zero, no CIDR, no mapped or decimal form, no special range
+# (unspecified, private, shared, loopback, link-local, multicast, reserved, broadcast).
+npt_valid_ipv4() {
+  [ "$#" -eq 1 ] || return 1
+  local re="^${NPT_OCTET}\\.${NPT_OCTET}\\.${NPT_OCTET}\\.${NPT_OCTET}\$"
+  [[ $1 =~ $re ]] || return 1
+  local a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]}
+  ((a == 0 || a == 10 || a == 127 || a >= 224)) && return 1
+  ((a == 100 && b >= 64 && b <= 127)) && return 1
+  ((a == 169 && b == 254)) && return 1
+  ((a == 172 && b >= 16 && b <= 31)) && return 1
+  ((a == 192 && b == 168)) && return 1
+  return 0
+}
+
+# A room slot NN, 00-31 (two digits; settings path /var/lib/npt/run/room-NN.json).
+npt_valid_nn() {
+  [ "$#" -eq 1 ] && [[ $1 =~ ^(0[0-9]|[12][0-9]|3[01])$ ]]
+}
+
+# A vCPU index below the online count (two arguments: the index, then the count the wrapper read).
+npt_valid_vcpu() {
+  [ "$#" -eq 2 ] && [[ $1 =~ ^([0-9]|[12][0-9]|3[01])$ ]] && [[ $2 =~ ^[1-9][0-9]?$ ]] && ((10#$1 < 10#$2))
+}
+
+# One word from a fixed list: npt_valid_word <word> <allowed>...
+npt_valid_word() {
+  [ "$#" -ge 2 ] || return 1
+  local w=$1 x
+  shift
+  for x in "$@"; do [ "$w" = "$x" ] && return 0; done
+  return 1
+}
+
+# A kernel cpu list ("0-3,8"), every CPU below NPT_MAX_CPUS.
+npt_cpulist_valid() {
+  [ "$#" -eq 1 ] && [[ $1 =~ ^[0-9]{1,2}(-[0-9]{1,2})?(,[0-9]{1,2}(-[0-9]{1,2})?)*$ ]] || return 1
+  local part lo hi
+  local IFS=,
+  for part in $1; do
+    lo=${part%-*} hi=${part#*-}
+    ((10#$lo <= 10#$hi && 10#$hi < NPT_MAX_CPUS)) || return 1
+  done
+}
+
+# Expands a valid cpu list to its CPUs, ascending, space-separated.
+npt_cpulist_expand() {
+  npt_cpulist_valid "$1" || return 1
+  local part lo hi c out=() seen=()
+  local IFS=,
+  for part in $1; do
+    lo=$((10#${part%-*})) hi=$((10#${part#*-}))
+    for ((c = lo; c <= hi; c++)); do seen[c]=1; done
+  done
+  for c in "${!seen[@]}"; do out+=("$c"); done
+  IFS=' '
+  printf '%s\n' "${out[*]}"
+}
+
+# True if a valid cpu list holds the CPU.
+npt_cpulist_has() {
+  local c
+  for c in $(npt_cpulist_expand "$1"); do [ "$c" = "$2" ] && return 0; done
+  return 1
+}
+
+# The number of CPUs in a valid cpu list.
+npt_cpulist_count() {
+  local n=0 c
+  for c in $(npt_cpulist_expand "$1"); do n=$((n + 1)); done
+  printf '%s\n' "$n"
+}
+
+# Condition 4's housekeeping set: every online CPU but the tick vCPU and its SMT siblings.
+# npt_housekeeping <online list> <tick vCPU> <the tick's thread_siblings_list>; prints a comma list, or fails when the
+# tick is offline, not among its own siblings, or nothing would be left.
+npt_housekeeping() {
+  [ "$#" -eq 3 ] || return 1
+  npt_cpulist_valid "$1" && npt_cpulist_valid "$3" || return 1
+  npt_cpulist_has "$1" "$2" && npt_cpulist_has "$3" "$2" || return 1
+  local c out=()
+  for c in $(npt_cpulist_expand "$1"); do
+    npt_cpulist_has "$3" "$c" || out+=("$c")
+  done
+  [ "${#out[@]}" -gt 0 ] || return 1
+  local IFS=,
+  printf '%s\n' "${out[*]}"
+}
+
+# INF-SB-9: PID 1's threads still need taskset when its Cpus_allowed_list (read after set-property) holds the tick
+# vCPU or does not read as a cpu list. npt_pid1_needs_move <allowed list> <tick vCPU>.
+npt_pid1_needs_move() {
+  [ "$#" -eq 2 ] || return 0
+  ! npt_cpulist_valid "$1" || npt_cpulist_has "$1" "$2"
+}
+
+# The unbound workqueue mask (/sys/devices/virtual/workqueue/cpumask) for a valid cpu list, in hex.
+npt_cpumask_hex() {
+  npt_cpulist_valid "$1" || return 1
+  local m=0 c
+  for c in $(npt_cpulist_expand "$1"); do m=$((m | (1 << c))); done
+  printf '%x\n' "$m"
+}
+
+# A thread name as the records print it: at most 32 characters of [A-Za-z0-9_.:/-], every other character `?`
+# (a room can name its threads, so a name never reaches a record raw).
+npt_comm_clean() {
+  local s=${1:0:32}
+  printf '%s\n' "${s//[^A-Za-z0-9_.:\/-]/?}"
+}
+
+# Condition 4's selection, on records read from /proc by `npt-ctl cpus` (one per thread, on stdin):
+#   <tid> <flags from /proc/<pid>/task/<tid>/stat> <Cpus_allowed_list> <clean name>
+# Prints, for the tick vCPU given:
+#   move <tid> <name>    a kernel thread (PF_KTHREAD) allowed on more than one CPU: moved to the housekeeping set
+#   left <tid> <name>    a kernel thread bound to the tick vCPU only: per-CPU, left, and excluded from `alone`
+#   counts <tid> <name>  any other thread whose allowed list holds the tick vCPU: it counts against `alone`
+# A malformed record is printed as `bad <line>` and never selected.
+npt_affinity_scan() {
+  [ "$#" -eq 1 ] || return 1
+  local tick=$1 tid flags allowed name n
+  while read -r tid flags allowed name; do
+    if ! [[ $tid =~ ^[0-9]{1,9}$ && $flags =~ ^[0-9]{1,12}$ ]] || ! npt_cpulist_valid "$allowed"; then
+      printf 'bad %s\n' "$(npt_comm_clean "$tid $flags $allowed")"
+      continue
+    fi
+    n=$(npt_cpulist_count "$allowed")
+    if ((10#$flags & NPT_PF_KTHREAD)); then
+      if ((n > 1)); then
+        printf 'move %s %s\n' "$tid" "$name"
+      elif [ "$allowed" = "$tick" ]; then
+        printf 'left %s %s\n' "$tid" "$name"
+      fi
+    elif npt_cpulist_has "$allowed" "$tick"; then
+      printf 'counts %s %s\n' "$tid" "$name"
+    fi
+  done
+}
+
+# npt-load-ctl's fixed verbs (C4), parsed from SSH_ORIGINAL_COMMAND: `<verb> NN` or `fwcheck`. Sets NPT_VERB and
+# NPT_NN; refuses every other text, extra words included.
+npt_load_parse() {
+  NPT_VERB='' NPT_NN=''
+  [ "$#" -eq 1 ] || return 1
+  if [[ $1 =~ ^(token|settings|start|stop|status|log|npt-log)\ (0[0-9]|[12][0-9]|3[01])$ ]]; then
+    NPT_VERB=${BASH_REMATCH[1]} NPT_NN=${BASH_REMATCH[2]}
+    return 0
+  fi
+  if [ "$1" = fwcheck ]; then
+    NPT_VERB=fwcheck
+    return 0
+  fi
+  return 1
+}
+
+# The RS-to-LG public key, one line: ed25519 only (a 51-byte blob is 68 base64 characters), an optional plain comment.
+npt_valid_pubkey() {
+  [ "$#" -eq 1 ] && [[ $1 =~ ^ssh-ed25519\ AAAAC3NzaC1lZDI1NTE5AAAAI[A-Za-z0-9+/]{43}(\ [A-Za-z0-9@._-]{1,64})?$ ]]
+}
+
+# The DNS-01 TXT value instant-acme gives (KeyAuthorization::dns_value: base64url of a SHA-256, 43 characters).
+npt_valid_txt_value() {
+  [ "$#" -eq 1 ] && [[ $1 =~ ^[A-Za-z0-9_-]{43}$ ]]
+}
+
+# A DNS host name in lower case (the zone's authoritative servers, read from the root-owned clone).
+npt_valid_hostname() {
+  [ "$#" -eq 1 ] && [[ $1 =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$ ]]
+}
+
+# A certificate serial or a SHA-256 in hex, as the issue mode prints them.
+npt_valid_hex() {
+  [ "$#" -eq 1 ] && [[ $1 =~ ^[0-9a-f]{2,128}$ ]]
+}
+
+# npt-super's `start` flags from one room's settings (fix pass items 8 and 10; U6a's merged npt-super,
+# crates/super/src/main.rs:54-139). `npt-ctl rooms start` reads the settings file as npt-room with NPT_SETTINGS_PY,
+# which prints one value per line in NPT_SUPER_FIELDS' order (marks joined by commas, a null bite empty), and passes
+# them here: each is checked against an anchored pattern, so npt-super's log takes the room's run and the same eight
+# header values (set, role, layer, profile, date, scene, tick_hz, bite) from that one file; the judge makes a run
+# INVALID when its logs differ on any of them (NR-U6A-1). Sets NPT_SUPER_ARGS; the room binary is the bites build only
+# for a bite, and npt-super's log is the room log's name with `super-` for `room-`.
+readonly NPT_SUPER_FIELDS='run set role date commit layer profile scene tick_hz machine_role machine_name machine_plan machine_location machine_address marks bite log'
+readonly NPT_SETTINGS_PY='import json, sys
+raw = open(sys.argv[1], "rb").read(65537)
+s = json.loads(raw) if len(raw) <= 65536 else sys.exit(2)
+out = []
+for k in sys.argv[2].split():
+    v = s.get(k)
+    if k == "marks" and isinstance(v, list) and all(isinstance(m, str) for m in v):
+        v = ",".join(v)
+    elif k == "bite" and v is None:
+        v = ""
+    if isinstance(v, bool) or not isinstance(v, (str, int)) or "\n" in str(v) or "\r" in str(v):
+        sys.exit(2)
+    out.append(str(v))
+sys.stdout.write("".join(x + "\n" for x in out))'
+npt_super_args() {
+  NPT_SUPER_ARGS=()
+  [ "$#" -eq 18 ] && npt_valid_nn "$1" || return 1
+  local nn=$1 id='^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$' w='^[A-Za-z0-9-]{1,16}$' mark='PM-[0-9]{4}-[0-9]{1,3}'
+  [[ $2 =~ $id && $3 =~ $id && $4 =~ ^[a-z][a-z-]{0,31}$ && $5 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || return 1
+  [[ $6 =~ ^[0-9a-f]{40}$ && $7 =~ ^(L1|L2|real)$ && $8 =~ ^(P[0-4]|B1|real-path)$ && $9 =~ ^(SS|ES|CO|TC)$ ]] || return 1
+  [[ ${10} =~ ^[1-9][0-9]{0,2}$ && ${11} =~ ^[A-Z]{1,8}$ && ${12} =~ $w && ${13} =~ $w && ${14} =~ ^[a-z0-9-]{1,16}$ ]] || return 1
+  [ -z "${15}" ] || npt_valid_ipv4 "${15}" || return 1
+  [[ ${16} =~ ^($mark(,$mark){0,15})?$ && ${17} =~ ^($mark/[a-z0-9-]{1,32})?$ ]] || return 1
+  [[ ${18} =~ ^/var/lib/npt/rooms/room-$nn(-[a-z0-9-]{1,32})?\.jsonl$ ]] || return 1
+  local bin=/opt/npt/bin/npt-server
+  [ -z "${17}" ] || bin=/opt/npt/bin/npt-server-bites
+  NPT_SUPER_ARGS=(--room "$bin" --settings "/var/lib/npt/run/room-$nn.json" --log "${18/\/room-//super-}"
+    --run "$2" --set "$3" --role "$4" --date "$5" --commit "$6" --layer "$7" --profile "$8" --scene "$9"
+    --tick-hz "${10}" --machine-role "${11}" --machine-name "${12}" --machine-plan "${13}"
+    --machine-location "${14}" --machine-address "${15}")
+  [ -z "${16}" ] || NPT_SUPER_ARGS+=(--marks "${16}")
+  [ -z "${17}" ] || NPT_SUPER_ARGS+=(--bite "${17}")
+}
+
+# The metrics_src element command for validated LG addresses (npt-ctl peers).
+npt_metrics_rule() {
+  [ "$#" -ge 1 ] && [ "$#" -le 4 ] || return 1
+  local a
+  for a in "$@"; do npt_valid_ipv4 "$a" || return 1; done
+  local IFS=,
+  local list="$*"
+  printf 'add element inet npt metrics_src { %s }\n' "${list//,/, }"
+}
diff --git a/spikes/netcode-proof/ops/sbin/npt-load-ctl b/spikes/netcode-proof/ops/sbin/npt-load-ctl
new file mode 100644
index 0000000..50d6c56
--- /dev/null
+++ b/spikes/netcode-proof/ops/sbin/npt-load-ctl
@@ -0,0 +1,89 @@
+#!/bin/bash -p
+# npt-load-ctl: LG's forced command for npt-load (C4; plan.md:1157-1162). Installed root-owned, 0755, at
+# /usr/local/bin/npt-load-ctl; it runs as npt-load (never root), named by `command=` in the root-owned
+# /etc/ssh/authorized_keys/npt-load with `from="<RS IPv4>",restrict` (written by `npt-ctl loadkey`). RS's run script
+# uses it to start, feed and stop U6c's npt-load, copy token files and run C5's check while Mustafa is away.
+# Fixed verbs from SSH_ORIGINAL_COMMAND, parsed by npt-lib.sh's npt_load_parse (no other word passes); fixed paths
+# under /var/lib/npt-load:
+#   token NN      stdin (at most 64 KiB) -> tokens/room-NN.tok (0600)
+#   settings NN   stdin (at most 64 KiB) -> run/load-NN.json (0600)
+#   start NN      /opt/npt/bin/npt-load run/load-NN.json, detached; log logs/load-NN.log
+#   stop NN       TERM, then KILL after 10 s; prints the exit (the abort path: recorded as stopped, no DONE)
+#   status NN     running or stopped
+#   log NN        the load's log (at most 256 MiB) to stdout
+#   npt-log NN    the load's npt-log, logs/load-NN.jsonl (at most 256 MiB), to stdout (NC-SB-7: RS keeps it)
+#   fwcheck       C5's LG half: a TCP connect to RS's port 22 must time out (only fw-rs can drop it)
+# npt-load's command line is U6c's (advisor-u6c-brief.md C1 (c)): `npt-load <settings path>`, one argument. It prints
+# READY once its clients are up and ends at the settings' duration_s with DONE and exit 0; its stdin is /dev/null
+# here, so stdin's close is no end for it.
+if [ "${NPT_ENV_CLEARED:-}" != 1 ]; then
+  exec /usr/bin/env -i NPT_ENV_CLEARED=1 PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C \
+    SSH_ORIGINAL_COMMAND="${SSH_ORIGINAL_COMMAND:-}" SSH_CONNECTION="${SSH_CONNECTION:-}" \
+    /bin/bash -p /usr/local/bin/npt-load-ctl
+fi
+set -euo pipefail
+set -f
+umask 077
+. /usr/local/lib/npt/npt-lib.sh
+
+readonly BASE=/var/lib/npt-load
+readonly BIN=/opt/npt/bin/npt-load
+readonly CAP=65536
+
+die() { printf 'npt-load-ctl: %s\n' "$*" >&2; exit 2; }
+npt_load_parse "${SSH_ORIGINAL_COMMAND:-}" || die "refused (verbs: token|settings|start|stop|status|log|npt-log NN, fwcheck)"
+readonly VERB=$NPT_VERB NN=$NPT_NN
+
+store() {
+  local tmp size
+  tmp=$(mktemp "$1.XXXXXX")
+  head -c $((CAP + 1)) > "$tmp"
+  size=$(stat -c %s "$tmp")
+  if ((size > CAP)); then rm -f "$tmp"; die "over $CAP bytes"; fi
+  mv -f "$tmp" "$1"
+  printf 'stored %s bytes\n' "$size"
+}
+
+PID=''
+running() {
+  local f="$BASE/run/load-$NN.pid"
+  [ -f "$f" ] || return 1
+  PID=$(tr -dc '0-9' < "$f")
+  [ -n "$PID" ] && [ "$(readlink "/proc/$PID/exe" 2> /dev/null)" = "$BIN" ]
+}
+
+case $VERB in
+  token) store "$BASE/tokens/room-$NN.tok" ;;
+  settings) store "$BASE/run/load-$NN.json" ;;
+  start)
+    running && die "load $NN is running already"
+    [ -f "$BASE/run/load-$NN.json" ] && [ -f "$BASE/tokens/room-$NN.tok" ] || die "settings and token first"
+    rm -f -- "$BASE/logs/load-$NN.jsonl"   # a re-run's fresh npt-log (RS kept the last one: NC-SB-7, NC-SB-10)
+    setsid "$BIN" "$BASE/run/load-$NN.json" < /dev/null > "$BASE/logs/load-$NN.log" 2>&1 &
+    printf '%s\n' "$!" > "$BASE/run/load-$NN.pid"
+    printf 'load %s started\n' "$NN"
+    ;;
+  stop)
+    running || die "load $NN is not running"
+    kill -TERM "$PID"
+    for _ in $(seq 1 20); do kill -0 "$PID" 2> /dev/null || break; sleep 0.5; done
+    if kill -0 "$PID" 2> /dev/null; then kill -KILL "$PID"; printf 'load %s killed after 10 s\n' "$NN"
+    else printf 'load %s stopped\n' "$NN"; fi
+    rm -f "$BASE/run/load-$NN.pid"
+    ;;
+  status) if running; then printf 'load %s running\n' "$NN"; else printf 'load %s stopped\n' "$NN"; fi ;;
+  log) head -c 268435456 -- "$BASE/logs/load-$NN.log" ;;
+  npt-log) head -c 268435456 -- "$BASE/logs/load-$NN.jsonl" ;;
+  fwcheck)
+    rs=${SSH_CONNECTION%% *}
+    npt_valid_ipv4 "$rs" || die "no RS address in the connection"
+    rc=0
+    timeout 5 bash -c 'exec 3<>"/dev/tcp/$0/22"' "$rs" 2> /dev/null || rc=$?
+    if [ "$rc" -eq 124 ]; then
+      printf 'fwcheck: blocked (LG cannot reach RS port 22: fw-rs is in force)\n'
+    else
+      printf 'fwcheck: OPEN (LG reached RS port 22: fw-rs is NOT in force; stop before any room opens)\n'
+      exit 3
+    fi
+    ;;
+esac
