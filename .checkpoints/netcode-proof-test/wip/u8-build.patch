+++ b/spikes/netcode-proof/ops/sbin/npt-userdata
@@ -0,0 +1,20 @@
+#!/bin/bash -p
+# npt-userdata [head]: the VM's stored user data, from a fixed path, for §7.3 step 7's check (plan.md:891-893); with
+# `head`, the two clones' commits (the root-owned clone read as root, which owns it; the build clone read as
+# npt-build, which owns it, so root never runs git in a tree another user writes). Root-owned, 0755.
+if [ "${NPT_ENV_CLEARED:-}" != 1 ]; then
+  exec /usr/bin/env -i NPT_ENV_CLEARED=1 PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C /bin/bash -p /usr/local/sbin/npt-userdata "$@"
+fi
+set -euo pipefail
+set -f
+umask 022
+
+die() { printf 'npt-userdata: %s\n' "$*" >&2; exit 2; }
+if [ "$#" -eq 0 ]; then
+  exec /usr/bin/cat /var/lib/cloud/instance/user-data.txt
+fi
+[ "$#" -eq 1 ] && [ "$1" = head ] || die "usage: npt-userdata [head]"
+printf 'clone %s\n' "$(HOME=/root GIT_CONFIG_NOSYSTEM=1 git -C /opt/npt/clone rev-parse HEAD)"
+printf 'build %s\n' "$(/usr/bin/setpriv --reuid=npt-build --regid=npt-build --clear-groups --no-new-privs \
+  --bounding-set=-all --inh-caps=-all --ambient-caps=-all --reset-env \
+  /usr/bin/env GIT_CONFIG_NOSYSTEM=1 git -C /home/npt-build/clone rev-parse HEAD)"
diff --git a/spikes/netcode-proof/ops/sbin/sudoers.d/npt b/spikes/netcode-proof/ops/sbin/sudoers.d/npt
new file mode 100644
index 0000000..e44bce1
--- /dev/null
+++ b/spikes/netcode-proof/ops/sbin/sudoers.d/npt
@@ -0,0 +1,14 @@
+# /etc/sudoers.d/npt on RS (u8-brief.md rev 1.1 section 1 Block 3): `npt` may run exactly these command lines as
+# root. Every argument is an anchored regular expression (sudo 1.9.10 or later reads ^...$), never `*`, which in
+# sudoers matches spaces too; "" admits no argument (Q-U8-1 confirmation 1, L5). Each wrapper validates again.
+# Checked by `visudo -c -f` before install and by the container test (ops/tests/wrappers.test.sh).
+Defaults:npt env_reset, !setenv, secure_path="/usr/sbin:/usr/bin:/sbin:/bin"
+npt ALL=(root) NOPASSWD: /usr/local/sbin/npt-ctl ^peers( (25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])([.](25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}){1,4}$
+npt ALL=(root) NOPASSWD: /usr/local/sbin/npt-ctl ^cpus ([0-9]|[12][0-9]|3[01])$
+npt ALL=(root) NOPASSWD: /usr/local/sbin/npt-ctl ^rooms (start|tokens) (0[0-9]|[12][0-9]|3[01])$
+npt ALL=(root) NOPASSWD: /usr/local/sbin/npt-ctl ^quic (off|on)$
+npt ALL=(root) NOPASSWD: /usr/local/sbin/npt-cert ^issue (staging|production)$
+npt ALL=(root) NOPASSWD: /usr/local/sbin/npt-capture ^(start|stop)$
+npt ALL=(root) NOPASSWD: /usr/local/sbin/npt-userdata ""
+npt ALL=(root) NOPASSWD: /usr/local/sbin/npt-userdata ^head$
+npt ALL=(root) NOPASSWD: /usr/local/sbin/npt-s14 ^run$
diff --git a/spikes/netcode-proof/ops/sbin/sudoers.d/npt-lg b/spikes/netcode-proof/ops/sbin/sudoers.d/npt-lg
