+# npt-host.path on RS (Q-U6C-7 as ruled, U8's F22; advisor-u6c-brief.md C1 (f)): starts npt-host.service once the
+# production order's chain exists. The issue mode writes that chain last, after the key's sync_all (C1 (a)), so the
+# host starts with both files whole. Staging writes staging.* beside it and starts nothing. rs.yaml installs this file
+# root-owned, 0644, from the root-owned clone; no sudoers line names npt-host or systemctl.
+[Unit]
+Description=npt page host: start once the production chain exists
+
+[Path]
+PathExists=/var/lib/npt/tls/production.chain.pem
+
+[Install]
+WantedBy=multi-user.target
diff --git a/spikes/netcode-proof/ops/systemd/npt-host.service b/spikes/netcode-proof/ops/systemd/npt-host.service
new file mode 100644
index 0000000..af18fd3
--- /dev/null
+++ b/spikes/netcode-proof/ops/systemd/npt-host.service
@@ -0,0 +1,26 @@
+# npt-host.service on RS (Q-U6C-7 as ruled; advisor-u6c-brief.md C1 (f)): U6c's page host, `npt-host serve`, as the
+# npt-host user on TCP 31000 with /etc/npt/host.json. Started only by npt-host.path (no [Install] section); runs until
+# stopped. rs.yaml installs this file root-owned, 0644, from the root-owned clone.
+# The restart rule (INF-SB-6, systemd.path(5)): when the host ends, the path unit checks the chain again and starts it
+# at once, so `Restart=no` does not hold it; the start limit does: a fourth start inside 300 s fails this unit and the
+# path unit for good, and `r1.sh host` then refuses. The sandbox (SEC-SB-9's part a read-only server cannot trip; the
+# rest, ProtectSystem=strict, PrivateDevices, MemoryDenyWriteExecute, SystemCallFilter and RestrictAddressFamilies,
+# comes from the host's needs at U6c's merge).
+[Unit]
+Description=npt page host (npt-host serve) on TCP 31000
+StartLimitIntervalSec=300
+StartLimitBurst=3
+
+[Service]
+Type=simple
+User=npt-host
+Group=npt-host
+NoNewPrivileges=yes
+ExecStart=/opt/npt/bin/npt-host serve /etc/npt/host.json
+Restart=no
+ProtectHome=yes
+PrivateTmp=yes
+CapabilityBoundingSet=
+RestrictNamespaces=yes
+LockPersonality=yes
+SystemCallArchitectures=native
