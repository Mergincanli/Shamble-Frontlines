--- /dev/null
+++ b/spikes/netcode-proof/ops/tests/browser.test.mjs
@@ -0,0 +1,164 @@
+// Test 4 (u8-brief.md rev 1.1 section 3; C2, C3; SEC-R1D-2, -3, -6): the browser package's config, lock and scripts.
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { execFileSync, spawnSync } from "node:child_process";
+import { readFileSync, readdirSync, statSync } from "node:fs";
+import { join, relative } from "node:path";
+import { test } from "node:test";
+import * as config from "../browser/config.mjs";
+import { OPS, SPIKE, leaks, text } from "./helpers.mjs";
+
+const FIXTURE = {
+  chrome: { browser: "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", driver: "C:\\Users\\m\\npt-operator\\drivers\\chromedriver.exe", driver_sha256: "a".repeat(64) },
+  edge: { browser: "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe", driver: "C:\\Users\\m\\npt-operator\\drivers\\msedgedriver.exe", driver_sha256: "b".repeat(64) },
+  firefox: { browser: "C:\\Program Files\\Mozilla Firefox\\firefox.exe", driver: "C:\\Users\\m\\npt-operator\\drivers\\geckodriver.exe", driver_sha256: "c".repeat(64) },
+};
+const m = config.loadMachine(FIXTURE);
+
+test("SEC-R1D-2: chromedriver and msedgedriver admit 127.0.0.1 only; no origin; geckodriver's localhost default kept", () => {
+  const c = config.capabilities(m, "chrome")["wdio:chromedriverOptions"];
+  assert.deepEqual(c.allowedIps, ["127.0.0.1"]);
+  assert.deepEqual(c.allowedOrigins, []);
+  assert.deepEqual(config.capabilities(m, "edge")["wdio:edgedriverOptions"].allowedIps, ["127.0.0.1"]);
+  const g = config.capabilities(m, "firefox")["wdio:geckodriverOptions"];
+  assert.ok(!("allowHosts" in g) && !("host" in g), "geckodriver keeps its localhost default");
+  assert.deepEqual(config.edgeDriverArgs(9515), ["--port=9515", "--allowed-ips=127.0.0.1"], "Edge's own driver line");
+  for (const b of config.BROWSERS) {
+    const all = JSON.stringify(config.remoteOptions(m, b));
+    assert.doesNotMatch(all, /0\.0\.0\.0|"\*"/, `${b}: no any-address, no wildcard`);
+  }
+  assert.doesNotMatch(text("browser/config.mjs") + text("browser/lib.mjs"), /0\.0\.0\.0/);
+});
+
+test("SEC-R1D-3: every driver and browser binary set from the machine record; cache and logs under .gate", () => {
+  const want = {
+    chrome: ["goog:chromeOptions", "wdio:chromedriverOptions"],
+    edge: ["ms:edgeOptions", "wdio:edgedriverOptions"],
+    firefox: ["moz:firefoxOptions", "wdio:geckodriverOptions"],
+  };
+  for (const [b, [browserKey, driverKey]] of Object.entries(want)) {
+    const caps = config.capabilities(m, b);
+    assert.equal(caps[browserKey].binary, FIXTURE[b].browser, `${b} browser binary`);
+    assert.equal(caps[driverKey].binary, FIXTURE[b].driver, `${b} driver binary`);
+    const o = config.remoteOptions(m, b);
+    for (const d of [o.outputDir, o.cacheDir]) assert.match(d, /[\\/]\.gate[\\/]/);
+  }
+  assert.throws(() => config.loadMachine({ ...FIXTURE, edge: { ...FIXTURE.edge, driver: "msedgedriver.exe" } }), /absolute path/);
+  assert.throws(() => config.loadMachine({ ...FIXTURE, chrome: { ...FIXTURE.chrome, driver_sha256: "" } }), /64 hex/);
+  assert.throws(() => config.loadMachine({ chrome: FIXTURE.chrome, edge: FIXTURE.edge }), /no firefox/);
+  assert.throws(() => config.verifyDriver(m, "chrome"), /no driver/);
+});
+
+test("the URL contract: the token rides in the fragment; bad rooms, suites and tokens refused", () => {
+  const u = new URL(config.pageUrl({ suite: "fallback", nn: "15", transport: "wt", attempt: 3, token: "nptj_" + "A".repeat(22) }));
+  assert.equal(u.origin, "https://rs.nt.shamblefrontlines.com:31000");
+  assert.equal(u.searchParams.get("suite"), "fallback");
+  assert.equal(u.searchParams.get("room"), "15");
+  assert.ok(u.hash.startsWith("#t=nptj_"), "the token in the fragment, never the query");
+  assert.ok(!u.search.includes("nptj_"));
+  assert.throws(() => config.pageUrl({ suite: "smoke", nn: "05", token: "x".repeat(20) }), /NN 10-19/);
+  assert.throws(() => config.pageUrl({ suite: "other", nn: "10", token: "x".repeat(20) }), /suite/);
+  assert.throws(() => config.pageUrl({ suite: "smoke", nn: "10", token: "a b" }), /token/);
+});
+
+test("the slot table equals R1.md's and r1.sh's (C3), a slot per attempt", () => {
+  const r1 = text("runs/r1.sh");
+  const plan = text("runs/R1.md");
+  for (const [room, { nn, slots }] of Object.entries(config.ROOMS)) {
+    assert.match(r1, new RegExp(`${room}\\) printf '${nn} ${slots}\\\\n'`));
+    assert.match(plan, new RegExp(`\\| ${room} \\| ${nn} \\| ${slots} \\|`));
+  }
+  assert.equal(config.SMOKE_SLOTS.length, config.ROOMS.smoke.slots);
+  assert.equal(config.MDS_SLOTS.length, config.ROOMS.mds.slots);
+  assert.equal(config.ATTEMPTS.laptop, config.ROOMS["cert-chrome"].slots);
+  assert.equal(config.ATTEMPTS.laptop, config.ROOMS["fallback-edge"].slots);
+});
+
+test("the package: webdriverio 10.2.0 exact, the lock as cleared (DEP-HOLD), every entry from the registry with sha512", () => {
+  const sha = (f) => createHash("sha256").update(readFileSync(join(OPS, "browser", f))).digest("hex");
+  assert.equal(sha("package.json"), "8370495dee2ed77e6a937c6f40c72a5485015428d57f90505f4e440504293c90");
+  assert.equal(sha("package-lock.json"), "a0efce8e511a8865d50008172b3f88e9cc072efbe92a85a035340562b7c49524");
+  const pkg = JSON.parse(text("browser/package.json"));
+  assert.deepEqual(pkg.dependencies, { webdriverio: "10.2.0" });
+  assert.ok(!pkg.scripts && !pkg.overrides && !pkg.devDependencies);
+  const lock = JSON.parse(text("browser/package-lock.json"));
+  assert.equal(lock.lockfileVersion, 3);
+  const entries = Object.entries(lock.packages).filter(([k]) => k !== "");
+  assert.equal(entries.length, 167, "security-u8-deps.md C0: 167 entries");
+  assert.equal(lock.packages["node_modules/webdriverio"].version, "10.2.0");
+  for (const [k, e] of entries) {
+    assert.ok(e.resolved.startsWith("https://registry.npmjs.org/"), `${k}: registry`);
+    assert.match(e.integrity, /^sha512-/, `${k}: sha512`);
+  }
+  assert.deepEqual(entries.filter(([, e]) => e.hasInstallScript).map(([k]) => k).sort(), ["node_modules/edgedriver", "node_modules/geckodriver"]);
+  assert.ok(!entries.some(([k]) => /@wdio\/cli|@wdio\/local-runner/.test(k)), "no testrunner");
+});
+
+/** Every text file under ops/ but node_modules and the tests themselves. */
+function opsFiles(dir = OPS, out = []) {
+  for (const n of readdirSync(dir)) {
+    const p = join(dir, n);
+    if (n === "node_modules" || p === join(OPS, "tests")) continue;
+    if (statSync(p).isDirectory()) opsFiles(p, out);
+    else out.push(p);
+  }
+  return out;
+}
+
+test("C2: no .npmrc under spikes/; every npm install is `npm ci --ignore-scripts` with npm_config_ignore_scripts=true", () => {
+  const tracked = execFileSync("git", ["ls-files", "--", "."], { cwd: SPIKE, encoding: "utf8" }).split("\n");
+  assert.deepEqual(tracked.filter((f) => /(^|\/)\.npmrc$/.test(f)), []);
+  const onDisk = (dir) => readdirSync(dir).flatMap((n) => {
+    const p = join(dir, n);
+    if (n === "node_modules" || n === "target" || n === ".gate") return [];
+    if (n === ".npmrc") return [p];
+    return statSync(p).isDirectory() ? onDisk(p) : [];
+  });
+  assert.deepEqual(onDisk(SPIKE), []);
+  let installs = 0;
+  for (const f of opsFiles()) {
+    if (f.endsWith("package-lock.json")) continue;
+    const lines = readFileSync(f, "utf8").split("\n");
+    for (const raw of lines) {
+      // The prohibition itself names each form as a lone code span; a real command never is one.
+      const l = raw.replace(/`(npx|npm exec|npm create|npm install|npm update)`/g, "");
+      assert.doesNotMatch(l, /\bnpx\b|npm exec|npm create|npm install|npm i\b|npm update/, `${relative(OPS, f)}: ${raw}`);
+      if (/\bnpm ci\b/.test(l)) {
+        installs++;
+        assert.match(l, /npm ci --ignore-scripts/, `${relative(OPS, f)}: ${l}`);
+        assert.match(l, /npm_config_ignore_scripts=true|\$env:npm_config_ignore_scripts = "true"/, `${relative(OPS, f)}: ${l}`);
+      }
+    }
+  }
+  assert.ok(installs >= 3, "R1.md's two forms, rules.md's, rs.yaml's");
+});
+
+test("the scripts: plain Node on standalone webdriverio, no testrunner; each refuses a bad browser; no address", () => {
+  for (const s of ["lib.mjs", "smoke.mjs", "cert14d.mjs", "fallback.mjs", "mds36.mjs", "config.mjs"]) {
+    const body = text(`browser/${s}`);
+    execFileSync(process.execPath, ["--check", join(OPS, "browser", s)]);
+    const code = body.split("\n").filter((l) => !/^\s*\/\/.*\bnever\b/.test(l)).join("\n");
+    assert.doesNotMatch(code, /@wdio\/cli|@wdio\/local-runner|\bdescribe\(|\bit\(/, s);
+    assert.deepEqual(leaks(body), [], s);
+  }
+  assert.match(text("browser/lib.mjs"), /^import \{ remote \} from "webdriverio";$/m);
+  // A refused browser exits 2 with its usage line before any SSH or WebDriver call.
+  for (const s of ["smoke.mjs", "cert14d.mjs", "fallback.mjs"]) {
+    const r = spawnSync(process.execPath, [join(OPS, "browser", s), "safari"], { encoding: "utf8" });
+    assert.equal(r.status, 2, `${s}: ${r.stderr}`);
+    assert.match(r.stderr, /^usage: node /, s);
+  }
+  const r = spawnSync(process.execPath, [join(OPS, "browser", "mds36.mjs"), "extra"], { encoding: "utf8" });
+  assert.equal(r.status, 2);
+});
+
+test("C3: fallback re-arms the block per browser and marks a WebTransport arrival INVALID; cert-14d writes attempt.ok", () => {
+  const f = text("browser/fallback.mjs");
+  assert.match(f, /console\.log\(quic\("off"\)\);/);
+  assert.match(f, /reached_webtransport/);
+  assert.match(f, /INVALID: an attempt reached WebTransport while QUIC was meant blocked/);
+  assert.match(f, /\} finally \{\n  console\.log\(quic\("on"\)\);/);
+  assert.match(text("browser/cert14d.mjs"), /events\(st\.records, "attempt"\)/);
+  assert.match(text("browser/mds36.mjs"), /console\.log\(quic\("on"\)\);/);
+  assert.match(text("browser/lib.mjs"), /`sudo -n \/usr\/local\/sbin\/npt-ctl quic \$\{state\}`/);
+});
diff --git a/spikes/netcode-proof/ops/tests/cloudinit.test.mjs b/spikes/netcode-proof/ops/tests/cloudinit.test.mjs
new file mode 100644
index 0000000..548ae40
--- /dev/null
+++ b/spikes/netcode-proof/ops/tests/cloudinit.test.mjs
@@ -0,0 +1,152 @@
+// Test 1 (u8-brief.md rev 1.1 section 3): the two cloud-init files.
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { statSync } from "node:fs";
+import { join } from "node:path";
+import { test } from "node:test";
+import { OPS, heredoc, leaks, nftCheck, text, yamlLoad } from "./helpers.mjs";
+
+const FILES = { rs: "cloud-init/rs.yaml", lg: "cloud-init/lg.yaml" };
+// plan.md:1138-1147 as NPT-TRIM trims it (replan-units.md:152-153): one room user, no per-slot users.
+const USERS = { rs: ["npt", "npt-build", "npt-host", "npt-room"], lg: ["npt", "npt-build", "npt-load"] };
+// No extra group: the room reads the TLS key through its own group (setpriv clears supplementary groups).
+const GROUPS = { rs: [], lg: [] };
+// plan.md:1150-1156.
+const SSHD_COMMON = [
+  "PasswordAuthentication no",
+  "KbdInteractiveAuthentication no",
+  "PermitRootLogin no",
+  "AuthenticationMethods publickey",
+  "X11Forwarding no",
+  "AllowAgentForwarding no",
+  "MaxAuthTries 3",
+  "LoginGraceTime 20",
+];
+const SSHD_ROLE = {
+  rs: [
+    "AllowUsers npt",
+    "AllowTcpForwarding local",
+    "PermitListen none",
+    "AllowStreamLocalForwarding no",
+    "PermitTunnel no",
+    "GatewayPorts no",
+    "PermitOpen none",
+  ],
+  lg: ["AllowUsers npt npt-load", "DisableForwarding yes"],
+};
+const WRAPPERS = { rs: "npt-ctl npt-cert npt-capture npt-userdata npt-s14", lg: "npt-ctl npt-userdata" };
+const SUDOERS = { rs: "sudoers.d/npt", lg: "sudoers.d/npt-lg" };
+
+function file(path, cfg) {
+  return (cfg.write_files || []).find((f) => f.path === path);
+}
+
+for (const [role, rel] of Object.entries(FILES)) {
+  const body = text(rel);
+  const cfg = yamlLoad(rel);
+
+  test(`${role}: starts #cloud-config, parses, under 32,768 bytes`, () => {
+    assert.ok(body.startsWith("#cloud-config\n"));
+    assert.equal(typeof cfg, "object");
+    assert.ok(statSync(join(OPS, rel)).size < 32768, "Hetzner's 32 KiB user-data limit (plan.md:1180)");
+  });
+
+  test(`${role}: users and groups equal the trimmed list; cloud-init grants no sudo`, () => {
+    const du = cfg.system_info.default_user;
+    assert.equal(du.name, "npt");
+    assert.equal(du.sudo, null);
+    assert.equal(du.lock_passwd, true);
+    const named = cfg.users.filter((u) => u !== "default");
+    assert.ok(cfg.users.includes("default"), "npt is the default user, so the operator key reaches npt only");
+    assert.deepEqual([du.name, ...named.map((u) => u.name)].sort(), USERS[role]);
+    for (const u of named) {
+      assert.ok(!("sudo" in u) || u.sudo === null, `${u.name}: no sudo from cloud-init`);
+      assert.equal(u.lock_passwd, true, `${u.name}: locked password`);
+    }
+    for (const u of named.filter((x) => x.name === "npt-room" || x.name === "npt-host" || x.name === "npt-build")) {
+      assert.equal(u.shell, "/usr/sbin/nologin", `${u.name}: no shell`);
+    }
+    assert.deepEqual(cfg.groups || [], GROUPS[role]);
+    assert.equal(cfg.ssh_pwauth, false);
+    assert.equal(cfg.disable_root, true);
+    assert.deepEqual(cfg.ssh_genkeytypes, ["ed25519"]);
+    assert.ok(!/sudoers\.d\/90-cloud-init-users/.test(body) || /rm -f \/etc\/sudoers\.d\/90-cloud-init-users/.test(body));
+  });
+
+  test(`${role}: the room and host users' fixed uids match the nft rules`, () => {
+    const uid = Object.fromEntries(cfg.users.filter((u) => u !== "default").map((u) => [u.name, u.uid]));
+    if (role === "rs") {
+      assert.equal(uid["npt-room"], 2001);
+      assert.equal(uid["npt-host"], 2002);
+    } else {
+      assert.equal(uid["npt-load"], 2004);
+    }
+  });
+
+  test(`${role}: no address outside redact-check's allow-list, no secret pattern`, () => {
+    assert.deepEqual(leaks(body), []);
+  });
+
+  test(`${role}: bootcmd's nftables text passes nft -c -f`, () => {
+    const nft = heredoc(cfg.bootcmd.join("\n"), "NFT");
+    assert.ok(nft, "an inline ruleset in bootcmd");
+    assert.match(nft, /policy drop;/);
+    assert.match(nft, /^table inet npt \{/m);
+    assert.doesNotMatch(nft, /dport 80\b/, "no TCP 80 (the re-plan: DNS-01 by hand)");
+    const r = nftCheck(nft);
+    assert.ok(r.ok, r.err);
+  });
+
+  if (role === "rs") {
+    test("rs: the wrappers' nft texts (quic off and on, peers, the ACME window) pass nft -c beside bootcmd's", () => {
+      const nft = heredoc(cfg.bootcmd.join("\n"), "NFT");
+      const lib = join(OPS, "sbin", "npt-lib.sh");
+      const rules = execFileSync(
+        "bash",
+        ["-c", '. "$1"; printf "%s\\n%s\\n" "$NPT_QUIC_OFF_RULE" "$NPT_QUIC_ON_RULE"; npt_metrics_rule 192.0.2.10 198.51.100.7', "_", lib],
+        { encoding: "utf8" },
+      );
+      assert.match(rules, /timeout 15m/, "Q-U8-3: the block times out after 15 minutes");
+      const acme = "add element inet npt acme_v4 { 192.0.2.20 timeout 35m, 192.0.2.21 timeout 35m }\n";
+      const r = nftCheck(`${nft}\n${rules}${acme}flush set inet npt acme_v4\n`);
+      assert.ok(r.ok, r.err);
+    });
+  }
+
+  test(`${role}: the sshd drop-ins hold every plan.md:1150-1156 key`, () => {
+    const conf = ["/etc/ssh/sshd_config.d/00-npt.conf", "/etc/ssh/sshd_config.d/00-npt-open.conf"]
+      .map((p) => file(p, cfg)?.content || "")
+      .join("\n");
+    for (const line of [...SSHD_COMMON, ...SSHD_ROLE[role]]) {
+      assert.ok(conf.split("\n").includes(line), `missing: ${line}`);
+    }
+  });
+
+  test(`${role}: names the code commit as 40 hex digits (the commit pair)`, () => {
+    assert.match(file("/etc/npt/commit", cfg).content, /^[0-9a-f]{40}\n$/);
+  });
+
+  test(`${role}: toolchains pinned by SHA-256, never piped into a shell or included by URL`, () => {
+    assert.doesNotMatch(body, /\|\s*(ba)?sh\b/);
+    assert.doesNotMatch(body, /#include/);
+    const downloads = body.match(/-o (rustup-init|node\.tar\.xz)/g) || [];
+    assert.ok(downloads.length >= 1);
+    for (const d of downloads) {
+      const name = d.slice(3).replace(".", "\\.");
+      assert.match(body, new RegExp(`[0-9a-f]{64}  ${name}" \\| sha256sum -c -`), `${d}: hash-checked`);
+    }
+    assert.match(body, /cargo fetch --locked/);
+    assert.match(body, /cargo build --locked --offline/);
+    if (role === "rs") {
+      assert.match(body, /cargo install wasm-bindgen-cli --version 0\.2\.130 --locked/);
+      assert.match(body, /npm_config_ignore_scripts=true npm ci --ignore-scripts/);
+      assert.doesNotMatch(body, /\bnpx\b|npm exec|npm create|npm install/);
+    }
+  });
+
+  test(`${role}: installs exactly its wrappers and its sudoers file, checked by visudo first`, () => {
+    assert.match(body, new RegExp(`for w in ${WRAPPERS[role]}; do install -m 0755`));
+    const s = SUDOERS[role].replace(".", "\\.");
+    assert.match(body, new RegExp(`visudo -c -q -f "\\$O/sbin/${s}"\\n\\s*install -m 0440 "\\$O/sbin/${s}" /etc/sudoers\\.d/npt`));
+  });
+}
diff --git a/spikes/netcode-proof/ops/tests/firewall.test.mjs b/spikes/netcode-proof/ops/tests/firewall.test.mjs
