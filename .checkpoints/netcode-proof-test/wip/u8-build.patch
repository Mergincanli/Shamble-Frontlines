+# 3 and 4; Q-U8-5). It runs as npt on RS from the root-owned clone, one fixed block per call:
+#   bash /opt/npt/clone/spikes/netcode-proof/ops/runs/r1.sh <block>
+# Every result goes under /var/lib/npt/results/r1/<block>/. Every room starts through `sudo npt-ctl rooms start NN`
+# (npt-super's hold form, condition 3), its stdin held by a holder process this script owns and closed to end it.
+# C1: Manual mode prompts every laptop command and no ssh allow exists, so while Mustafa is away the laptop runs
+# nothing: `chain server` starts the server blocks on RS detached from the SSH session (they survive the disconnect,
+# hold each room's stdin, write a done or stopped marker per block); `chain-status` reads them when he is back.
+# Blocks:
+#   bringup                  C-U8-1's facts and THP, taskset, netem, the login checks, C5's firewall proof, npt-ctl
+#                            cpus, then one npt-super start whose `alone` must read 1 (condition 4)
+#   cert-staging|cert-production            starts the order and prints the TXT step (him present)
+#   cert-staging-wait|cert-production-wait  waits for the order's end and records the ledger line
+#   headers probe calibrate starts ds-selftest s14 bites   the server blocks (normally through a chain)
+#   browsers <room> | browsers-down <room>  a browser leg's room up or down (rooms: R1.md's slot table)
+#   tokens NN                a room's token file to stdout (the laptop's browser scripts; never a log)
+#   collect                  npt-judge's summaries and the raw tarball
+#   chain server|bites | chain-status
+# Interfaces still to align at Stop B against the merged code (each in one home here): the room settings' field names
+# (room_settings: U6a's and U6b's structs), npt-load's settings (load_settings: U6c), the probe's leg-edge records
+# (probe_presence: U6c, Q-U8-5), npt-super's `hold` verb and its log's `room_start` event.
+set -euo pipefail
+umask 022
+export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
+readonly SELF=/opt/npt/clone/spikes/netcode-proof/ops/runs/r1.sh
+readonly SPIKE=/opt/npt/clone/spikes/netcode-proof
+readonly R=/var/lib/npt/results/r1 RUN=/var/lib/npt/run ROOMS=/var/lib/npt/rooms BIN=/opt/npt/bin
+readonly B=/var/lib/npt/bringup STATE=/var/lib/npt/state
+readonly TICK=3
+readonly SERVER_CHAIN="headers probe calibrate starts ds-selftest s14"
+readonly BITES_CHAIN="bites"
+readonly TIMING_BLOCKS="headers probe starts ds-selftest bites"
+die() { printf 'r1.sh: %s\n' "$*" >&2; exit 2; }
+[ "$(id -un)" = npt ] || die "run as npt"
+. /usr/local/lib/npt/npt-lib.sh
+
+# ---- small helpers ---------------------------------------------------------------------------------------------
+out() { mkdir -p "$R/$1"; printf '%s\n' "$R/$1"; }
+readf() { cat "$1" 2> /dev/null || echo unreadable; }
+stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }
+stat_cpu() { { printf 'utc %s\nuptime %s\n' "$(stamp)" "$(cat /proc/uptime)"; grep '^cpu' /proc/stat; } > "$1"; }
+rs_ip() {
+  local a
+  a=$(ip -4 -o addr show dev eth0 scope global | awk '{print $4}' | cut -d/ -f1 | head -n 1)
+  npt_valid_ipv4 "$a" || die "RS's own IPv4 is unreadable"
+  printf '%s\n' "$a"
+}
+lg_ip() {
+  local a
+  a=$(sed -n 's/^lg=\([^ ]*\).*/\1/p' "$STATE/peers" 2> /dev/null)
+  npt_valid_ipv4 "$a" || die "no LG address: run npt-ctl peers first"
+  printf '%s\n' "$a"
+}
+lg() {
+  ssh -i "$HOME/.ssh/npt_lg" -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes \
+    -o ConnectTimeout=10 "npt-load@$(lg_ip)" "$1"
+}
+deadline_ok() {
+  # Each VM's delete-by is its creation plus 4 h (L1); RS's boot stands for its creation. No block starts within
+  # 10 minutes of it, so the chain cannot run past the delete-by (6.3: everything stops at 13:30).
+  local boot now
+  boot=$(date -d "$(uptime -s)" +%s)
+  now=$(date +%s)
+  ((now < boot + 4 * 3600 - 600))
+}
+timing_invalid() {
+  local d=$1
+  if [ -f "$R/bringup/TIMING-INVALID" ]; then
+    cp "$R/bringup/alone-tasks.txt" "$d/INVALID-alone.txt"
+    printf 'INVALID: bring-up read alone 0 (condition 4); the task list is beside this file and goes to the advisor\n'
+  fi
+}
+
+# One npt-log event field per line: logq <log> <event> <field>.
+logq() {
+  python3 -I - "$1" "$2" "$3" << 'PY'
+import json, sys
+path, ev, field = sys.argv[1:4]
+try:
+    for line in open(path, encoding="utf-8"):
+        try:
+            r = json.loads(line)
+        except ValueError:
+            continue
+        if r.get("k") == "event" and r.get("ev") == ev and field in r.get("f", {}):
+            print(r["f"][field])
+except OSError:
+    pass
+PY
+}
+
+# ---- room settings and rooms (the one home for the settings' field names) -----------------------------------------
+# room_settings NN <kind> [<log suffix>]: writes /var/lib/npt/run/room-NN.json (npt writes, npt-room reads through
+# its group). Kinds: alone, headers, probe, calibrate, start, ds, browser:<slots>, bite:<id>.
+room_settings() {
+  local nn=$1 kind=$2 sfx=${3:-} scene=SS clients=1 tick=$TICK layer=L2 profile=P0 transport=both mode=room
+  local bin=$BIN/npt-server bite=null mark=null hk io
+  case $kind in
+    alone | start) ;;
+    headers) clients=48 ;;
+    probe) mode=probe profile=P1 ;;
+    calibrate) clients=48 mode=calibrate ;;
+    ds) clients=48 transport=ws profile=P2 mark=120 ;;
+    browser:*) clients=${kind#browser:} tick=null ;;
+    bite:*) bite="\"${kind#bite:}\"" bin=$BIN/npt-server-bites ;;
+    *) die "unknown room kind" ;;
+  esac
+  [[ $clients =~ ^[0-9]{1,2}$ ]] || die "bad client count"
+  hk=$(sed -n 's/^housekeeping=//p' "$STATE/cpus" 2> /dev/null)
+  npt_cpulist_valid "$hk" || die "run npt-ctl cpus first"
+  io="\"$hk\""
+  [ "$tick" = null ] && io=null
+  local s=$((10#$nn)) f="$RUN/room-$nn.json"
+  rm -f "$f"
+  cat > "$f" << JSON
+{"run": "R1", "set": "$kind", "role": "RS", "date": "$(date -u +%Y-%m-%d)", "commit": "$(cat "$B/head.txt")",
+ "layer": "$layer", "profile": "$profile", "seed": 1, "scene": "$scene", "clients": $clients, "cmd_timing": "B",
+ "mode": "$mode", "machine": {"role": "RS", "name": "RS", "plan": "CCX23", "location": "fsn1", "address": "$(rs_ip)"},
+ "tick_vcpu": $tick, "io_vcpus": $io, "transport": "$transport",
+ "wt_bind": "0.0.0.0:$((30001 + s))", "ws_bind": "0.0.0.0:$((31001 + s))",
+ "ws_cert_chain": "/var/lib/npt/tls/chain.pem", "ws_cert_key": "/var/lib/npt/tls/key.pem",
+ "log_path": "$ROOMS/room-$nn$sfx.log", "token_path": "$ROOMS/room-$nn.tok", "hash_path": "/var/lib/npt/hash/room-$nn.json",
+ "ws_split_mark_s": $mark, "bite": $bite,
+ "super": {"log_path": "$ROOMS/super-$nn$sfx.log", "room_binary": "$bin", "open_deadline_s": 10}}
+JSON
+  chmod 0640 "$f"
+}
+
+# room_up NN [<log suffix>]: a holder keeps the room's stdin open; the room starts through npt-ctl; waits for OPEN
+# (npt-super's room_start event in its log) up to 15 s.
+room_up() {
+  local nn=$1 sfx=${2:-} fifo="$RUN/room-$1.in" i
+  rm -f "$fifo"
+  mkfifo -m 0600 "$fifo"
+  setsid bash -c 'exec 3> "$1"; exec sleep infinity' _ "$fifo" < /dev/null > /dev/null 2>&1 &
+  printf '%s\n' "$!" > "$RUN/room-$nn.holder"
+  setsid sudo -n /usr/local/sbin/npt-ctl rooms start "$nn" < "$fifo" > "$RUN/room-$nn.out" 2>&1 &
+  printf '%s\n' "$!" > "$RUN/room-$nn.pid"
+  for i in $(seq 1 75); do
+    [ -n "$(logq "$ROOMS/super-$nn$sfx.log" room_start spawn_to_open_ns)" ] && return 0
+    sleep 0.2
+  done
+  room_down "$nn" || true
+  die "room $nn did not open within 15 s (its output: $RUN/room-$nn.out)"
+}
+
+# room_down NN: closes the room's stdin (npt-super ends and kills its room), then waits up to 15 s.
+room_down() {
+  local nn=$1 holder pid i
+  holder=$(tr -dc '0-9' < "$RUN/room-$nn.holder" 2> /dev/null) || true
+  pid=$(tr -dc '0-9' < "$RUN/room-$nn.pid" 2> /dev/null) || true
+  [ -n "$holder" ] && kill "$holder" 2> /dev/null || true
+  for i in $(seq 1 75); do [ -n "$pid" ] && [ -d "/proc/$pid" ] || break; sleep 0.2; done
+  rm -f "$RUN/room-$nn.in" "$RUN/room-$nn.holder" "$RUN/room-$nn.pid"
+  [ -z "$pid" ] || [ ! -d "/proc/$pid" ]
+}
+
+# load_settings NN <mode> <transport> <clients> <duration s>: npt-load's settings (U6c's names; the one home).
+load_settings() {
+  local s=$((10#$1))
+  printf '{"room": "%s", "server": "%s", "wt_port": %s, "ws_port": %s, "mode": "%s", "transport": "%s", "clients": %s, "duration_s": %s, "token_path": "/var/lib/npt-load/tokens/room-%s.tok", "log_path": "/var/lib/npt-load/logs/load-%s.npt.log"}\n' \
+    "$1" "$(rs_ip)" $((30001 + s)) $((31001 + s)) "$2" "$3" "$4" "$5" "$1" "$1"
+}
+load_up() { sudo -n /usr/local/sbin/npt-ctl rooms tokens "$1" | lg "token $1" && load_settings "$@" | lg "settings $1" && lg "start $1"; }
+load_wait() {
+  local i
+  for i in $(seq 1 "$2"); do lg "status $1" | grep -q stopped && return 0; sleep 1; done
+  lg "stop $1" || true
+}
+keep() { local d=$1 nn=$2 sfx=${3:-}; cp -p "$ROOMS/room-$nn$sfx.log" "$ROOMS/super-$nn$sfx.log" "$d/" 2> /dev/null || true; }
+
+# ---- the blocks ----------------------------------------------------------------------------------------------
+bringup() {
+  local d alone
+  d=$(out bringup)
+  [ -f "$B/build.done" ] || { tail -n 5 "$B/steps.log" 2> /dev/null; die "cloud-init's build is not done (see above)"; }
+  cp -p "$B"/steps.log "$B"/bin.sha256 "$B"/dist.sha256 "$B"/head.txt "$B"/netem.txt "$d/"
+  local hz
+  hz=$( (grep -E '^CONFIG_HZ=' "/boot/config-$(uname -r)" 2> /dev/null || zcat /proc/config.gz 2> /dev/null | grep -E '^CONFIG_HZ=') | cut -d= -f2 || true)
+  {
+    # C-U8-1: U3-Q9's four facts and the THP mode, U3d's dry-run commands; each read, or `unreadable`, never guessed
+    # (CONFIG_HZ never from `getconf CLK_TCK`, which is USER_HZ).
+    printf 'kernel %s\n' "$(uname -r)"
+    printf 'clocksource %s (available: %s)\n' "$(readf /sys/devices/system/clocksource/clocksource0/current_clocksource)" \
+      "$(readf /sys/devices/system/clocksource/clocksource0/available_clocksource)"
+    printf 'cpuidle %s governor %s\n' "$(readf /sys/devices/system/cpu/cpuidle/current_driver)" \
+      "$(readf /sys/devices/system/cpu/cpuidle/current_governor)"
+    printf 'config_hz %s\n' "${hz:-unreadable}"
+    printf 'thp %s\n' "$(readf /sys/kernel/mm/transparent_hugepage/enabled)"
+    printf 'nproc %s\nmodel %s\n' "$(nproc)" "$(grep -m1 '^model name' /proc/cpuinfo | cut -d: -f2- | sed 's/^ //')"
+    for c in /sys/devices/system/cpu/cpu[0-9]*; do printf '%s siblings %s\n' "${c##*/}" "$(cat "$c/topology/thread_siblings_list")"; done
+    # Q-U6A-5's term: util-linux's taskset on the image.
+    printf 'taskset %s (%s)\n' "$(taskset --version)" "$(dpkg -S /usr/bin/taskset)"
+    printf 'sch_netem %s (bring-up: %s)\n' "$(grep -q '^sch_netem ' /proc/modules && echo loaded || echo absent)" "$(cat "$B/netem.txt")"
+    printf 'ipv6_fetch %s\n' "$(curl -6 -sS -o /dev/null -w '%{http_code}' --max-time 10 https://github.com 2>&1 || true)"
+  } > "$d/facts.txt"
+  cat "$d/facts.txt"
+  # The login: npt in its own group only; sudo lists the wrappers only (cloud-init's default-user merge, F13).
+  [ "$(id -nG)" = npt ] || die "npt is in groups beyond its own: $(id -nG)"
+  sudo -n -l > "$d/sudo-l.txt"
+  ! grep -Eq '\(ALL( : ALL)?\) (NOPASSWD: )?ALL' "$d/sudo-l.txt" || die "npt has a full sudo rule"
+  # C5: both Hetzner firewalls in force, before any room opens. Prints no address outside the VM list.
+  if ! lg fwcheck | tee "$d/c5-lg.txt" | grep -q '^fwcheck: blocked'; then
+    touch "$d/STOP"
+    die "C5: LG reached RS's port 22: fw-rs is not in force. No room opens; this comes to Mustafa"
+  fi
+  if ping -c 3 -W 2 "$(lg_ip)" > "$d/c5-rs.txt" 2>&1; then
+    touch "$d/STOP"
+    die "C5: LG answered RS's ICMP echo: fw-lg is not in force. No room opens; this comes to Mustafa"
+  fi
+  if ! grep -q ' 0 received' "$d/c5-rs.txt"; then
+    touch "$d/STOP"
+    die "C5: the ICMP check did not run (see c5-rs.txt): fw-lg is unproven. No room opens; this comes to Mustafa"
+  fi
+  printf 'C5: fw-rs and fw-lg in force (LG cannot reach RS port 22; LG does not answer RS)\n' | tee "$d/c5.txt"
+  # Condition 4: the housekeeping set, then one npt-super start whose `alone` must read 1.
+  sudo -n /usr/local/sbin/npt-ctl cpus "$TICK" > "$d/cpus.txt"
+  room_settings 00 alone
+  room_up 00
+  sleep 2
+  alone=$(logq "$ROOMS/room-00.log" affinity alone | head -n 1)
+  { printf 'utc %s\n' "$(stamp)"; grep -E '^(cpu|ctxt|procs_running)' /proc/stat; } > "$d/alone-stat.txt"
+  room_down 00 || true
+  keep "$d" 00
+  if [ "$alone" = 1 ]; then
+    printf 'alone 1: the tick vCPU %s is the room tick thread'"'"'s alone\n' "$TICK" | tee "$d/alone.txt"
+  else
+    { printf 'alone %s (want 1); every task whose allowed list holds the tick vCPU %s:\n' "${alone:-unread}" "$TICK"
+      for t in /proc/[0-9]*/task/[0-9]*; do
+        printf '%s %s %s %s\n' "${t##*/}" "$(cut -d')' -f2- "$t/stat" 2> /dev/null | awk '{print $7}')" \
+          "$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' "$t/status" 2> /dev/null)" "$(npt_comm_clean "$(cat "$t/comm" 2> /dev/null)")"
+      done | npt_affinity_scan "$TICK" | grep -E '^(counts|move) ' || true
+    } > "$d/alone-tasks.txt"
+    touch "$d/TIMING-INVALID"
+    cat "$d/alone-tasks.txt"
+    printf 'alone 0: recorded. R1 goes on with the certificate, the browser legs and the ping; the timing blocks (%s) are recorded INVALID with this list and come to the advisor (C1)\n' "$TIMING_BLOCKS"
+  fi
+  touch "$d/done"
+}
+
+cert() {
+  local p=$1 d i
+  d=$(out cert)
+  [ ! -f "$R/bringup/STOP" ] || die "bring-up stopped (C5)"
+  if [ "$p" = staging ]; then
+    # R1 reads and records both directories' profile lists (plan.md:971-972).
+    for u in https://acme-staging-v02.api.letsencrypt.org/directory https://acme-v02.api.letsencrypt.org/directory; do
+      printf '%s %s\n' "$u" "$(curl -sS --max-time 15 "$u" | python3 -I -c 'import json,sys; print(sorted(json.load(sys.stdin).get("meta", {}).get("profiles", {})))')"
+    done > "$d/profiles.txt"
+    cat "$d/profiles.txt"
+  fi
+  setsid sudo -n /usr/local/sbin/npt-cert issue "$p" < /dev/null > "$RUN/cert-$p.live" 2>&1 &
+  printf '%s\n' "$!" > "$RUN/cert-$p.pid"
+  for i in $(seq 1 120); do grep -q '^Add in Cloudflare' "$RUN/cert-$p.live" && break; sleep 1; done
+  # The TXT step goes to the laptop's screen only: never into the results.
+  grep -E '^(Add in Cloudflare|Polling|npt-cert)' "$RUN/cert-$p.live" || die "the order printed no TXT step in 2 minutes"
+}
+
+cert_wait() {
+  local p=$1 d pid i
+  d=$(out cert)
+  pid=$(tr -dc '0-9' < "$RUN/cert-$p.pid")
+  for i in $(seq 1 1860); do [ -d "/proc/$pid" ] || break; sleep 1; done
+  grep -v '^Add in Cloudflare' "$RUN/cert-$p.live" | tee "$d/$p.txt"
+  rm -f "$RUN/cert-$p.live" "$RUN/cert-$p.pid"
+  grep -q 'Ledger: serial' "$d/$p.txt" || die "the $p order failed: the run stops and this comes to Mustafa"
+}
+
+headers() {
+  local d
+  d=$(out headers)
+  timing_invalid "$d"
+  room_settings 01 headers
+  room_up 01
+  load_up 01 bots wt 48 300
+  load_wait 01 330
+  room_down 01 || true
+  lg "log 01" > "$d/load-01.log" || true
+  keep "$d" 01
+}
+
+probe() {
+  local d
+  d=$(out probe)
+  timing_invalid "$d"
+  stat_cpu "$d/stat-before.txt"
+  room_settings 02 probe
+  room_up 02
+  load_up 02 probe wt 1 660
+  load_wait 02 700
+  room_down 02 || true
+  stat_cpu "$d/stat-after.txt"
+  lg "log 02" > "$d/load-02.log" || true
+  keep "$d" 02
+  probe_presence "$ROOMS/room-02.log" | tee "$d/presence.txt"
+}
+
+# Q-U8-5 and C-U8-2, -4, -6: the probe's own leg-edge records (U6c adds them to C-U6-7's leg-edge calls) must be
+# present for every leg at both edges, the socket's drops row found at both, and no drop on the P1 socket between
+# them; a missing read makes that leg INVALID, never "unreadable counts as present". Proposed record (U6c's brief
+# names it, its npt-log names go to the advisor): event `leg_edge` with f.leg (0 P0, 1 P1, 2 P2, 3 P3, 4 P4, 5 B1),
+# f.edge (0 start, 1 end), f.cpu_lines (the count of ^cpu lines read), f.udp_drops (the socket row's drops).
+probe_presence() {
+  python3 -I - "$1" << 'PY'
+import json, sys
+legs = ["P0", "P1", "P2", "P3", "P4", "B1"]
+seen = {}
+try:
+    for line in open(sys.argv[1], encoding="utf-8"):
+        try:
+            r = json.loads(line)
+        except ValueError:
+            continue
+        if r.get("k") == "event" and r.get("ev") == "leg_edge":
+            f = r.get("f", {})
+            seen[(f.get("leg"), f.get("edge"))] = f
+except OSError:
+    pass
+for i, name in enumerate(legs):
+    a, b = seen.get((i, 0)), seen.get((i, 1))
+    if not a or not b:
+        print(f"{name}: INVALID: a leg-edge read is missing (start {'present' if a else 'missing'}, end {'present' if b else 'missing'})")
+    elif not a.get("cpu_lines") or not b.get("cpu_lines") or "udp_drops" not in a or "udp_drops" not in b:
+        print(f"{name}: INVALID: a /proc/stat or socket-row read is missing at an edge")
+    elif name == "P1" and b["udp_drops"] != a["udp_drops"]:
+        print(f"P1: INVALID: {b['udp_drops'] - a['udp_drops']} drops on the probe's P1 socket between its reads (C-U8-6): to the advisor before any L2 mark counts")
+    else:
+        print(f"{name}: present at both edges")
+PY
+}
+
+calibrate() {
+  local d
+  d=$(out calibrate)
+  room_settings 03 calibrate
+  room_up 03
+  load_up 03 calibrate wt 48 300
+  load_wait 03 330
+  room_down 03 || true
+  lg "log 03" > "$d/load-03.log" || true
+  keep "$d" 03
+}
+
+starts() {
+  local d i sfx
+  d=$(out starts)
+  timing_invalid "$d"
+  for i in $(seq -w 1 20); do
+    sfx="-s$i"
+    room_settings 04 start "$sfx"
+    room_up 04 "$sfx"
+    room_down 04 || true
+    keep "$d" 04 "$sfx"
+  done
+  printf 'starts: %s\n' "$(cat "$ROOMS"/super-04-s*.log | grep -c '"ev":"room_start"' || true)"
+}
+
+ds_selftest() {
+  local d
+  d=$(out ds-selftest)
+  timing_invalid "$d"
+  stat_cpu "$d/stat-before.txt"
+  room_settings 05 ds
+  room_up 05
+  # LG's 48 WebSocket connections at P2 join within 60 s; the 1 min warm-up follows; the pool's mark is at OPEN +
+  # 120 s (settings `ws_split_mark_s`); the measured window is the 5 minutes after it (C-U8-3).
+  load_up 05 bots ws 48 420
+  load_wait 05 450
+  room_down 05 || true
+  stat_cpu "$d/stat-after.txt"
+  lg "log 05" > "$d/load-05.log" || true
+  keep "$d" 05
+}
+
+s14() {
+  local d dir
+  d=$(out s14)
+  dir=$(sudo -n /usr/local/sbin/npt-s14 run | sed -n 's/^npt-s14: .* results in \(\/var\/lib\/npt\/s14\/[0-9TZ]*\)$/\1/p')
+  [ -n "$dir" ] && [ -d "$dir" ] || die "npt-s14 gave no results folder"
+  cp -rp "$dir"/. "$d/"
+}
+
+bites() {
+  local d id nn=06
+  d=$(out bites)
+  timing_invalid "$d"
+  for id in PM-0001-1/shared-vcpu PM-0006-11/no-smt-map PM-0001-16/double-load; do
+    room_settings "$nn" "bite:$id" "-${id##*/}"
+    room_up "$nn" "-${id##*/}"
+    sleep 10
+    room_down "$nn" || true
+    keep "$d" "$nn" "-${id##*/}"
+  done
+}
+
+# R1.md's slot table: one room per mark and browser, a slot per attempt (C3; condition 2).
+browser_room() {
+  case $1 in
+    smoke) printf '10 8\n' ;; cert-chrome) printf '11 20\n' ;; cert-edge) printf '12 20\n' ;;
+    cert-firefox) printf '13 20\n' ;; cert-brave) printf '14 1\n' ;; fallback-chrome) printf '15 20\n' ;;
+    fallback-edge) printf '16 20\n' ;; fallback-firefox) printf '17 20\n' ;; fallback-brave) printf '18 1\n' ;;
+    mds) printf '19 3\n' ;; *) die "unknown browser room (R1.md's slot table)" ;;
+  esac
+}
+
+readonly BROWSER_ROOMS="smoke cert-chrome cert-edge cert-firefox cert-brave fallback-chrome fallback-edge fallback-firefox fallback-brave mds"
+browsers() {
+  local nn slots
+  npt_valid_word "$1" $BROWSER_ROOMS || die "unknown browser room (R1.md's slot table)"
+  read -r nn slots < <(browser_room "$1")
+  room_settings "$nn" "browser:$slots"
+  room_up "$nn"
+  printf 'browser room %s up: NN %s, UDP %s, TCP %s, %s slots\n' "$1" "$nn" $((30001 + 10#$nn)) $((31001 + 10#$nn)) "$slots"
+}
+
+browsers_down() {
+  local nn slots d
+  npt_valid_word "$1" $BROWSER_ROOMS || die "unknown browser room (R1.md's slot table)"
+  read -r nn slots < <(browser_room "$1")
+  d=$(out "browsers/$1")
+  room_down "$nn" || true
+  keep "$d" "$nn"
+  printf 'browser room %s down\n' "$1"
+}
+
+collect() {
+  local d
+  d=$(out collect)
+  "$BIN/npt-judge" --marks "$SPIKE/marks/marks.json" --logs "$R" --out "$d/verdicts.json" > "$d/judge.txt" 2>&1 || true
+  tar -C /var/lib/npt/results -czf /var/lib/npt/results/r1.tar.gz r1
+  sha256sum /var/lib/npt/results/r1.tar.gz | tee "$d/tarball.sha256"
+}
+
+chain_run() {
+  local name=$1 list b
+  case $name in server) list=$SERVER_CHAIN ;; bites) list=$BITES_CHAIN ;; esac
+  mkdir -p "$R/chain"
+  for b in $list; do
+    if [ -f "$R/bringup/STOP" ] || ! deadline_ok; then
+      printf '%s stopped (bring-up STOP or the delete-by is near) %s\n' "$b" "$(stamp)" > "$R/chain/$b.stopped"
+      continue
+    fi
+    printf 'running %s\n' "$(stamp)" > "$R/chain/$b.running"
+    if bash "$SELF" "$b" > "$R/chain/$b.log" 2>&1; then
+      mv -f "$R/chain/$b.running" "$R/chain/$b.done"
+    else
+      mv -f "$R/chain/$b.running" "$R/chain/$b.stopped"
+    fi
+  done
+  printf 'chain %s ended %s\n' "$name" "$(stamp)" > "$R/chain/$name.ended"
+}
+
+[ "$#" -ge 1 ] || die "a block is needed"
+case $1 in
+  bringup) bringup ;;
+  cert-staging) cert staging ;;
+  cert-production) cert production ;;
+  cert-staging-wait) cert_wait staging ;;
+  cert-production-wait) cert_wait production ;;
+  headers) headers ;;
+  probe) probe ;;
+  calibrate) calibrate ;;
+  starts) starts ;;
+  ds-selftest) ds_selftest ;;
+  s14) s14 ;;
+  bites) bites ;;
+  browsers) [ "$#" -eq 2 ] || die "browsers <room>"; browsers "$2" ;;
+  browsers-down) [ "$#" -eq 2 ] || die "browsers-down <room>"; browsers_down "$2" ;;
+  tokens) [ "$#" -eq 2 ] && npt_valid_nn "$2" || die "tokens NN"; exec sudo -n /usr/local/sbin/npt-ctl rooms tokens "$2" ;;
+  collect) collect ;;
+  chain)
+    [ "$#" -eq 2 ] && npt_valid_word "$2" server bites || die "chain server|bites"
+    [ -f "$R/bringup/done" ] || die "bring-up is not done"
+    [ ! -f "$R/bringup/STOP" ] || die "bring-up stopped (C5)"
+    mkdir -p "$R/chain"
+    setsid nohup bash "$SELF" chain-run "$2" < /dev/null > "$R/chain/$2.chain.log" 2>&1 &
+    printf 'chain %s started on RS (pid %s); it holds its rooms itself; read it with `r1.sh chain-status`\n' "$2" "$!"
+    ;;
+  chain-run) [ "$#" -eq 2 ] && npt_valid_word "$2" server bites || die "chain-run server|bites"; chain_run "$2" ;;
+  chain-status)
+    for b in $SERVER_CHAIN $BITES_CHAIN; do
+      st=pending
+      for m in done stopped running; do [ -f "$R/chain/$b.$m" ] && st=$m; done
+      printf '%-12s %s\n' "$b" "$st"
+    done
+    ls "$R/chain/"*.ended 2> /dev/null || true
+    ;;
+  *) die "unknown block" ;;
+esac
diff --git a/spikes/netcode-proof/ops/runs/s14/compare.py b/spikes/netcode-proof/ops/runs/s14/compare.py
new file mode 100644
index 0000000..35ac5ca
--- /dev/null
+++ b/spikes/netcode-proof/ops/runs/s14/compare.py
@@ -0,0 +1,269 @@
+# S14's comparison (u8-brief.md rev 1.1 section 1 Block 4; plan.md:1256 under TCP-FREEZE; the advisor's section 2 ruling
+# on the burst knob), a copy of results/u3c-kernel-check/compare.py adapted (never imported from results/). It applies
+# one written rule to the kernel's runs (npt-s14's output folder, copied here after R1) and the model's KCMODEL lines
+# alike. The model side runs in this container after R1 (R1.md, "S14's model side").
+#   python3 -I compare.py schedule        the burst schedule as NPT_KC_BURSTS reads it (equal to probe.py's)
+#   python3 -I compare.py env <out>       the model run's environment: NPT_KC_RTT_NS (the measured tcpi_rtt), ...
+#   python3 -I compare.py summary <out>   each kernel run's numbers and standing
+#   python3 -I compare.py judge <out>     the verdict, with verdict.json written beside model.txt
+# ---- Fixed in writing before any run -----------------------------------------------------------------------------
+# DELAY, STALL and REPAIR PATH: as results/u3c-kernel-check/run.sh:19-36. A message's delay is its in-order arrival
+#   minus its send stamp (the model: its in-order release minus its write). BASE is the run's median delay over every
+#   message (nearest rank). An episode is a maximal run of consecutive messages each more than half a send gap
+#   (16,666,666 ns) above BASE; its length L is its first message's delay minus BASE. RACK path if L <= RTT + gap +
+#   2 ms + 1 ms (RTT: the mean client tcpi_rtt over the kernel runs), else probe-or-timeout. Stalls are counted over
+#   the steady window only: messages written before 59 s (index k with k x gap < 59 s), before the first burst.
+# BURST RECOVERY (advisor-u3q.md:130-133's (e) definition): per burst, the time from the link's return to the in-order
+#   delivery of the first message written at or after the return. Kernel: the return is the burst's measured end
+#   (bursts-runN.json `actual`, from the run's first message), the message the first whose send stamp is at or after
+#   it. Model: the return is the scheduled end, the message index ceil((start + len) / gap), its delay from the line's
+#   `delay_ns` (every message) when present, else its `late` entry, else BASE (recorded as approximate).
+# A KERNEL RUN IS INVALID if it did not deliver every message; if its send lateness p99 > 1 ms; if its tcpi_rtt is
+#   outside 99-120 ms (netem's 100 ms round trip not in place: U3c's C12 (f), read against netem's 100 ms); if its
+#   bursts file does not hold the 10 scheduled bursts, or a burst started more than 20 ms off schedule or lasted more
+#   than 20 ms more or less than 1 s. VOID if it retransmitted nothing, or its steady episodes outnumber its
+#   tcpi_total_retrans (U3c's noise guard).
+# JUDGED (S14, plan.md:1256): each half compares the kernel's pooled values (3 runs) with the model's (seeds pooled):
+#   p50 and p99 (nearest rank) each within 10 % of the model's (|kernel - model| <= 0.10 x model).
+#   Stall half: the steady episodes' L. Burst half: the recoveries; NOT-RUN when the model's lines carry no `bursts`
+#   equal to the schedule (MOVED's NPT_KC_BURSTS rider not in): R1's report then says the burst half is NOT-RUN and
+#   why, and it comes to the advisor before -18's WebSocket part counts.
+# VERDICT: INVALID if any run is INVALID or the model gave no line; else VOID if any run is VOID; else MISS if either
+#   half misses, PASS if both pass, PARTIAL if the stall half passes and the burst half is NOT-RUN. A MISS means netem
+#   wins (TCP-FREEZE): the WebSocket rows are judged on VM runs with netem in place of DelayStream's model, the model
+#   is not repaired, and R1's report records the comparison and the switch (NETEM-BAR (a) applies to those rows).
+import glob
+import json
+import math
+import os
+import sys
+
+GAP = 33_333_333
+HALF_GAP = GAP // 2
+SLOP = 2_000_000
+JITTER = 1_000_000
+STEADY_END_NS = 59_000_000_000
+BURSTS = [((60 + 10 * k) * 1_000_000_000, 1_000_000_000) for k in range(10)]
+MESSAGES = 170 * 1_000_000_000 // GAP
+WITHIN = 0.10
+RTT_LO, RTT_HI = 99_000_000, 120_000_000
+BURST_SLACK_NS = 20_000_000
+
+
+def rank(values, q):
+    """Nearest-rank quantile (q in (0, 1])."""
+    s = sorted(values)
+    return s[max(1, math.ceil(q * len(s))) - 1]
+
+
+def episodes(delay_of, n_steady, base):
+    """L of the first message of each maximal run of steady messages more than half a gap above base."""
+    out, prev = [], False
+    for k in range(n_steady):
+        d = delay_of(k)
+        above = d is not None and d - base > HALF_GAP
+        if above and not prev:
+            out.append(d - base)
+        prev = above
+    return out
+
+
+def n_steady():
+    return math.ceil(STEADY_END_NS / GAP)
+
+
+def kernel_runs(out):
+    runs = []
+    for spath in sorted(glob.glob(os.path.join(out, "server-run*.json"))):
+        tag = spath[spath.rindex("-run") + 4:-5]
+        s = json.load(open(spath))
+        c = json.load(open(os.path.join(out, f"client-run{tag}.json")))
+        bpath = os.path.join(out, f"bursts-run{tag}.json")
+        b = json.load(open(bpath)) if os.path.exists(bpath) else None
+        runs.append((f"run{tag}", s, c, b))
+    return runs
+
+
+def kernel_numbers(s, c, b):
+    delays = s["delay_ns"]
+    got = [d for d in delays if d is not None]
+    base = rank(got, 0.5) if got else 0
+    eps = episodes(lambda k: delays[k], min(n_steady(), len(delays)), base)
+    lat = sorted(abs(x) for x in c["send_late_ns"])
+    lat99 = rank(lat, 0.99) if lat else 0
+    rec = []
+    if b:
+        first = c["first_due_ns"]
+        for start, length in b["actual"]:
+            ret = first + start + length
+            k0 = next((k for k, t in enumerate(s["sent_ns"]) if t is not None and t >= ret), None)
+            if k0 is not None and delays[k0] is not None:
+                rec.append(s["sent_ns"][k0] + delays[k0] - ret)
+    return base, eps, lat99, rec
+
+
+def standing(s, c, b, eps, lat99):
+    if s["delivered"] != s["messages"]:
+        return "INVALID", f"delivered {s['delivered']} of {s['messages']}"
+    if lat99 > JITTER:
+        return "INVALID", f"send lateness p99 {lat99} ns > 1 ms"
+    rtt = 1000 * c["tcp_info_client"]["rtt_us"]
+    if not RTT_LO <= rtt <= RTT_HI:
+        return "INVALID", f"tcpi_rtt {rtt} ns outside 99-120 ms: netem's 100 ms round trip not in place"
+    if not b or len(b.get("actual", [])) != len(BURSTS):
+        return "INVALID", "the bursts file does not hold the 10 scheduled bursts"
+    for (s0, l0), (s1, l1) in zip(BURSTS, b["actual"]):
+        if abs(s1 - s0) > BURST_SLACK_NS or abs(l1 - l0) > BURST_SLACK_NS:
+            return "INVALID", f"a burst ran off schedule ({s1}, {l1}) against ({s0}, {l0})"
+    retrans = c["tcp_info_client"]["total_retrans"]
+    if retrans == 0:
+        return "VOID", "no retransmission (tcpi_total_retrans 0)"
+    if len(eps) > retrans:
+        return "VOID", f"{len(eps)} steady episodes > {retrans} retransmissions (the noise guard)"
+    return None, f"{len(eps)} steady episodes <= {retrans} retransmissions"
+
+
+def model_lines(path):
+    out = []
+    if os.path.exists(path):
+        for line in open(path):
+            if line.startswith("KCMODEL "):
+                out.append(json.loads(line[len("KCMODEL "):]))
+    return out
+
+
+def model_numbers(m):
+    late = {k: d for k, d in m["late"]}
+    full = m.get("delay_ns")
+    base = m["p50_ns"]
+
+    def delay_of(k):
+        if full is not None:
+            return full[k]
+        return late.get(k, base)
+
+    eps = episodes(delay_of, min(n_steady(), m["n"]), base)
+    rec, approx = [], 0
+    for start, length in m.get("bursts") or []:
+        ret = start + length
+        k0 = -(-ret // GAP)
+        if k0 >= m["n"]:
+            continue
+        if full is None and k0 not in late:
+            approx += 1
+        rec.append(k0 * GAP + delay_of(k0) - ret)
+    return eps, rec, approx
+
+
+def kernel_rtt(out):
+    rtts = [c["tcp_info_client"]["rtt_us"] for _, _, c, _ in kernel_runs(out)]
+    return round(1000 * sum(rtts) / len(rtts))
+
+
+def half(kernel, model):
+    """One half's comparison: p50 and p99 within 10 % of the model's."""
+    if not kernel or not model:
+        return "MISS", f"no values (kernel {len(kernel)}, model {len(model)})", {}
+    k50, k99, m50, m99 = rank(kernel, 0.5), rank(kernel, 0.99), rank(model, 0.5), rank(model, 0.99)
+    ok50, ok99 = abs(k50 - m50) <= WITHIN * m50, abs(k99 - m99) <= WITHIN * m99
+    nums = {"kernel_p50_ns": k50, "kernel_p99_ns": k99, "model_p50_ns": m50, "model_p99_ns": m99,
+            "kernel_n": len(kernel), "model_n": len(model)}
+    text = (f"p50 kernel {k50 / 1e6:.3f} ms vs model {m50 / 1e6:.3f} ms ({'within' if ok50 else 'NOT within'} 10 %); "
+            f"p99 kernel {k99 / 1e6:.3f} ms vs model {m99 / 1e6:.3f} ms ({'within' if ok99 else 'NOT within'} 10 %)")
+    return ("PASS" if ok50 and ok99 else "MISS"), text, nums
+
+
+def judge(out):
+    rtt = kernel_rtt(out)
+    bound = rtt + GAP + SLOP + JITTER
+    kinds, lines, runs_seen = set(), [], []
+    k_eps, k_rec = [], []
+    for name, s, c, b in kernel_runs(out):
+        base, eps, lat99, rec = kernel_numbers(s, c, b)
+        kind, why = standing(s, c, b, eps, lat99)
+        if kind:
+            kinds.add(kind)
+        if c["cc_client"] != "cubic" or s["cc_server"] != "cubic":
+            why += f"; cubic not set (client {c['cc_client']}, server {s['cc_server']}): recorded"
+        runs_seen.append({"run": name, "standing": kind or "judged", "why": why, "base_ns": base,
+                          "steady_episodes": len(eps), "recoveries": len(rec),
+                          "tcpi_rtt_minus_100ms_ns": 1000 * c["tcp_info_client"]["rtt_us"] - 100_000_000})
+        lines.append(f"{name}: {kind or 'judged'} ({why}); tcpi_rtt - 100 ms = "
+                     f"{1000 * c['tcp_info_client']['rtt_us'] - 100_000_000} ns")
+        k_eps += eps
+        k_rec += rec
+    models = model_lines(os.path.join(out, "model.txt"))
+    if not models:
+        kinds.add("INVALID")
+        lines.append("model.txt holds no KCMODEL line: INVALID")
+    m_eps, m_rec, approx, with_bursts = [], [], 0, True
+    for m in models:
+        if [list(x) for x in m.get("bursts") or []] != [list(x) for x in BURSTS]:
+            with_bursts = False
+        eps, rec, a = model_numbers(m)
+        m_eps += eps
+        m_rec += rec
+        approx += a
+    stall, stall_text, stall_nums = half(k_eps, m_eps)
+    if models and with_bursts:
+        burst, burst_text, burst_nums = half(k_rec, m_rec)
+    else:
+        burst, burst_nums = "NOT-RUN", {}
+        burst_text = ("the model's lines carry no burst schedule equal to probe.py's (MOVED's NPT_KC_BURSTS rider not "
+                      "in): R1's report says the burst half is NOT-RUN and why; to the advisor before -18's WebSocket "
+                      "part counts")
+    k_rack = sum(1 for e in k_eps if e <= bound)
+    m_rack = sum(1 for e in m_eps if e <= bound)
+    if "INVALID" in kinds:
+        verdict = "INVALID"
+    elif "VOID" in kinds:
+        verdict = "VOID"
+    elif "MISS" in (stall, burst):
+        verdict = "MISS"
+    elif burst == "NOT-RUN":
+        verdict = "PARTIAL"
+    else:
+        verdict = "PASS"
+    follow = {
+        "PASS": "the model agrees with the kernel at zero jitter: DelayStream's model stands for the WebSocket rows",
+        "PARTIAL": "the stalls agree; the burst half is NOT-RUN (above)",
+        "MISS": ("netem wins (TCP-FREEZE): the WebSocket rows are judged on VM runs with netem in place of "
+                 "DelayStream's model; the model is not repaired; R1's report records the comparison and the switch"),
+        "VOID": "not judged; one rerun inside R1's S14 block if time allows, else to the advisor",
+        "INVALID": "not judged; one rerun inside R1's S14 block if time allows, else to the advisor",
+    }[verdict]
+    lines = [f"tcpi_rtt (mean over runs) {rtt} ns; RACK bound L <= {bound} ns"] + lines
+    lines.append(f"stall half: {stall}: {stall_text}")
+    lines.append(f"burst half: {burst}: {burst_text}")
+    lines.append(f"reported, not judged: RACK-path share kernel {k_rack} of {len(k_eps)}, model {m_rack} of "
+                 f"{len(m_eps)}; model recoveries approximated from BASE: {approx}")
+    lines.append(f"VERDICT: {verdict} ({follow})")
+    result = {"verdict": verdict, "rtt_ns": rtt, "kernel_runs": runs_seen, "stall_half": stall,
+              "stall": stall_nums, "burst_half": burst, "burst": burst_nums, "model_lines": len(models),
+              "model_recoveries_approximate": approx}
+    json.dump(result, open(os.path.join(out, "verdict.json"), "w"), indent=1)
+    print("\n".join(lines))
+
+
+def main():
+    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
+    if cmd == "schedule" and len(sys.argv) == 2:
+        print(",".join(f"{s}:{l}" for s, l in BURSTS))
+    elif cmd == "env" and len(sys.argv) == 3:
+        print(f"NPT_KC_RTT_NS={kernel_rtt(sys.argv[2])} NPT_KC_MESSAGES={MESSAGES} NPT_KC_RUNS=100 "
+              f"NPT_KC_BURSTS={','.join(f'{s}:{l}' for s, l in BURSTS)}")
+    elif cmd == "summary" and len(sys.argv) == 3:
+        for name, s, c, b in kernel_runs(sys.argv[2]):
+            base, eps, lat99, rec = kernel_numbers(s, c, b)
+            kind, why = standing(s, c, b, eps, lat99)
+            print(f"{name}: delivered {s['delivered']} of {s['messages']}; base {base} ns; {len(eps)} steady episodes; "
+                  f"{len(rec)} recoveries; send lateness p99 {lat99} ns; tcp_info {c['tcp_info_client']}; "
+                  f"{kind or 'judged'}: {why}")
+    elif cmd == "judge" and len(sys.argv) == 3:
+        judge(sys.argv[2])
+    else:
+        print("usage: compare.py schedule | env <out> | summary <out> | judge <out>", file=sys.stderr)
+        sys.exit(2)
+
+
+main()
diff --git a/spikes/netcode-proof/ops/runs/s14/probe.py b/spikes/netcode-proof/ops/runs/s14/probe.py
new file mode 100644
index 0000000..f3c8f8d
--- /dev/null
+++ b/spikes/netcode-proof/ops/runs/s14/probe.py
@@ -0,0 +1,183 @@
+# S14's kernel side on RS (u8-brief.md rev 1.1 section 1 Block 4; plan.md:1256; advisor-u3q.md:139-143), a copy of
+# results/u3c-kernel-check/probe.py adapted to a veth pair between two network namespaces (never imported from
+# results/). ops/sbin/npt-s14 runs it: `server` and `client` as npt inside the namespaces, `bursts` as root.
+#   python3 -I probe.py messages                    the run's message count (the schedule's length)
+#   python3 -I probe.py schedule                    the burst schedule as NPT_KC_BURSTS reads it
+#   python3 -I probe.py server <port> <n>           accepts one connection; prints every message's send stamp and delay
+#   python3 -I probe.py client <host> <port> <n>    prints `START <first due ns>`, sends, then one JSON object
+#   python3 -I probe.py bursts <first due ns>       root: netem to 100 % loss on both directions at each burst
+# ---- Fixed in writing before any run (S14; the advisor's section 2 ruling on the burst knob) ---------------------
+# PATTERN: one TCP connection client -> server over the veth pair, 200 B messages every 33,333,333 ns (30 Hz),
+#   TCP_NODELAY, cubic on the listener and both sockets (read back and recorded), as U3c's probe. netem (npt-s14):
+#   50 ms each way, 2 % loss on the client's egress (the data direction), no jitter (netem's jitter reorders, which
+#   the model leaves out).
+# SCHEDULE: 60 s steady, then 10 one-second total-loss bursts, one every 10 s (starts at 60, 70, ..., 150 s), then a
+#   20 s tail: 170 s, 5,100 messages. Each burst is (start_ns, len_ns) from the run's first message, which is the
+#   form `kernel_cross_check_model`'s NPT_KC_BURSTS knob reads (MOVED's rider): total loss on both directions during
+#   [start, start + len), applied when a packet is sent (netem drops at enqueue).
+# CLOCK: CLOCK_MONOTONIC is one clock for every namespace of the host, so the server's receive stamp minus the send
+#   stamp carried in the message is the delay, and the bursts mode times its netem changes on the same clock.
+import json
+import socket
+import struct
+import subprocess
+import sys
+import time
+
+SIZE = 200
+PERIOD_NS = 33_333_333
+STEADY_S = 60
+BURSTS = [((STEADY_S + 10 * k) * 1_000_000_000, 1_000_000_000) for k in range(10)]
+TOTAL_S = 170
+MESSAGES = TOTAL_S * 1_000_000_000 // PERIOD_NS
+TCP_CONGESTION = getattr(socket, "TCP_CONGESTION", 13)
+COUNTERS = {
+    "/proc/net/snmp": ("Tcp:", ["RetransSegs"]),
+    "/proc/net/netstat": ("TcpExt:", ["TCPFastRetrans", "TCPLossProbes", "TCPTimeouts", "TCPLostRetransmit"]),
+}
+TC = "/usr/sbin/tc"
+LINKS = [("npt-s14c", "s14c", "loss 2%"), ("npt-s14s", "s14s", "")]
+
+
+def kernel_counters():
+    """The named counters now, in this network namespace (None where a file or name is missing)."""
+    out = {}
+    for path, (prefix, names) in COUNTERS.items():
+        try:
+            lines = [line.split() for line in open(path) if line.startswith(prefix)]
+        except OSError:
+            lines = []
+        table = dict(zip(lines[0][1:], (int(x) for x in lines[1][1:]))) if len(lines) >= 2 else {}
+        for name in names:
+            out[name] = table.get(name)
+    return out
+
+
+def set_cc(s, errors, who):
+    try:
+        s.setsockopt(socket.IPPROTO_TCP, TCP_CONGESTION, b"cubic")
+    except OSError as e:
+        errors.append(f"{who}: {e}")
+
+
+def get_cc(s):
+    return s.getsockopt(socket.IPPROTO_TCP, TCP_CONGESTION, 16).split(b"\0", 1)[0].decode()
+
+
+def server(port, n):
+    errors = []
+    ls = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    ls.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+    set_cc(ls, errors, "listener")
+    ls.bind(("", port))
+    ls.listen(1)
+    c, _ = ls.accept()
+    set_cc(c, errors, "accepted")
+    c.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+    sent, delay = [None] * n, [None] * n
+    buf, got = b"", 0
+    while got < n:
+        d = c.recv(65536)
+        if not d:
+            break
+        now = time.monotonic_ns()
+        buf += d
+        while len(buf) >= SIZE:
+            seq, stamp = struct.unpack_from("<QQ", buf, 0)
+            buf = buf[SIZE:]
+            if seq < n and sent[seq] is None:
+                sent[seq], delay[seq] = stamp, now - stamp
+                got += 1
+    cc = get_cc(c)
+    c.close()
+    ls.close()
+    print(json.dumps({"role": "server", "port": port, "messages": n, "delivered": got, "cc_server": cc,
+                      "cc_errors": errors, "sent_ns": sent, "delay_ns": delay}))
+
+
+def client(host, port, n):
+    errors = []
+    counters_before = kernel_counters()
+    cs = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    set_cc(cs, errors, "client")
+    cs.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+    for _ in range(50):
+        try:
+            cs.connect((host, port))
+            break
+        except OSError:
+            time.sleep(0.1)
+    else:
+        sys.exit("probe.py client: could not connect")
+    cc = get_cc(cs)
+    first = time.monotonic_ns() + 500_000_000
+    print(f"START {first}", flush=True)
+    late = []
+    for i in range(n):
+        due = first + i * PERIOD_NS
+        while True:
+            now = time.monotonic_ns()
+            if now >= due:
+                break
+            time.sleep(min(0.005, (due - now) / 1e9))
+        stamp = time.monotonic_ns()
+        late.append(stamp - due)
+        cs.sendall(struct.pack("<QQ", i, stamp).ljust(SIZE, b"\0"))
+    time.sleep(3)
+    info = cs.getsockopt(socket.IPPROTO_TCP, socket.TCP_INFO, 256)
+    cs.close()
+    # struct tcp_info (include/uapi/linux/tcp.h): 8 u8 fields, then u32 rto, ato, snd_mss, rcv_mss, unacked, sacked,
+    # lost, retrans, fackets, last_data_sent, last_ack_sent, last_data_recv, last_ack_recv, pmtu, rcv_ssthresh, rtt,
+    # rttvar, snd_ssthresh, snd_cwnd, advmss, reordering, rcv_rtt, rcv_space, total_retrans.
+    u32 = struct.unpack_from("<24I", info, 8)
+    print(json.dumps({"role": "client", "messages": n, "first_due_ns": first, "period_ns": PERIOD_NS,
+                      "cc_client": cc, "cc_errors": errors, "send_late_ns": late,
+                      "tcp_info_client": {"rto_us": u32[0], "rtt_us": u32[15], "rttvar_us": u32[16],
+                                          "snd_cwnd": u32[18], "total_retrans": u32[23]},
+                      "kernel_counters_before": counters_before, "kernel_counters_after": kernel_counters()}))
+
+
+def netem(loss_all):
+    """Both links to total loss (a burst) or back to their steady settings; returns the call's start and end."""
+    t0 = time.monotonic_ns()
+    for ns, dev, steady in LINKS:
+        loss = "loss 100%" if loss_all else steady
+        subprocess.run([TC, "-n", ns, "qdisc", "change", "dev", dev, "root", "netem", "delay", "50ms", *loss.split()],
+                       check=True, env={"PATH": "/usr/sbin:/usr/bin"})
+    return t0, time.monotonic_ns()
+
+
+def bursts(first):
+    now = time.monotonic_ns()
+    if abs(first - now) > 10_000_000_000:
+        print("probe.py bursts: the first-message stamp is not within 10 s of now: refused", file=sys.stderr)
+        sys.exit(2)
+    actual, calls = [], []
+    for start, length in BURSTS:
+        time.sleep(max(0, first + start - time.monotonic_ns()) / 1e9)
+        on = netem(True)
+        time.sleep(max(0, first + start + length - time.monotonic_ns()) / 1e9)
+        off = netem(False)
+        actual.append([on[1] - first, off[1] - on[1]])
+        calls.append([on[1] - on[0], off[1] - off[0]])
+    print(json.dumps({"schedule": [list(b) for b in BURSTS], "actual": actual, "tc_call_ns": calls}))
+
+
+def main():
+    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
+    if cmd == "messages" and len(sys.argv) == 2:
+        print(MESSAGES)
+    elif cmd == "schedule" and len(sys.argv) == 2:
+        print(",".join(f"{s}:{l}" for s, l in BURSTS))
+    elif cmd == "server" and len(sys.argv) == 4:
+        server(int(sys.argv[2]), int(sys.argv[3]))
+    elif cmd == "client" and len(sys.argv) == 5:
+        client(sys.argv[2], int(sys.argv[3]), int(sys.argv[4]))
+    elif cmd == "bursts" and len(sys.argv) == 3 and sys.argv[2].isdigit():
+        bursts(int(sys.argv[2]))
+    else:
+        print("usage: probe.py messages|schedule|server <port> <n>|client <host> <port> <n>|bursts <ns>", file=sys.stderr)
+        sys.exit(2)
+
+
+main()
diff --git a/spikes/netcode-proof/ops/sbin/npt-capture b/spikes/netcode-proof/ops/sbin/npt-capture
new file mode 100644
index 0000000..7c0b785
--- /dev/null
+++ b/spikes/netcode-proof/ops/sbin/npt-capture
@@ -0,0 +1,51 @@
+#!/bin/bash -p
+# npt-capture start|stop: a packet capture with a fixed interface, filter, snap length, count cap and output path
+# (u8-brief.md rev 1.1 section 1 Block 3; plan.md:1140-1141). Root-owned, 0755. No caller text reaches tcpdump: no
+# -z, -Z, -w, -r or filter from the caller (GTFOBins). tcpdump opens the interface as root, then drops to its own
+# user before it opens the savefile (-Z tcpdump), so root never opens a path another user writes; the directory is
+# tcpdump's, readable by group npt, and the name ends in .pcap (Ubuntu's AppArmor profile for tcpdump admits it).
+if [ "${NPT_ENV_CLEARED:-}" != 1 ]; then
+  exec /usr/bin/env -i NPT_ENV_CLEARED=1 PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C /bin/bash -p /usr/local/sbin/npt-capture "$@"
+fi
+set -euo pipefail
+set -f
+umask 022
+. /usr/local/lib/npt/npt-lib.sh
+
+readonly IFACE=eth0
+readonly OUT=/var/lib/npt/capture/rs.pcap
+readonly PIDF=/run/npt-capture.pid
+readonly LOG=/run/npt-capture.log
+readonly FILTER='udp portrange 30001-30032 or tcp portrange 31000-31032'
+
+die() { printf 'npt-capture: %s\n' "$*" >&2; exit 2; }
+[ "$#" -eq 1 ] && npt_valid_word "$1" start stop || die "usage: npt-capture start|stop"
+[ "$(tr -d '\n' < /etc/npt/role)" = rs ] || die "RS only"
+
+PID=''
+running() {
+  [ -f "$PIDF" ] && [ ! -L "$PIDF" ] || return 1
+  PID=$(tr -dc '0-9' < "$PIDF")
+  [ -n "$PID" ] && [ "$(cat "/proc/$PID/comm" 2>/dev/null)" = tcpdump ]
+}
+
+case $1 in
+  start)
+    running && die "a capture is running already"
+    [ -d "/sys/class/net/$IFACE" ] || die "no interface $IFACE"
+    setsid /usr/bin/tcpdump -i "$IFACE" -n -s 96 -c 2000000 -U -Z tcpdump -w "$OUT" "$FILTER" < /dev/null > "$LOG" 2>&1 &
+    printf '%s\n' "$!" > "$PIDF"
+    sleep 1
+    running || die "tcpdump did not start (its messages: $LOG)"
+    printf 'capture started on %s: snap length 96, at most 2,000,000 packets, the two game ranges only\n' "$IFACE"
+    ;;
+  stop)
+    running || die "no capture is running"
+    kill -INT "$PID"
+    for _ in $(seq 1 20); do kill -0 "$PID" 2> /dev/null || break; sleep 0.5; done
+    kill -0 "$PID" 2> /dev/null && die "tcpdump did not stop"
+    rm -f "$PIDF"
+    tail -n 3 "$LOG"
+    printf 'capture stopped; the file stays on RS (raw data never leaves the VM: plan.md:1187-1188)\n'
+    ;;
+esac
diff --git a/spikes/netcode-proof/ops/sbin/npt-cert b/spikes/netcode-proof/ops/sbin/npt-cert
new file mode 100644
index 0000000..bc40b0b
--- /dev/null
+++ b/spikes/netcode-proof/ops/sbin/npt-cert
@@ -0,0 +1,117 @@
+#!/bin/bash -p
+# npt-cert issue staging|production: the WebSocket leg's browser-trusted certificate by DNS-01 by hand
+# (u8-brief.md rev 1.1 section 1 Block 3; replan-units.md:107-118; Q-U8-4 as ruled). Root-owned, 0755.
+# 1. Opens npt-host's egress to the one ACME directory host (its addresses resolved here, each element timing out
+#    after 35 minutes); DNS goes over loopback to the local resolver, which nftables admits.
+# 2. Runs U6c's issue mode as npt-host, ONE process across both phases (no ACME key or order state on disk between
+#    them). Its interface (U6c's brief takes it): stdout `PROFILE <name>`, `TXT_NAME <name>`, `TXT_VALUE <value>`;
+#    then it reads `go` on stdin; then `SERIAL <hex>`, `SHA256 <hex>`, `DONE`. It writes the key (0640, group
+#    npt-room through the setgid directory) and the chain under /var/lib/npt/tls, and requires `shortlived` in
+#    production (fails closed); this wrapper checks the PROFILE line too.
+# 3. Polls EVERY authoritative server of the zone (npt-ns.txt in the root-owned clone) with `dig +norecurse` every
+#    15 s and sends `go` only when all show the value (Let's Encrypt validates from several perspectives). One
+#    30-minute bound covers both phases; no retry loop: a failed order stops the run and comes back to Mustafa.
+# 4. Closes the egress, prints the serial and hash for the ledger. The TXT value goes to stdout only, never a file.
+if [ "${NPT_ENV_CLEARED:-}" != 1 ]; then
+  exec /usr/bin/env -i NPT_ENV_CLEARED=1 PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C /bin/bash -p /usr/local/sbin/npt-cert "$@"
+fi
+set -euo pipefail
+set -f
+umask 022
+. /usr/local/lib/npt/npt-lib.sh
+
+die() { printf 'npt-cert: %s\n' "$*" >&2; exit 2; }
+fail() { printf 'npt-cert: order FAILED: %s. The run stops; this comes back to Mustafa.\n' "$*" >&2; exit 3; }
+
+[ "$#" -eq 2 ] && [ "$1" = issue ] && npt_valid_word "$2" staging production || die "usage: npt-cert issue staging|production"
+[ "$(tr -d '\n' < /etc/npt/role)" = rs ] || die "RS only"
+readonly PROFILE=$2
+case $PROFILE in
+  staging) readonly ACME=acme-staging-v02.api.letsencrypt.org ;;
+  production) readonly ACME=acme-v02.api.letsencrypt.org ;;
+esac
+
+ns=()
+while read -r n; do
+  case $n in '' | '#'*) continue ;; esac
+  npt_valid_hostname "$n" || die "npt-ns.txt holds a bad name"
+  ns+=("$n")
+done < /usr/local/lib/npt/npt-ns.txt
+[ "${#ns[@]}" -ge 2 ] || die "npt-ns.txt must name every authoritative server of the zone"
+
+readonly DEADLINE=$(($(date +%s) + 1800))
+left() { printf '%s\n' $((DEADLINE - $(date +%s))); }
+ISSUE_PID=''
+cleanup() {
+  if [ -n "$ISSUE_PID" ]; then kill "$ISSUE_PID" 2>/dev/null || true; fi
+  nft flush set inet npt acme_v4 || true
+}
+trap cleanup EXIT
+
+addrs=()
+while read -r a; do npt_valid_ipv4 "$a" && addrs+=("$a timeout 35m"); done < <(dig +short +time=5 +tries=2 A "$ACME")
+[ "${#addrs[@]}" -ge 1 ] || fail "the ACME host did not resolve"
+elements=$(IFS=,; printf '%s' "${addrs[*]}")
+nft "add element inet npt acme_v4 { ${elements//,/, } }"
+
+coproc ISSUE {
+  umask 027
+  exec /usr/bin/setpriv --reuid=npt-host --regid=npt-host --clear-groups --no-new-privs --bounding-set=-all \
+    --inh-caps=-all --ambient-caps=-all --reset-env /opt/npt/bin/npt-host issue "$PROFILE"
+}
+
+VALUE=''
+expect() {
+  local t line
+  t=$(left)
+  ((t > 0)) || fail "30 minutes passed before $1"
+  IFS= read -r -t "$t" line <&"${ISSUE[0]}" || fail "the issue mode ended or stalled before $1"
+  if [ "$1" = DONE ]; then
+    [ "$line" = DONE ] || fail "unexpected line from the issue mode before DONE (not printed)"
+    return 0
+  fi
+  [[ $line =~ ^$1\ ([^[:space:]]+)$ ]] || fail "unexpected line from the issue mode before $1 (not printed)"
+  VALUE=${BASH_REMATCH[1]}
+}
+
+expect PROFILE
+if [ "$PROFILE" = production ] && [ "$VALUE" != shortlived ]; then
+  fail "production requires the shortlived profile (the order's: $(npt_comm_clean "$VALUE"))"
+fi
+order_profile=$VALUE
+expect TXT_NAME
+[ "$VALUE" = "$NPT_CHALLENGE_NAME" ] || fail "the challenge name is not $NPT_CHALLENGE_NAME"
+expect TXT_VALUE
+npt_valid_txt_value "$VALUE" || fail "the TXT value is malformed"
+txt=$VALUE
+printf 'Add in Cloudflare (zone shamblefrontlines.com): type TXT, name _acme-challenge.rs.nt, content %s, TTL 1 min.\n' "$txt"
+printf 'Polling %s every 15 s; at most until %s UTC.\n' "${ns[*]}" "$(date -u -d "@$DEADLINE" +%H:%M:%S)"
+
+while :; do
+  all=1
+  for n in "${ns[@]}"; do
+    got=$(dig +norecurse +short +time=5 +tries=1 TXT "$NPT_CHALLENGE_NAME" "@$n" 2>/dev/null | tr -d '"') || got=''
+    grep -qxF -- "$txt" <<< "$got" || all=0
+  done
+  [ "$all" = 1 ] && break
+  (($(left) > 15)) || fail "the TXT record did not show on every authoritative server within 30 minutes"
+  sleep 15
+done
+printf 'Every authoritative server shows it: readying the challenge.\n'
+printf 'go\n' >&"${ISSUE[1]}"
+
+expect SERIAL
+npt_valid_hex "$VALUE" || fail "the serial is malformed"
+serial=$VALUE
+expect SHA256
+[[ $VALUE =~ ^[0-9a-f]{64}$ ]] || fail "the hash is malformed"
+sha=$VALUE
+expect DONE
+pid=$ISSUE_PID
+for _ in $(seq 1 30); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
+kill -0 "$pid" 2>/dev/null && fail "the issue mode did not end after DONE"
+wait "$pid" || fail "the issue mode ended non-zero"
+ISSUE_PID=''
+nft flush set inet npt acme_v4
+printf 'npt-cert: issued (%s, profile %s); egress closed. Ledger: serial %s, sha256 %s.\n' "$PROFILE" "$order_profile" "$serial" "$sha"
+printf 'Delete the TXT record now; the session confirms its absence over DNS-over-HTTPS.\n'
diff --git a/spikes/netcode-proof/ops/sbin/npt-ctl b/spikes/netcode-proof/ops/sbin/npt-ctl
new file mode 100644
index 0000000..6bc183d
--- /dev/null
+++ b/spikes/netcode-proof/ops/sbin/npt-ctl
@@ -0,0 +1,196 @@
+#!/bin/bash -p
+# npt-ctl: the run's root controls (u8-brief.md rev 1.1 section 1 Block 3; C1, C4; Q-U8-1, -3, -7; L4).
+# Installed root-owned, 0755, at /usr/local/sbin/npt-ctl; `npt` reaches it only through sudoers.d/npt (RS) or npt-lg
+# (LG), each argument matched there by an anchored pattern and validated again here by npt-lib.sh.
+#   RS:  npt-ctl peers <LG IPv4> [<more LG IPv4s>]   metrics_src, PermitOpen <LG>:22, sshd -t, reload; VM addresses only
+#        npt-ctl cpus <tick vCPU>                     condition 4's housekeeping set (slices, workqueue mask, kthreads)
+#        npt-ctl rooms start NN                       npt-super's hold form as npt-room in npt-rooms.slice (stdin held)
+#        npt-ctl rooms tokens NN                      that room's token file, read as npt-room, to stdout only
+#        npt-ctl quic off|on                          UDP 30001-30032 dropped from all but metrics_src, 15 min at most
+#   LG:  npt-ctl loadkey <RS IPv4>                    RS's .pub (one line on stdin) for npt-load, forced command (C4)
+# No free argument reaches systemd-run, setpriv, taskset, nft, sshd or systemctl: each command line is built from
+# validated values and root-owned records only (Q-U8-1 term 2).
+if [ "${NPT_ENV_CLEARED:-}" != 1 ]; then
+  exec /usr/bin/env -i NPT_ENV_CLEARED=1 PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C /bin/bash -p /usr/local/sbin/npt-ctl "$@"
+fi
+set -euo pipefail
+set -f
+umask 022
+. /usr/local/lib/npt/npt-lib.sh
+
+readonly STATE=/var/lib/npt/state
+readonly SETPRIV_ROOM=(/usr/bin/setpriv --reuid=npt-room --regid=npt-room --clear-groups --no-new-privs
+  --bounding-set=-all --inh-caps=-all --ambient-caps=-all --reset-env)
+
+die() { printf 'npt-ctl: %s\n' "$*" >&2; exit 2; }
+role() { tr -d '\n' < /etc/npt/role; }
+need_role() { [ "$(role)" = "$1" ] || die "this verb runs on ${1^^} only"; }
+
+peers() {
+  need_role rs
+  [ "$#" -ge 1 ] && [ "$#" -le 4 ] || die "peers takes 1 to 4 LG addresses"
+  local a open=() rule
+  for a in "$@"; do npt_valid_ipv4 "$a" || die "not a public IPv4 in plain form"; open+=("$a:22"); done
+  rule=$(npt_metrics_rule "$@")
+  nft flush set inet npt metrics_src
+  nft "$rule"
+  local conf=/etc/ssh/sshd_config.d/00-npt-open.conf tmp
+  tmp=$(mktemp /etc/ssh/sshd_config.d/.npt-open.XXXXXX)
+  cp -p "$conf" "$conf.prev"
+  printf 'PermitOpen %s\n' "${open[*]}" > "$tmp"
+  chmod 0644 "$tmp"
+  mv -f "$tmp" "$conf"
+  if ! /usr/sbin/sshd -t; then
+    mv -f "$conf.prev" "$conf"
+    die "sshd -t refused the new PermitOpen; the previous file is back"
+  fi
+  rm -f "$conf.prev"
+  systemctl --no-pager reload ssh.service
+  printf 'lg=%s\n' "$*" > "$STATE/peers.tmp"
+  mv -f "$STATE/peers.tmp" "$STATE/peers"
+  printf 'peers: metrics_src {%s}; PermitOpen %s; sshd -t ok; reloaded\n' "$*" "${open[*]}"
+  # Bring-up's dry runs (plan.md:1151, u8-brief.md section 3): the effective sshd values of plan.md:1150-1155 and the
+  # loaded ruleset, for comparison with rs.yaml. VM addresses only.
+  printf -- '--- sshd -T (the plan'"'"'s keys)\n'
+  /usr/sbin/sshd -T | grep -Ei '^(passwordauthentication|kbdinteractiveauthentication|permitrootlogin|authenticationmethods|x11forwarding|allowagentforwarding|maxauthtries|logingracetime|allowusers|allowtcpforwarding|permitlisten|allowstreamlocalforwarding|permittunnel|gatewayports|permitopen) '
+  printf -- '--- nft list ruleset\n'
+  nft list ruleset
+}
+
+cpus() {
+  need_role rs
+  [ "$#" -eq 1 ] || die "cpus takes one tick vCPU"
+  local online n tick sib hk path refused=0 moved=0 left=0 counts=0 line
+  online=$(tr -d '\n' < /sys/devices/system/cpu/online)
+  npt_cpulist_valid "$online" || die "unreadable online CPU list"
+  n=$(npt_cpulist_count "$online")
+  npt_valid_vcpu "$1" "$n" || die "the tick vCPU must be an online CPU index"
+  tick=$((10#$1))
+  sib=$(tr -d '\n' < "/sys/devices/system/cpu/cpu$tick/topology/thread_siblings_list")
+  hk=$(npt_housekeeping "$online" "$tick" "$sib") || die "no housekeeping set would be left"
+  local rec="$STATE/cpus.tmp"
+  {
+    printf 'tick=%s\nsiblings=%s\nonline=%s\nhousekeeping=%s\n' "$tick" "$sib" "$online" "$hk"
+    for u in system.slice user.slice; do
+      systemctl --no-pager set-property --runtime "$u" "AllowedCPUs=$hk"
+      printf 'allowed.%s=%s\n' "$u" "$(systemctl --no-pager show -P AllowedCPUs "$u")"
+    done
+    # L4: systemd may refuse AllowedCPUs= on init.scope; then PID 1's threads are moved by taskset instead.
+    if systemctl --no-pager set-property --runtime init.scope "AllowedCPUs=$hk" 2>/dev/null; then
+      printf 'init.scope=AllowedCPUs %s\n' "$(systemctl --no-pager show -P AllowedCPUs init.scope)"
+    else
+      local pid1=()
+      set +f
+      pid1=(/proc/1/task/[0-9]*)
+      set -f
+      for path in "${pid1[@]}"; do taskset -pc "$hk" "${path##*/}" >/dev/null; done
+      printf 'init.scope=taskset on PID 1 threads\n'
+    fi
+    printf '%s\n' "$(npt_cpumask_hex "$hk")" > /sys/devices/virtual/workqueue/cpumask
+    printf 'workqueue.cpumask=%s\n' "$(tr -d '\n' < /sys/devices/virtual/workqueue/cpumask)"
+    while read -r line; do
+      set -- $line
+      case $1 in
+        move)
+          if taskset -pc "$hk" "$2" >/dev/null 2>&1; then moved=$((moved + 1))
+          else refused=$((refused + 1)); printf 'kthread.refused=%s %s\n' "$2" "$3"; fi ;;
+        left) left=$((left + 1)) ;;
+        counts) counts=$((counts + 1)) ;;
+      esac
+    done < <(affinity_records | npt_affinity_scan "$tick")
+    printf 'kthreads.moved=%s\nkthreads.refused=%s\nkthreads.left_per_cpu=%s\n' "$moved" "$refused" "$left"
+    # The read-back: threads that would still count against `alone` after the moves (before any room starts).
+    printf 'tasks.on_tick_after_moves=%s\n' "$(affinity_records | npt_affinity_scan "$tick" | grep -c '^\(counts\|move\) ' || true)"
+    # IRQ affinity is read and recorded per vCPU, never changed (no mark asks it).
+    awk 'NR == 1 { n = NF; next } { for (i = 2; i <= n + 1; i++) if ($i ~ /^[0-9]+$/) s[i - 2] += $i }
+         END { for (c = 0; c < n; c++) printf "irq.cpu%d=%d\n", c, s[c] }' /proc/interrupts
+  } > "$rec"
+  chmod 0644 "$rec"
+  mv -f "$rec" "$STATE/cpus"
+  cat "$STATE/cpus"
+}
+
+# One record per thread for npt_affinity_scan: tid, stat flags, Cpus_allowed_list, a clean name.
+affinity_records() {
+  local t stat rest flags allowed comm tasks=()
+  set +f
+  tasks=(/proc/[0-9]*/task/[0-9]*)
+  set -f
+  for t in "${tasks[@]}"; do
+    stat=$(cat "$t/stat" 2>/dev/null) || continue
+    rest=${stat##*) }
+    set -- $rest
+    flags=${7:-}
+    allowed=$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' "$t/status" 2>/dev/null) || continue
+    comm=$(cat "$t/comm" 2>/dev/null) || continue
+    printf '%s %s %s %s\n' "${t##*/}" "$flags" "$allowed" "$(npt_comm_clean "$comm")"
+  done
+}
+
+housekeeping_record() {
+  local hk
+  [ -f "$STATE/cpus" ] && [ ! -L "$STATE/cpus" ] || die "run npt-ctl cpus first"
+  hk=$(sed -n 's/^housekeeping=//p' "$STATE/cpus")
+  npt_cpulist_valid "$hk" || die "the housekeeping record is unreadable"
+  printf '%s\n' "$hk"
+}
+
+rooms() {
+  need_role rs
+  [ "$#" -eq 2 ] && npt_valid_word "$1" start tokens && npt_valid_nn "$2" || die "rooms start|tokens NN"
+  local nn=$2
+  case $1 in
+    tokens)
+      # Q-U8-7 with Q-U8-1 term 4: read as npt-room, so a link the room plants reaches nothing npt-room cannot read.
+      exec "${SETPRIV_ROOM[@]}" /usr/bin/head -c 1048576 -- "/var/lib/npt/rooms/room-$nn.tok" ;;
+    start)
+      local hk
+      hk=$(housekeeping_record)
+      [ -f "/var/lib/npt/run/room-$nn.json" ] || die "no settings at /var/lib/npt/run/room-$nn.json"
+      # A restart frees the room's token and hash paths as npt-room (U6a and U6b refuse an existing path).
+      "${SETPRIV_ROOM[@]}" /usr/bin/rm -f -- "/var/lib/npt/rooms/room-$nn.tok" "/var/lib/npt/hash/room-$nn.json"
+      # Condition 3 and Q-U8-1: npt-super's hold form as npt-room in npt-rooms.slice (every CPU), started off the
+      # tick vCPU by taskset so only the room's tick thread pins itself onto it (Q-U6A-5); stdin passes through.
+      exec systemd-run --quiet --scope --collect --slice=npt-rooms.slice --unit="npt-room-$nn-$$" \
+        "${SETPRIV_ROOM[@]}" /usr/bin/taskset -c "$hk" /opt/npt/bin/npt-super hold "/var/lib/npt/run/room-$nn.json" ;;
+  esac
+}
+
+quic() {
+  need_role rs
+  [ "$#" -eq 1 ] && npt_valid_word "$1" off on || die "quic off|on"
+  if [ "$1" = off ]; then
+    nft list set inet npt metrics_src | grep -Eq 'elements = \{' || die "metrics_src is empty: run npt-ctl peers first"
+    nft "$NPT_QUIC_OFF_RULE"
+  else
+    nft "$NPT_QUIC_ON_RULE"
+  fi
+  nft list set inet npt quic_off | sed -n 's/^[[:space:]]*elements = /quic_off: /p'
+  printf 'quic %s\n' "$1"
+}
+
+loadkey() {
+  need_role lg
+  [ "$#" -eq 1 ] && npt_valid_ipv4 "$1" || die "loadkey takes RS's IPv4"
+  local key tmp
+  key=$(head -c 512 | head -n 1 | tr -d '\r')
+  npt_valid_pubkey "$key" || die "stdin is not one ed25519 public key line"
+  set -- "$1" $key
+  tmp=$(mktemp /etc/ssh/authorized_keys/.npt-load.XXXXXX)
+  printf 'from="%s",restrict,command="/usr/local/bin/npt-load-ctl" %s %s npt-rs-to-lg\n' "$1" "$2" "$3" > "$tmp"
+  chmod 0644 "$tmp"
+  mv -f "$tmp" /etc/ssh/authorized_keys/npt-load
+  ssh-keygen -l -f /etc/ssh/authorized_keys/npt-load
+}
+
+[ "$#" -ge 1 ] || die "a verb is needed"
+verb=$1
+shift
+case $verb in
+  peers) peers "$@" ;;
+  cpus) cpus "$@" ;;
+  rooms) rooms "$@" ;;
+  quic) quic "$@" ;;
+  loadkey) loadkey "$@" ;;
+  *) die "unknown verb" ;;
+esac
diff --git a/spikes/netcode-proof/ops/sbin/npt-lib.sh b/spikes/netcode-proof/ops/sbin/npt-lib.sh
new file mode 100644
index 0000000..f26aae0
--- /dev/null
+++ b/spikes/netcode-proof/ops/sbin/npt-lib.sh
@@ -0,0 +1,191 @@
+# npt-lib.sh: validators and pure computations for U8's wrappers (u8-brief.md rev 1.1 section 1 Block 3).
+# No side effects: sourcing defines constants and functions only, reads no file and runs no command, so the container
+# tests (ops/tests/wrappers.test.sh) source it as the wrappers do. Installed root-owned, 0644, at
+# /usr/local/lib/npt/npt-lib.sh. Every validator takes exactly one argument and refuses anything else.
+
+readonly NPT_OCTET='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
+readonly NPT_PF_KTHREAD=$((0x00200000))
+readonly NPT_MAX_CPUS=32
+# Q-U8-3: the QUIC block. One interval element with a 15-minute timeout, so the block cannot stay on.
+readonly NPT_QUIC_OFF_RULE='add element inet npt quic_off { 30001-30032 timeout 15m }'
+readonly NPT_QUIC_ON_RULE='flush set inet npt quic_off'
+readonly NPT_DNS_NAME='rs.nt.shamblefrontlines.com'
+readonly NPT_CHALLENGE_NAME='_acme-challenge.rs.nt.shamblefrontlines.com'
+
+# A public IPv4 in plain dotted form: no leading zero, no CIDR, no mapped or decimal form, no special range
+# (unspecified, private, shared, loopback, link-local, multicast, reserved, broadcast).
+npt_valid_ipv4() {
+  [ "$#" -eq 1 ] || return 1
+  local re="^${NPT_OCTET}\\.${NPT_OCTET}\\.${NPT_OCTET}\\.${NPT_OCTET}\$"
+  [[ $1 =~ $re ]] || return 1
+  local a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]}
+  ((a == 0 || a == 10 || a == 127 || a >= 224)) && return 1
+  ((a == 100 && b >= 64 && b <= 127)) && return 1
+  ((a == 169 && b == 254)) && return 1
+  ((a == 172 && b >= 16 && b <= 31)) && return 1
+  ((a == 192 && b == 168)) && return 1
+  return 0
+}
+
+# A room slot NN, 00-31 (two digits; settings path /var/lib/npt/run/room-NN.json).
+npt_valid_nn() {
+  [ "$#" -eq 1 ] && [[ $1 =~ ^(0[0-9]|[12][0-9]|3[01])$ ]]
+}
+
+# A vCPU index below the online count (two arguments: the index, then the count the wrapper read).
+npt_valid_vcpu() {
+  [ "$#" -eq 2 ] && [[ $1 =~ ^([0-9]|[12][0-9]|3[01])$ ]] && [[ $2 =~ ^[1-9][0-9]?$ ]] && ((10#$1 < 10#$2))
+}
+
+# One word from a fixed list: npt_valid_word <word> <allowed>...
+npt_valid_word() {
+  [ "$#" -ge 2 ] || return 1
+  local w=$1 x
+  shift
+  for x in "$@"; do [ "$w" = "$x" ] && return 0; done
+  return 1
+}
+
+# A kernel cpu list ("0-3,8"), every CPU below NPT_MAX_CPUS.
+npt_cpulist_valid() {
+  [ "$#" -eq 1 ] && [[ $1 =~ ^[0-9]{1,2}(-[0-9]{1,2})?(,[0-9]{1,2}(-[0-9]{1,2})?)*$ ]] || return 1
+  local part lo hi
+  local IFS=,
+  for part in $1; do
+    lo=${part%-*} hi=${part#*-}
+    ((10#$lo <= 10#$hi && 10#$hi < NPT_MAX_CPUS)) || return 1
+  done
+}
+
+# Expands a valid cpu list to its CPUs, ascending, space-separated.
+npt_cpulist_expand() {
+  npt_cpulist_valid "$1" || return 1
+  local part lo hi c out=() seen=()
+  local IFS=,
+  for part in $1; do
+    lo=$((10#${part%-*})) hi=$((10#${part#*-}))
+    for ((c = lo; c <= hi; c++)); do seen[c]=1; done
+  done
+  for c in "${!seen[@]}"; do out+=("$c"); done
+  IFS=' '
+  printf '%s\n' "${out[*]}"
+}
+
+# True if a valid cpu list holds the CPU.
+npt_cpulist_has() {
+  local c
+  for c in $(npt_cpulist_expand "$1"); do [ "$c" = "$2" ] && return 0; done
+  return 1
+}
+
+# The number of CPUs in a valid cpu list.
+npt_cpulist_count() {
+  local n=0 c
+  for c in $(npt_cpulist_expand "$1"); do n=$((n + 1)); done
+  printf '%s\n' "$n"
+}
+
+# Condition 4's housekeeping set: every online CPU but the tick vCPU and its SMT siblings.
+# npt_housekeeping <online list> <tick vCPU> <the tick's thread_siblings_list>; prints a comma list, or fails when the
+# tick is offline, not among its own siblings, or nothing would be left.
+npt_housekeeping() {
+  [ "$#" -eq 3 ] || return 1
+  npt_cpulist_valid "$1" && npt_cpulist_valid "$3" || return 1
+  npt_cpulist_has "$1" "$2" && npt_cpulist_has "$3" "$2" || return 1
+  local c out=()
+  for c in $(npt_cpulist_expand "$1"); do
+    npt_cpulist_has "$3" "$c" || out+=("$c")
+  done
+  [ "${#out[@]}" -gt 0 ] || return 1
+  local IFS=,
+  printf '%s\n' "${out[*]}"
+}
+
+# The unbound workqueue mask (/sys/devices/virtual/workqueue/cpumask) for a valid cpu list, in hex.
+npt_cpumask_hex() {
+  npt_cpulist_valid "$1" || return 1
+  local m=0 c
+  for c in $(npt_cpulist_expand "$1"); do m=$((m | (1 << c))); done
+  printf '%x\n' "$m"
+}
+
+# A thread name as the records print it: at most 32 characters of [A-Za-z0-9_.:/-], every other character `?`
+# (a room can name its threads, so a name never reaches a record raw).
+npt_comm_clean() {
+  local s=${1:0:32}
+  printf '%s\n' "${s//[^A-Za-z0-9_.:\/-]/?}"
+}
+
+# Condition 4's selection, on records read from /proc by `npt-ctl cpus` (one per thread, on stdin):
+#   <tid> <flags from /proc/<pid>/task/<tid>/stat> <Cpus_allowed_list> <clean name>
+# Prints, for the tick vCPU given:
+#   move <tid> <name>    a kernel thread (PF_KTHREAD) allowed on more than one CPU: moved to the housekeeping set
+#   left <tid> <name>    a kernel thread bound to the tick vCPU only: per-CPU, left, and excluded from `alone`
+#   counts <tid> <name>  any other thread whose allowed list holds the tick vCPU: it counts against `alone`
+# A malformed record is printed as `bad <line>` and never selected.
+npt_affinity_scan() {
+  [ "$#" -eq 1 ] || return 1
+  local tick=$1 tid flags allowed name n
+  while read -r tid flags allowed name; do
+    if ! [[ $tid =~ ^[0-9]{1,9}$ && $flags =~ ^[0-9]{1,12}$ ]] || ! npt_cpulist_valid "$allowed"; then
+      printf 'bad %s\n' "$(npt_comm_clean "$tid $flags $allowed")"
+      continue
+    fi
+    n=$(npt_cpulist_count "$allowed")
+    if ((10#$flags & NPT_PF_KTHREAD)); then
+      if ((n > 1)); then
+        printf 'move %s %s\n' "$tid" "$name"
+      elif [ "$allowed" = "$tick" ]; then
+        printf 'left %s %s\n' "$tid" "$name"
+      fi
+    elif npt_cpulist_has "$allowed" "$tick"; then
+      printf 'counts %s %s\n' "$tid" "$name"
+    fi
+  done
+}
+
+# npt-load-ctl's fixed verbs (C4), parsed from SSH_ORIGINAL_COMMAND: `<verb> NN` or `fwcheck`. Sets NPT_VERB and
+# NPT_NN; refuses every other text, extra words included.
+npt_load_parse() {
+  NPT_VERB='' NPT_NN=''
+  [ "$#" -eq 1 ] || return 1
+  if [[ $1 =~ ^(token|settings|start|stop|status|log)\ (0[0-9]|[12][0-9]|3[01])$ ]]; then
+    NPT_VERB=${BASH_REMATCH[1]} NPT_NN=${BASH_REMATCH[2]}
+    return 0
+  fi
+  if [ "$1" = fwcheck ]; then
+    NPT_VERB=fwcheck
+    return 0
+  fi
+  return 1
+}
+
+# The RS-to-LG public key, one line: ed25519 only (a 51-byte blob is 68 base64 characters), an optional plain comment.
+npt_valid_pubkey() {
+  [ "$#" -eq 1 ] && [[ $1 =~ ^ssh-ed25519\ AAAAC3NzaC1lZDI1NTE5AAAAI[A-Za-z0-9+/]{43}(\ [A-Za-z0-9@._-]{1,64})?$ ]]
+}
+
+# The DNS-01 TXT value instant-acme gives (KeyAuthorization::dns_value: base64url of a SHA-256, 43 characters).
+npt_valid_txt_value() {
+  [ "$#" -eq 1 ] && [[ $1 =~ ^[A-Za-z0-9_-]{43}$ ]]
+}
+
+# A DNS host name in lower case (the zone's authoritative servers, read from the root-owned clone).
+npt_valid_hostname() {
+  [ "$#" -eq 1 ] && [[ $1 =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$ ]]
+}
+
+# A certificate serial or a SHA-256 in hex, as the issue mode prints them.
+npt_valid_hex() {
+  [ "$#" -eq 1 ] && [[ $1 =~ ^[0-9a-f]{2,128}$ ]]
+}
+
+# The metrics_src element command for validated LG addresses (npt-ctl peers).
+npt_metrics_rule() {
+  [ "$#" -ge 1 ] && [ "$#" -le 4 ] || return 1
+  local a
+  for a in "$@"; do npt_valid_ipv4 "$a" || return 1; done
+  local IFS=,
+  local list="$*"
+  printf 'add element inet npt metrics_src { %s }\n' "${list//,/, }"
+}
diff --git a/spikes/netcode-proof/ops/sbin/npt-load-ctl b/spikes/netcode-proof/ops/sbin/npt-load-ctl
new file mode 100644
index 0000000..36e7c17
--- /dev/null
+++ b/spikes/netcode-proof/ops/sbin/npt-load-ctl
@@ -0,0 +1,84 @@
+#!/bin/bash -p
+# npt-load-ctl: LG's forced command for npt-load (C4; plan.md:1157-1162). Installed root-owned, 0755, at
+# /usr/local/bin/npt-load-ctl; it runs as npt-load (never root), named by `command=` in the root-owned
+# /etc/ssh/authorized_keys/npt-load with `from="<RS IPv4>",restrict` (written by `npt-ctl loadkey`). RS's run script
+# uses it to start, feed and stop U6c's npt-load, copy token files and run C5's check while Mustafa is away.
+# Fixed verbs from SSH_ORIGINAL_COMMAND, parsed by npt-lib.sh's npt_load_parse (no other word passes); fixed paths
+# under /var/lib/npt-load:
+#   token NN      stdin (at most 64 KiB) -> tokens/room-NN.tok (0600)
+#   settings NN   stdin (at most 64 KiB) -> run/load-NN.json (0600)
+#   start NN      /opt/npt/bin/npt-load run/load-NN.json, detached; log logs/load-NN.log
+#   stop NN       TERM, then KILL after 10 s; prints the exit
+#   status NN     running or stopped
+#   log NN        the load's log (at most 256 MiB) to stdout
+#   fwcheck       C5's LG half: a TCP connect to RS's port 22 must time out (only fw-rs can drop it)
+# The verbs and npt-load's command line follow the interface U6c's brief names; these are U8's proposal until then.
+if [ "${NPT_ENV_CLEARED:-}" != 1 ]; then
+  exec /usr/bin/env -i NPT_ENV_CLEARED=1 PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C \
+    SSH_ORIGINAL_COMMAND="${SSH_ORIGINAL_COMMAND:-}" SSH_CONNECTION="${SSH_CONNECTION:-}" \
+    /bin/bash -p /usr/local/bin/npt-load-ctl
+fi
+set -euo pipefail
+set -f
+umask 077
+. /usr/local/lib/npt/npt-lib.sh
+
+readonly BASE=/var/lib/npt-load
+readonly BIN=/opt/npt/bin/npt-load
+readonly CAP=65536
+
+die() { printf 'npt-load-ctl: %s\n' "$*" >&2; exit 2; }
+npt_load_parse "${SSH_ORIGINAL_COMMAND:-}" || die "refused (verbs: token|settings|start|stop|status|log NN, fwcheck)"
+readonly VERB=$NPT_VERB NN=$NPT_NN
+
+store() {
+  local tmp size
+  tmp=$(mktemp "$1.XXXXXX")
+  head -c $((CAP + 1)) > "$tmp"
+  size=$(stat -c %s "$tmp")
+  if ((size > CAP)); then rm -f "$tmp"; die "over $CAP bytes"; fi
+  mv -f "$tmp" "$1"
+  printf 'stored %s bytes\n' "$size"
+}
+
+PID=''
+running() {
+  local f="$BASE/run/load-$NN.pid"
+  [ -f "$f" ] || return 1
+  PID=$(tr -dc '0-9' < "$f")
+  [ -n "$PID" ] && [ "$(readlink "/proc/$PID/exe" 2> /dev/null)" = "$BIN" ]
+}
+
+case $VERB in
+  token) store "$BASE/tokens/room-$NN.tok" ;;
+  settings) store "$BASE/run/load-$NN.json" ;;
+  start)
+    running && die "load $NN is running already"
+    [ -f "$BASE/run/load-$NN.json" ] && [ -f "$BASE/tokens/room-$NN.tok" ] || die "settings and token first"
+    setsid "$BIN" "$BASE/run/load-$NN.json" < /dev/null > "$BASE/logs/load-$NN.log" 2>&1 &
+    printf '%s\n' "$!" > "$BASE/run/load-$NN.pid"
+    printf 'load %s started\n' "$NN"
+    ;;
+  stop)
+    running || die "load $NN is not running"
+    kill -TERM "$PID"
+    for _ in $(seq 1 20); do kill -0 "$PID" 2> /dev/null || break; sleep 0.5; done
+    if kill -0 "$PID" 2> /dev/null; then kill -KILL "$PID"; printf 'load %s killed after 10 s\n' "$NN"
+    else printf 'load %s stopped\n' "$NN"; fi
+    rm -f "$BASE/run/load-$NN.pid"
+    ;;
+  status) if running; then printf 'load %s running\n' "$NN"; else printf 'load %s stopped\n' "$NN"; fi ;;
+  log) head -c 268435456 -- "$BASE/logs/load-$NN.log" ;;
+  fwcheck)
+    rs=${SSH_CONNECTION%% *}
+    npt_valid_ipv4 "$rs" || die "no RS address in the connection"
+    rc=0
+    timeout 5 bash -c 'exec 3<>"/dev/tcp/$0/22"' "$rs" 2> /dev/null || rc=$?
+    if [ "$rc" -eq 124 ]; then
+      printf 'fwcheck: blocked (LG cannot reach RS port 22: fw-rs is in force)\n'
+    else
+      printf 'fwcheck: OPEN (LG reached RS port 22: fw-rs is NOT in force; stop before any room opens)\n'
+      exit 3
+    fi
+    ;;
+esac
