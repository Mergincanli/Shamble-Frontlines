@@ -0,0 +1,29 @@
+#!/bin/sh
+# pre-push: redact-check on every pushed commit, from a fixed copy outside every worktree (plan.md:1201, :1334;
+# u8-brief.md rev 1.1 Block 8). Git for Windows runs hooks through its own sh. Installed at Stop B: this file into the
+# laptop clone's .git/hooks/pre-push; ops/operator/redact-check.mjs copied to ~/npt-operator/redact-check.mjs; the
+# kept VM addresses, one per line, in ~/npt-operator/vms.txt. EXPECTED is that copy's SHA-256, recorded at Stop B
+# (ops/tests/operator.test.mjs keeps it equal to ops/operator/redact-check.mjs). It refuses the push on a finding, a
+# missing copy or a hash mismatch.
+set -eu
+COPY="$HOME/npt-operator/redact-check.mjs"
+VMS="$HOME/npt-operator/vms.txt"
+EXPECTED=941c692514b7d9a7c65f55f0a2c2d890745b59c10b6b1ecc24beff531c578af2
+
+if [ ! -f "$COPY" ]; then
+  echo "pre-push: no fixed redact-check copy at $COPY: push refused" >&2
+  exit 1
+fi
+GOT=$(sha256sum "$COPY" | cut -d' ' -f1)
+if [ "$GOT" != "$EXPECTED" ]; then
+  echo "pre-push: the fixed copy's SHA-256 is not Stop B's ($GOT): push refused" >&2
+  exit 1
+fi
+set -- --pre-push
+if [ -f "$VMS" ]; then
+  set -- --vms "$VMS" --pre-push
+fi
+if ! node "$COPY" "$@"; then
+  echo "pre-push: redact-check refused this push (findings above)" >&2
+  exit 1
+fi
