new file mode 100644
index 0000000..ade3fdc
--- /dev/null
+++ b/spikes/netcode-proof/crates/client/src/cues.rs
@@ -0,0 +1,101 @@
+//! The client's own cues (u4-build-plan.md §5 U4g: `CueLog`; ADR 0001 part 4; R1-ABL-REC4): an own shot's muzzle flash
+//! and sound, keyed by (entity, weapon, command sequence), play once however often the replay runs the command that
+//! fired it. The room never sends a client its own cosmetic shot events (part 6), so these cues come from the client's
+//! own predictions alone. PM-0001-62's `own_cue` event: one per key and cue kind, written when the key's window closes
+//! (the room ran its command, so no replay can reach it again), with how often it played.
+//!
+//! **PM-0001-62/cues-from-replay** (bites builds only, per instance): the log written from the replays too, so each
+//! replayed shot plays again (u4-build-plan.md §4.14 :504).
+
+use std::collections::VecDeque;
+
+use crate::dist;
+
+/// A cue an own shot plays.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CueKind {
+    /// The muzzle flash.
+    Flash,
+    /// The shot's sound.
+    Sound,
+}
+
+/// One own cue key and kind, closed (PM-0001-62's `own_cue` event).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct OwnCue {
+    /// The entity: the client's soldier, by its slot.
+    pub entity: u16,
+    /// The weapon id (the soldier record's weapon field).
+    pub weapon: u8,
+    /// The command that fired, by the client's 32-bit command counter.
+    pub seq: u32,
+    /// Which cue.
+    pub kind: CueKind,
+    /// How often it played.
+    pub plays: u32,
+}
+
+/// The open keys, oldest first: (command index, entity, weapon, plays), at most `held` (the predictor's command history).
+#[derive(Clone, Debug, Default)]
+pub(crate) struct CueLog {
+    open: VecDeque<(u32, u16, u8, u32)>,
+    from_replay: bool,
+    closed: Vec<OwnCue>,
+}
+
+impl CueLog {
+    /// PM-0001-62/cues-from-replay: the log written from the replays too.
+    #[cfg(feature = "bites")]
+    pub(crate) fn plant_from_replay(&mut self) {
+        self.from_replay = true;
+    }
+
+    /// A prediction of command `index` fired a shot of `entity`'s weapon `weapon`; `replay` when a replay ran it. A key
+    /// plays at the first prediction that fires it, never again (but under the bite); the oldest key closes early when
+    /// `held` are open.
+    pub(crate) fn fired(&mut self, index: u32, entity: u16, weapon: u8, replay: bool, held: usize) {
+        if let Some(open) = self.open.iter_mut().find(|o| o.0 == index) {
+            if replay && self.from_replay {
+                open.3 += 1;
+            }
+            return;
+        }
+        if self.open.len() >= held {
+            self.close_oldest();
+        }
+        self.open.push_back((index, entity, weapon, 1));
+    }
+
+    /// The room ran the client's command `last_run`: every key at or before it closes.
+    pub(crate) fn close_through(&mut self, last_run: u32) {
+        while self.open.front().is_some_and(|o| dist(last_run, o.0) >= 0) {
+            self.close_oldest();
+        }
+    }
+
+    /// Every open key closes (a run's end).
+    pub(crate) fn close_all(&mut self) {
+        while !self.open.is_empty() {
+            self.close_oldest();
+        }
+    }
+
+    fn close_oldest(&mut self) {
+        if let Some((seq, entity, weapon, plays)) = self.open.pop_front() {
+            for kind in [CueKind::Flash, CueKind::Sound] {
+                self.closed.push(OwnCue {
+                    entity,
+                    weapon,
+                    seq,
+                    kind,
+                    plays,
+                });
+            }
+        }
+    }
+
+    /// The cues closed since the last call.
+    pub(crate) fn take(&mut self) -> Vec<OwnCue> {
+        core::mem::take(&mut self.closed)
+    }
+}
