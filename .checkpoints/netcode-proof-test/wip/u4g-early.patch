+/// The reset refuses two records that are not one slot's soldier and own-state records, and changes nothing then.
+#[test]
+fn carry_47_the_reset_refuses_records_of_another_kind_or_slot() {
+    let scene = Scene::stress();
+    let world = World::new(&scene, 7, 0);
+    let (soldier, own) = (
+        record_of(&world, EntityKind::Soldier),
+        record_of(&world, EntityKind::OwnState),
+    );
+    let other = EntityRecord { index: 1, ..own };
+    let far = EntityRecord {
+        index: 64,
+        ..soldier
+    };
+    let mut w = world.clone();
+    for (a, b) in [
+        (own, soldier),
+        (soldier, other),
+        (far, EntityRecord { index: 64, ..own }),
+    ] {
+        assert!(!w.reset_slot(&a, &b, [9; 4]));
+    }
+    assert_eq!(w.dump(), world.dump());
+    assert_eq!(w.slot_records(64), None);
+    assert_eq!(w.slot_records(0), Some([soldier, own]));
+}
