+#[test]
+fn u6c_npt_load_hosts_four_brawlers_over_webtransport_and_ends_at_its_duration() {
+    hosts_four("wt", 5);
+}
+
+#[test]
+fn u6c_npt_load_hosts_four_brawlers_over_websocket_and_ends_at_the_rooms_close() {
+    hosts_four("ws", 30);
+}
