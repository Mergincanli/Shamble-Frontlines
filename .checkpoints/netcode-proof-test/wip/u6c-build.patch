+/// stdin that never yields, until the test ends.
+struct Never(std::sync::mpsc::Receiver<()>);
+impl Read for Never {
+    fn read(&mut self, _: &mut [u8]) -> io::Result<usize> {
+        let _ = self.0.recv();
+        Ok(0)
+    }
+}
