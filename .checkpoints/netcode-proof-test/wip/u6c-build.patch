+    /// Parses and range-checks one settings text (SEC-U6AD-2's rules).
+    pub fn parse(text: &[u8]) -> Result<LoadSettings, String> {
+        let s: LoadSettings =
+            serde_json::from_slice(text).map_err(|e| format!("the settings: {e}"))?;
+        let m = &s.machine;
+        let texts = [
+            &s.room,
+            &s.server,
+            &s.mode,
+            &s.transport,
+            &s.token_path,
+            &s.log_path,
+            &s.run,
