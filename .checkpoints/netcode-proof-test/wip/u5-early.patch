+test("the fuzz crate is read as crates/ is: no relaxing, no unsafe, no export or extern of its own, one fuzz_target! per target file and no other libfuzzer_sys macro, no build script; each plant fails by name (U5-Q7 term 1; the advisor's SEC-U5D-1 ruling)", () => {
+  const T = "fuzz/fuzz_targets/input.rs";
