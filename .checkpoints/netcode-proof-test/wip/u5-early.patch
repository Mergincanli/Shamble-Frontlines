+  const fuzzWith = (files) => unsafeWith((f) => Object.assign(f, { "fuzz/Cargo.toml": manifest, [T]: FUZZ_TARGET }, files));
+  assert.deepEqual(fuzzWith({}), [], "a clean target");
+  const refused = (at, name) => `${at} names \`${name}\`, which the fuzz crate may not: ${FUZZ_WHY_TEXT}`;
+  const end = FUZZ_TARGET.split("\n").length;
