diff --git a/spikes/netcode-proof/fuzz/Cargo.toml b/spikes/netcode-proof/fuzz/Cargo.toml
new file mode 100644
index 0000000..c96329c
--- /dev/null
+++ b/spikes/netcode-proof/fuzz/Cargo.toml
@@ -0,0 +1,189 @@
+# The netcode proof test's fuzz crate (U5; PM-0001-34, plan §4.7 and §4.8): cargo-fuzz's targets, built and run on a
+# dated nightly (`cargo +nightly-2026-11-01 fuzz ...`; rust-toolchain.toml keeps everything else on 1.99.1), with
+# --locked. Not a member of the spike's workspace (its Cargo.toml excludes fuzz/): a workspace of its own, below, so its
+# instrumented nightly builds never change the workspace's resolve. Its Cargo.lock began as a copy of the workspace's,
+# then gained only libfuzzer-sys and its own dependencies by a minimal resolve (never `generate-lockfile`): every
+# package both locks hold has one version and checksum (check.mjs checks it), and the audits read both locks
+# (u5-brief.md Block 0; ADV-U5B-3).
+[package]
+name = "npt-fuzz"
+description = "The decoder fuzz targets (PM-0001-34) and DelayStream's scanner target, counted by npt-alloc's window"
+version = "0.0.0"
+edition = "2024"
+rust-version = "1.99.1"
+publish = false
+
+[package.metadata]
+cargo-fuzz = true
+
+# Its own workspace, so cargo never takes it for a member of the spike's (cargo-fuzz's form).
+[workspace]
+members = ["."]
+resolver = "3"
+
+# The workspace's lints, key for key (U5-Q7 term 1; check.mjs compares the tables): outside the spike's workspace,
+# `workspace = true` would name this workspace's own, empty table. unsafe_code is forbid: no #[allow] here can relax it.
+# libfuzzer-sys's `fuzz_target!` expands in this crate (the exported entry each target links to libFuzzer), and rustc
+# does not lint code another crate's macro builds, so the read of that expansion at Block 0 is the check there (U5-Q7
+# term 3).
+[lints.rust]
+unsafe_code = "forbid"
+
+[lints.clippy]
+disallowed_types = "deny"
+disallowed_methods = "deny"
+iter_over_hash_type = "deny"
+
+[features]
+# The bites build (plan §4.7; U5-Q6): npt-proto's planted defects (PM-0001-34/unchecked-index among them), one chosen
+# at run time by NPT_BITE, read once at a target's start; a build without this feature that sees NPT_BITE set refuses
+# to start.
+bites = ["npt-proto/bites"]
+
+[dependencies]
+# libFuzzer's driver and `fuzz_target!` (cargo-fuzz's runtime crate). Its exact version and its own dependencies are the
+# minimal resolve's, read with their sources before anything is built (DEP-HOLD; u5-brief.md Block 0).
+libfuzzer-sys = "0.4"
+# The spike's own crates, by path, at the workspace's lock entries: the decoders (npt-proto, with npt-link's
+# `Channel`), the client's receive path and the fixed joined state it starts from (npt-client, npt-room, npt-sim's
+# stress scene), DelayStream's request and frame scanner (npt-net's `fuzz` entry) and the counting allocator.
+npt-alloc = { path = "../crates/alloc" }
+npt-client = { path = "../crates/client" }
+npt-link = { path = "../crates/link" }
+npt-net = { path = "../crates/net", features = ["fuzz"] }
+npt-proto = { path = "../crates/proto" }
+npt-room = { path = "../crates/room" }
+npt-sim = { path = "../crates/sim" }
+# The seed generator's draws (every draw seeded and recorded), at the workspace's pins: already in both locks.
+rand_chacha = { version = "=0.10.0", default-features = false }
+rand_core = { version = "=0.10.1", default-features = false }
+
+# One target per [[bin]] (cargo-fuzz's form: no test, doc or bench build of a target); the code they share is the
+# crate's library. The 14 parts of PM-0001-34 (Ping and Pong each on both receivers' ways), SessionStatus and
+# RoomControl (U5-Q1), then the three with state: Snapshot and FullState through npt-client's receive path, and
+# DelayStream's scanner in both directions with S2's differential.
+[[bin]]
+name = "input"
+path = "fuzz_targets/input.rs"
+test = false
+doc = false
+bench = false
+
+[[bin]]
+name = "resync"
+path = "fuzz_targets/resync.rs"
+test = false
+doc = false
+bench = false
+
+[[bin]]
+name = "ping"
+path = "fuzz_targets/ping.rs"
+test = false
+doc = false
+bench = false
+
+[[bin]]
+name = "pong"
+path = "fuzz_targets/pong.rs"
+test = false
+doc = false
+bench = false
+
+[[bin]]
+name = "join"
+path = "fuzz_targets/join.rs"
+test = false
+doc = false
+bench = false
+
+[[bin]]
+name = "join_accepted"
+path = "fuzz_targets/join_accepted.rs"
+test = false
+doc = false
+bench = false
+
+[[bin]]
+name = "join_rejected"
+path = "fuzz_targets/join_rejected.rs"
+test = false
+doc = false
+bench = false
+
+[[bin]]
