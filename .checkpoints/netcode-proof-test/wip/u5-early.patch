+test("npt-alloc, the fourth exception: one allow on its one unsafe impl GlobalAlloc, all its unsafe inside it, the clippy deny at its root; each plant fails by name (U5; the advisor's U5-Q3 ruling)", () => {
+  const F = ALLOC_UNSAFE_FILE;
+  const where = `the one \`unsafe impl GlobalAlloc for <type>\` in ${F}`;
+  const relaxes = (at, on) => `${at} relaxes unsafe_code on ${on}; npt-alloc may only put #[allow(unsafe_code, reason = "...")] directly on ${where}`;
+  const sites = (k) => `npt-alloc's unsafe impl GlobalAlloc has ${k} #[allow(unsafe_code, reason = ...)] attributes, not 1`;
+  const end = ALLOC_LIB.split("\n").length;
+  const allowAt = ALLOC_LIB.split("\n").indexOf("#[allow(") + 1;
+  const impl = "`unsafe impl GlobalAlloc for Counting {`";
+  // An unsafe block or an unsafe fn outside the impl, in lib.rs or another file of the crate.
+  assert.deepEqual(unsafeWith((f) => (f[F] = `${ALLOC_LIB}fn stray() {\n    unsafe {}\n}\n`)), [`${F}:${end + 1} has \`unsafe\` outside ${where}`]);
+  assert.deepEqual(unsafeWith((f) => (f["crates/alloc/tests/t.rs"] = "unsafe fn f() {}\n")), [`crates/alloc/tests/t.rs:1 has \`unsafe\` outside ${where}`]);
+  // A second allow on the impl, or a second impl with its own.
+  assert.deepEqual(unsafeWith((f) => (f[F] = ALLOC_LIB.replace(ALLOC_HEAD, `${ALLOC_ALLOW}${ALLOC_HEAD}`))), [sites(2)]);
+  assert.deepEqual(unsafeWith((f) => (f[F] = `${ALLOC_LIB}${ALLOC_ALLOW}unsafe impl GlobalAlloc for Other {\n}\n`)), [sites(2)]);
+  // An allow with an empty reason, or one that says nothing: not the placed form, so the impl's unsafe is outside too.
+  for (const reason of ['""', '"\\n"']) {
+    const p = unsafeWith((f) => (f[F] = ALLOC_LIB.replace(ALLOC_ALLOW, `#[allow(unsafe_code, reason = ${reason})]\n`)));
+    assert.ok(p.includes(relaxes(`${F}:${allowAt}`, impl)) && p.includes(sites(0)), `${reason}: ${p.join("\n")}`);
+    assert.ok(p.some((x) => x.endsWith(`has \`unsafe\` outside ${where}`)), p.join("\n"));
+  }
+  // The allow moved to a helper, given as expect, or as an inner attribute.
+  const moved = unsafeWith((f) => (f[F] = ALLOC_LIB.replace(ALLOC_ALLOW, "").replace("fn note(", `${ALLOC_ALLOW}fn note(`)));
+  const noteAt = ALLOC_LIB.split("\n").indexOf("fn note(size: usize) {") + 1;
+  assert.ok(moved.includes(relaxes(`${F}:${noteAt}`, "`fn note(size: usize) {`")) && moved.includes(sites(0)), moved.join("\n"));
+  const expected = unsafeWith((f) => (f[F] = ALLOC_LIB.replace(ALLOC_ALLOW, ALLOC_ALLOW.replace("#[allow(", "#[expect("))));
+  assert.ok(expected.includes(relaxes(`${F}:${allowAt}`, impl)) && expected.includes(sites(0)), expected.join("\n"));
+  const inner = unsafeWith((f) => (f["crates/alloc/tests/t.rs"] = "#![allow(unsafe_code)]\n"));
+  assert.deepEqual(inner, [relaxes("crates/alloc/tests/t.rs:1", "its whole module or crate (#!)")]);
+  // unsafe_code named in code outside an attribute (a macro could build the attribute from it).
+  assert.deepEqual(unsafeWith((f) => (f[F] = `${ALLOC_LIB}const N: &str = stringify!(unsafe_code);\n`)), [
+    `${F}:${end} names unsafe_code outside an attribute (a macro can build the attribute from it)`,
+  ]);
+  // The crate-level deny of the two clippy lints: missing, or one of them relaxed in another file.
+  assert.deepEqual(unsafeWith((f) => (f[F] = ALLOC_LIB.replace(DENY, ""))), [
+    `${F} does not deny clippy::undocumented_unsafe_blocks and clippy::multiple_unsafe_ops_per_block at the crate root`,
+  ]);
+  assert.deepEqual(unsafeWith((f) => (f["crates/alloc/tests/t.rs"] = "#![allow(clippy::undocumented_unsafe_blocks)]\n")), [
+    `crates/alloc/tests/t.rs:1 names clippy's undocumented_unsafe_blocks outside ${F}'s crate-level deny (relaxing it would let an unsafe block go without its SAFETY comment or hold more than one unsafe operation)`,
+  ]);
+});
