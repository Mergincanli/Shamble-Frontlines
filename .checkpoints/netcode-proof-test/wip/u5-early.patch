+[package]
+name = "npt-alloc"
+description = "A counting global allocator over System, for the tests and the fuzz harness: per-thread windows of count, bytes and largest request"
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+publish.workspace = true
+
+# Not `workspace = true`: the workspace forbids unsafe_code, which no #[allow] can relax (E0453), and an implementation
+# of GlobalAlloc is unsafe code. So this crate has its own tables, as npt-tcpinfo and npt-hash-wasm have (the spike's
+# fourth unsafe exception, ADR 0002:269: "an exception needs a written invariant, a test and an `#[allow]` with its
+# reason"; the advisor's U5-Q3 ruling): [lints.rust] denies the lint, so the one `unsafe impl GlobalAlloc` over `System`
+# in src/lib.rs can carry one #[allow(unsafe_code, reason = "...")], and nothing else in the crate relaxes it. Every
+# other lint is the workspace's, key for key. check.mjs's deps step checks the level, the tables against the
+# workspace's key for key (it refuses a lint given in any form its reader does not read), and where the allow sits.
+[lints.rust]
+unsafe_code = "deny"
+
+[lints.clippy]
+disallowed_types = "deny"
+disallowed_methods = "deny"
+iter_over_hash_type = "deny"
+
+# std only: no dependency, no build script and no `build` or `include` key (U5-Q3 term 2; check.mjs's
+# DENY_EXCEPTION_WHY). At U5 only dev dependencies (npt-sim's and npt-proto's tests) and the fuzz crate depend on it; a
+# normal dependency (U6's PM-0006-20) is U6's change, with its own read (U5-Q3 term 4).
diff --git a/spikes/netcode-proof/crates/alloc/src/lib.rs b/spikes/netcode-proof/crates/alloc/src/lib.rs
