+  for (const [line, name] of [
+    ["fuzz_mutator!(|d: &mut [u8], s: usize, m: usize, seed: u32| s);", "fuzz_mutator"],
+    ["fuzz_crossover!(|a: &[u8], b: &[u8], out: &mut [u8], seed: u32| 0);", "fuzz_crossover"],
+    ['#[export_name = "x"]\npub fn x() {}', "export_name"],
+    ['#[link_section = ".x"]\nstatic X: u8 = 0;', "link_section"],
+    ['extern "C" {\n}', "extern"],
+    ["#[macro_use]\nmod m {}", "macro_use"],
+  ]) {
+    assert.deepEqual(fuzzWith({ [T]: `${FUZZ_TARGET}${line}\n` }), [refused(`${T}:${end}`, name)], line);
+  }
+  const unsafeIn = (at) => `${at} has unsafe code (1 \`unsafe\` or \`global_asm\`; only npt-client-wasm, npt-tcpinfo, npt-hash-wasm and npt-alloc may)`;
+  assert.deepEqual(fuzzWith({ [T]: `${FUZZ_TARGET}#[unsafe(no_mangle)]\npub extern "C" fn x() {}\n` }), [
+    unsafeIn(`${T}:${end}`),
+    refused(`${T}:${end}`, "no_mangle"),
+    refused(`${T}:${end + 1}`, "extern"),
+  ]);
+  // An unsafe block or an unsafe fn, and a relaxing attribute, as in any crate under the forbid.
+  assert.deepEqual(fuzzWith({ "fuzz/src/lib.rs": "pub fn f() {\n    unsafe {}\n}\n" }), [unsafeIn("fuzz/src/lib.rs:2")]);
+  assert.deepEqual(fuzzWith({ "fuzz/src/lib.rs": "unsafe fn f() {}\n" }), [unsafeIn("fuzz/src/lib.rs:1")]);
+  assert.deepEqual(fuzzWith({ "fuzz/src/lib.rs": "#![allow(unsafe_code)]\n" }), [
+    "fuzz/src/lib.rs relaxes unsafe_code (only npt-client-wasm, npt-tcpinfo, npt-hash-wasm and npt-alloc may)",
+  ]);
+  // libfuzzer_sys named other than as the path libfuzzer_sys::fuzz_target: a glob, a group, a rename, another item.
+  const named = (at) =>
+    `${at} names libfuzzer_sys other than as the path libfuzzer_sys::fuzz_target (a glob, a group, a rename, another item or extern crate): ${FUZZ_WHY_TEXT}`;
+  for (const form of ["use libfuzzer_sys::*;", "use libfuzzer_sys::{fuzz_target};", "use libfuzzer_sys::fuzz_target as ft;", "use libfuzzer_sys as lf;", "use libfuzzer_sys::Corpus;"]) {
+    assert.deepEqual(fuzzWith({ [T]: FUZZ_TARGET.replace("use libfuzzer_sys::fuzz_target;", form) }), [named(`${T}:3`)], form);
+  }
+  assert.deepEqual(fuzzWith({ [T]: FUZZ_TARGET.replace("use libfuzzer_sys::fuzz_target;", "extern crate libfuzzer_sys;") }), [refused(`${T}:3`, "extern"), named(`${T}:3`)]);
+  assert.deepEqual(fuzzWith({ [T]: FUZZ_TARGET.replace("use libfuzzer_sys::fuzz_target;\n\nfuzz_target!", "libfuzzer_sys::fuzz_target!") }), [], "the call by its path");
+  // fuzz_target! once in each target file and nowhere else.
+  const callsIn = (at, k) => `${at} calls fuzz_target! ${k} times, not once: ${FUZZ_WHY_TEXT}`;
+  assert.deepEqual(fuzzWith({ [T]: FUZZ_TARGET.replace(/fuzz_target!\(\|data: &\[u8\]\| \{\n {4}let _ = data;\n\}\);\n/, "") }), [callsIn(T, 0)]);
+  assert.deepEqual(fuzzWith({ [T]: `${FUZZ_TARGET}fuzz_target!(|data: &[u8]| {});\n` }), [callsIn(T, 2)]);
+  for (const f of ["fuzz/src/lib.rs", "fuzz/fuzz_targets/sub/x.rs", "fuzz/examples/seeds.rs"]) {
+    assert.deepEqual(fuzzWith({ [f]: "fuzz_target!(|data: &[u8]| {});\n" }), [`${f}:1 calls fuzz_target! outside fuzz/fuzz_targets/<name>.rs: ${FUZZ_WHY_TEXT}`], f);
+  }
