+
+# As the workspace (plan §4.5; ADR 0002 part 2): overflow checks stay on for the sim and the protocol in the release
+# profile cargo-fuzz builds with, as in the measured builds.
+[profile.release.package.npt-sim]
+overflow-checks = true
+[profile.release.package.npt-proto]
+overflow-checks = true
