index 0000000..9759875
--- /dev/null
+++ b/spikes/netcode-proof/crates/alloc/src/lib.rs
@@ -0,0 +1,144 @@
+//! npt-alloc: a global allocator that counts, for the tests and the fuzz harness (U5; the advisor's U5-Q3 ruling).
+//!
+//! [`Counting`] is System's allocator with one addition: each memory request made on a thread while that thread's
+//! window is open is noted there. [`start`] opens the calling thread's window at zero, [`stop`] closes it and gives
+//! what it saw as [`Counts`]: how many requests, their bytes summed and the largest single one. An `alloc` or
+//! `alloc_zeroed` is one request of its size; a `realloc` is one request of its new size (a vector grown by `push`
+//! reaches its largest size by realloc: u5-alloc-bounds.md:105-107); a `dealloc` is none. Another thread's requests
+//! never reach a window, and nothing is counted while no window is open. A test or fuzz binary installs it with
+//! `#[global_allocator] static ALLOC: npt_alloc::Counting = npt_alloc::Counting;`. The allocator only counts: what a
+//! count means (a bar, a refusal) is its caller's to decide, after [`stop`], never inside an allocation.
+//!
+//! **The spike's fourth `unsafe` exception** (after npt-client-wasm, npt-tcpinfo and npt-hash-wasm), under ADR
+//! 0002:269's rule: "an exception needs a written invariant, a test and an `#[allow]` with its reason". The
+//! `#[allow(unsafe_code, reason = ...)]` sits on the one `unsafe impl GlobalAlloc` below and nowhere else in the crate;
+//! the workspace forbids unsafe_code, which no allow can relax, so this crate's manifest has its own lint tables:
+//! unsafe_code denied, every other lint the workspace's. Each unsafe block holds one unsafe operation and a SAFETY
+//! comment (the two clippy lints below are errors). The invariant: every method hands its arguments to System's same
+//! method unchanged and returns System's result, so every pointer this allocator gives out is System's and goes back to
+//! System with the layout it was made with; and counting never allocates, never re-enters the allocator and never
+//! unwinds, since it only reads and writes a `Copy` value in a const-initialised thread-local that has no destructor.
+//! The tests (tests/window.rs) show each count. check.mjs's deps step checks that the crate ships with no dependency and
+//! no member ships it, that its lint tables are the workspace's key for key but for unsafe_code "deny", that it has no
+//! build script, and, as its scan reads the crate's files, that the one attribute sits on that impl and no other
+//! relaxing attribute exists here, that every `unsafe` in the crate lies inside that impl, and that the two clippy lints
+//! below stay denied here and relaxed nowhere.
+
+#![deny(
+    clippy::undocumented_unsafe_blocks,
+    clippy::multiple_unsafe_ops_per_block
+)]
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::Cell;
+
+/// What a window saw: the memory requests made on its thread while it was open.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Counts {
+    /// The requests: each `alloc`, `alloc_zeroed` and `realloc` is one; a `dealloc` is none.
+    pub allocations: u64,
+    /// Their sizes summed, a `realloc` at its new size.
+    pub bytes: u64,
+    /// The largest single request.
+    pub largest: u64,
+}
+
+/// No request seen.
+const ZERO: Counts = Counts {
+    allocations: 0,
+    bytes: 0,
+    largest: 0,
+};
+
+/// One thread's window: whether it is open, and what it has seen since it opened.
+#[derive(Clone, Copy)]
+struct Window {
+    open: bool,
+    counts: Counts,
+}
+
+thread_local! {
+    /// The calling thread's window. Const-initialised, and `Window` has no destructor, so reading or writing it never
+    /// allocates and never fails, even while the thread's other thread-locals are being torn down.
+    static WINDOW: Cell<Window> = const { Cell::new(Window { open: false, counts: ZERO }) };
+}
+
+/// Opens the calling thread's window, its counts at zero; a window already open starts again from zero.
+pub fn start() {
+    let _ = WINDOW.try_with(|w| {
+        w.set(Window {
+            open: true,
+            counts: ZERO,
+        });
+    });
+}
+
+/// Closes the calling thread's window and gives what it saw since [`start`] (zero when no window was open).
+#[must_use]
+pub fn stop() -> Counts {
+    WINDOW
+        .try_with(|w| {
+            let seen = w.get().counts;
+            w.set(Window {
+                open: false,
+                counts: ZERO,
+            });
+            seen
+        })
+        .unwrap_or(ZERO)
+}
+
+/// Notes one request of `size` bytes in the calling thread's window, if it is open. Saturating arithmetic on `Copy`
+/// values in a `Cell`: no allocation, no panic.
+fn note(size: usize) {
+    let _ = WINDOW.try_with(|w| {
+        let mut now = w.get();
+        if now.open {
+            let size = size as u64;
+            now.counts.allocations = now.counts.allocations.saturating_add(1);
+            now.counts.bytes = now.counts.bytes.saturating_add(size);
+            now.counts.largest = now.counts.largest.max(size);
+            w.set(now);
+        }
+    });
+}
+
+/// The counting allocator: System's, with each request noted in the calling thread's window (see the crate's doc).
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Counting;
+
+#[allow(
+    unsafe_code,
+    reason = "the fourth exception (ADR 0002:269): GlobalAlloc is an unsafe trait; this impl hands every call to \
+              System unchanged and only notes the request in a const thread-local"
+)]
+// SAFETY: every method passes its arguments to System's same method unchanged and returns System's result, so each
+// pointer this allocator gives out is System's and comes back to System with the layout it was made with, and System
+// meets GlobalAlloc's contract. `note` touches only a `Copy` value in a const thread-local with no destructor: it never
+// allocates, never re-enters the allocator and never unwinds.
+unsafe impl GlobalAlloc for Counting {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        note(layout.size());
+        // SAFETY: the caller meets `alloc`'s contract for `layout` (a non-zero size), which is System's contract too.
+        unsafe { System.alloc(layout) }
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        note(layout.size());
+        // SAFETY: the caller meets `alloc_zeroed`'s contract for `layout` (a non-zero size), which is System's too.
+        unsafe { System.alloc_zeroed(layout) }
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        // SAFETY: the caller gives a pointer this allocator returned for `layout`; every such pointer is System's, made
+        // for that same layout (alloc, alloc_zeroed and realloc return System's results unchanged).
+        unsafe { System.dealloc(ptr, layout) }
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        note(new_size);
+        // SAFETY: as for dealloc, `ptr` is System's, made for `layout`; the caller meets `realloc`'s contract for
+        // `new_size` (non-zero, no overflow when rounded to the alignment), which is System's too.
+        unsafe { System.realloc(ptr, layout, new_size) }
+    }
+}
diff --git a/spikes/netcode-proof/crates/alloc/tests/window.rs b/spikes/netcode-proof/crates/alloc/tests/window.rs
