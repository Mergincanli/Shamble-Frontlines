+/// A server-side WsLink whose gate reads fixed inputs (the tests set them), and its raw client.
+async fn fixed_link(
+    seed: u64,
+) -> (
+    WsLink,
+    Arc<Mutex<Inputs>>,
+    crate::l2::delay::tests::ClientWs,
+) {
+    fixed_link_at(seed, GATE).await
+}
