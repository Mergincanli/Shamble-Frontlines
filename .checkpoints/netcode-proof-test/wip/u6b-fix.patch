+            .map(|r| tick_record(r, 2).v["ws_skipped_snaps_count"])
+            .sum::<i64>();
+    }
+    let ticks = ticks.lock().unwrap_or_else(PoisonError::into_inner).clone();
+    let outside = outside
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .clone();
