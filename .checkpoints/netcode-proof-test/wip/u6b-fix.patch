+//! The certificate pin (u6b-brief.md Block 1; tls_test.rs's `Pinned` promoted to shipped code): a client accepts the
+//! one server certificate whose SHA-256 equals a given 32 B hash, as a browser's `serverCertificateHashes` does, and
+//! still checks the handshake's signature through the provider's own algorithms. Both native clients (WtClient,
+//! WsClient) use it, on ring, TLS 1.3 only.
+
+use std::sync::Arc;
+
+use tokio_rustls::rustls;
+use tokio_rustls::rustls::client::danger::{
+    HandshakeSignatureValid, ServerCertVerified, ServerCertVerifier,
+};
+use tokio_rustls::rustls::crypto::CryptoProvider;
+use tokio_rustls::rustls::pki_types::{CertificateDer, ServerName, UnixTime};
+use tokio_rustls::rustls::{DigitallySignedStruct, SignatureScheme};
+
+/// SHA-256 of `bytes`, through ring's TLS 1.3 suite's own hash (no hashing crate of npt-net's own).
+pub(crate) fn sha256(bytes: &[u8]) -> [u8; 32] {
+    let mut out = [0u8; 32];
+    if let Some(suite) = rustls::crypto::ring::cipher_suite::TLS13_AES_128_GCM_SHA256.tls13() {
+        out.copy_from_slice(suite.common.hash_provider.hash(bytes).as_ref());
+    }
+    out
+}
+
+/// Accepts exactly the certificate whose SHA-256 is `hash`, and checks the handshake's signature with the provider's
+/// algorithms.
+#[derive(Debug)]
+struct Pinned {
+    hash: [u8; 32],
+    provider: Arc<CryptoProvider>,
+}
+
+impl ServerCertVerifier for Pinned {
+    fn verify_server_cert(
+        &self,
+        end_entity: &CertificateDer<'_>,
+        _intermediates: &[CertificateDer<'_>],
+        _server_name: &ServerName<'_>,
+        _ocsp: &[u8],
+        _now: UnixTime,
+    ) -> Result<ServerCertVerified, rustls::Error> {
+        if sha256(end_entity.as_ref()) == self.hash {
+            Ok(ServerCertVerified::assertion())
+        } else {
+            Err(rustls::Error::General("not the pinned certificate".into()))
+        }
+    }
+
+    fn verify_tls12_signature(
+        &self,
+        _message: &[u8],
+        _cert: &CertificateDer<'_>,
+        _dss: &DigitallySignedStruct,
+    ) -> Result<HandshakeSignatureValid, rustls::Error> {
+        Err(rustls::Error::General("TLS 1.2 is not offered".into()))
+    }
+
+    fn verify_tls13_signature(
+        &self,
+        message: &[u8],
+        cert: &CertificateDer<'_>,
+        dss: &DigitallySignedStruct,
+    ) -> Result<HandshakeSignatureValid, rustls::Error> {
+        rustls::crypto::verify_tls13_signature(
+            message,
+            cert,
+            dss,
+            &self.provider.signature_verification_algorithms,
+        )
+    }
+
+    fn supported_verify_schemes(&self) -> Vec<SignatureScheme> {
+        self.provider
+            .signature_verification_algorithms
+            .supported_schemes()
+    }
+}
+
+/// A client's TLS: TLS 1.3 through `provider`, ALPN `alpn`, the server's certificate pinned by its SHA-256 `hash`.
+pub(crate) fn client_config(
+    provider: CryptoProvider,
+    hash: [u8; 32],
+    alpn: &[u8],
+) -> std::io::Result<rustls::ClientConfig> {
+    let provider = Arc::new(provider);
+    let mut tls = rustls::ClientConfig::builder_with_provider(Arc::clone(&provider))
+        .with_protocol_versions(&[&rustls::version::TLS13])
+        .map_err(std::io::Error::other)?
+        .dangerous()
+        .with_custom_certificate_verifier(Arc::new(Pinned { hash, provider }))
+        .with_no_client_auth();
+    tls.alpn_protocols = vec![alpn.to_vec()];
+    Ok(tls)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// FIPS 180-2's "abc" vector, its first and last 8 bytes (a whole 64-digit literal reads as a secret to
+    /// redact-check): the hash the pin compares is SHA-256.
+    #[test]
+    fn u6b_the_pin_hashes_with_sha_256() {
+        let got = sha256(b"abc");
+        assert_eq!(got[..8], [0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea]);
+        assert_eq!(got[24..], [0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad]);
+    }
+
+    /// SEC-U6B-4 (P19's test): the pin still checks the handshake's signature: a server presenting the pinned
+    /// certificate with its own key is taken; with another key (a replayed public certificate) it is refused.
+    #[tokio::test(flavor = "current_thread")]
+    async fn u6b_the_pin_refuses_the_pinned_certificate_signed_with_another_key() {
+        use rustls::pki_types::{PrivateKeyDer, PrivatePkcs8KeyDer};
+        use rustls::server::{ClientHello, ResolvesServerCert};
+        use rustls::sign::CertifiedKey;
+        #[derive(Debug)]
+        struct Fixed(Arc<CertifiedKey>);
+        impl ResolvesServerCert for Fixed {
+            fn resolve(&self, _: ClientHello<'_>) -> Option<Arc<CertifiedKey>> {
+                Some(Arc::clone(&self.0))
+            }
+        }
+        let provider = rustls::crypto::ring::default_provider();
+        let (cert, own) = crate::l2::tls_test::self_signed(&provider);
+        // Another Ed25519 key: the same PKCS#8 prefix (RFC 8410), another seed.
+        let mut other = own.secret_der()[..16].to_vec();
+        other.extend([7u8; 32]);
+        let other = PrivateKeyDer::Pkcs8(PrivatePkcs8KeyDer::from(other));
+        for (key, taken) in [(own, true), (other, false)] {
+            let signer = provider.key_provider.load_private_key(key).expect("a key");
+            let ck = Arc::new(CertifiedKey::new(vec![cert.clone()], signer));
+            let server = rustls::ServerConfig::builder_with_provider(Arc::new(provider.clone()))
+                .with_protocol_versions(&[&rustls::version::TLS13])
+                .expect("TLS 1.3")
+                .with_no_client_auth()
+                .with_cert_resolver(Arc::new(Fixed(ck)));
+            let client =
+                client_config(provider.clone(), sha256(cert.as_ref()), b"h3").expect("TLS");
+            let (c, s) = tokio::io::duplex(16_384);
+            let name = ServerName::try_from("localhost").expect("a name");
+            let (got, _) = tokio::join!(
+                tokio_rustls::TlsConnector::from(Arc::new(client)).connect(name, c),
+                tokio_rustls::TlsAcceptor::from(Arc::new(server)).accept(s),
+            );
+            assert_eq!(got.is_ok(), taken, "own key: {taken}");
+        }
+    }
+}
diff --git a/spikes/netcode-proof/crates/net/src/session.rs b/spikes/netcode-proof/crates/net/src/session.rs
new file mode 100644
index 0000000..bfe90ca
--- /dev/null
+++ b/spikes/netcode-proof/crates/net/src/session.rs
@@ -0,0 +1,198 @@
+//! What both transports share (u6b-brief.md Blocks 1-3): the listener's settings, an accepted session, a session's
+//! bounded inbox, its closed flag and a server's counts.
+//!
+//! **Stamps (Block 1):** both servers take the caller's clock as `fn() -> u64` (npt-server passes its room clock, the
+//! tests an injected one) and the deadline as a value. Each message's `Recv::arrival_ns` is read by the session's
+//! reader task when the message has arrived, never at `poll_recv`; each session carries its accept stamp (the first
+//! QUIC packet or the TCP accept) to the room, whose Join deadline runs from it (plan.md:516). DelayStream keeps its own
+//! clock for its own stamps; the two are never mixed.
+
+use std::net::SocketAddr;
+use std::sync::Arc;
+use std::sync::atomic::Ordering::Relaxed;
+use std::sync::atomic::{AtomicBool, AtomicU64};
+use std::time::Duration;
+
+use npt_link::{Channel, Link, Recv};
+use tokio::sync::mpsc;
+
+use crate::cap::ConnCap;
+
+/// How a server listens: its address, the room's clock, the handshake deadline (ns, from the accept stamp: TLS, the
+/// upgrade or HTTP/3, and the hand-off to the room) and the process's connection cap.
+/// The last two are the caller's values for fix 1's gate (WebSocket only; npt-net names no npt-sim or npt-proto item):
+/// `tick_ns` the room's tick period, in which the snapshot budget N counts (NR-U6B-2; npt-server passes
+/// 1,000,000,000 / `npt_sim::TICK_HZ`), and `outside_max` the largest datagram written outside an announced tick, the
+/// room's own Ping or Pong (R-PING; npt-server passes npt-proto's `Limits::PING` and `Limits::PONG`, 32 B).
+#[derive(Debug, Clone)]
+pub struct Listen {
+    pub addr: SocketAddr,
+    pub clock: fn() -> u64,
+    pub deadline_ns: u64,
+    pub cap: Arc<ConnCap>,
+    pub tick_ns: u64,
+    pub outside_max: usize,
+}
+
+/// One session a server accepted: its link, its peer's address and its accept stamp on the room's clock.
+pub struct Accepted {
+    pub link: Box<dyn Link + Send>,
+    pub peer: SocketAddr,
+    pub accept_ns: u64,
+}
+
+impl std::fmt::Debug for Accepted {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("Accepted")
+            .field("peer", &self.peer)
+            .field("accept_ns", &self.accept_ns)
+            .finish_non_exhaustive()
+    }
+}
+
+/// Accepted sessions waiting for the room, at most this many per server.
+pub(crate) const PENDING: usize = 64;
+/// Messages a session's inbox holds: a full one drops a datagram (counted) and stops reading a stream (the transport's
+/// flow control then holds the peer).
+pub(crate) const INBOX: usize = 256;
+/// The bytes a session's send queue holds above the transport (tungstenite's 128 KB bound, the catalogue's: it holds
+/// a 65,541 B FullState); a reliable message beyond it is `BufferFull`.
+pub(crate) const SEND_QUEUE_BYTES: u64 = 128 * 1024;
+
+/// The reader tasks' end of a session's inbox.
+#[derive(Clone)]
+pub(crate) struct InboxTx {
+    tx: mpsc::Sender<Recv>,
+    clock: fn() -> u64,
+    dropped: Arc<AtomicU64>,
+}
+
+impl InboxTx {
+    /// A datagram that has just arrived, stamped now: dropped and counted when the inbox is full.
+    pub(crate) fn datagram(&self, bytes: Vec<u8>) {
+        let r = Recv {
+            channel: Channel::Datagram,
+            bytes,
+            arrival_ns: (self.clock)(),
+        };
+        if self.tx.try_send(r).is_err() {
+            self.dropped.fetch_add(1, Relaxed);
+        }
+    }
+
+    /// A stream message that has just arrived, stamped now; waits for room (so the reader stops reading). False once
+    /// the link is gone.
+    pub(crate) async fn stream(&self, channel: Channel, bytes: Vec<u8>) -> bool {
+        let r = Recv {
+            channel,
+            bytes,
+            arrival_ns: (self.clock)(),
+        };
+        self.tx.send(r).await.is_ok()
+    }
+}
+
+/// A session's inbox (the link's end).
+pub(crate) fn inbox(
+    clock: fn() -> u64,
+    dropped: Arc<AtomicU64>,
+) -> (InboxTx, mpsc::Receiver<Recv>) {
+    let (tx, rx) = mpsc::channel(INBOX);
+    (InboxTx { tx, clock, dropped }, rx)
+}
+
+/// The one bound on a link's closing, from its drop (SEC-U6B-1): the drain of its queue, the closing handshake (the
+/// control stream's finish and acknowledgement; the Close frame, the peer's, TLS's close_notify) and the close, on both
+/// transports. 2 s (WebTransport's wait as built; WebSocket's was 10 s, for its closing handshake alone): a queued
+/// `Kick` and the handshake take two or three round trips, 0.6 s at P4's 200 ms before a loss's retransmission (the kick
+/// tests run at P2), while a peer that withholds stream credit or stops reading holds a permit at most 2 s past the
+/// drop, the handshake deadline's own scale.
+pub(crate) const CLOSE_WAIT: Duration = Duration::from_secs(2);
+
+/// Runs a closing task's `work` (its drain, then its closing handshake) until it ends, or until [`CLOSE_WAIT`] after
+/// the link's drop, whichever comes first (SEC-U6B-1). `None`: the bound cut it. While the link lives, `work` waits
+/// as long as it must (the link's own bounded queue answers the room `BufferFull`).
+pub(crate) async fn bounded<T>(
+    flags: &Flags,
+    work: impl std::future::Future<Output = T>,
+) -> Option<T> {
+    tokio::select! {
+        t = work => Some(t),
+        () = async {
+            flags.gone.notified().await;
+            tokio::time::sleep(CLOSE_WAIT).await;
+        } => None,
+    }
+}
+
+/// A session's closed flag, set by whichever task sees the end first.
+#[derive(Debug, Default)]
+pub(crate) struct Flags {
+    closed: AtomicBool,
+    /// The peer closed first (its close frame, its EOF or its connection close): a later error on our side's close is
+    /// a normal end (C1c).
+    peer_closed: AtomicBool,
+    /// The link was dropped: [`bounded`]'s bound runs from here (a stored permit if the closing task is not yet
+    /// waiting).
+    gone: tokio::sync::Notify,
+}
+
+impl Flags {
+    /// The link's drop (its `Drop`): the closing's bound starts.
+    pub(crate) fn dropped(&self) {
+        self.gone.notify_one();
+    }
+    pub(crate) fn close(&self) {
+        self.closed.store(true, Relaxed);
+    }
+    pub(crate) fn closed(&self) -> bool {
+        self.closed.load(Relaxed)
+    }
+    pub(crate) fn peer_closed(&self) {
+        self.peer_closed.store(true, Relaxed);
+        self.close();
+    }
+    pub(crate) fn by_peer(&self) -> bool {
+        self.peer_closed.load(Relaxed)
+    }
+}
+
+/// A server's counts for its transport's event at the run's end (Block 5).
+#[derive(Debug, Default)]
+pub(crate) struct Counts {
+    /// Sessions handed to the room.
+    pub(crate) accepted: AtomicU64,
+    /// Handshakes that failed before the deadline (one count: QUIC, HTTP/3 or the answer; TLS or the upgrade).
+    pub(crate) failed: AtomicU64,
+    /// Connections closed at the deadline before a session reached the room.
+    pub(crate) deadline: AtomicU64,
+    /// Sessions closed as malformed by the transport's framing (a control length above 512 B, an unknown tag).
+    pub(crate) malformed: AtomicU64,
+    /// Datagrams a full inbox dropped.
+    pub(crate) dropped: Arc<AtomicU64>,
+    /// Closes whose own end failed while the peer had not closed (C1c: after the peer's close it is a normal end).
+    pub(crate) close_failed: AtomicU64,
+    /// WebSocket only (R-PING): datagrams outside an announced tick, sent and refused.
+    pub(crate) outside: [AtomicU64; 2],
+}
+
+impl Counts {
+    /// The event's fields (`event.<transport>_accept.<name>`; SERIES.md), with the cap's refusals for `wt`; the
+    /// WebSocket's adds its datagrams outside a tick.
+    pub(crate) fn rows(&self, cap: &ConnCap, wt: bool) -> Vec<(&'static str, u64)> {
+        let mut rows = vec![
+            ("accepted_count", self.accepted.load(Relaxed)),
+            ("handshake_failed_count", self.failed.load(Relaxed)),
+            ("cap_refused_count", cap.refused(wt)),
+            ("deadline_closed_count", self.deadline.load(Relaxed)),
+            ("malformed_closed_count", self.malformed.load(Relaxed)),
+            ("datagrams_dropped_count", self.dropped.load(Relaxed)),
+            ("close_failed_count", self.close_failed.load(Relaxed)),
+        ];
+        if !wt {
+            rows.push(("outside_tick_sent_count", self.outside[0].load(Relaxed)));
+            rows.push(("outside_tick_refused_count", self.outside[1].load(Relaxed)));
+        }
+        rows
+    }
+}
diff --git a/spikes/netcode-proof/crates/net/src/ws_server.rs b/spikes/netcode-proof/crates/net/src/ws_server.rs
new file mode 100644
index 0000000..137feec
--- /dev/null
+++ b/spikes/netcode-proof/crates/net/src/ws_server.rs
@@ -0,0 +1,994 @@
+//! T3 `WsServer`'s accept path, T2 `WsClient` and T4 the send path with fix 1 (u6b-brief.md Blocks 3 and 4): the
+//! WebSocket fallback over TLS 1.3 (tokio-rustls, ring), tokio-tungstenite, and DelayStream on impaired runs.
+//!
+//! - **Accept** (`WsServer::start`): the TCP accept takes the accept stamp and a permit of the process's [`ConnCap`]
+//!   (none free: the connection is dropped at once, counted), before any TLS; then under `timeout_at(accept +
+//!   deadline)` (S5 b): TLS (ws_config.rs's acceptor), `DelayStream::wrap` unless `cfg.pass_through` (R20: clean runs
+//!   go plain), tokio-tungstenite's accept with `ws_config(cfg.ws_max_message_bytes)`, so tungstenite's limits and
+//!   DelayStream's come from one `&L2Config` (S5 a), and the hand-off to the room. The connection's index is its
+//!   place in accept order (delay.rs's CONN_INDEX_RULE). One handshake-failure count (TLS or the upgrade); a miss of the
+//!   deadline is counted apart. The wrapper is on or off for the process (`header.params.ws_wrapper`). No Origin check
+//!   (cut: replan-units.md:19); nothing reads the request's URL or headers, and none is logged (E22).
+//! - **`WsLink`**: one binary message per channel message behind its 1 B channel tag (`Channel::ws_tag`; catalogue
+//!   :73-76); an unknown tag, or a text message, closes the session as malformed, counted. Its reader runs on its own
+//!   task over the WebSocket's split halves, stamping each message as it arrives; its writer on another.
+//! - **Fix 1** (Block 4; ws_gate.rs, called never copied): one `TickWriter` per connection, its N counted in the
+//!   caller's tick period (`Listen::tick_ns`, NR-U6B-2). `Link::begin_tick` reads
+//!   the gate's inputs once (F11): DelayStream's `gate_inputs` (one lock, one model step) on L2, or on the plain path
+//!   the kernel's srtt (TCP_INFO) and outstanding bytes (SIOCOUTQ), owed = tungstenite's bytes not yet taken below it
+//!   plus rustls's TLS bytes not yet taken by the kernel; on both, plus what this link's own send queue holds. The plain
+//!   path's free value is `u64::MAX`: its reason (S5 d), the kernel's send buffer (autotuned to megabytes) is never
+//!   the binding condition there; the third condition, outstanding + the snapshot within N snapshots, binds first. The
+//!   tick's whole snapshot is gated all or none in the model's bytes (each message's payload, tag, frame header and
+//!   TLS's 22 B); a skipped tick answers each of its datagrams `BufferFull`, and a datagram past the announced count
+//!   too. A datagram outside any announced tick (R-PING, the brief's condition 1, rev 1.2: the room's own Pings and
+//!   Pongs, which its I/O step sends between ticks) is never held to the snapshot budget (a 10 B Ping against N x 10 B
+//!   would be refused whenever a snapshot is in flight) and never written ungated: only when it is at most
+//!   `Listen::outside_max` (the largest Ping or Pong, 32 B) and fix 1's first two conditions hold (nothing owed below
+//!   this link's own bounded queue, which only this check leaves out, and room in the socket); otherwise
+//!   `BufferFull`; both counted (`event.ws_accept`'s `outside_tick_*`). Control and FullState messages are
+//!   not gated (the 128 KB queue bound, tungstenite's own). The per-tick reads (and their syscalls) run where
+//!   `begin_tick` is called: the session's I/O task on the room's I/O runtime, never the tick thread.
+//! - **Close:** the queued messages (`Kick(replaced)` first), then a Close frame, the peer's, and the stream's
+//!   shutdown, all within 2 s of the link's drop (`session::CLOSE_WAIT`, SEC-U6B-1; it was 10 s for the handshake
+//!   alone, DelayStream's own wait, with no bound on the drain: a peer that stops reading is cut at 2 s); an error in
+//!   that close after the peer had closed is a normal end (C1c), else counted (a cut counts as an error). The permit
+//!   returns, and the connection's `ws_summary` is kept for the room's log, when that ends.
+//! - **`WsClient`**: TCP, tokio-rustls's client (ring, ALPN http/1.1, SNI, the pin), tungstenite's client handshake
+//!   with the client's own limits (`L2Config::WS_CLIENT_MAX_MESSAGE_BYTES`, never the server's 513 B), masked frames,
+//!   the tag. `Connecting` until the upgrade ends.
+
+use std::collections::VecDeque;
+use std::io;
+use std::net::SocketAddr;
+use std::pin::Pin;
+use std::sync::atomic::Ordering::Relaxed;
+use std::sync::atomic::{AtomicU32, AtomicU64};
+use std::sync::{Arc, Mutex, PoisonError};
+use std::task::{Context, Poll};
+use std::time::Duration;
+
+use futures_util::stream::{SplitSink, SplitStream};
+use futures_util::{SinkExt, StreamExt};
+use npt_link::{Channel, Link, LinkState, Recv, SendResult};
+use tokio::io::{AsyncRead, AsyncWrite, AsyncWriteExt, ReadBuf};
+use tokio::net::TcpStream;
+use tokio::sync::{mpsc, oneshot};
+use tokio_rustls::rustls::pki_types::{
+    CertificateDer, PrivateKeyDer, PrivatePkcs8KeyDer, ServerName,
+};
+use tokio_tungstenite::WebSocketStream;
+use tokio_tungstenite::tungstenite::Message;
+use tokio_tungstenite::tungstenite::protocol::WebSocketConfig;
+
+use crate::cap::{Permit, Via};
+use crate::session::{
+    Accepted, Counts, Flags, InboxTx, Listen, PENDING, SEND_QUEUE_BYTES, bounded, inbox,
+};
+// The tests' 30 Hz tick (the runs' comes from the caller: `Listen::tick_ns`).
+#[cfg(test)]
+pub(crate) const TICK_NS: u64 = 33_333_333;
+use crate::ws_gate::{Inputs, Snap, TickWriter};
+use crate::{DelayStream, L2Config, tcp_kernel, ws_config};
+
+/// The largest datagram a WebSocket link takes: npt-client's receive cap (catalogue's `Snapshot` row: 1,150 B).
+const MAX_DATAGRAM: usize = 1_150;
+/// One TLS 1.3 record's plaintext and its overhead (S0), for the plain path's TLS bytes and the gate's sizes.
+const RECORD: u64 = 16_384;
+const TLS_OVERHEAD: u64 = 22;
+/// Connection summaries kept for the room's log between its reads.
+const SUMMARIES: usize = 1_024;
+/// Messages a send queue holds (beside its byte bound).
+const SEND_QUEUE: usize = 256;
+
+/// The caller's two values for a connection's gate ([`Listen`]'s `tick_ns` and `outside_max`).
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct GateCfg {
+    pub(crate) tick_ns: u64,
+    pub(crate) outside_max: usize,
+}
+
+impl GateCfg {
+    pub(crate) fn of(l: &Listen) -> GateCfg {
+        GateCfg {
+            tick_ns: l.tick_ns,
+            outside_max: l.outside_max,
+        }
+    }
+}
+
+/// A server-to-client frame's bytes for `payload` bytes (unmasked: 2, 4 or 10 B of header, RFC 6455 §5.2).
+fn frame_bytes(payload: u64) -> u64 {
+    payload
+        + match payload {
+            0..=125 => 2,
+            126..=65_535 => 4,
+            _ => 10,
+        }
+}
+
+/// One message of `len` bytes in the gate's model bytes: its tag, its frame and TLS's 22 B per record (S0).
+fn model_bytes(len: usize) -> u64 {
+    let f = frame_bytes(len as u64 + 1);
+    f + TLS_OVERHEAD * f.div_ceil(RECORD)
+}
+
+/// The plain path's byte counts (S5 d): what tungstenite handed down, what rustls took of it, the TLS bytes those make
+/// and what the kernel took of them.
+#[derive(Debug, Default)]
+struct PlainCounts {
+    framed: AtomicU64,
+    plain: AtomicU64,
+    tls: AtomicU64,
+    sock: AtomicU64,
+}
+
+/// A stream that counts what its writes took: `took` the bytes, `tls` (above rustls) the TLS bytes they make.
+struct Counted<S> {
+    inner: S,
+    counts: Arc<PlainCounts>,
+    above_tls: bool,
+}
+
+impl<S: AsyncRead + Unpin> AsyncRead for Counted<S> {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_read(cx, buf)
+    }
+}
+
+impl<S: AsyncWrite + Unpin> AsyncWrite for Counted<S> {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        let this = self.get_mut();
+        let r = Pin::new(&mut this.inner).poll_write(cx, buf);
+        if let Poll::Ready(Ok(n)) = r {
+            let n = n as u64;
+            if this.above_tls {
+                this.counts.plain.fetch_add(n, Relaxed);
+                this.counts
+                    .tls
+                    .fetch_add(n + TLS_OVERHEAD * n.div_ceil(RECORD), Relaxed);
+            } else {
+                this.counts.sock.fetch_add(n, Relaxed);
+            }
+        }
+        r
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_flush(cx)
+    }
+
+    fn poll_shutdown(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_shutdown(cx)
+    }
+}
+
+/// Where fix 1's inputs come from.
+enum Source {
+    /// DelayStream's model (L2).
+    Delay(DelayStream<()>),
+    /// The plain path: the connection's socket (a second descriptor, for the kernel's readings only) and the counts,
+    /// with their values when the link began.
+    Plain {
+        kernel: TcpStream,
+        counts: Arc<PlainCounts>,
+        base: [u64; 3],
+    },
+    /// The tests' fixed inputs.
+    #[cfg(test)]
+    Fixed(Arc<Mutex<Inputs>>),
+}
+
+/// The plain path's stream: tungstenite over TLS, each counted (S5 d).
+type PlainWs = WebSocketStream<Counted<tokio_rustls::server::TlsStream<Counted<TcpStream>>>>;
+
+/// The plain path (R20): a second descriptor for the kernel's readings, TLS between the two counters, the upgrade, and
+/// fix 1's source with the counts as the upgrade left them.
+async fn plain(
+    tcp: TcpStream,
+    acceptor: &tokio_rustls::TlsAcceptor,
+    ws: WebSocketConfig,
+) -> io::Result<(PlainWs, Source, Arc<PlainCounts>)> {
+    let std = tcp.into_std()?;
+    let kernel = TcpStream::from_std(std.try_clone()?)?;
+    let tcp = TcpStream::from_std(std)?;
+    let counts = Arc::new(PlainCounts::default());
+    let below = Counted {
+        inner: tcp,
+        counts: Arc::clone(&counts),
+        above_tls: false,
+    };
+    let tls = acceptor.accept(below).await?;
+    let above = Counted {
+        inner: tls,
+        counts: Arc::clone(&counts),
+        above_tls: true,
+    };
+    let ws = tokio_tungstenite::accept_async_with_config(above, Some(ws))
+        .await
+        .map_err(io::Error::other)?;
+    let base = [
+        counts.plain.load(Relaxed),
+        counts.tls.load(Relaxed),
+        counts.sock.load(Relaxed),
+    ];
+    let source = Source::Plain {
+        kernel,
+        counts: Arc::clone(&counts),
+        base,
+    };
+    Ok((ws, source, counts))
+}
