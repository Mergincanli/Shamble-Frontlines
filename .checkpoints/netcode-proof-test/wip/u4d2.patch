+  refused.exports.begin = () => 1;
+  assert.match(replay(refused.exports, { path, name: "SS-s1", firstTick: 0, bite: 1, arm: 5 }).error, /^SS-s1: begin\(1, 5\) returned 1, not BEGUN/);
+  assert.equal(trap.lines.at(-1), `failed ${trap.error}`);
+});
