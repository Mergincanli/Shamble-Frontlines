+/// The dump word named exactly `name`, if the dump has one.
+fn word_if(d: &StateDump, name: &str) -> Option<u32> {
+    (0..d.words().len())
+        .find(|&i| d.field(i).as_deref() == Some(name))
+        .map(|i| d.words()[i])
+}
