+++ b/spikes/netcode-proof/web/src/worker.ts
@@ -0,0 +1,397 @@
+// worker.ts: the module Worker (u7-brief.md rev 1.1 Block T3; C-U7-3; C1, C5, C9). It loads the Wasm client, makes a
+// 16 B bind, connects (lib.ts's chooser), stamps every received message with performance.now() in its own read,
+// queues it (at most 512) and hands the queue to the client at the next wake, set from next_due_ns; after each wake's
+// sends it stamps the send time the next step gets. A trap ends the session ("Ended"): no restart, no rejoin.
+// The token reaches the Wasm only; the bind never leaves this Worker; neither is posted, logged or recorded.
+import {
+  ATTEMPT_DEADLINE_MS, CH, NS_PER_MS, Recorder, STATUS, clockResNs, connect, controlFramer, counterIndex,
+  fullStateFramer, packInbox, readLimits, settles, unpackOutbox, wsUnwrap, wsWrap,
+  InboxQueue, type Channel, type Limits, type Link, type Needed, type OutRecord, type StreamFramer, type Transport,
+  type WsLike, type WtLike, type WtOptions,
+} from "./lib.js";
+
+export interface CoreClient {
+  step(nowNs: bigint, prevSendNs: bigint, inbox: Uint8Array): Uint8Array;
+  next_due_ns(): bigint;
+  counters(): Uint32Array;
+}
+/** wasm-bindgen's `--target web` module of npt-client-wasm (C5's boundary). */
+export interface CoreModule {
+  default(): Promise<unknown>;
+  Client: new (token: string, bind: Uint8Array) => CoreClient;
+  counter_names(): string[];
+  limits(): Uint32Array;
+}
+export interface StartMsg {
+  readonly kind: "start";
+  readonly link: Link;
+  readonly host: string;
+  readonly wtTimeoutMs: number | null;
+  readonly mdsPeriodMs: number | null;
+}
+export type ToPage =
+  | { readonly kind: "status"; readonly text: string }
+  | { readonly kind: "records"; readonly lines: readonly string[] }
+  | { readonly kind: "counters"; readonly names: readonly string[]; readonly values: readonly number[] }
+  | { readonly kind: "clock"; readonly resNs: number };
+export interface EngineDeps {
+  now(): number;
+  setTimer(fn: () => void, ms: number): unknown;
+  clearTimer(id: unknown): void;
+  fetchText(path: string): Promise<string>;
+  webTransport(url: string, options: WtOptions): WtLike;
+  webSocket(url: string): WsLike;
+  randomBytes(n: number): Uint8Array;
+  loadCore(): Promise<CoreModule>;
+  post(msg: ToPage): void;
+}
+
+const BIND_BYTES = 16;
+const SECOND_MS = 1000;
+const WAKE_MAX_MS = 1000;
+/** Writes in flight per writer, full-state streams open at once, and WebSocket bytes buffered: every queue bounded. */
+const PENDING_MAX = 64;
+const UNI_MAX = 4;
+const WS_BUFFER_MAX = 1_048_576;
+/** `prev_send_ns` at the first step, before anything was sent. */
+const NO_SEND_NS = 0n;
+
+/** Reads `r` chunk by chunk, each read starting the next (no loop, no promise chain); `onDone` once at the end. */
+function pump<T>(r: ReadableStreamDefaultReader<T>, onChunk: (v: T) => boolean, onDone: (error: boolean) => void): void {
+  void (async (): Promise<void> => {
+    let res: ReadableStreamReadResult<T>;
+    try {
+      res = await r.read();
+    } catch {
+      onDone(true);
+      return;
+    }
+    if (res.done) onDone(false);
+    else if (onChunk(res.value)) pump(r, onChunk, onDone);
+  })();
+}
+
+/** The page's own counters, beside the client's. */
+const PAGE_COUNTERS = ["inbox_dropped", "datagram_over_cap", "datagram_send_dropped", "send_failed", "uni_refused"] as const;
+
+export class Engine {
+  private readonly startMs: number;
+  private ended = false;
+  private playing = false;
+  private shownJoined = false;
+  private fellBack = false;
+  private transport: Transport = "wt";
+  private rec: Recorder | null = null;
+  private client: CoreClient | null = null;
+  private lim: Limits | null = null;
+  private idx: Needed | null = null;
+  private names: readonly string[] = [];
+  private wt: WtLike | null = null;
+  private ws: WsLike | null = null;
+  private dgWriter: WritableStreamDefaultWriter<Uint8Array> | null = null;
+  private ctlWriter: WritableStreamDefaultWriter<Uint8Array> | null = null;
+  private readonly pending = { dg: 0, ctl: 0 };
+  private openUnis = 0;
+  private prevSendNs = NO_SEND_NS;
+  private readonly inbox = new InboxQueue();
+  private readonly pc: Record<(typeof PAGE_COUNTERS)[number], number> = {
+    inbox_dropped: 0, datagram_over_cap: 0, datagram_send_dropped: 0, send_failed: 0, uni_refused: 0,
+  };
+  private readonly timers: Record<"wake" | "second" | "mds" | "deadline", unknown> = {
+    wake: null, second: null, mds: null, deadline: null,
+  };
+
+  constructor(private readonly d: EngineDeps) {
+    this.startMs = d.now();
+    d.post({ kind: "clock", resNs: clockResNs(d.now) });
+  }
+
+  /** Nanoseconds since this Worker started: the records' clock (C1). */
+  private ns(): number {
+    return (this.d.now() - this.startMs) * NS_PER_MS;
+  }
+  /** The client's clock: performance.now() as integer ns. */
+  private stamp(): bigint {
+    return BigInt(Math.round(this.d.now() * NS_PER_MS));
+  }
+  private status(text: string): void {
+    this.d.post({ kind: "status", text });
+  }
+  private arm(name: keyof Engine["timers"], fn: () => void, ms: number): void {
+    this.timers[name] = this.d.setTimer(() => {
+      this.timers[name] = null;
+      if (!this.ended) fn();
+    }, ms);
+  }
+
+  async start(m: StartMsg): Promise<void> {
+    const core = (async (): Promise<CoreModule | null> => {
+      try {
+        const mod = await this.d.loadCore();
+        await mod.default();
+        return mod;
+      } catch {
+        return null;
+      }
+    })();
+    const rec = new Recorder((line) => this.d.post({ kind: "records", lines: [line] }), this.ns());
+    this.rec = rec;
+    this.arm("deadline", () => rec.attempt(this.ns(), 0), ATTEMPT_DEADLINE_MS);
+    this.arm("second", this.everySecond, SECOND_MS);
+    const chosen = await connect({
+      link: m.link, host: m.host, timeoutMs: m.wtTimeoutMs, fetchText: this.d.fetchText, webTransport: this.d.webTransport,
+      webSocket: this.d.webSocket, setTimer: this.d.setTimer, clearTimer: this.d.clearTimer, onStatus: (s) => this.status(s),
+    });
+    if (chosen.kind === "failed") return this.end(chosen.why);
+    if (chosen.kind === "wt") this.watchWt(chosen.wt);
+    else this.watchWs(chosen.ws, chosen.fellBack);
+    const mod = await core;
+    if (this.ended) return undefined;
+    if (mod === null) return this.end("the client did not load");
+    const lim = readLimits(mod.limits());
+    const names = mod.counter_names();
+    const idx = counterIndex(names);
+    if (!lim.ok) return this.end(lim.why);
+    if (!idx.ok) return this.end(idx.why);
+    [this.lim, this.idx, this.names] = [lim.value, idx.value, names];
+    try {
+      this.client = new mod.Client(m.link.token, this.d.randomBytes(BIND_BYTES));
+    } catch {
+      return this.end("the client refused the link");
+    }
+    if (this.wt !== null) await this.setupWt(this.wt, lim.value, m.mdsPeriodMs);
+    else this.setupWs(lim.value);
+    if (!this.ended) this.wake();
+    return undefined;
+  }
+
+  /** The chosen transport's end is watched at once, before the client has loaded. */
+  private watchWt(wt: WtLike): void {
+    this.wt = wt;
+    void (async (): Promise<void> => {
+      await settles(wt.closed);
+      this.end("the WebTransport session closed");
+    })();
+  }
+  private watchWs(ws: WsLike, fellBack: boolean): void {
+    [this.ws, this.transport, this.fellBack] = [ws, "ws", fellBack];
+    this.ws.onclose = this.ws.onerror = (): void => this.end("the WebSocket closed");
+  }
+
+  private async setupWt(wt: WtLike, lim: Limits, mdsPeriodMs: number | null): Promise<void> {
+    const dg = wt.datagrams as WtLike["datagrams"] & { createWritable?: () => WritableStream<Uint8Array> };
+    this.dgWriter = (typeof dg.createWritable === "function" ? dg.createWritable() : dg.writable).getWriter();
+    try {
+      const bidi = await wt.createBidirectionalStream();
+      this.ctlWriter = bidi.writable.getWriter();
+      this.readStream(bidi.readable, controlFramer(lim), CH.control, () => this.end("the control stream ended"));
+    } catch {
+      return this.end("the control stream did not open");
+    }
+    pump(wt.datagrams.readable.getReader(), (v) => this.onDatagram(v, wt, lim), () => undefined);
+    pump(wt.incomingUnidirectionalStreams.getReader(), (s) => this.onUni(s, lim), () => undefined);
+    const read = (): void => {
+      this.rec?.mdsRead(this.ns(), wt.datagrams.maxDatagramSize);
+      if (mdsPeriodMs !== null) this.arm("mds", read, mdsPeriodMs);
+    };
+    read();
+    return undefined;
+  }
+
+  private onDatagram(v: Uint8Array, wt: WtLike, lim: Limits): boolean {
+    const at = this.stamp();
+    if (this.ended) return false;
+    this.rec?.datagram(v.byteLength, wt.datagrams.maxDatagramSize);
+    if (v.byteLength > lim.datagram) this.pc.datagram_over_cap++;
+    else if (!this.inbox.push({ channel: CH.datagram, arrivalNs: at, bytes: v })) this.pc.inbox_dropped++;
+    return true;
+  }
+
+  private onUni(s: ReadableStream<Uint8Array>, lim: Limits): boolean {
+    if (this.ended) return false;
+    if (this.openUnis >= UNI_MAX) {
+      this.pc.uni_refused++;
+      void settles(s.cancel());
+      return true;
+    }
+    this.openUnis++;
+    this.readStream(s, fullStateFramer(lim), CH.fullState, () => this.openUnis--);
+    return true;
+  }
+
+  /** One stream's messages, reassembled and capped; a message over its cap or cut short ends the session. */
+  private readStream(s: ReadableStream<Uint8Array>, framer: StreamFramer, channel: Channel, onEnd: () => void): void {
+    pump(s.getReader(), (v) => {
+      const at = this.stamp();
+      if (this.ended) return false;
+      let frames: Uint8Array[];
+      try {
+        frames = framer.push(v);
+      } catch {
+        this.end("a stream message over its cap");
+        return false;
+      }
+      frames.forEach((bytes) => {
+        if (!this.inbox.push({ channel, arrivalNs: at, bytes })) this.pc.inbox_dropped++;
+      });
+      return true;
+    }, (error) => {
+      if (framer.partial || error) this.end("a stream ended inside a message");
+      else onEnd();
+    });
+  }
+
+  private setupWs(lim: Limits): void {
+    const ws = this.ws;
+    if (ws === null) return;
+    ws.onmessage = (e): void => {
+      const at = this.stamp();
+      if (this.ended) return;
+      if (!(e.data instanceof ArrayBuffer)) return this.end("a WebSocket message that is not binary");
+      const u = wsUnwrap(new Uint8Array(e.data), lim);
+      if (!u.ok && u.close) return this.end(u.why);
+      if (!u.ok) this.pc.datagram_over_cap++;
+      else if (!this.inbox.push({ channel: u.channel, arrivalNs: at, bytes: u.bytes })) this.pc.inbox_dropped++;
+      return undefined;
+    };
+  }
+
+  private send(r: OutRecord): void {
+    if (this.ws !== null && this.lim !== null) {
+      if (this.ws.bufferedAmount <= WS_BUFFER_MAX) this.ws.send(wsWrap(this.lim.tags[r.channel], r.bytes));
+      else if (r.channel === CH.datagram) this.pc.datagram_send_dropped++;
+      else this.end("the WebSocket's send buffer is full");
+      return;
+    }
+    const isDg = r.channel === CH.datagram;
+    const w = isDg ? this.dgWriter : this.ctlWriter;
+    const key = isDg ? "dg" : "ctl";
+    if (w === null) return;
+    if (this.pending[key] >= PENDING_MAX) {
+      if (isDg) this.pc.datagram_send_dropped++;
+      else this.end("the control stream is stuck");
+      return;
+    }
+    this.pending[key]++;
+    void (async (): Promise<void> => {
+      if (!(await settles(w.write(r.bytes)))) this.pc.send_failed++;
+      this.pending[key]--;
+    })();
+  }
+
+  /** One wake: the queue to the client, its outbox sent, the send time stamped (C-U7-3), the next wake set. */
+  private readonly wake = (): void => {
+    const client = this.client;
+    if (this.ended || client === null) return;
+    let out: OutRecord[];
+    let dueNs: bigint;
+    try {
+      out = unpackOutbox(client.step(this.stamp(), this.prevSendNs, packInbox(this.inbox.drain())));
+      out.forEach((r) => this.send(r));
+      this.prevSendNs = this.stamp();
+      this.observe(client.counters());
+      dueNs = client.next_due_ns();
+    } catch {
+      return this.end("the client trapped");
+    }
+    const ms = Number(dueNs - this.stamp()) / NS_PER_MS;
+    if (!this.ended) this.arm("wake", this.wake, Math.min(WAKE_MAX_MS, Math.max(0, ms)));
+    return undefined;
+  };
+
+  private observe(c: Uint32Array): void {
+    const idx = this.idx;
+    if (idx === null) return;
+    const [joined, samples, own] = [c[idx.joined] ?? 0, c[idx.clock_samples] ?? 0, c[idx.own_soldier] ?? 0];
+    const ns = this.ns();
+    if (joined > 0 && samples > 0) this.rec?.attempt(ns, 1);
+    if (this.playing || joined === 0) return;
+    if (own > 0) {
+      this.playing = true;
+      this.status(STATUS.playing(this.transport));
+      if (this.fellBack) this.rec?.fallback(ns);
+    } else if (!this.shownJoined) {
+      this.shownJoined = true;
+      this.status(STATUS.joined(this.transport));
+    }
+  }
+
+  private postCounters(): void {
+    const core = this.client === null ? [] : Array.from(this.client.counters());
+    this.d.post({
+      kind: "counters",
+      names: [...this.names, ...PAGE_COUNTERS.map((n) => `page_${n}`)],
+      values: [...core, ...PAGE_COUNTERS.map((n) => (n === "inbox_dropped" ? this.inbox.dropped : this.pc[n]))],
+    });
+  }
+
+  private readonly everySecond = (): void => {
+    if (this.wt !== null && this.client !== null) this.rec?.second(this.ns());
+    this.postCounters();
+    this.arm("second", this.everySecond, SECOND_MS);
+  };
+
+  /** Ends the session once: timers cleared, `attempt.ok` 0 if not yet written, the transport closed. No restart. */
+  private end(why: string): void {
+    if (this.ended) return;
+    this.ended = true;
+    Object.values(this.timers).forEach((t) => (t === null ? undefined : this.d.clearTimer(t)));
+    this.rec?.attempt(this.ns(), 0);
+    this.status(STATUS.ended(why));
+    try {
+      this.postCounters();
+    } catch {
+      // a trapped client may not answer
+    }
+    try {
+      this.wt?.close();
+      this.ws?.close();
+    } catch {
+      // already closed
+    }
+  }
+}
+
+/** The start message's shape, checked (it comes from the page, which parsed the link). */
+export function readStart(x: unknown): StartMsg | null {
+  const m = x as Partial<StartMsg> | null;
+  const ms = (v: unknown): boolean => v === null || (typeof v === "number" && v > 0);
+  const ok = m !== null && typeof m === "object" && m.kind === "start" && typeof m.host === "string"
+    && typeof m.link === "object" && m.link !== null && typeof m.link.token === "string"
+    && ms(m.wtTimeoutMs) && ms(m.mdsPeriodMs);
+  return ok ? (m as StartMsg) : null;
+}
+
+/** wasm-bindgen's glue, beside this file in the dist (a string, so tsc does not resolve it). */
+const CORE_URL: string = "./npt_client_wasm.js";
+
+interface WorkerScope {
+  postMessage(m: unknown): void;
+  onmessage: ((e: MessageEvent) => void) | null;
+}
+
+if ("WorkerGlobalScope" in globalThis) {
+  const scope = globalThis as unknown as WorkerScope;
+  const engine = new Engine({
+    now: () => performance.now(),
+    setTimer: (fn, ms) => setTimeout(fn, ms),
+    clearTimer: (id) => clearTimeout(id as ReturnType<typeof setTimeout>),
+    fetchText: async (path) => {
+      const r = await fetch(path, { cache: "no-store", credentials: "omit", redirect: "error" });
+      if (!r.ok) throw new Error("not found");
+      return r.text();
+    },
+    webTransport: (url, options) => new WebTransport(url, options as WebTransportOptions) as unknown as WtLike,
+    webSocket: (url) => new WebSocket(url) as unknown as WsLike,
+    randomBytes: (n) => crypto.getRandomValues(new Uint8Array(n)),
+    loadCore: async () => (await import(CORE_URL)) as CoreModule,
+    post: (msg) => scope.postMessage(msg),
+  });
+  let started = false;
+  scope.onmessage = (e): void => {
+    const m = readStart(e.data);
+    if (started || m === null) return;
+    started = true;
+    void engine.start(m);
+  };
+}
diff --git a/spikes/netcode-proof/web/test/boundary.test.mjs b/spikes/netcode-proof/web/test/boundary.test.mjs
new file mode 100644
index 0000000..01b2589
--- /dev/null
+++ b/spikes/netcode-proof/web/test/boundary.test.mjs
@@ -0,0 +1,53 @@
+// boundary.test.mjs: C5's golden file against the page's packing (lib.js) and the fake core's own (fake-core.mjs).
+// R3's Rust test reads the same file with include_str! against the real packing.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { test } from "node:test";
+import { fakePackOutbox, fakeUnpackInbox } from "./fake-core.mjs";
+import { WEB, load } from "./helpers.mjs";
+
+const L = await load("lib.js");
+const G = JSON.parse(readFileSync(join(WEB, "test", "fixtures", "boundary.json"), "utf8"));
+const hex = (b) => Buffer.from(b).toString("hex");
+const bytes = (h) => Uint8Array.from(Buffer.from(h, "hex"));
+const inbox = G.inbox.records.map((r) => ({ channel: r.channel, arrivalNs: BigInt(r.arrival_ns), bytes: bytes(r.bytes_hex) }));
+const outbox = G.outbox.records.map((r) => ({ channel: r.channel, bytes: bytes(r.bytes_hex) }));
+
+test("the golden file: one inbox record per channel, an arrival above 2^32, two outbox records", () => {
+  assert.deepEqual(G.inbox.records.map((r) => r.channel), [0, 1, 2]);
+  assert.ok(inbox.some((r) => r.arrivalNs > 0xffffffffn));
+  assert.deepEqual(G.outbox.records.map((r) => r.channel), [0, 1]);
+});
+
+test("the page packs the golden inbox and reads the golden outbox", () => {
+  assert.equal(hex(L.packInbox(inbox)), G.inbox.hex);
+  assert.deepEqual(L.unpackOutbox(bytes(G.outbox.hex)).map((r) => ({ channel: r.channel, bytes_hex: hex(r.bytes) })),
+    G.outbox.records);
+  assert.equal(L.packInbox([]).length, 0);
+  assert.deepEqual(L.unpackOutbox(new Uint8Array(0)), []);
+});
+
+test("the fake core reads the golden inbox and packs the golden outbox", () => {
+  const u = fakeUnpackInbox(bytes(G.inbox.hex));
+  assert.equal(u.refused, 0);
+  assert.deepEqual(u.records.map((r) => ({ channel: r.channel, arrival_ns: String(r.arrivalNs), bytes_hex: hex(r.bytes) })),
+    G.inbox.records);
+  assert.equal(hex(fakePackOutbox(outbox)), G.outbox.hex);
+});
+
+test("a malformed outbox is a core fault: cut header, cut body, unknown channel", () => {
+  const o = bytes(G.outbox.hex);
+  assert.throws(() => L.unpackOutbox(o.subarray(0, 3)), /record header/);
+  assert.throws(() => L.unpackOutbox(o.subarray(0, o.length - 1)), /inside a record/);
+  const bad = Uint8Array.from(o);
+  bad[0] = 2;
+  assert.throws(() => L.unpackOutbox(bad), /unknown channel/);
+});
+
+test("the fake core refuses a truncated inbox record and the rest after it", () => {
+  const b = bytes(G.inbox.hex);
+  const u = fakeUnpackInbox(b.subarray(0, b.length - 1));
+  assert.equal(u.refused, 1);
+  assert.equal(u.records.length, 2);
+});
diff --git a/spikes/netcode-proof/web/test/build.test.mjs b/spikes/netcode-proof/web/test/build.test.mjs
new file mode 100644
index 0000000..4715221
--- /dev/null
+++ b/spikes/netcode-proof/web/test/build.test.mjs
@@ -0,0 +1,125 @@
+// build.test.mjs: Block T1 (u7-brief.md rev 1.1): index.html under the CSP, build.mjs's dist and its checks, web/'s
+// npm rule (advisor-u8-brief.md C2 as security-u7-deps.md item (4) applies it).
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { test } from "node:test";
+import {
+  DIST_NAMES, GATE as BUILD_GATE, WEB as BUILD_WEB, assemble, encodedRustFlags, homePaths, outDirFor, parseArgs,
+  wasmBindgenOk,
+} from "../build.mjs";
+import { GATE, WEB, scratch } from "./helpers.mjs";
+
+const html = readFileSync(join(WEB, "index.html"), "utf8");
+
+test("index.html: no inline script, no inline style, the three elements the scripts read", () => {
+  const scripts = [...html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script>/gi)];
+  assert.equal(scripts.length, 1);
+  assert.match(scripts[0][1], /\btype="module"/);
+  assert.match(scripts[0][1], /\bsrc="main\.js"/);
+  assert.equal(scripts[0][2].trim(), "");
+  assert.doesNotMatch(html, /<style\b/i);
+  assert.doesNotMatch(html, /\sstyle\s*=/i);
+  assert.doesNotMatch(html, /\son[a-z]+\s*=/i);
+  assert.doesNotMatch(html, /javascript:/i);
+  for (const id of ["status", "version", "counters"]) assert.match(html, new RegExp(`id="${id}"`));
+});
+
+test("the dist is the seven names U6c's host takes", () => {
+  assert.deepEqual([...DIST_NAMES], [
+    "index.html", "main.js", "worker.js", "lib.js", "hooks.js", "npt_client_wasm.js", "npt_client_wasm_bg.wasm",
+  ]);
+});
+
+function fakeInputs(dir) {
+  const js = join(dir, "js");
+  const bg = join(dir, "bindgen");
+  mkdirSync(js);
+  mkdirSync(bg);
+  for (const n of ["main.js", "worker.js", "lib.js", "hooks.js"]) writeFileSync(join(js, n), `// ${n}\n`);
+  writeFileSync(join(bg, "npt_client_wasm.js"), "// glue\n");
+  writeFileSync(join(bg, "npt_client_wasm_bg.wasm"), Buffer.from([0, 0x61, 0x73, 0x6d, 1, 0, 0, 0]));
+  writeFileSync(join(js, "extra.js"), "// never copied\n");
+  return { jsDir: js, bindgenDir: bg };
+}
+
+test("assemble: a fresh folder with exactly the seven files, each SHA-256 right", () => {
+  const dir = scratch("assemble");
+  const inputs = fakeInputs(dir);
+  const out = join(dir, "dist");
+  mkdirSync(out);
+  writeFileSync(join(out, "stale.txt"), "old\n");
+  const sums = assemble({ out, index: join(WEB, "index.html"), ...inputs });
+  assert.deepEqual(readdirSync(out).sort(), [...DIST_NAMES].sort());
+  assert.deepEqual(sums.map((s) => s.name), [...DIST_NAMES]);
+  for (const s of sums) {
+    assert.equal(s.sha256, createHash("sha256").update(readFileSync(join(out, s.name))).digest("hex"));
+  }
+});
+
+test("assemble: a hooks file replaces tsc's; a missing input or a folder outside .gate/ is refused", () => {
+  const dir = scratch("assemble-hooks");
+  const inputs = fakeInputs(dir);
+  const hooks = join(dir, "other-hooks.js");
+  writeFileSync(hooks, "// other\n");
+  const out = join(dir, "dist");
+  assemble({ out, index: join(WEB, "index.html"), ...inputs, hooks });
+  assert.equal(readFileSync(join(out, "hooks.js"), "utf8"), "// other\n");
+  assert.throws(() => assemble({ out, index: join(dir, "absent.html"), ...inputs }), /missing index\.html/);
+  assert.throws(() => assemble({ out: join(WEB, "test"), index: join(WEB, "index.html"), ...inputs }), /web\/dist or under \.gate/);
+});
+
+test("outDirFor: web/dist, the bites folder under .gate/ (C13), --out only under .gate/netcode-proof-test/", () => {
+  assert.equal(BUILD_WEB, WEB);
+  assert.equal(BUILD_GATE, GATE);
+  assert.equal(outDirFor({}), join(WEB, "dist"));
+  assert.equal(outDirFor({ bites: true }), join(GATE, "dist-bites"));
+  assert.equal(outDirFor({ out: join(GATE, "t5", "dist") }), join(GATE, "t5", "dist"));
+  assert.throws(() => outDirFor({ out: join(WEB, "dist2") }), /under \.gate/);
+  assert.throws(() => outDirFor({ out: GATE }), /under \.gate/);
+  assert.throws(() => outDirFor({ out: join(GATE, "..", "x") }), /under \.gate/);
+  assert.deepEqual(parseArgs([]), { bites: false, out: null });
+  assert.deepEqual(parseArgs(["--bites"]), { bites: true, out: null });
+  assert.throws(() => parseArgs(["--bites", "--out", "x"]), /own folder/);
+  assert.throws(() => parseArgs(["--fast"]), /unknown argument/);
+});
+
+test("wasm-bindgen: exactly 0.2.130 passes", () => {
+  assert.equal(wasmBindgenOk("wasm-bindgen 0.2.130\n"), true);
+  assert.equal(wasmBindgenOk("wasm-bindgen 0.2.129"), false);
+  assert.equal(wasmBindgenOk("wasm-bindgen 0.2.1300"), false);
+  assert.equal(wasmBindgenOk(""), false);
+});
+
+test("the remap flags name CARGO_HOME, the workspace and the target, one per field", () => {
+  const f = encodedRustFlags("/h/.cargo", "/w/spike", "/w/.gate/t").split("\x1f");
+  assert.deepEqual(f, [
+    "--remap-path-prefix=/h/.cargo=/cargo-home",
+    "--remap-path-prefix=/w/spike=/npt",
+    "--remap-path-prefix=/w/.gate/t=/npt-target",
+  ]);
+});
+
+test("the Wasm scan finds absolute home paths and passes remapped ones", () => {
+  const bad = Buffer.from("\0\0panicked at /home/someone/.cargo/registry/src/x/lib.rs\0", "latin1");
+  assert.deepEqual(homePaths(bad), ["/home/"]);
+  assert.deepEqual(homePaths(Buffer.from("C:\\Users\\me\\x.rs")), ["C:\\Users\\"]);
+  assert.deepEqual(homePaths(Buffer.from("/opt/w/spike/crates/a.rs"), ["/opt/w/spike"]), ["/opt/w/spike"]);
+  assert.deepEqual(homePaths(Buffer.from("\0/cargo-home/registry/src/x.rs /npt/crates/client/src/lib.rs\0")), []);
+});
+
+test("web/ holds no .npmrc and no npm-shrinkwrap.json (C2; security-u7-deps.md item (4))", () => {
+  const found = [];
+  const walk = (d) => {
+    for (const n of readdirSync(d)) {
+      if (n === "node_modules") continue;
+      const p = join(d, n);
+      if (n === ".npmrc" || n === "npm-shrinkwrap.json") found.push(p);
+      if (statSync(p).isDirectory()) walk(p);
+    }
+  };
+  walk(WEB);
+  assert.deepEqual(found, []);
+  assert.equal(existsSync(join(WEB, "dist")), false, "a web/dist folder fails check.mjs's redact step (N-U7D-1)");
+});
diff --git a/spikes/netcode-proof/web/test/connect.test.mjs b/spikes/netcode-proof/web/test/connect.test.mjs
new file mode 100644
index 0000000..9b14240
--- /dev/null
+++ b/spikes/netcode-proof/web/test/connect.test.mjs
@@ -0,0 +1,152 @@
+// connect.test.mjs: the transport chooser (u7-brief.md rev 1.1 section 3; C4, C9) over a fake clock and fake
+// transports: wt ready, wt failing, wt silent, ws, the no-fallback suites, the hash file first, the late-ready attempt.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { FakeClock, FakeWs, FakeWt, HASH_BYTES, connectDeps, flush } from "./fakes.mjs";
+import { load, token } from "./helpers.mjs";
+
+const L = await load("lib.js");
+const link = (o = {}) => ({ suite: "smoke", room: "10", transport: "wt", attempt: 0, token: token(), wrongHash: false, bite: null, ...o });
+
+/** Starts connect() and resolves `out.v` once it settles. */
+function start(d) {
+  const out = { v: undefined };
+  L.connect(d).then((v) => (out.v = v));
+  return out;
+}
+
+test("wt ready: WebTransport, with the pinned hash, no pooling, unreliable required, the room's port", async () => {
+  const c = new FakeClock();
+  const d = connectDeps(link(), c);
+  const r = start(d);
+  await flush();
+  assert.deepEqual(d.fetched, ["/npt/cert-hash-10.json"]);
+  assert.equal(FakeWt.made.length, 1);
+  const wt = FakeWt.made[0];
+  assert.equal(wt.url, "https://127.0.0.1:30011/npt");
+  assert.equal(wt.options.allowPooling, false);
+  assert.equal(wt.options.requireUnreliable, true);
+  assert.equal(wt.options.serverCertificateHashes.length, 1);
+  assert.equal(wt.options.serverCertificateHashes[0].algorithm, "sha-256");
+  assert.deepEqual([...wt.options.serverCertificateHashes[0].value], [...HASH_BYTES]);
+  await c.advance(200);
+  wt.open();
+  await flush();
+  assert.equal(r.v.kind, "wt");
+  assert.equal(r.v.wt, wt);
+  assert.equal(c.timers.size, 0, "the 1.5 s timer is cleared");
+  await c.advance(5000);
+  assert.equal(FakeWs.made.length, 0);
+  assert.equal(wt.closeCalls, 0);
+});
+
+test("wt failing: WebSocket at once, not after 1.5 s", async () => {
+  const c = new FakeClock();
+  const d = connectDeps(link(), c);
+  const r = start(d);
+  await c.advance(100);
+  FakeWt.made[0].fail();
+  await flush();
+  assert.equal(FakeWs.made.length, 1);
+  assert.equal(FakeWs.made[0].url, "wss://127.0.0.1:31011/");
+  assert.equal(FakeWs.made[0].binaryType, "arraybuffer");
+  FakeWs.made[0].open();
+  await flush();
+  assert.equal(r.v.kind, "ws");
+  assert.equal(r.v.fellBack, true);
+  assert.equal(c.t, 100);
+});
+
+test("wt silent: WebSocket at 1.5 s, not before (P9)", async () => {
+  const c = new FakeClock();
+  const d = connectDeps(link(), c);
+  const r = start(d);
+  await c.advance(1499);
+  assert.equal(FakeWs.made.length, 0);
+  await c.advance(1);
+  assert.equal(FakeWs.made.length, 1);
+  assert.equal(FakeWt.made[0].closeCalls, 1, "the silent attempt is closed");
+  FakeWs.made[0].open();
+  await flush();
+  assert.equal(r.v.kind, "ws");
+  assert.deepEqual(d.statuses, ["WebTransport · Connecting", "WebSocket · Connecting"]);
+});
+
+test("C9: a WebTransport ready at 1.6 s, after the fallback began, is closed again and never used", async () => {
+  const c = new FakeClock();
+  const d = connectDeps(link(), c);
+  const r = start(d);
+  await c.advance(1600);
+  const wt = FakeWt.made[0];
+  wt.open();
+  await flush();
+  assert.equal(wt.closeCalls, 2);
+  assert.equal(wt.bidis.length, 0, "no control stream, so no Join, on the abandoned session");
+  FakeWs.made[0].open();
+  await flush();
+  assert.equal(r.v.kind, "ws");
+});
+
+test("ws: never WebTransport, no hash file", async () => {
+  const c = new FakeClock();
+  const d = connectDeps(link({ transport: "ws" }), c);
+  const r = start(d);
+  await flush();
+  FakeWs.made[0].open();
+  await flush();
+  assert.equal(r.v.kind, "ws");
+  assert.equal(r.v.fellBack, false);
+  assert.equal(FakeWt.made.length, 0);
+  assert.deepEqual(d.fetched, []);
+});
+
+test("cert-14d and wt-attempts: no fallback and no timer; a failed session fails at once (P13)", async () => {
+  for (const suite of ["cert-14d", "wt-attempts"]) {
+    const c = new FakeClock();
+    const d = connectDeps(link({ suite }), c);
+    const r = start(d);
+    await c.advance(5000);
+    assert.equal(r.v, undefined, `${suite}: still waiting at 5 s`);
+    assert.equal(FakeWs.made.length, 0);
+    FakeWt.made[0].fail();
+    await flush();
+    assert.deepEqual(r.v, { kind: "failed", why: "the WebTransport session did not open" });
+    await c.advance(5000);
+    assert.equal(FakeWs.made.length, 0, `${suite}: never WebSocket`);
+  }
+});
+
+test("hash=wrong pins each byte XOR 0xff (C4)", async () => {
+  const c = new FakeClock();
+  const d = connectDeps(link({ suite: "wt-attempts", wrongHash: true }), c);
+  start(d);
+  await flush();
+  assert.deepEqual([...FakeWt.made[0].options.serverCertificateHashes[0].value], [...HASH_BYTES].map((b) => b ^ 0xff));
+});
+
+test("the hash file comes first: a fetch failure or a bad file connects nothing", async () => {
+  for (const o of [{ fetchFails: true }, { hashText: "{}" }]) {
+    const c = new FakeClock();
+    const d = connectDeps(link(), c, o);
+    const r = start(d);
+    await c.advance(3000);
+    assert.equal(r.v.kind, "failed");
+    assert.equal(FakeWt.made.length + FakeWs.made.length, 0);
+  }
+});
+
+test("a WebSocket that never opens fails; no timeout (null) waits on WebTransport for ever", async () => {
+  const c = new FakeClock();
+  const d = connectDeps(link({ transport: "ws" }), c);
+  const r = start(d);
+  await flush();
+  FakeWs.made[0].fail();
+  await flush();
+  assert.deepEqual(r.v, { kind: "failed", why: "the WebSocket did not open" });
+  const c2 = new FakeClock();
+  const d2 = connectDeps(link(), c2, { timeoutMs: null });
+  const r2 = start(d2);
+  await c2.advance(30000);
+  assert.equal(r2.v, undefined);
+  assert.equal(FakeWs.made.length, 0);
+});
