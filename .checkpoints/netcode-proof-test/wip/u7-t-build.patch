index 0000000..5d0b47b
--- /dev/null
+++ b/spikes/netcode-proof/web/test/fake-core.mjs
@@ -0,0 +1,105 @@
+// fake-core.mjs: a stand-in for wasm-bindgen's npt_client_wasm.js with the Wasm class's shape (C5's boundary): a
+// default `init`, `new Client(token, bind)`, `step(now_ns: bigint, prev_send_ns: bigint, inbox: Uint8Array)` returning
+// the outbox, `next_due_ns(): bigint`, `counters(): Uint32Array`, and free `counter_names()` and `limits()`. Its
+// packing is written here from C5's text, apart from lib.ts's, so the golden file checks both.
+// Script: the first step sends the Join on Control; each due step sends an Input datagram, every 5th a Ping. A control
+// message of type 8 (JoinAccepted) sets `joined`, a datagram of type 6 (Pong) counts a clock sample, a full state
+// after the join sets `own_soldier`.
+export const TYPE = { input: 1, snapshot: 2, fullState: 3, ping: 5, pong: 6, join: 7, joinAccepted: 8 };
+export const TICK_NS = 33_333_333n;
+/** Steps a call at most (the real core's `npt_sim::LOOP_CATCHUP`). */
+export const CATCHUP = 7;
+export const NAMES = ["joined", "clock_samples", "own_soldier", "steps", "inbox_records", "inbox_refused"];
+
+/** C5's inbox, read with Buffer: records, or the rest refused at the first malformed one. */
+export function fakeUnpackInbox(bytes, caps = [1150, 256, 65541]) {
+  const b = Buffer.from(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  const out = [];
+  let o = 0;
+  let refused = 0;
+  while (o < b.length && out.length < 512) {
+    if (o + 13 > b.length) {
+      refused++;
+      break;
+    }
+    const channel = b.readUInt8(o);
+    const arrivalNs = b.readBigUInt64LE(o + 1);
+    const len = b.readUInt32LE(o + 9);
+    if (channel > 2 || len > caps[channel] || o + 13 + len > b.length) {
+      refused++;
+      break;
+    }
+    out.push({ channel, arrivalNs, bytes: Uint8Array.from(b.subarray(o + 13, o + 13 + len)) });
+    o += 13 + len;
+  }
+  return { records: out, refused };
+}
+
+/** C5's outbox, written with Buffer. */
+export function fakePackOutbox(records) {
+  return new Uint8Array(Buffer.concat(records.flatMap((r) => {
+    const h = Buffer.alloc(5);
+    h.writeUInt8(r.channel, 0);
+    h.writeUInt32LE(r.bytes.length, 1);
+    return [h, Buffer.from(r.bytes)];
+  })));
+}
+
+/** A core module; `opts.limits` replaces the six numbers, `opts.names` the counter names, `opts.trapAt` traps there. */
+export function makeCore(opts = {}) {
+  const log = { inits: 0, clients: [], steps: [] };
+  const limits = opts.limits ?? [256, 65541, 1150, 0, 1, 2];
+  class Client {
+    constructor(token, bind) {
+      if (typeof token !== "string" || !/^nptj_[A-Za-z0-9_-]{22}$/.test(token)) throw new Error("bad token");
+      if (!(bind instanceof Uint8Array) || bind.length !== 16) throw new Error("bad bind");
+      log.clients.push({ token, bind: Uint8Array.from(bind) });
+      this.c = { joined: 0, clock_samples: 0, own_soldier: 0, steps: 0, inbox_records: 0, inbox_refused: 0 };
+      this.due = 0n;
+      this.sentJoin = false;
+    }
+    step(nowNs, prevSendNs, inbox) {
+      if (typeof nowNs !== "bigint" || typeof prevSendNs !== "bigint" || !(inbox instanceof Uint8Array)) {
+        throw new TypeError("step(bigint, bigint, Uint8Array)");
+      }
+      const { records, refused } = fakeUnpackInbox(inbox, [limits[2], limits[0], limits[1]]);
+      log.steps.push({ nowNs, prevSendNs, records });
+      this.c.inbox_records += records.length;
+      this.c.inbox_refused += refused;
+      for (const r of records) {
+        if (r.channel === 1 && r.bytes[2] === TYPE.joinAccepted) this.c.joined = 1;
+        if (r.channel === 0 && r.bytes[0] === TYPE.pong && this.c.joined) this.c.clock_samples++;
+        if (r.channel === 2 && this.c.joined) this.c.own_soldier = 1;
+      }
+      const out = [];
+      if (!this.sentJoin) {
+        this.sentJoin = true;
+        out.push({ channel: 1, bytes: [3, 0, TYPE.join, 0xa1, 0xa2] });
+      }
+      if (opts.trapAt !== undefined && this.c.steps >= opts.trapAt) throw new WebAssembly.RuntimeError("unreachable");
+      for (let k = 0; k < CATCHUP && this.due <= nowNs; k++) {
+        this.c.steps++;
+        out.push({ channel: 0, bytes: [TYPE.input, this.c.steps & 0xff] });
+        if (this.c.steps % 5 === 0) out.push({ channel: 0, bytes: [TYPE.ping, this.c.steps & 0xff] });
+        this.due = (this.due === 0n ? nowNs : this.due) + TICK_NS;
+      }
+      return fakePackOutbox(out);
+    }
+    next_due_ns() {
+      return this.due;
+    }
+    counters() {
+      return Uint32Array.from(NAMES.map((n) => this.c[n]));
+    }
+    free() {}
+  }
+  return {
+    log,
+    default: async () => {
+      log.inits++;
+    },
+    Client,
+    counter_names: () => (opts.names ?? NAMES).slice(),
+    limits: () => Uint32Array.from(limits),
+  };
+}
diff --git a/spikes/netcode-proof/web/test/fakes.mjs b/spikes/netcode-proof/web/test/fakes.mjs
new file mode 100644
index 0000000..b2a96b5
--- /dev/null
+++ b/spikes/netcode-proof/web/test/fakes.mjs
@@ -0,0 +1,157 @@
+// fakes.mjs: a fake clock with timers, a fake WebTransport and WebSocket (Node's own web streams), for the chooser and
+// the Worker's tests. Each fake records what the page did to it; nothing touches a network.
+
+/** Lets every pending promise callback run. */
+export async function flush(rounds = 4) {
+  for (let i = 0; i < rounds; i++) await new Promise((r) => setImmediate(r));
+}
+
+/** Time in ms from 0; timers fire only inside `advance`, in time order, with promises flushed after each. */
+export class FakeClock {
+  t = 0;
+  seq = 0;
+  timers = new Map();
+  now = () => this.t;
+  setTimer = (fn, ms) => {
+    const id = ++this.seq;
+    this.timers.set(id, { at: this.t + Math.max(0, ms), fn });
+    return id;
+  };
+  clearTimer = (id) => {
+    this.timers.delete(id);
+  };
+  async advance(ms) {
+    const end = this.t + ms;
+    await flush();
+    for (;;) {
+      const next = [...this.timers.entries()].filter(([, x]) => x.at <= end).sort((a, b) => a[1].at - b[1].at || a[0] - b[0])[0];
+      if (!next) break;
+      this.timers.delete(next[0]);
+      this.t = next[1].at;
+      next[1].fn();
+      await flush();
+    }
+    this.t = end;
+    await flush();
+  }
+}
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((a, b) => {
+    resolve = a;
+    reject = b;
+  });
+  return { promise, resolve, reject };
+}
+
+/** A readable stream whose chunks the test pushes, and a writable one that keeps what the page wrote. */
+function pipePair() {
+  let ctl;
+  const readable = new ReadableStream({ start: (c) => (ctl = c) });
+  const written = [];
+  const writable = new WritableStream({ write: (chunk) => void written.push(Uint8Array.from(chunk)) });
+  return { readable, writable, written, push: (b) => ctl.enqueue(Uint8Array.from(b)), end: () => ctl.close() };
+}
+
+export class FakeWt {
+  static made = [];
+  constructor(url, options) {
+    this.url = url;
+    this.options = options;
+    this.closeCalls = 0;
+    this.bidis = [];
+    this._ready = deferred();
+    this._closed = deferred();
+    this.ready = this._ready.promise;
+    this.closed = this._closed.promise;
+    this.ready.catch(() => {});
+    this.dg = pipePair();
+    this.datagrams = { readable: this.dg.readable, writable: this.dg.writable, maxDatagramSize: 1024 };
+    let uctl;
+    this.incomingUnidirectionalStreams = new ReadableStream({ start: (c) => (uctl = c) });
+    this.pushUni = (chunks) => {
+      let sc;
+      const s = new ReadableStream({ start: (c) => (sc = c) });
+      uctl.enqueue(s);
+      for (const ch of chunks) sc.enqueue(Uint8Array.from(ch));
+      return { end: () => sc.close(), push: (b) => sc.enqueue(Uint8Array.from(b)) };
+    };
+    FakeWt.made.push(this);
+  }
+  open() {
+    this._ready.resolve();
+  }
+  fail() {
+    this._ready.reject(new Error("refused"));
+    this._closed.reject(new Error("refused"));
+  }
+  close() {
+    this.closeCalls++;
+    this._closed.resolve();
+  }
+  async createBidirectionalStream() {
+    const p = pipePair();
+    this.bidis.push(p);
+    return p;
+  }
+}
+
+export class FakeWs {
+  static made = [];
+  constructor(url) {
+    this.url = url;
+    this.binaryType = "blob";
+    this.bufferedAmount = 0;
+    this.sent = [];
+    this.closeCalls = 0;
+    this.onopen = this.onclose = this.onerror = this.onmessage = null;
+    FakeWs.made.push(this);
+  }
+  open() {
+    this.onopen?.({});
+  }
+  fail() {
+    this.onerror?.({});
+    this.onclose?.({});
+  }
+  message(bytes) {
+    this.onmessage?.({ data: Uint8Array.from(bytes).buffer });
+  }
+  send(d) {
+    this.sent.push(Uint8Array.from(d));
+  }
+  close() {
+    this.closeCalls++;
+  }
+}
+
+/** The hash file U6b's room writes, for a 32-byte value that is no palindrome (bytes 0x00..0x1f). */
+export const HASH_BYTES = Uint8Array.from({ length: 32 }, (_, i) => i);
+export const hashFile = (hex = Buffer.from(HASH_BYTES).toString("hex")) =>
+  JSON.stringify({ algorithm: "sha-256", value_hex: hex, validity_ns: 13 * 86400 * 1e9 });
+
+/** ConnectDeps over the fakes; `fetched` lists every path asked for. */
+export function connectDeps(link, clock, { timeoutMs = 1500, hashText = hashFile(), fetchFails = false } = {}) {
+  FakeWt.made = [];
+  FakeWs.made = [];
+  const d = {
+    link,
+    host: "127.0.0.1",
+    timeoutMs,
+    fetched: [],
+    statuses: [],
+    fetchText: async (path) => {
+      d.fetched.push(path);
+      if (fetchFails) throw new Error("404");
+      return hashText;
+    },
+    webTransport: (url, options) => new FakeWt(url, options),
+    webSocket: (url) => new FakeWs(url),
+    setTimer: clock.setTimer,
+    clearTimer: clock.clearTimer,
+    onStatus: (s) => d.statuses.push(s),
+  };
+  return d;
+}
