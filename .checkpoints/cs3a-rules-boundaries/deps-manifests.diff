diff --git a/crates/devtools/Cargo.toml b/crates/devtools/Cargo.toml
index e5f8b193..69b263a8 100644
--- a/crates/devtools/Cargo.toml
+++ b/crates/devtools/Cargo.toml
@@ -5,5 +5,16 @@ edition.workspace = true
 rust-version.workspace = true
 publish.workspace = true
 
+# An rlib for the native tests and tools, and a cdylib for the test-only WebAssembly module: the development build
+# makes it so that the rule tests also run in WebAssembly (ADR 0002 part 8). It is never part of what players get.
+[lib]
+crate-type = ["cdylib", "rlib"]
+
+[dependencies]
+sim = { path = "../sim" }
+# For the panic hook as players get it, linked into the test module.
+sim-wasm = { path = "../sim-wasm" }
+wasm-bindgen = { workspace = true }
+
 [lints]
 workspace = true
