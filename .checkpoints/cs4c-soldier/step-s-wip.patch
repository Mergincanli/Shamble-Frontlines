+  const floor = buildMapFloor(MAP);
+  const position = meshOf(floor, "wall").geometry.getAttribute("position");
+  position.setX(0, 99);
+  const wall = readInventory(floor).find((object) => object.id === "wall");
+  expect(wall?.points.some((point) => point[0] === 99)).toBe(true);
