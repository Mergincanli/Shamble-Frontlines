+    /// The map's bounds as the simulation holds them: each face of the document narrowed once to `f32` by the shapes'
+    /// own rule (`narrow`; never from the centimetres), its lower corner and then its upper one. The movement reads
+    /// them: the bottom is the ground, the four sides are walls, the top is an underside.
+    #[must_use]
+    pub const fn bounds_m(&self) -> [[f32; 3]; 2] {
+        self.bounds_m
+    }
+
+    /// The ground: the bounds' lower y, solid under the whole box (content's map.rs: "a soldier with nothing under him
+    /// stands on it, and a fall ends on it").
+    #[must_use]
+    pub const fn floor_y(&self) -> f32 {
+        self.bounds_m[0][1]
+    }
+
+    /// The shapes whose stored box meets the box from `min` to `max` (touching counts), their indices in rising order,
+    /// written into `found`, which holds every shape a world may have. The tree's walk prunes each node whose box
+    /// misses the query; the order the walk visits the leaves in is the tree's, so the indices are sorted after it,
+    /// and a caller's ties go to the lower index whatever the layout. A query with a corner that is no number finds
+    /// nothing. It allocates nothing.
+    pub fn candidates<'f>(
+        &self,
+        min: [f32; 3],
+        max: [f32; 3],
+        found: &'f mut [u32; MAX_SHAPES],
+    ) -> &'f [u32] {
+        let meets = |low: [f32; 3], high: [f32; 3]| {
+            (0..3).all(|axis| low[axis] <= max[axis] && min[axis] <= high[axis])
+        };
+        let mut count = 0;
+        self.tree.traverse(|node| {
+            if !meets(node.mins().to_array(), node.maxs().to_array()) {
+                return TraversalAction::Prune;
+            }
+            if let Some(shape) = node.leaf_data()
+                && let Some(place) = found.get_mut(count)
+            {
+                *place = shape;
+                count += 1;
+            }
+            TraversalAction::Continue
+        });
+        let found = &mut found[..count];
+        found.sort_unstable();
+        found
+    }
+
