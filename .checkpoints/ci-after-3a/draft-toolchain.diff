+              python3 -I -B crates/devtools/vectors/make_f32_vectors.py --check
               cargo build --locked --target wasm32-unknown-unknown -p sim -p protocol -p room -p client-endpoint -p sim-wasm
+              echo "== the test-only module (devtools) built for wasm32 on its own line, so a native-only dependency fails here by name"
