--- a/.github/workflows/toolchain.yml
+++ b/.github/workflows/toolchain.yml
@@ -7,7 +7,10 @@
 # CI-WASM: before the cut, the wasm-bindgen tool's archive is fetched and checked against Mustafa's values and by
 # GitHub's own check of the release; its one program is installed root-owned. Inside the cut the page is built with
 # it; then the boundary tests, the type checks of the Worker, the page and the browser specs, and the browser tests
-# run (in the runner image's Google Chrome: nothing is downloaded for them).
+# run in the runner image's Google Chrome, then the tests the firefox project of playwright.config.ts names run in its
+# Mozilla Firefox (Mustafa's FIREFOX-SOURCE (c); Playwright drives that Firefox over WebDriver BiDi): nothing is
+# downloaded for them. Inside the cut the job also runs every crate's release tests, the two vector generators' checks
+# and a wasm32 build of the test-only crate (devtools) on its own line.
 name: toolchain
 
 on:
@@ -156,8 +159,14 @@
               SHAMBLE_WRITE_TYPES=1 cargo test --workspace --locked
               changed=$(git status --porcelain --untracked-files=all -- packages/types/src/generated)
