                 npx --no -- playwright test -c packages/e2e/playwright.config.ts --project=firefox --workers=1 --retries=0 \
                   --reporter=list --global-timeout=300000
             '
+
+      # After the cut, for pull requests from this repository only: hand the tested player build to lane 2's preview
+      # workflow (.github/workflows/preview.yml, which starts on `workflow_run` of this workflow's name `toolchain` and
+      # treats these files as data). The cut's code wrote the build, so first a check that it holds only plain files
+      # and folders, none named with a leading dot (the upload follows symbolic links and drops dot names unasked),
+      # with absolute paths, since the cut's user can write in PATH. It catches a link or dot name left in the build and
+      # prints the count; it is no boundary: code that ran inside the cut is the runner's user and can still change
+      # later steps (CUT-ESCAPE).
+      - name: Check that the tested build holds only plain files and folders (pull requests from this repository only)
+        if: github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository
+        shell: /usr/bin/bash --noprofile --norc -euo pipefail {0}
+        run: |
+          d="$GITHUB_WORKSPACE/.gate/dist-production"
+          for p in "$GITHUB_WORKSPACE/.gate" "$d"; do [ -d "$p" ] && [ ! -L "$p" ] || { echo "$p is not a plain folder"; exit 1; }; done
+          bad=$(/usr/bin/find "$d" -mindepth 1 \( ! -type f ! -type d -o -name '.*' \) -print)
+          [ -z "$bad" ] || { echo "not a plain file or folder, or a name that begins with a dot:"; echo "$bad"; exit 1; }
+          n=$(/usr/bin/find "$d" -type f -printf '.' | /usr/bin/wc -c)
+          [ "$n" -gt 0 ] || { echo "the build is empty"; exit 1; }
+          echo "$n files, $(/usr/bin/du -sb "$d" | /usr/bin/cut -f1) bytes"
+
+      # An empty upload fails; nothing whose own name begins with a dot leaves, file or folder (the check above refuses
+      # such names, so its count equals the upload's).
+      - name: Hand the tested build to the preview workflow (pull requests from this repository only)
+        if: github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: preview-site
+          path: .gate/dist-production
+          include-hidden-files: true
+          if-no-files-found: error
+          retention-days: 7
