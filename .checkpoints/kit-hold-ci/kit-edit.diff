+// The manifests and lockfiles that pushing `rev` would publish with no recorded check: changed against the remote
+// branch (against main's merge-base while the branch is not on the remote yet) and not named, with the sha256 of
+// their content in `rev`, in that commit's .checkpoints/<slug>/dependency-check.md. What cannot be read is held.
+function heldDependencyFiles(o, branch, rev) {
+  const remote = git('rev-parse', '--verify', '--quiet', `refs/remotes/origin/${branch}`);
+  const base = remote.ok ? remote : git('merge-base', 'refs/remotes/origin/main', rev);
+  const names = base.ok ? git('diff', '-z', '--name-only', '--no-renames', base.out, rev) : base;
+  if (!names.ok) return ['(what this push changes could not be read)'];
+  const record = git('show', `${rev}:${DIR}${o.slug}/dependency-check.md`);
+  const released = new Set(record.ok ? record.out.split('\n').map((l) => l.trim()) : []);
+  return names.out.split('\0').filter((f) => DEP_FILE.test(f)).filter((f) => {
+    let sum = 'deleted';
+    try {
+      const blob = execFileSync('git', ['cat-file', 'blob', `${rev}:${f}`], { stdio: ['ignore', 'pipe', 'ignore'], shell: false, maxBuffer: 64 << 20 });
+      sum = createHash('sha256').update(blob).digest('hex');
+    } catch { /* the file is not in rev: removed */ }
+    return !released.has(`${sum}  ${f}`);
+  });
+}
